{
  "name": "zero-core-cloudflare",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute zero-core --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute zero-core --remote --file=./migrations/0001_init.sql",
    "db:export": "wrangler d1 export zero-core --remote --output=zero-core-export.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
