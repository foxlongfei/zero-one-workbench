      "id": "D06_RETURN_READINESS",
      "outputs": [
        "DIRECTION_ONLY_NO_OBSERVATION",
        "DIRECTION_ONLY_PARTIAL_OBSERVATION",
        "DIRECTION_ONLY_INPUT_INCOMPLETE",
        "DIRECTION_AND_OBSERVATION_READY"
      ]
    }
  ],
  "rules": [
    "A non-empty value requires one allowed source; otherwise MISSING_SOURCE.",
    "A source without a value is ORPHAN_SOURCE.",
    "A blank value and blank source is UNKNOWN, not a negative observation.",
    "Only four known fields with no pair errors return DIRECTION_AND_OBSERVATION_READY.",
    "All other valid states return a direction-only readiness result and never an environmental judgment."
