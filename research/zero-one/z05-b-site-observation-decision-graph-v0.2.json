  "scope": "Classify whether four site-observation fields are ready for a later environmental method. This graph does not make an environmental or auspiciousness judgment.",
  "fields": ["opening", "road", "water", "slope"],
  "allowed_sources": ["DIRECT_OBSERVATION", "MEASURED", "REPORTED"],
  "decision_nodes": [
    {
      "id": "D04_VALIDATE_FIELD_SOURCE_PAIRS",
