n'));\nrecord('A01','JavaScript syntax',()=>execFileSync(process.execPath,['--check','portal/assets/v02-exercise-workbench.js']));\nrecord('B01','JavaScript syntax',()=>execFileSync(process.execPath,['--check','portal/assets/v02-residence-workbench.js']));\nrecord('A01','main page integration',()=>assert.ok(ah.includes('v02-exercise-workbench.js')));\nrecord('B01','main page integration',()=>assert.ok(bh.includes('v02-residence-workbench.js')));\nrecord('A01','exercise ID and teaching controls',()=>{for(const v of ['exercise:wger:1551:push-up','v02-play','v02-stop','v02-phase','v02-speed','license'])assert.ok(a.includes(v),v)});\nrecord('A01','exercise object roles and joint motion',()=>{for(const v of ['primary','secondary','stabilizers','v02-joints','PROJECT_GUIDANCE_NOT_UPSTREAM_STANDARD'])assert.ok(a.includes(v),v)});\nrecord('A01','licensed upstream record imported',()=>{assert.equal(upstream.exercise.uuid,'f5b84269-18af-4464-a61f-b767cbcd81dc');assert.equal(upstream.exercise.license.shortName,'CC-BY-SA 4');assert.equal(upstream.exercise.license.author,'Settebello');for(const v of ['LICENSED_RECORD_IMPORTED','v02-wger-pushup.json','CC-BY-SA 4','Settebello'])assert.ok(a.includes(v),v)});\nrecord('A01','licensed common variant imported',()=>{assert.equal(upstreamVariant.exercise.id,1964);assert.equal(upstreamVariant.exercise.uuid,'1842e1be-ac67-4f34-a527-4ca2b72d8e11');assert.equal(upstreamVariant.exercise.license.shortName,'CC-BY-SA 4');assert.equal(upstreamVariant.exercise.license.author,'Anon#2');for(const v of ['LICENSED_VARIANT_IMPORTED','v02-wger-wide-pushup.json','v02-load-wide','NO_MEDIA_IN_CURRENT_RECORD'])assert.ok(a.includes(v),v)});\nrecord('B01','residence identity and persistence',()=>{for(const v of ['zero-one.residence.v0.2','caseId','localStorage','r-export','r-import','revisions'])assert.ok(b.includes(v),v)});\nrecord('B01','material provenance and active clarification',()=>{for(const v of ['r-material','r-source','r-confidence','r-next-question