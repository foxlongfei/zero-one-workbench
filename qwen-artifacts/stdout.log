lick=async()=>{stop();try{if(view){await view.goTo(item.cfi)}else{textIndex=restoredTextIndex(item,textPages.length);renderText()}$('bookmarkPanel').hidden=true;status(`已跳转到书签：${item.label||'保存的位置'}`)}catch(e){status(`书签跳转失败：${e.message}；可删除后重新添加`)}};remove.type='button';remove.dataset.action='delete-bookmark';remove.textContent='删除';remove.setAttribute('aria-label','删除书签 '+jump.textContent);remove.onclick=()=>{writeBookmarks(readBookmarks().filter(x=>x.id!==item.id));renderBookmarks();status(`已删除书签：${item.label||'保存的位置'}`)};li.append(jump,remove);$('bookmarkList').append(li)}}\nfunction addBookmark(){const pos=getPos();if(!active||!pos||(view&&!pos.cfi)){status('当前位置尚未就绪，请翻页或等待正文载入后再添加书签');return}const item={id:crypto.randomUUID(),createdAt:Date.now(),label:pos.label||$('position').textContent||'保存的位置',...(view?{cfi:pos.cfi}:{index:textIndex})};const items=readBookmarks();const same=view?items.some(x=>x.cfi===item.cfi):items.some(x=>Number(x.index)===textIndex);if(same){status('当前位置已有书签');return}items.push(item);writeBookmarks(items);renderBookmarks();status(`已添加书签：${item.label}`)}\nfunction addToc(items,depth=0){if(!items||depth>8)return;for(const item of items){const li=document.createElement('li'),b=document.createElement('button'),label=item.label||item.title||'章节';b.textContent='　'.repeat(depth)+label;b.onclick=async()=>{stop();const target=view;try{await target.goTo(item.href);if(view===target){$('tocPanel').hidden=true;status(`已跳转到 ${label}`)}}catch(e){if(view===target)status(`目录“${label}”跳转失败：${e.message}；可选择其他章节或返回书架`)}};li.append(b);$('tocList').append(li);addToc(item.subitems||item.children,depth+1)}}\nfunction splitTXT(text){const chunks=[];const chapters=text.split(/(?=^\\s*(?:第[一二三四五六七八九十百千0-9]+[章节回卷]|Chapter\\s+\\d+)(?:\\s|$))/gim).filter(Boolean);for(const chapter of chapters){for(let i=0;i<chapter.length;i+=3000)chunks.push(chapter.slice(i,i+3000))}return chunks.length?chunks:['（空文件）']}\nfunction restoredTextIndex(saved,length){const index=Number(s