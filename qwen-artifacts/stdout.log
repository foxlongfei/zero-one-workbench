ice: '', apiKey: '' },\n  library: { baseUrl: params.get('voiceLibrary') || '', token: '', voiceId: '' },\n  music: { volume: 0.18, ducking: true },\n  statistics: { days: {}, listenedMs: 0 },\n  worldFavourites: [],\n};\nconst mergeSettings = patch => ({\n  ...settings,\n  ...patch,\n  endpoint: { ...settings.endpoint, ...patch.endpoint },\n  library: { ...settings.library, ...patch.library },\n  music: { ...settings.music, ...patch.music },\n  statistics: { ...settings.statistics, ...patch.statistics },\n});\n\nlet settings = DEFAULT_SETTINGS;\ntry {\n  settings = mergeSettings(JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}'));\n} catch { /* corrupted preferences fall back to defaults */ }\nconst saveSettings = () => localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));\n\n// --------------------------------------------------------------------------\n// Speech engines\n// --------------------------------------------------------------------------\nlet narration = null;\nlet currentEngine = null;\nlet activeVoice = null;\n\nconst buildEngine = (kind = settings.engine) => {\n  if (kind === 'endpoint' && settings.endpoint.baseUrl) {\n    try {\n      return new EndpointEngine({ ...settings.endpoint, speed: settings.rate, name: settings.endpoint.model || '神经网络语音' });\n    } catch (error) {\n      status(`没接通语音服务：${error.message}`, 'warn');\n    }\n  }\n  if (kind === 'library' && activeVoice) {\n    return new LibraryVoiceEngine({\n      voiceId: activeVoice.id, name: activeVoice.name, speed: settings.rate,\n      baseUrl: settings.library.baseUrl, licenseToken: settings.library.token,\n    });\n  }\n  if (params.get('ttsTone') === '1') {\n    // Test-only voice, opted in per URL: it exists so the listening loop can be\n    // verified in a real browser without a network or model download.\n    return new ToneEngine({ speed: settings.rate });\n  }\n  return new BrowserEngine({ voiceURI: settings.browserVoiceURI, rate: settings.rate });\n};\n\nconst engineHint = engine => {\n  if (!engine) return '还没有可用的朗读引擎。';\n  if (engine.kind === 'browser') return '本机浏览器语音：不联网、不上传文本；音质取决于设备。';\n  if (engine.kind === 'endpoint') return `神经网络语音「${engine.name}」：朗读文本会发送到 ${engine.baseUrl}。`;\n  if (engine.kind === 'library') return `家庭授权声音「${engine.name}」：文本只发送到你的声音库。`;\n  return '离线测试音：仅用于自动化测试。';\n};\n\n// --------------------------------------------------------------------------\n// Shelf\n// --------------------------------------------------------------------------\nlet books = [];\nlet coverUrls = new Set();\nlet activeBook = null;\nlet voices = [];\n\nconst progressKey = id => `rw03-progress-${id}`;\nconst bookProgress = id => {\n  try { return JSON.parse(localStorage.getItem(progressKey(id)) || 'null'); } catch { return null; }\n};\nconst saveProgress = (id, position) => {\n  localStorage.setItem(progressKey(id), JSON.stringify({ ...position, updatedAt: now() }));\n  if (localStorage.getItem('rw03-last-book') === id) renderResume();\n};\n\nconst formatOf = book => String(book.format || book.filename?.split('.').pop() || '').toUpperCase();\nconst titleOf = book => book.title || book.filename || '未命名';\n\nfunction progressLabel(book) {\n  const saved = bookProgress(book.id);\n  if (!saved) return '尚未开始';\n  if (saved.finished) return '已读完 · 可再听一遍';\n  const chapter = saved.chapterTitle || `第 ${Number(saved.chapter || 0) + 1} 章`;\n  return `${saved.listening ? '听到' : '读到'} ${chapter} · ${percent(saved.fraction ?? 0)}`;\n}\n\nasync function refreshShelf() {\n  books = (await store.listBooks()).sort((a, b) => {"}]}},{"type":"user","uuid":"a9086fe4-95c8-4d16-b294-edf84c2d1f55","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_01_wKmApW1Jye7iFE6opUNg9403","is_error":false,"content":"// Playlist resolution for 听世界 (listening world): background music, radio\n// streams and podcasts resolved from licences. Resolution is data-driven and\n// pure so it can be tested; playback itself lives in the UI.\n//\n// Rights model: every source states license and whether it is safe for public\n// deployment. Streams at third-party URLs are never re-hosted; we only link to\n// the official endpoint the rights holder publishes. Bundled assets must be\n// public-domain or CC0/CC-BY (attribution rendered in the UI).\n\nconst hourNumber = date => (date instanceof Date ? date.getHours() : Number(date));\n\nexport const BUILTIN_SOURCES = [\n  {\n    id: 'ambience-room',\n    kind: 'ambience',\n    title: '安静书房',\n    attribution: '合成环境音，公共领域（本站生成）',\n    license: 'public-domain',\n    requiresNetwork: false,\n    daypart: null,\n  },\n  {\n    id: 'bbcr3',\n    kind: 'radio',\n    title: 'BBC Radio 3 · 古典音乐',\n    url: 'https://stream.live.vc.bbcmedia.co.uk/bbc_radio_three',\n    homepage: 'https://www.bbc.co.uk/radio3',\n    attribution: 'BBC Radio 3 官方公开直播地址',\n    license: 'official-stream',\n    requiresNetwork: true,\n    daypart: ['day'],\n    topic: 'classical',\n  },\n  {\n    id: 'france-musique',\n    kind: 'radio',\n    title: 'France Musique · 古典音乐',\n    url: 'https://icecast.radiofrance.fr/francemusique-midfi.mp3',\n    homepage: 'https://www.radiofrance.fr/francemusique',\n    attribution: 'Radio France 官方公开直播地址',\n    license: 'official-stream',\n    requiresNetwork: true,\n    daypart: ['day'],\n    topic: 'classical',\n  },\n  {\n    id: 'ningxia-story',\n    kind: 'podcast',\n    title: '睡前故事（示例单集）',\n    url: '',\n    attribution: '示例条目：上线前须替换为持权方授权节目',\n    license: 'placeholder',\n    requiresNetwork: true,\n    daypart: ['evening'],\n    topic: 'story',\n  },\n];\n\nexport function resolveDaypart(date = new Date()) {\n  const h = hourNumber(date);\n  if (h < 7) return 'night';\n  if (h < 18) return 'day';\n  return 'evening';\n}\n\n// Pick the playlist to play behind the book.\nexport function resolvePlaylist({ sources = BUILTIN_SOURCES, ambience = [], daypart = resolveDaypart(), topic = '', favourites = [], mode = 'auto' } = {}) {\n  if (mode === 'ambience') {\n    const item = ambience[0];\n    if (!item) return { kind: 'none', reason: '尚未添加背景音乐文件' };\n    return { kind: 'ambience', item };\n  }\n  if (mode === 'favourites') {\n    const source = sources.find(s => favourites.includes(s.id));\n    if (!source) return { kind: 'none', reason: '收藏夹为空' };\n    return playlistOf(source);\n  }\n  const candidates = sources.filter(source => source.license !== 'placeholder'\n    && source.daypart?.includes(daypart)\n    && (!topic || source.topic === topic));\n  if (candidates.length) return playlistOf(candidates[0]);\n  if (ambience.length) return { kind: 'ambience', item: ambience[0] };\n  return { kind: 'none', reason: `当前时段（${daypart}）没有可用频道` };\n}\n\nconst playlistOf = source => ({\n  kind: source.kind,\n  item: source,\n  playable: source.requiresNetwork ? Boolean(source.url) : true,\n});\n\nexport function catalog({ sources = BUILTIN_SOURCES } = {}) {\n  const byKind = {};\n  for (const source of sources) {\n    byKind[source.kind] = byKind[source.kind] || [];\n    byKind[source.kind].push(source);\n  }\n  return byKind;\n}\n"}]}},{"type":"assistant","uuid":"bf60deeb-7c0b-4486-aa7b-477455d6ba9c","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"id":"bf60deeb-7c0b-4486-aa7b-477455d6ba9c","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"text","text":"I'll save memories about the durable gotchas — the test/browser invocation traps I just rediscovered — before writing code."}],"stop_reason":null,"usage":{"input_tokens":0,"output_tokens":0}}},{"type":"assistant","uuid":"8d238aa1-60ca-492a-bf39-c9f82d956994","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"id":"8d238aa1-60ca-492a-bf39-c9f82d956994","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_x3OiWeLb2dP2LoKKIYzp9242","name":"write_file","