d":"036f0f85-9409-42fd-ba27-d870a2fd1734","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"id":"036f0f85-9409-42fd-ba27-d870a2fd1734","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_eNxVDSdC2ttDBN2cLwsS6927","name":"read_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/read-with-you/state.js"}},{"type":"tool_use","id":"call_01_6vKxXO2Jz81p1bxl9Mu34101","name":"read_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/read-with-you/tts.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":25387,"output_tokens":114,"cache_read_input_tokens":14080,"total_tokens":25501}}},{"type":"user","uuid":"5b3561c3-9acb-4513-88da-6c41efe6ca1e","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_eNxVDSdC2ttDBN2cLwsS6927","is_error":false,"content":"// Local-first persistence for Read With You.\n// One IndexedDB database, versioned stores, no data ever leaves the device.\n// Old prototype data from the same origin is migrated on first launch.\n\nexport const DB_NAME = 'rwy-db';\nexport const DB_VERSION = 1;\nconst LEGACY_DB = 'zero-one-reader-library';\n\nexport const STORES = {\n  books: { keyPath: 'id', indexes: [['fingerprint', 'fingerprint']] },\n  positions: { keyPath: 'bookId' },\n  bookmarks: { keyPath: 'id', indexes: [['bookId', 'bookId']] },\n  notes: { keyPath: 'id', indexes: [['bookId', 'bookId']] },\n  settings: { keyPath: 'id' },\n  voices: { keyPath: 'id' },\n  audit: { keyPath: 'id', indexes: [['at', 'at']] },\n};\n\nlet dbPromise = null;\n\nfunction promisify(request) {\n  return new Promise((resolve, reject) => {\n    request.onsuccess = () => resolve(request.result);\n    request.onerror = () => reject(request.error);\n  });\n}\n\nexport function txDone(tx) {\n  return new Promise((resolve, reject) => {\n    tx.oncomplete = () => resolve();\n    tx.onerror = () => reject(tx.error);\n    tx.onabort = () => reject(tx.error || new Error('transaction aborted'));\n  });\n}\n\nexport function openDb() {\n  if (dbPromise) return dbPromise;\n  dbPromise = new Promise((resolve, reject) => {\n    const request = indexedDB.open(DB_NAME, DB_VERSION);\n    request.onupgradeneeded = () => {\n      const db = request.result;\n      for (const [name, def] of Object.entries(STORES)) {\n        const store = db.objectStoreNames.contains(name)\n          ? request.transaction.objectStore(name)\n          : db.createObjectStore(name, { keyPath: def.keyPath });\n        for (const [indexName, path] of def.indexes || []) {\n          if (!store.indexNames.contains(indexName)) store.createIndex(indexName, path);\n        }\n      }\n    };\n    request.onsuccess = () => {\n      const db = request.result;\n      db.onversionchange = () => db.close();\n      resolve(db);\n    };\n    request.onerror = () => reject(request.error);\n    request.onblocked = () => reject(new Error('另一个页面正在升级书库，请关闭其它标签页后重试'));\n  }).then(async (db) => {\n    await migrateLegacy(db).catch(() => {});\n    return db;\n  });\n  return dbPromise;\n}\n\nasync function migrateLegacy(db) {\n  const markerKey = 'legacy-migrated';\n  const settingsTx = db.transaction('settings', 'readonly');\n  const marker = await promisify(settingsTx.objectStore('settings').get(markerKey));\n  if (marker) return;\n  let legacy;\n  try {\n    legacy = await new Promise((resolve, reject) => {\n      const request = indexedDB.open(LEGACY_DB);\n      request.onsuccess = () => resolve(request.result);\n      request.onerror = () => reject(request.error);\n      request.onblocked = () => reject(new Error('blocked'));\n    });\n  } catch {\n    return;\n  }\n  const imported = [];\n  try {\n    if (!legacy.objectStoreNames.contains('books')) return;\n    const books = await promisify(legacy.transaction('books', 'readonly').objectStore('books').getAll());\n    for (const old of books) {\n      if (!old?.blob?.size) continue;\n      const id = `mig-${old.id}`;\n      const existing = await get('books', id);\n      if (existing) continue;\n      const format = String(old.format || old.filename?.split('.').pop() || '').toUpperCase();\n      await put('books', {\n        id,\n        title: old.title || old.filename || '未命名',\n        author: old.author || '',\n        format,\n        filename: old.filename || 'book',\n        blob: old.blob,\n        cover: old.cover instanceof Blob ? old.cover : null,\n        fingerprint: old.fingerprint || null,\n        size: old.blob.size,\n        addedAt: Date.parse(old.added) || Date.now(),\n        migratedFrom: LEGACY_DB,\n      });\n      imported.push([old.id, id]);\n    }\n    for (const [oldId, newId] of imported) {\n      for (const key of ['reader-pos-', 'reader-bookmarks-']) {\n        const raw = localStorage.getItem(key + oldId);\n        if (!raw) continue;\n        const value = JSON.parse(raw);\n        if (key === 'reader-pos-') {\n          await put('positions', {\n            bookId: newId,\n            cfi: value.cfi || null,\n            textPage: Number.isInteger(value.index) ? value.index : null,\n            label: value.label || '',\n            updatedAt: Number(value.lastReadAt) || Date.now(),\n          });\n        } else if (Array.isArray(value)) {\n          for (const item of value)\n            await put('bookmarks', { id: `mig-${item.id}`, bookId: newId, cfi: item.cfi || null, label: item.label || '', createdAt: item.createdAt || Date.now() });\n        }\n      }\n    }\n  } finally {\n    legacy.close?.();\n  }\n  if (imported.length) await audit('library.migrated', { count: imported.length, from: LEGACY_DB });\n  await put('settings', { id: markerKey, at: Date.now(), count: imported.length });\n}\n\nexport async function getStore(name, mode = 'readonly') {\n  const db = await openDb();\n  return db.transaction(name, mode).objectStore(name);\n}\n\nexport async function get(name, key) {\n  return promisify((await getStore(name)).get(key));\n}\n\nexport async function getAll(name) {\n  return promisify((await getStore(name)).getAll());\n}\n\nexport async function getAllByIndex(name, index, value) {\n  return promisify((await getStore(name)).index(index).getAll(value));\n}\n\nexport async function put(name, value) {\n  const store = await getStore(name, 'readwrite');\n  const tx = store.transaction;\n  const result = promisify(store.put(value));\n  await txDone(tx);\n  return result;\n}\n\nexport async function del(name, key) {\n  const store = await getStore(name, 'readwrite');\n  const tx = store.transaction;\n  await promisify(store.delete(key));\n  await txDone(tx);\n}\n\nexport async function count(name) {\n  return promisify((await getStore(name)).count());\n}\n\nexport async function audit(action, detail = {}) {\n  // Privacy audit log: actions and metadata only, never note text or audio.\n  const entry = { id: crypto.randomUUID(), at: Date.now(), action, detail };\n  try {\n    await put('audit', entry);\n  } catch {\n    return entry;\n  }\n  return entry;\n}\n\nexport async function getAudit(limit = 200) {\n  const all = await getAll('audit');\n  return all.sort((a, b) => b.at - a.at).slice(0, limit);\n}\n\n// Settings helpers -------------------------------------------------------\n\nexport async function getSettings() {\n  const rows = await getAll('settings');\n  return Object.fromEntries(rows.map((row) => [row.id, 'value' in row ? row.value : row]));\n}\n\nexport async function setSetting(id, value) {\n  return put('settings', { id, value });\n}\n\n// Positions --------------------------------------------------------------\n\nexport async function savePosition(bookId, position) {\n  const row = { bookId, updatedAt: Date.now(), ...position };\n  await put('positions', row);\n  return row;\n}\n\nexport async function getPosition(bookId) {\n  return get('positions', bookId);\n}\n\n// Deletion ---------------------------------------------------------------\n\nexport async function deleteBookCascade(bookId) {\n  const removed = {};\n  const db = await openDb();\n  const names = ['books', 'positions', 'notes', 'bookmarks'];\n  const tx = db.transaction(names, 'readwrite');\n  tx.objectStore('books').delete(bookId);\n  tx.objectStore('positions').delete(bookId);\n  const notesIndex = tx.objectStore('notes').index('bookId');\n  const bookmateNotes = await promisify(notesIndex.getAllKeys(bookId));\n  removed.notes = bookmateNotes.length;\n  for (const key of bookmateNotes) tx.objectStore('notes').delete(key);\n  const bookmarkIndex = tx.objectStore('bookmarks').index('bookId');\n  const bookmarkKeys = await promisify(bookmarkIndex.getAllKeys(bookId));\n  removed.bookmarks = bookmarkKeys.length;\n  for (const key of bookmarkKeys) tx.objectStore('bookmarks').delete(key);\n  await txDone(tx);\n  removed.book = true;\n  return removed;\n}\n\n// Export / import of everything the user owns -----------------------------\n\nfunction blobToBase64(blob) {\n  return new Promise((resolve, reject) => {\n    const reader = new FileReader();\n    reader.onload = () => resolve(String(reader.result).split(',')[1] || '');\n    reader.onerror = () => reject(reader.error);\n    reader.readAsDataURL(blob);\n  });\n}\n\nfunction base64ToBlob(base64, type) {\n  const binary = atob(base64);\n  const bytes = new Uint8Array(binary.length);\n  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);\n  return new Blob([bytes], { type });\n}\n\nexport async function exportLibrary({ includeBookFiles = false } = {}) {\n  const books = (await getAll('books')).map(async (book) => ({\n    ...book,\n    blob: includeBookFiles && book.blob ? { base64: await blobToBase64(book.blob), type: book.blob.type } : null,\n    cover: null,\n  }));\n  const [resolvedBooks, positions, bookmarks, notes, settings, voices] = await Promise.all([\n    Promise.all(books), getAll('positions'), getAll('bookmarks'), getAll('notes'), getAll('settings'), getAll('voices'),\n  ]);\n  return {\n    app: 'read-with-you',\n    schema: DB_VERSION,\n    exportedAt: new Date().toISOString(),\n    includeBookFiles,\n    books: resolvedBooks,\n    positions,\n    bookmarks,\n    notes,\n    settings,\n    voices,\n  };\n}\n\nexport async function importLibrary(data) {\n  if (data?.app !== 'read-with-you') throw new Error('不是陪你读书的备份文件');\n  let books = 0;\n  for (const book of data.books || []) {\n    const { base64, type } = book.blob || {};\n    const blob = base64 ? base64ToBlob(base64, type || 'application/octet-stream') : undefined;\n    const existing = blob ? null : await get('books', book.id);\n    await put('books', { ...book, blob: blob || existing?.blob, cover: existing?.cover || null });\n    books++;\n  }\n  for (const [store, rows] of [['positions', data.positions], ['bookmarks', data.bookmarks], ['notes', data.notes], ['voices', data.voices]]) {\n    for (const row of rows || []) await put(store, row);\n  }\n  for (const row of data.settings || []) if (!String(row.id).startsWith('legacy-')) await put('settings', row);\n  await audit('library.imported', { books });\n  return { books };\n}\n"}]}},{"type":"user","uuid":"a0f12cff-fc56-4e93-973d-6abbbef1e065","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_01_6vKxXO2Jz81p1bxl9Mu34101","is_error":false,"content":"// Turns book text into natural, speakable sentences and drives chapter-by-chapter\n// narration for paginated books (foliate-js) and plain-text books.\n\nconst TERMINATORS = new Set(['。', '！', '？', '；', '…', '!', '?', ';', '.']);\nconst CLOSERS = new Set(['”', '’', '\"', \"'\", '）', ')', '】', ']', '》', '」', '』']);\nconst SOFT_BREAKS = new Set(['，', '、', ',']);\nconst ABBREVIATIONS = /(?:\\b(?:Mr|Mrs|Ms|Dr|St|No|vs|etc|e\\.g|i\\.e|Vol|Ch|Fig|Jr|Sr)\\.|\\b[A-Z]\\.)$/;\nconst CJK = /[\\u3040-\\u30ff\\u3400-\\u9fff\\uf900-\\ufaff]/;\nconst LATIN_DECIMAL = /\\d$/;\n\nexport const isCjk = (text = '') => CJK.test(text);\n\n/** Split raw text into natural sentences. Pure, so it can be unit-tested in Node. */\nexport function splitSentences(text, { max = 220, minMerge = 4 } = {}) {\n  const clean = String(text || '').replace(/\\r\\n?/g, '\\n').replace(/[\\u00ad\\u200b\\ufeff]/g, '').replace(/[ \\t]+/g, ' ').replace(/\\n{2,}/g, '\\n');\n  const sentences = [];\n  let buffer = '';\n  const flush = (soft) => {\n    const piece = buffer.trim();\n    buffer = '';\n    if (!piece) return;\n    if (soft && sentences.length && piece.length < minMerge && sentences[sentences.length - 1].length + piece.length <= max) {\n      sentences[sentences.length - 1] += (isCjk(sentences[sentences.length - 1].slice(-1)) ? '' : ' ') + piece;\n      return;\n    }\n    sentences.push(piece);\n  };\n  for (let i = 0; i < clean.length; i++) {\n    const ch = clean[i];\n    buffer += ch;\n    if (ch === '\\n') {\n      if (buffer.trim().length > max) {\n        const cut = buffer;\n        buffer = '';\n        for (const piece of hardWrap(cut.trim(), max)) sentences.push(piece);\n      } else flush(false);\n      continue;\n    }\n    if (TERMINATORS.has(ch)) {\n      // Keep closing quotes/brackets and repeated punctuation with the sentence.\n      while (i + 1 < clean.length && (TERMINATORS.has(clean[i + 1]) || CLOSERS.has(clean[i + 1]))) buffer += clean[++i];\n      const next = clean[i + 1];\n      const wordContext = buffer.trimEnd().slice(0, -1);\n      if (ch === '.' && !isCjk(buffer) && (ABBREVIATIONS.test(wordContext) || /^(?:Mr|Mrs|Ms|Dr|St|No|vs|etc|Jr|Sr)$/.test(wordContext.split(/\\s/).at(-1)))) continue;\n      if (ch === '.' && !isCjk(buffer) && LATIN_DECIMAL.test(wordContext) && /\\d/.test(next || '')) continue;\n      flush(false);\n      continue;\n    }\n    if (SOFT_BREAKS.has(ch) && buffer.length >= max * 0.7) {\n      const next = clean[i + 1];\n      if (ch !== ',' || !/[0-9]/.test(next || '')) flush(true);\n      continue;\n    }\n    if (buffer.length >= max * 1.6) {\n      const cut = buffer;\n      buffer = '';\n      for (const piece of hardWrap(cut.trim(), max)) sentences.push(piece);\n    }\n  }\n  flush(false);\n  return sentences.filter((sentence) => /\\S/.test(sentence));\n}\n\nexport function hardWrap(text, max) {\n  const out = [];\n  let rest = text;\n  while (rest.length > max) {\n    let cut = -1;\n    for (let i = max; i > max * 0.5; i--) {\n      if (/[\\s，。、；：,!;:]/.test(rest[i] || '')) {\n        cut = i + 1;\n        break;\n      }\n    }\n    if (cut < 0) cut = max;\n    out.push(rest.slice(0, cut).trim());\n    rest = rest.slice(cut).trim();\n  }\n  if (rest) out.push(rest);\n  return out.filter(Boolean);\n}\n\n/** Rough seconds estimate to show the listener how long is left. */\nexport function estimateSeconds(text, rate = 1) {\n  const cjkCount = (text.match(/[\\u3400-\\u9fff]/g) || []).length;\n  const words = (text.replace(/[\\u3400-\\u9fff]/g, ' ').match(/[A-Za-z0-9'’-]+/g) || []).length;\n  return (cjkCount / 4.4 + words / 2.6) / Math.max(0.5, rate);\n}\n\n/** Parse an SSML-ish string produced by foliate-js into {segments:[{tag,text,marks}], text}. */\nexport function ssmlSegments(ssml) {\n  const segments = [];\n  let text = '';\n  const marks = [];\n  const tagRe = /<(\\/?)([a-zA-Z]+)([^>]*?)(\\/?)>/g;\n  let stack = [];\n  let last = 0;\n  const pushText = (raw) => {\n    const decoded = decodeEntities(raw);\n    for (const part of splitSentences(decoded)) {\n      segments.push({ tag: stack[stack.length - 1] || 'p', text: part, start: text.length });\n      text += part;\n    }\n  };\n  let match;\n  while ((match = tagRe.exec(ssml))) {\n    if (match.index > last) pushText(ssml.slice(last, match.index));\n    last = tagRe.lastIndex;\n    const [, closing, rawTag, attrs] = match;\n    const tag = rawTag.toLowerCase();\n    if (closing) {\n      const at = stack.lastIndexOf(tag);\n      if (at >= 0) stack = stack.slice(0, at);\n      continue;\n    }\n    if (tag === 'mark') {\n      const name = /name=\"([^\"]*)\"/.exec(attrs)?.[1];\n      if (name) marks.push({ name, offset: text.replace(/\\s+$/, '').length });\n      continue;\n    }\n    if (tag === 'break') {\n      text += ' ';\n      continue;\n    }\n    stack.push(tag);\n  }\n  if (last < ssml.length) pushText(ssml.slice(last));\n  return { segments, text, marks };\n}\n\nexport function decodeEntities(raw) {\n  return raw.replace(/&(#x?[0-9a-fA-F]+|amp|lt|gt|quot|apos|nbsp);/g, (all, entity) => {\n    if (entity[0] === '#') {\n      const code = entity[1] === 'x' || entity[1] === 'X' ? parseInt(entity.slice(2), 16) : parseInt(entity.slice(1), 10);\n      return Number.isFinite(code) ? String.fromCodePoint(code) : all;\n    }\n    return { amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\", nbsp: ' ' }[entity] ?? all;\n  });\n}\n\n/** Chapter model for .txt books: detect headings, fall back to paged sections. */\nexport function parsePlainText(text) {\n  const normalized = String(text || '').replace(/^\\ufeff/, '').replace(/\\r\\n?/g, '\\n');\n  const lines = normalized.split('\\n');\n  const headingRe = /^\\s*第[一二三四五六七八九十百千零〇0-9]+[章节回卷篇部](?:[\\s:：.、].*)?$/;\n  const plainHeadingRe = /^\\s*(?:Chapter\\s+[0-9IVXLC]+|卷[一二三四五六七八九十]+|序章|楔子|尾声|后记|前言|引言)(?:[\\s:：.、].*)?$/i;\n  const chapters = [];\n  let current = { title: '', lines: [] };\n  const onHeading = (line) => /[。！？.!?]/.test(line) ? false : headingRe.test(line) || plainHeadingRe.test(line);\n  const hasHeading = lines.some(onHeading);\n  if (hasHeading) current = { title: '正文', lines: [] };\n  for (const line of lines) {\n    if (hasHeading && onHeading(line)) {\n      if (current.lines.some((l) => l.trim())) chapters.push(current);\n      current = { title: line.trim(), lines: [] };\n    } else {\n      current.lines.push(line);\n    }\n  }\n  if (chapters.length) {\n    // Trailing material after the last heading still belongs to the book.\n    if (current.lines.some((l) => l.trim())) chapters.push(current);\n    return chapters.map((chapter, index) => {\n      const paragraphs = chapter.lines.map((l) => l.trim()).filter(Boolean);\n      return { index, title: chapter.title || `第 ${index + 1} 节`, text: paragraphs.join('\\n'), sentences: splitSentences(paragraphs.join('\\n')) };\n    }).filter((chapter) => chapter.text);\n  }\n  const paragraphs = current.lines.map((l) => l.trim()).filter(Boolean);\n  return [{ index: 0, title: '正文', text: paragraphs.join('\\n'), sentences: splitSentences(paragraphs.join('\\n')) }];\n}\n\nexport function formatDuration(seconds) {\n  if (!Number.isFinite(seconds) || seconds <= 0) return '0:00';\n  const total = Math.round(seconds);\n  const h = Math.floor(total / 3600);\n  const m = Math.floor((total % 3600) / 60);\n  const s = total % 60;\n  return h ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}` : `${m}:${String(s).padStart(2, '0')}`;\n}\n\n// Narration core ---------------------------------------------------------\n\n/**\n * Speaks a queue of chunks through an injected speech engine. The engine is a\n * tiny interface (`speak(u, handlers)`, `cancel()`) so tests can run it in Node.\n */\nexport class Narration {\n  constructor(engine, { onState = () => {}, onProgress = () => {}, onEnd = () => {}, onError = () => {} } = {}) {\n    this.engine = engine;\n    this.onState = onState;\n    this.onProgress = onProgress;\n    this.onEnd = onEnd;\n    this.onError = onError;\n    this.queue = [];\n    this.index = 0;\n    this.state = 'idle';\n    this.rate = 1;\n    this.pitch = 1;\n    this.voice = null;\n    this.lang = 'zh-CN';\n    this.runToken = 0;\n    this.current = null;\n  }\n\n  setState(state) {\n    this.state = state;\n    this.onState(state, this);\n  }\n\n  setVoice(voice, lang) {\n    this.voice = voice || null;\n    if (lang) this.lang = lang;\n  }\n\n  start(chunks, startAt = 0) {\n    this.stop();\n    this.render(chunks);\n    this.want = startAt;\n    this.skipEmpty();\n    this.runToken++;\n    this.setState('speaking');\n    this.speakCurrent();\n  }\n\n  render(chunks) {\n    // Each chunk: {chapter, chapterTitle, text, sentenceIndex, meta}\n    this.queue = [];\n    for (const chunk of chunks) {\n      for (const sentence of splitSentences(chunk.text, { max: chunk.max || 220 })) {\n        this.queue.push({ ...chunk, text: sentence, chunkIndex: this.queue.length });\n      }\n    }\n    this.onProgress({ index: 0, total: this.queue.length, chunk: this.queue[0] });\n  }\n\n  /** Track a not-yet-started sentence requested by seekTo, let it speak, then advance. */\n  skipEmpty() {\n    this.index = Math.max(0, Math.min(this.want ?? 0, this.queue.length - 1));\n    while (this.index < this.queue.length - 1 && !this.queue[this.index].text.trim()) this.index++;\n  }\n\n  current() {\n    return this.queue[this.index] || null;\n  }\n\n  speakCurrent() {\n    const token = this.runToken;\n    const chunk = this.queue[this.index];\n    if (!chunk) {\n      this.setState('ended');\n      this.onEnd();\n      return;\n    }\n    if (!chunk.text.trim() && this.index < this.queue.length - 1) {\n      this.index++;\n      this.speakCurrent();\n      return;\n    }\n    this.current = chunk;\n    this.onProgress({ index: this.index, total: this.queue.length, chunk });\n    const utterance = { text: chunk.text, rate: this.rate, pitch: this.pitch, voice: this.voice, lang: this.lang };\n    this.engine.speak(utterance, {\n      onBoundary: (event) => {\n        if (token !== this.runToken) return;\n        this.onProgress({ index: this.index, total: this.queue.length, chunk, boundary: event });\n      },\n      onEnd: () => {\n        if (token !== this.runToken) return;\n        this.index++;\n        if (this.state === 'speaking') this.speakCurrent();\n      },\n      onError: (error) => {\n        if (token !== this.runToken) return;\n        if (error?.error === 'interrupted' || error?.error === 'canceled') return;\n        this.setState('error');\n        this.onError(error);\n      },\n    });\n  }\n\n  pause() {\n    if (this.state !== 'speaking') return;\n    this.runToken++;\n    this.engine.cancel();\n    this.setState('paused');\n  }\n\n  resume() {\n    if (this.state !== 'paused') return;\n    this.runToken++;\n    this.setState('speaking');\n    this.speakCurrent();\n  }\n\n  toggle() {\n    if (this.state === 'speaking') this.pause();\n    else if (this.state === 'paused') this.resume();\n  }\n\n  /** Start from a queue index (used when the user taps a paragraph). */\n  seekTo(index) {\n    index = Math.max(0, Math.min(index, this.queue.length - 1));\n    while (index < this.queue.length - 1 && !this.queue[index].text.trim()) index++;\n    this.want = index;\n    if (this.state === 'speaking') {\n      this.index = index;\n      this.runToken++;\n      this.engine.cancel();\n      this.speakCurrent();\n    } else {\n      this.skipEmpty();\n      this.onProgress({ index: this.index, total: this.queue.length, chunk: this.queue[this.index] });\n    }\n  }\n\n  skip(seconds) {\n    // Approximate: move by ~4.4 CJK characters per second.\n    const sign = Math.sign(seconds) || 1;\n    let chars = Math.abs(seconds) * 4.4 * this.rate;\n    let index = this.index;\n    while (chars > 0 && index >= 0 && index < this.queue.length) {\n      index += sign;\n      chars -= (this.queue[index]?.text.length || 4) * (sign > 0 ? 1 : 1);\n      if (sign < 0 && chars <= 0) break;\n    }\n    this.seekTo(Math.max(0, Math.min(this.queue.length - 1, index)));\n    if (this.state === 'speaking' || this.state === 'paused') {\n      this.runToken++;\n      this.engine.cancel();\n      if (this.state === 'paused') this.setState('paused');\n      else this.speakCurrent();\n      if (this.state === 'paused') this.onProgress({ index: this.index, total: this.queue.length, chunk: this.queue[this.index] });\n    }\n  }\n\n  stop() {\n    this.runToken++;\n    this.engine.cancel();\n    if (this.state !== 'idle') this.setState('idle');\n  }\n}\n\n/** Browser SpeechSynthesis adapter with voice warm-up and Chrome's long-text guard. */\nexport function createSpeechEngine(synth = window.speechSynthesis, Utterance = window.SpeechSynthesisUtterance) {\n  const engine = {\n    supported: Boolean(synth && Utterance),\n    synth,\n    speak(utter, { onBoundary, onEnd, onError }) {\n      if (!engine.supported) {\n        onError?.(new Error('此浏览器不支持语音朗读'));\n        return;\n      }\n      const u = new Utterance(utter.text);\n      u.lang = utter.lang;\n      u.rate = utter.rate;\n      u.pitch = utter.pitch;\n      if (utter.voice) u.voice = utter.voice;\n      u.onboundary = (event) => onBoundary?.(event);\n      u.onend = () => onEnd?.();\n      u.onerror = (event) => onError?.(event);\n      synth.speak(u);\n    },\n    cancel() {\n      try {\n        synth?.cancel();\n      } catch {}\n    },\n    voices() {\n      return synth?.getVoices?.() || [];\n    },\n    onVoicesChanged(callback) {\n      synth?.addEventListener?.('voiceschanged', callback);\n    },\n  };\n  return engine;\n}\n\n/** Map a book's language tag to a BCP-47 voice language. */\nexport function voiceLanguageFor(languageTags) {\n  const tag = Array.isArray(languageTags) ? languageTags[0] : languageTags;\n  const raw = String(tag || 'zh-CN');\n  const lower = raw.toLowerCase();\n  if (lower.startsWith('zh')) {\n    if (/hant|tw|hk|mo/.test(lower)) return 'zh-TW';\n    return 'zh-CN';\n  }\n  return raw.split(',')[0].trim() || 'en-US';\n}\n\nexport function preferredVoice(voices, lang, savedName) {\n  if (!voices?.length) return null;\n  if (savedName) {\n    const saved = voices.find((voice) => voice.name === savedName);\n    if (saved) return saved;\n  }\n  const base = lang.split('-')[0].toLowerCase();\n  const exact = voices.filter((voice) => voice.lang.toLowerCase().replace('_', '-') === lang.toLowerCase());\n  const sameBase = voices.filter((voice) => voice.lang.toLowerCase().startsWith(base));\n  const pool = exact.length ? exact : sameBase;\n  if (!pool.length) return null;\n  return (\n    pool.find((voice) => voice.localService && /xiaoxiao|tingting|meijia|huihui|google|natural/i.test(voice.name)) ||\n    pool.find((voice) => voice.localService) ||\n    pool[0]\n  );\n}\n"}]}},{"type":"assistant","uuid":"59f6154a-0c73-4230-bf13-bbb92d5405e1","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"id":"59f6154a-0c73-4230-bf13-bbb92d5405e1","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_yJZi0sZug9eouEXUZb3J0490","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && ls portal/vendor/foliate-js/ && wc -l portal/vendor/foliate-js/*.js | tail -5","description":"List foliate-js vendor files"}}],"stop_reason":"tool_use","usage":{"input_tokens":32350,"output_tokens":107,"cache_read_input_tokens":25088,"total_tokens":32457}}},{"type":"user","uuid":"2314c4bf-161b-4920-ba15-25bc066e7339","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_yJZi0sZug9eouEXUZb3J0490","is_error":false,"content":"LICENSE\ncomic-book.js\nepub.js\nepubcfi.js\nfb2.js\nfixed-layout.js\nmobi.js\noverlayer.js\npaginator.js\nprogress.js\nsearch.js\ntext-walker.js\ntts.js\nuri-template.js\nvendor\nview.js\n    43 portal/vendor/foliate-js/text-walker.js\n   278 portal/vendor/foliate-js/tts.js\n    52 portal/vendor/foliate-js/uri-template.js\n   597 portal/vendor/foliate-js/view.js\n  5912 total"}]}},{"type":"assistant","uuid":"8af0a965-66a5-4ecb-8f8b-6a502a4296df","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"id":"8af0a965-66a5-4ecb-8f8b-6a502a4296df","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_YiyzL