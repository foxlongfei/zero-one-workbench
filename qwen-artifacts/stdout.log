id);if(!card)return;card.querySelector('[data-role=\"progress\"]').textContent=progressText(book,saved);card.querySelector('[data-action=\"open\"]').textContent=saved?'继续阅读':'阅读';card.querySelector('[data-action=\"reset\"]').hidden=!saved}\nfunction shelfOrder(a,b){const ap=storedPos(a.id),bp=storedPos(b.id);if(Boolean(ap)!==Boolean(bp))return bp?1:-1;const at=Number(ap?.lastReadAt)||Date.parse(a.added||0)||0,bt=Number(bp?.lastReadAt)||Date.parse(b.added||0)||0;return bt-at}\nconst searchText=book=>`${book.title||''} ${book.author||''} ${book.filename||''} ${format(book)}`.toLocaleLowerCase('zh-CN');\nfunction clearCoverURLs(){for(const url of coverURLs)URL.revokeObjectURL(url);coverURLs.clear()}\nfunction renderShelf(){const query=$('shelfSearch').value.trim().toLocaleLowerCase('zh-CN');const visible=query?books.filter(book=>searchText(book).includes(query)):books;clearCoverURLs();$('shelf').replaceChildren();$('searchSummary').textContent=query?`找到 ${visible.length} / ${books.length} 本`:`共 ${books.length} 本`;for(const b of visible){const saved=storedPos(b.id);const card=document.createElement('article');card.className='book';card.dataset.bookId=b.id;const name=document.createElement('strong');name.textContent=b.title||b.filename||'未命名';const meta=document.createElement('small');meta.textContent=[b.author,format(b).toUpperCase()].filter(Boolean).join(' · ');const progress=document.createElement('small');progress.dataset.role='progress';progress.textContent=progressText(b,saved);const actions=document.createElement('div');actions.className='toolbar';const open=document.createElement('button');open.type='button';open.dataset.action='open';open.textContent=saved?'继续阅读':'阅读';open.onclick=()=>openBook(b);const reset=document.createElement('button');reset.type='button';reset.dataset.action='reset';reset.textContent='从头开始';reset.hidden=!saved;reset.setAttribute('aria-label','清除阅读位置并从头开始 '+name.textContent);reset.onclick=()=>clearProgress(b);const remove=document.createEle