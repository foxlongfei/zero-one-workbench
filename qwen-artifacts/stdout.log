adPoints(exercise, { reps = 0, holdSeconds = 0, bodyweightKg = 70, scale = 1 } = {}) {\n  const share = exercise.capacityLoads?.bodyweightShare ?? 0.6;\n  const rom = exercise.capacityLoads?.rangeOfMotion ?? 1;\n  const perRep = bodyweightKg * share * rom * scale * 0.02;\n  const perHoldSecond = bodyweightKg * share * rom * scale * 0.008;\n  return Math.round(reps * perRep + holdSeconds * perHoldSecond);\n}\n\n/** Volume for the archive: total work reps across a session, separated from holds. */\nexport function summarizeSession(entries) {\n  return entries.reduce((acc, e) => {\n    acc.reps += e.reps || 0;\n    acc.holdSeconds += e.holdSeconds || 0;\n    acc.points += e.points || 0;\n    acc.sets += e.sets || 0;\n    return acc;\n  }, { reps: 0, holdSeconds: 0, points: 0, sets: 0 });\n}\n\n/**\n * Pick the next session from a track definition. Progression is deliberately boring and\n * conservative: hold the same step until the person completes the top of the range twice.\n */\nexport function nextSession(track, history) {\n  const week = Math.max(1, track.startWeek ?? 1);\n  const done = history.filter((h) => h.trackId === track.id);\n  const lastTwo = done.slice(-2);\n  const promoted = lastTwo.length === 2 && lastTwo.every((h) => h.completed && h.reps >= (h.target ?? 0));\n  const step = Math.min(track.steps?.length ? track.steps.length - 1 : 0, (track.step ?? 0) + (promoted ? 1 : 0));\n  const sessions = track.sessionsByStep?.[step] || track.sessions || [];\n  const index = done.length % Math.max(1, sessions.length);\n  return { week, step, session: sessions[index] || null, promoted };\n}\n\n/** Readiness gate: three honest questions, no scoring theatre. */\nexport function readinessCheck({ sleep, soreness, pain }) {\n  const flags = [];\n  if (pain === 'sharp') flags.push({ level: 'stop', text: '有尖锐疼痛：今天不做这个动作，必要时就医。本工具不做诊断。' });\n  if (pain === 'mild') flags.push({ level: 'caution', text: '有轻微不适：缩小幅度、减少组数，动作中一旦加重就停。' });\n  if (soreness >= 4) flags.push({ level: 'caution', text: '酸痛明显：今天以活动度和小幅度为主，不追次数。' });\n  if (sleep <= 2) flags.push({ level: 'caution', text: '睡眠不足：把今天当恢复日，目标改成\"完成最低量\"即可。' });\n  const level = flags.some((f) => f.level === 'stop') ? 'stop' : flags.length ? 'caution' : 'ready';\n  return { level, flags };\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/session.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":50407,"output_tokens":1739,"cache_read_input_tokens":49920,"total_tokens":52146}}},{"type":"user","uuid":"86b73e90-fadf-4490-818b-904e507f7923","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_rCqgO5G5Umo6TnmNovyz4012","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/session.js."}]}},{"type":"assistant","uuid":"970548ac-e9f5-415c-b46d-46db574584c6","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"id":"970548ac-e9f5-415c-b46d-46db574584c6","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_Rca1Zvg5KZNs7a5GQG4A4924","name":"write_file","input":{"content":"/**\n * Local-first archive: profiles, consent, capacity records.\n *\n * Nothing leaves the browser. The only outbound path is an export file the person chooses to\n * save themselves, and that export carries the consent text it was created under so a restored\n * copy still says what it was for.\n */\nconst KEY = 'zero-one.movement.v1';\n\nexport const CONSENT_VERSION = 1;\nexport const CONSENT_TEXT = [\n  '训练记录保存在这台设备的浏览器里，不会自动上传。',\n  '导出文件包含你的训练次数、时长、动作与自评，请自行保管。',\n  '照片分析在本地计算，产品默认不保存照片；如选择保存，也只存在本机。',\n  '这些记录用于你自己的练习反馈，不做医疗诊断。',\n].join('\\n');\n\nfunction emptyState() {\n  return {\n    version: 1,\n    profiles: [],\n    activeProfileId: null,\n    consent: null,\n    records: [],\n    settings: { units: 'metric', voice: true },\n  };\n}\n\nlet storage = null;\n/** Inject a storage backend (localStorage in the browser, a memory shim in tests). */\nexport function useStorage(backend) {\n  storage = backend;\n}\n\nfunction read() {\n  if (!storage) return emptyState();\n  try {\n    const raw = storage.getItem(KEY);\n    if (!raw) return emptyState();\n    const parsed = JSON.parse(raw);\n    return { ...emptyState(), ...parsed };\n  } catch {\n    return emptyState();\n  }\n}\n\nfunction write(state) {\n  if (storage) storage.setItem(KEY, JSON.stringify(state));\n  return state;\n}\n\nexport function state() {\n  return read();\n}\n\nexport function consentGiven() {\n  const s = read();\n  return Boolean(s.consent && s.consent.version === CONSENT_VERSION && s.consent.acceptedAt);\n}\n\nexport function giveConsent(now = new Date()) {\n  const s = read();\n  s.consent = { version: CONSENT_VERSION, acceptedAt: now.toISOString(), text: CONSENT_TEXT };\n  return write(s);\n}\n\nexport function revokeConsent() {\n  const s = read();\n  s.consent = null;\n  return write(s);\n}\n\nexport function createProfile({ name, ageGroup = 'adult', heightCm = null, bodyweightKg = null, goals = [], environment = 'home', equipment = ['none'] }, now = new Date()) {\n  if (!consentGiven()) throw new Error('需要先确认数据使用说明');\n  const s = read();\n  const profile = {\n    id: `p${Date.now().toString(36)}${(s.profiles.length + 1).toString(36)}`,\n    name: name?.trim() || '我',\n    ageGroup,\n    heightCm,\n    bodyweightKg,\n    goals,\n    environment,\n    equipment,\n    createdAt: now.toISOString(),\n  };\n  s.profiles.push(profile);\n  s.activeProfileId = profile.id;\n  return write(s).profiles.at(-1);\n}\n\nexport function activeProfile() {\n  const s = read();\n  return s.profiles.find((p) => p.id === s.activeProfileId) || null;\n}\n\nexport function setActiveProfile(id) {\n  const s = read();\n  if (s.profiles.some((p) => p.id === id)) s.activeProfileId = id;\n  return write(s);\n}\n\nexport function updateProfile(patch) {\n  const s = read();\n  const profile = s.profiles.find((p) => p.id === s.activeProfileId);\n  if (!profile) return null;\n  Object.assign(profile, patch);\n  write(s);\n  return profile;\n}\n\n/**\n * Append a finished session. The record keeps what the person did (reps, holds, duration,\n * reps pace) and the derived points, never the raw pose stream.\n */\nexport function addRecord({ trackId = null, sessionId = null, exerciseIds = [], reps = 0, holdSeconds = 0, sets = 0, points = 0, durationSeconds = 0, readiness = null, note = '' }, now = new Date()) {\n  if (!consentGiven()) throw new Error('需要先确认数据使用说明');\n  const profile = activeProfile();\n  if (!profile) throw new Error('先建立个人档案');\n  const s = read();\n  const record = {\n    id: `r${now.getTime().toString(36)}`,\n    profileId: profile.id,\n    at: now.toISOString(),\n    trackId,\n    sessionId,\n    exerciseIds,\n    reps,\n    holdSeconds,\n    sets,\n    points,\n    durationSeconds,\n    readiness,\n    note,\n  };\n  s.records.push(record);\n  write(s);\n  return record;\n}\n\nexport function records(profileId = activeProfile()?.id) {\n  return read().records.filter((r) => !profileId || r.profileId === profileId);\n}\n\n/** Consecutive-day streak over sessions, using the local date of each record. */\nexport function streak(list) {\n  const days = [...new Set(list.map((r) => r.at.slice(0, 10)))].sort();\n  if (!days.length) return 0;\n  let best = 1, run = 1;\n  for (let i = 1; i < days.length; i += 1) {\n    const prev = new Date(`${days[i - 1]}T00:00:00Z`);\n    const cur = new Date(`${days[i]}T00:00:00Z`);\n    const gap = Math.round((cur - prev) / 86400000);\n    run = gap === 1 ? run + 1 : 1;\n    best = Math.max(best, run);\n  }\n  const today = new Date().toISOString().slice(0, 10);\n  const last = days.at(-1);\n  const stillLive = Math.round((new Date(`${today}T00:00:00Z`) - new Date(`${last}T00:00:00Z`)) / 86400000) <= 1;\n  return stillLive ? run : 0;\n}\n\n/** Capacity trend per exercise: best reps and hold over the last 8 weeks. */\nexport function capacityTrend(list) {\n  const byExercise = new Map();\n  for (const r of list) {\n    for (const id of r.exerciseIds || []) {\n      const entry = byExercise.get(id) || { reps: 0, holdSeconds: 0, sessions: 0, lastAt: null };\n      entry.reps = Math.max(entry.reps, r.reps);\n      entry.holdSeconds = Math.max(entry.holdSeconds, r.holdSeconds);\n      entry.sessions += 1;\n      entry.lastAt = r.at;\n      byExercise.set(id, entry);\n    }\n  }\n  return byExercise;\n}\n\nexport function exportData(now = new Date()) {\n  const s = read();\n  return JSON.stringify({\n    schema: 'zero-one.movement.archive.v1',\n    exportedAt: now.toISOString(),\n    consent: s.consent,\n    profiles: s.profiles,\n    activeProfileId: s.activeProfileId,\n    records: s.records,\n  }, null, 2);\n}\n\n/**\n * Import a previously exported archive. Defaults to merge (records are keyed by id, so a\n * re-import does not duplicate), and refuses files that carry no consent record.\n */\nexport function importData(text, { mode = 'merge' } = {}) {\n  const incoming = JSON.parse(text);\n  if (incoming.schema !== 'zero-one.movement.archive.v1') throw new Error('不是动起来的档案文件');\n  const s = mode === 'replace' ? emptyState() : read();\n  const ids = new Set(s.records.map((r) => r.id));\n  for (const r of incoming.records || []) if (!ids.has(r.id)) s.records.push(r);\n  const profileIds = new Set(s.profiles.map((p) => p.id));\n  for (const p of incoming.profiles || []) if (!profileIds.has(p.id)) s.profiles.push(p);\n  if (!mode === 'replace' && incoming.consent && !consentGiven()) s.consent = incoming.consent;\n  if (!s.activeProfileId) s.activeProfileId = incoming.activeProfileId || s.profiles[0]?.id || null;\n  write(s);\n  return { profiles: s.profiles.length, records: s.records.length };\n}\n\nexport function clearAll() {\n  if (storage) storage.removeItem(KEY);\n  return emptyState();\n}\n\n/** Browser wiring: localStorage, guarded so private-mode failures degrade to session-only. */\nexport function browserStorage() {\n  try {\n    const probe = '__movement_probe__';\n    window.localStorage.setItem(probe, '1');\n    window.localStorage.removeItem(probe);\n    return window.localStorage;\n  } catch {\n    const memory = new Map();\n    return {\n      getItem: (k) => (memory.has(k) ? memory.get(k) : null),\n      setItem: (k, v) => memory.set(k, v),\n      removeItem: (k) => memory.delete(k),\n    };\n  }\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/store.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":52190,"output_tokens":2059,"cache_read_input_tokens":50048,"total_tokens":54249}}},{"type":"user","uuid":"e5944dd2-30cb-4d56-afef-7e7028a96fd7","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_Rca1Zvg5KZNs7a5GQG4A4924","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/store.js."}]}},{"type":"assistant","uuid":"8685ddc0-4da5-4d08-96e2-09e9d6ebb709","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"id":"8685ddc0-4da5-4d08-96e2-09e9d6ebb709","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_5UK4dswcFcm6MGfhXmCQ8014","name":"edit","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/store.js","new_string":"  if (mode !== 'replace' && incoming.consent && !consentGiven()) s.consent = incoming.consent;","old_string":"  if (!mode === 'replace' && incoming.consent && !consentGiven()) s.consent = incoming.consent;"}}],"stop_reason":"tool_use","usage":{"input_tokens":54292,"output_tokens":146,"cache_read_input_tokens":51840,"total_tokens":54438}}},{"t