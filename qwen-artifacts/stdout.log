 0.58;\n      out[i] = last * 0.32;\n    }\n    const drops = Math.floor(seconds * 22);\n    for (let n = 0; n < drops; n++) {\n      const start = Math.floor(random() * length);\n      const amp = 0.12 + random() * 0.2;\n      const decay = 30 + random() * 60;\n      const dur = Math.floor(rate * 0.05);\n      for (let k = 0; k < dur; k++) {\n        const env = Math.exp(-k / decay);\n        if (env < 0.002) break;\n        const index = (start + k) % length;\n        out[index] += noise() * env * amp * 0.5;\n      }\n    }\n    // A faint continuous hiss gives the rain a \"room\" instead of a hiss-less bed.\n    for (let i = 0; i < length; i++) out[i] += (random() * 2 - 1) * 0.016;\n  } else if (id === 'fire') {\n    for (let i = 0; i < length; i++) {\n      last = 0.55 * last + noise() * 0.45;\n      // Slow breathing swell so it feels alive rather than a static hiss.\n      const swell = 0.68 + 0.32 * Math.sin((TAU * i) / length * 3 + 1.4);\n      out[i] = last * 0.3 * swell;\n    }\n    const crackles = Math.floor(seconds * 9);\n    for (let n = 0; n < crackles; n++) {\n      const start = Math.floor(random() * length);\n      const amp = 0.4 + random() * 0.5;\n      const dur = Math.floor(rate * (0.004 + random() * 0.012));\n      for (let k = 0; k < dur; k++) {\n        const env = Math.exp(-k / (dur * 0.28));\n        out[(start + k) % length] += noise() * env * amp;\n      }\n    }\n  } else if (id === 'train') {\n    let low = 0;\n    let rumble = 0;\n    for (let i = 0; i < length; i++) {\n      rumble = 0.92 * rumble + noise() * 0.08;\n      low = 0.996 * low + noise() * 0.004;\n      const clack = Math.pow(Math.max(0, Math.sin((TAU * i * 2.1) / rate)), 18);\n      out[i] = low * 2.4 + rumble * 1.7 + clack * 0.045;\n    }\n    for (let beat = 0; beat < seconds * 2.1; beat++) {\n      const start = Math.floor((beat / 2.1) * rate);\n      for (let k = 0; k < rate * 0.03; k++) {\n        out[(start + k) % length] += noise() * Math.exp(-k / (rate * 0.006)) * 0.22;\n      }\n    }\n  } else if (id === 'window') {\n    for (let i = 0; i < length; i++) {\n      last = 0.88 * last + noise() * 0.12;\n      const gust = 0.55 + 0.45 * Math.sin((TAU * i) / length * 2 + 0.6) * Math.sin((TAU * i) / length * 5.3);\n      out[i] = last * 1.6 * Math.max(0.15, gust);\n    }\n  } else {\n    for (let i = 0; i < length; i++) out[i] = noise() * 0.05;\n  }\n\n  // Normalise to -18 dBFS-ish and crossfade the seam for a seamless loop.\n  let peak = 0;\n  for (let i = 0; i < length; i++) peak = Math.max(peak, Math.abs(out[i]));\n  const gain = peak > 0 ? 0.25 / peak : 1;\n  for (let i = 0; i < length; i++) out[i] *= gain;\n\n  const fade = Math.floor(rate * 0.35);\n  for (let i = 0; i < fade; i++) {\n    const t = i / fade;\n    out[i] = out[i] * t + out[length - fade + i] * (1 - t);\n  }\n  return out.subarray(0, length - fade);\n}\n\n/** Encode mono float samples as a 16-bit PCM WAV. */\nexport function encodeWav(samples, rate = SAMPLE_RATE) {\n  const buffer = new ArrayBuffer(44 + samples.length * 2);\n  const view = new DataView(buffer);\n  const write = (offset, text) => [...text].forEach((ch, i) => view.setUint8(offset + i, ch.charCodeAt(0)));\n  write(0, 'RIFF');\n  view.setUint32(4, 36 + samples.length * 2, true);\n  write(8, 'WAVE');\n  write(12, 'fmt ');\n  view.setUint32(16, 16, true);\n  view.setUint16(20, 1, true);\n  view.setUint16(22, 1, true);\n  view.setUint32(24, rate, true);\n  view.setUint32(28, rate * 2, true);\n  view.setUint16(32, 2, true);\n  view.setUint16(34, 16, true);\n  write(36, 'data');\n  view.setUint32(40, samples.length * 2, true);\n  for (let i = 0; i < samples.length; i++) {\n    const clamped = Math.max(-1, Math.min(1, samples[i]));\n    view.setInt16(44 + i * 2, clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff, true);\n  }\n  return new Blob([buffer], { type: 'audio/wav' });\n}\n\nconst cache = new Map();\n\nexport function makeAmbience(id) {\n  const meta = AMBIENCE.find((item) => item.id === id);\n  if (!meta) return null;\n  if (!cache.has(id)) {\n    const wav = encodeWav(renderScene(id));\n    cache.set(id, { ...meta, blob: wav, wavUrl: URL.createObjectURL(wav) });\n  }\n  return cache.get(id);\n}\n\nexport function warmAmbience(ids = AMBIENCE.map((item) => item.id)) {\n  for (const id of ids) makeAmbience(id);\n}\n"}}],"stop_reason":"tool_use","usage":{"input_tokens":72064,"output_tokens":2079,"cache_read_input_tokens":70528,"total_tokens":74143}}},{"type":"user","uuid":"db9816ac-123f-4d2d-bced-4f4fc1f62e03","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_FOpWMxPCRFD0pHcKr1Wy6301","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/read-with-you/ambience.js."}]}},{"type":"assistant","uuid":"ea544049-ce4c-4992-8269-8e060f9eb936","session_id":"824540e8-f13e-4561-93d4-f3f912d801e1","parent_tool_use_id":null,"message":{"id":"ea544049-ce4c-4992-8269-8e060f9eb936","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_zYgkMsgjaXCw8f4PMicD6162","name":"write_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/read-with-you/notes.js","content":"// 读伴 (the reading companion): local, deterministic helpers for notes,\n// highlights and the \"看见与讨论\" panel. There is no cloud AI here on purpose —\n// the companion shows the reader what they just heard and asks questions that\n// help a family talk about the book together.\n\nimport { getAllByIndex } from './state.js';\nimport { splitSentences, isCjk } from './tts.js';\n\nexport const NOTE_KINDS = ['想法', '想记住', '想讨论'];\n\nexport function excerptAround(text, needle, radius = 120) {\n  const clean = String(text || '').replace(/\\s+/g, ' ').trim();\n  if (!clean) return '';\n  const index = needle ? clean.indexOf(needle.slice(0, 30)) : -1;\n  if (index < 0) return clean.slice(0, radius * 2);\n  const start = Math.max(0, index - radius);\n  const end = Math.min(clean.length, index + needle.length + radius);\n  return `${start > 0 ? '…' : ''}${clean.slice(start, end)}${end < clean.length ? '…' : ''}`;\n}\n\nconst QUESTION_TEMPLATES = [\n  (subject) => `这句话里，${subject}最在意的好像不是自己的事。你觉得呢？`,\n  (subject) => `如果换成是你，会像${subject}那样说出口吗？为什么？`,\n  () => '这里有一句停顿很久的话。你读到这里时，心里响起了什么？',\n  () => '这一小段里，哪个词让你停了一下？可以念给家里的人听。',\n  () => '如果只能把这一段讲给一个人听，你会讲给谁？',\n  () => '作者没有写出来的那一半，你猜是什么？',\n];\n\nfunction hashText(text) {\n  let hash = 0;\n  for (let i = 0; i < text.length; i++) hash = (hash * 31 + text.charCodeAt(i)) % 100003;\n  return hash;\n}\n\n/** Guess who a sentence is about, without any model: reuse a repeated name. */\nexport function subjectOf(paragraph) {\n  const names = paragraph.match(/[\\u4e00-\\u9fa5]{2,3}/g) || [];\n  const counts = new Map();\n  for (const name of names) counts.set(name, (counts.get(name) || 0) + 1);\n  const stop = new Set(['什么', '一个', '自己', '我们', '他们', '你们', '这个', '那个', '时候', '已经', '没有', '因为', '所以', '可是', '如果', '就是', '感觉', '觉得']);\n  const repeated = [...counts.entries()].filter(([name, count]) => count > 1 && !stop.has(name)).sort((a, b) => b[1] - a[1]);\n  return repeated[0]?.[0] || '';\n}\n\nexport function discussionPrompts(sentence, { picked = null } = {}) {\n  if (!sentence) return [];\n  const subject = subjectOf(sentence);\n  const chips = ['留意人物', '换位想想', '词语的温度', '讲给家人听', '留白'];\n  const seed = hashText(sentence);\n  const pickedPrompt = picked == null ? null : QUESTION_TEMPLATES[picked % QUESTION_TEMPLATES.length];\n  const main = (pickedPrompt || QUESTION_TEMPLATES[seed % QUESTION_TEMPLATES.length])(subject || '这个人');\n  const second = QUESTION_TEMPLATES[(seed + 3) % QUESTION_TEMPLATES.length](subject || '这个人');\n  return [\n    { id: 0, chip: chips[seed % chips.length], text: main },\n    { id: 1, chip: chips[(seed + 2) % chips.length], text: second },\n  ];\n}\n\n/** Split the sentence into readable \"lines\" for slow, family-style reading. */\nexport function gentleLines(sentence, { max = 26 } = {}) {\n  const parts = splitSentences(sentence, { max: 999 });\n  const lines = [];\n  for (const part of parts) {\n    if (part.length <= max) {\n      lines.push(part);\n      continue;\n    }\n    const pieces = part.split(/(?<=[，、；：,;:])/);\n    let buffer = '';\n    for (const piece of pieces) {\n      if (buffer && (buffer + piece).length > max) {\n        lines.push(buffer);\n        buffer = '';\n      }\n      buffer += piece;\n    }\n    if (buffer) lines.push(buffer);\n  }\n  return lines.map((line) => line.trim()).filter(Boolean);\n}\n\nexport function highlightTerms(sentence, limit = 3) {\n  if (!sentence) return [];\n  const stop = new Set(['一个', '自己', '没有', '什么', '这个', '那个', '我们', '他们', '因为', '所以', '已经', '还是', '可以', '时候', '这样', '那样', '不是', '就是', '但是', '如果']);\n  const terms = new Map();\n  if (isCjk(sentence)) {\n    for (let size = 2; size <= 3; size++) {\n      for (let i = 0; i + size <= sentence.length; i++) {\n        const chunk = sentence.slice(i, i + size);\n        if (!/^[\\u4e00-\\u9fa5]+$/.test(chunk) || stop.has(chunk)) continue;\n        terms.set(chunk, (terms.get(chunk) || 0) + 1);\n      }\n    }\n  } else {\n    for (const word of sentence.match(/[A-Za-z]{4,}/g) || []) terms.set(word.toLowerCase(), (terms.get(word.toLowerCase()) || 0) + 1);\n  }\n  const ranked = [...terms.entries()].filter(([, count]) => count > 1 || isCjk(sentence)).sort((a, b) => b[1] - a[1] || b[0].length - a[0].length);\n  const picked = [];\n  for (const [term] of ranked) {\n    if (picked.some((other) => other.includes(term) || term.includes(other))) continue;\n    picked.push(term);\n    if (picked.length >= limit) break;\n  }\n  return picked;\n}\n\nexport async function notesFor(bookId) {\n  const rows = await getAllByIndex('notes', 'bookId', bookId);\n  return rows.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));\n}\n"}