||'';return''}\nasync function inspectBook(file){let parsed;try{parsed=await makeBook(file);const title=metadataText(parsed.metadata?.title);const author=metadataText(parsed.metadata?.author);const cover=await parsed.getCover?.();return{title,author,cover:cover instanceof Blob&&cover.size?cover:null}}catch(err){console.warn('无法预读书籍元数据，将使用文件名与默认封面',err);return{}}finally{parsed?.destroy?.()}}\n$('files').onchange=async e=>{let imported=0,duplicates=0,skipped=0,emptyTxt=0,failed=0;const errors=[];try{await libraryReady;for(const f of e.target.files){try{const ext=f.name.split('.').pop().toLowerCase();if(!['epub','mobi','azw3','fb2','cbz','txt'].includes(ext)){skipped++;continue}if(ext==='txt'&&!(await f.text()).trim()){emptyTxt++;continue}const digest=await fingerprint(f);const existing=books.find(b=>b.fingerprint===digest||(!b.fingerprint&&b.filename===f.name&&b.blob?.size===f.size));if(existing){duplicates++;continue}const metadata=ext==='txt'?{}:await inspectBook(f);await request(tx('readwrite').put({id:'local-'+crypto.randomUUID(),title:metadata.title||f.name.replace(/\\.[^.]+$/,''),author:metadata.author||'',cover:metadata.cover||null,format:ext.toUpperCase(),filename:f.name,size:f.size,fingerprint:digest,blob:f,local:true,added:new Date().toISOString()}));imported++;await refresh()}catch(err){failed++;errors.push(`${f.name}: ${err?.message||String(err)}`)}}await refresh();const notes=[];if(duplicates)notes.push(`${duplicates} 本已在书架，未重复添加`);if(emptyTxt)notes.push(`跳过 ${emptyTxt} 本空白 TXT`);if(skipped)notes.push(`跳过 ${skipped} 个不支持的文件`);if(failed)notes.push(`${failed} 本导入失败（${errors.slice(0,3).join('；')}${errors.length>3?'；其余请逐本重试':''}）`);status(`已导入 ${imported} 本${notes.length?'；'+notes.join('；'):''}`)}catch(err){status(`书库无法完成导入：${err.message}`)}finally{e.target.value=''}};\nconst baseMusicVolume=()=>Math.max(0,Math.min(1,Number($('volume').value)||0));\nfunction syncMusicVolume(){const duck=$('ducking').checked&&speaking&&!synth?.paused;$('music').volume=baseMusicVolume()*(duck?.25:1)}\nfunction stop(){token++;synth?.cancel();speaking=false;syncMusicVolume();$('speak').textContent='🔊 朗读'}\nfunction showShelf(){openRun++;stop();view?.close();view?.remove();view=null;active=null;$('readerScreen').hidden=true;$('shelfScreen').hidden=false;$('tocPanel').hidden=true;$('bookmarkPanel').hidden=true;$('settings').hidden=true;refresh().catch(e=>status('书架刷新失败：'+e.message))}\n$('back').onclick=showShelf;\nfunction savePos(value){if(!active)return;try{const saved={...value,lastReadAt:Date.now()};localStorage.setItem('reader-pos-'+active.id,JSON.stringify(saved));updateProgressCard(active,saved)}catch{}}\nfunction getPos(){return active?storedPos(active.id):null}\nconst bookmarkKey=()=>active?'reader-bookmarks-'+active.id:'';\nfunction readBookmarks(){try{return active?JSON.parse(localStorage.getItem(bookmarkKey())||'[]'):[]}catch{return[]}}\nfunction writeBookmarks(items){if(active)localStorage.setItem(bookmarkKey(),JSON.stringify(items))}\nfunction renderBookmarks(){const items=readBookmarks();$('bookmarkList').replaceChildren();$('bookmarkEmpty').hidden=items.length>0;for(const item of items){const li=document.createElement('li'),jump=document.createElement('button'),remove=document.createElement('button');jump.type='button';jump.dataset.action='jump-bookmark';jump.textContent=item.label||'保存的位置';jump.onclick=async()=>{stop();try{if(view){await view.goTo(item.cfi)}else{textIndex=restoredTextIndex(item,textPages.length);renderText()}$('bookmarkPanel').hidden=true;status(`已跳转到书签：${item.label||'保存的位置'}`)}catch(e){status(`书签跳转失败：${e.message}；可删除后重新添加`)}};remove.type='button';remove.dataset.action='delete-bookmark';remove.textContent='删除';remove.setAttribute('aria-label','删除书签 '+jump.textContent);remove.onclick=()=>{writeBookmarks(readBookmarks().filter(x=>x.id!==item.id));renderBookmarks();status(`已删除书签：${item.label||'保存的位置'}`)};li.append(jump,remove);$('bookmarkList').append(li)}}\nfunction addBookmark(){const pos=getPos();if(!active||!pos||(view&&!pos.cfi)){status('当前位置尚未就绪，请翻页或等待正文载入后再添加书签');return}const item={id:crypto.randomUUID(),createdAt:Date.now(),label:pos.label||$('position').textContent||'保存的位置',...(view?{cfi:pos.cfi}:{index:textIndex})};const items=readBookmarks();const same=view?items.some(x=>x.cfi===item.cfi):items.some(x=>Number(x.index)===textIndex);if(same){status('当前位置已有书签');return}items.push(item);writeBookmarks(items);renderBookmarks();status(`已添加书签：${item.label}`)}\nfunction addToc(items,depth=0){if(!items||depth>8)return;for(const item of items){const li=document.createElement('li'),b=document.createElement('button'),label=item.label||item.title||'章节';b.textContent='　'.repeat(depth)+label;b.onclick=async()=>{stop();const target=view;try{await target.goTo(item.href);if(view===target){$('tocPanel').hidden=true;status(`已跳转到 ${label}`)}}catch(e){if(view===target)status(`目录“${label}”跳转失败：${e.message}；可选择其他章节或返回书架`)}};li.append(b);$('tocList').append(li);addToc(item.subitems||item.children,depth+1)}}\nfunction splitTXT(text){const chunks=[];const chapters=text.split(/(?=^\\s*(?:第[一二三四五六七八九十百千0-9]+[章节回卷]|Chapter\\s+\\d+)(?:\\s|$))/gim).filter(Boolean);for(const chapter of chapters){for(let i=0;i<chapter.length;i+=3000)chunks.push(chapter.slice(i,i+3000))}return chunks.length?chunks:['（空文件）']}\nfunction restoredTextIndex(saved,length){const index=Number(saved?.index);return Number.isInteger(index)&&index>=0&&index<length?index:0}\nasync function openBook(b){const run=++openRun;stop();view?.close();view?.remove();view=null;active=b;$('shelfScreen').hidden=true;$('readerScreen').hidden=false;$('bookTitle').textContent=b.title||b.filename;$('tocButton').disabled=true;$('tocList').replaceChildren();$('tocPanel').hidden=true;$('bookmarkPanel').hidden=true;renderBookmarks();$('position').textContent='';$('textView').hidden=true;$('textView').replaceChildren();$('bookView').querySelector('foliate-view')?.remove();status('正在打开 '+b.title);\ntry{if(format(b)==='txt'){const contents=await b.blob.text();if(run!==openRun||active!==b)return;textPages=splitTXT(contents);const saved=getPos();textIndex=restoredTextIndex(saved,textPages.length);const recovered=Boolean(saved)&&textIndex!==Number(saved.index);$('textView').hidden=false;renderText();$('tocButton').disabled=false;for(let i=0;i<textPages.length;i++){const li=document.createElement('li'),btn=document.createElement('button');const heading=textPages[i].trim().split('\\n')[0].slice(0,55);btn.textContent=(heading&&/^(第.{1,12}[章节回卷]|Chapter\\s+\\d+)/i.test(heading)?heading:'第 '+(i+1)+' 页');btn.onclick=()=>{stop();textIndex=i;renderText();$('tocPanel').hidden=true};li.append(btn);$('tocList').append(li)}status(recovered?'保存的 TXT 阅读位置已失效，已从第一页打开 '+b.title:'已打开 '+b.title)}else{const nextView=document.createElement('foliate-view');view=nextView;$('bookView').append(nextView);nextView.addEventListener('relocate',e=>{if(run===openRun&&active===b){const cfi=e.detail?.cfi,label=e.detail?.tocItem?.label||'';if(cfi)savePos({cfi,label});$('position').textContent=label||'已保存阅读位置'}});await nextView.open(b.blob);if(run!==openRun||active!==b){nextView.close();nextView.remove();return}addToc(nextView.book?.toc);$('tocButton').disabled=false;const savedCFI=getPos()?.cfi||null;let recovered=false;try{await nextView.init({lastLocation:savedCFI,showTextStart:true})}catch(e){if(!savedCFI)throw e;localStorage.removeItem('reader-pos-'+b.id);updateProgressCard(b,null);await nextView.goToTextStart();recovered=true}if(run===openRun&&active===b)status(recovered?'保存的阅读位置已失效，已从书首打开 '+b.title:'已打开 '+b.title)}}catch(e){if(run===openRun){const title=b.title||b.filename||'未命名';console.error(e);view?.close();view?.remove();view=null;active=null;$('readerScreen').hidden=true;$('shelfScreen').hidden=false;$('tocPanel').hidden=true;$('settings').hidden=true;await refresh();status(`打开《${title}》失败：${e.message}；书籍仍保留在书架，可重新导入或删除`)}}}\nfunction renderText(){$('textView').textContent=textPages[textIndex]||'';$('position').textContent='第 '+(textIndex+1)+' / '+textPages.length+' 页';savePos({index:textIndex})}\n$('tocButton').onclick=()=>{const show=$('tocPanel').hidden;$('tocPanel').hidden=!show;if(show)$('bookmarkPanel').hidden=true};\n$('bookmarkButton').onclick=()=>{renderBookmarks();const show=$('bookmarkPanel').hidden;$('bookmarkPanel').hidden=!show;if(show)$('tocPanel').hidden=true};\n$('bookmarkAdd').onclick=addBookmark;\n$('settingsButton').onclick=()=>$('settings').hidden=!$('settings').hidden;\nasync function page(direction){stop();if(view){const target=view,label=direction>0?'下一页':'上一页';try{await(direction>0?target.next():target.prev());if(view===target)status('已翻到'+label)}catch(e){if(view===target)status(`${label}加载失败：${e.message}；可重试、使用目录或返回书架`)}}else if(active){textIndex=Math.min(textPages.length-1,Math.max(0,textIndex+direction));renderText()}}\n$('prev').onclick=()=>page(-1);$('next').onclick=()=>page(1);\nfunction voices(){return synth?.getVoices()||[]}\nfunction refreshVoices(){const all=voices();$('voice').replaceChildren(...all.map((v,i)=>new Option(v.name+' · '+v.lang,String(i))));const zh=all.findIndex(v=>v.lang.toLowerCase().startsWith('zh'));if(zh>=0)$('voice').value=String(zh)}\nrefreshVoices();synth?.addEventListener?.('voiceschanged',refreshVoices);\nfunction speechFailure(e){stop();status(`连续朗读中断：${e.message||e}；可重试、使用目录或返回书架`)}\nasync function speakSection(index,run){if(run!==token||!active)return;let txt='';if(view){const section=view.book?.sections[index];if(!section){stop();status('已朗读到结尾');return}await view.goTo(index);const doc=await section.createDocument();doc.querySelectorAll('script,style,nav').forEach(x=>x.remove());txt=(doc.body||doc.documentElement)?.textContent||''}else{if(index>=textPages.length){stop();status('已朗读到结尾');return}textIndex=index;renderText();txt=textPages[index]}if(run!==token)return;txt=txt.replace(/\\s+/g,' ').trim();if(!txt){await speakSection(index+1,run);return}let offset=0;const pieces=txt.match(/[\\s\\S]{1,550}/g)||[];function nextPiece(){if(run!==token)return;if(offset>=pieces.length){speakSection(index+1,run).catch(speechFailure);return}const u=new SpeechSynthesisUtterance(pieces[offset++]);utter=u;u.lang='zh-CN';u.rate=Number($('rate').value);const v=voices()[Number($('voice').value)];if(v)u.voice=v;u.onend=nextPiece;u.onerror=e=>{stop();status('朗读失败：'+e.error)};synth.speak(u)}nextPiece()}\n$('speak').onclick=async()=>{if(!supported){status('当前浏览器没有语音朗读能力');return}if(speaking){if(synth.paused){synth.resume();syncMusicVolume();$('speak').textContent='⏸ 暂停'}else{synth.pause();syncMusicVolume();$('speak').textContent='▶ 继续'}return}stop();speaking=true;syncMusicVolume();$('speak').textContent='⏸ 暂停';const run=token;try{const index=view?(view.renderer?.getContents()?.[0]?.index??0):textIndex;await speakSection(index,run)}catch(e){speechFailure(e)}};\nfunction setMusicSource(blob,name){const audio=$('music');if(audio.dataset.url)URL.revokeObjectURL(audio.dataset.url);audio.dataset.url=URL.createObjectURL(blob);audio.src=audio.dataset.url;$('musicName').textContent=name||'本机背景音';$('clearMusic').hidden=false;syncMusicVolume()}\nasync function restoreMusic(){const saved=await request(settingsTx().get('background-audio'));if(saved?.blob instanceof Blob&&saved.blob.size)setMusicSource(saved.blob,saved.name)}\n$('musicFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{await libraryReady;await request(settingsTx('readwrite').put({id:'background-audio',name:f.name,type:f.type,blob:f,updatedAt:Date.now()}));setMusicSource(f,f.name);status(`背景音“${f.name}”已保存在本机，下次打开仍可使用`)}catch(err){status(`背景音保存失败：${err.message}`)}finally{e.target.value=''}};\n$('clearMusic').onclick=async()=>{try{await request(settingsTx('readwrite').delete('background-audio'));const audio=$('music');audio.pause();if(audio.dataset.url)URL.revokeObjectURL(audio.dataset.url);delete audio.dataset.url;audio.removeAttribute('src');audio.load();$('musicName').textContent='尚未选择背景音';$('clearMusic').hidden=true;status('已清除本机背景音')}catch(err){status(`背景音清除失败：${err.message}`)}};\n$('volume').oninput=syncMusicVolume;$('ducking').checked=localStorage.getItem('reader-music-ducking')!=='off';$('ducking').onchange=()=>{localStorage.setItem('reader-music-ducking',$('ducking').checked?'on':'off');syncMusicVolume()};syncMusicVolume();\nwindow.addEventListener('pagehide',()=>{stop();clearCoverURLs();if($('music').dataset.url)URL.revokeObjectURL($('music').dataset.url)});\nlibraryReady=openDB().then(async()=>{await refresh();await restoreMusic()}).then(()=>{$('importButton').disabled=false;$('importButton').textContent='＋ 添加电子书'});\nlibraryReady.catch(e=>status('书库不可用：'+e.message));\n----\n# C01《陪你读书》核心开发文档\n\n> 状态：IN_PROGRESS / NOT_ACCEPTED。创建于 2026-10-14。本文件是 C01 固定核心入口，不以 PR、聊天或页面说明替代验收。\n\n## 一、产品目标与最简交互\n**书架 → 选择一本书 → 目录／正文 → 🔊 朗读。** 打开即书架，正文是主界面；朗读只需一个喇叭按钮。设置收纳声音、速度、背景音；不把导入、音频 URL、开发状态堆在正文。儿童／长者的可读性、无障碍与操作简洁性应由实测验证。\n\n## 二、REUSE-FIRST 技术路线\n- 阅读内核：foliate-js（上游 https://github.com/johnfactotum/foliate-js，MIT），固定源码版本并保留许可证；依赖 zip.js（BSD-3-Clause）、fflate（MIT）许可证需随发布核对。不得重新发明 EPUB、MOBI、AZW3、FB2、CBZ 解析器。\n- 现有书库：IndexedDB `zero-one-reader-library` / `books`；兼容旧数据，不能无迁移方案修改 schema。\n- TXT：本地纯文本阅读；PDF 优先 PDF.js，但尚未接入。加密 DRM 书籍不承诺支持。DOCX/RTF/HTML/Markdown/CBR 为待评估扩展，不能冒称已支持。\n- 朗读：先复用浏览器 SpeechSynthesis；朗读、暂停、续读、跨章节、声音选择应分别实测。用户授权的个性化声音为独立后续能力。\n- 背景音：人声优先，基础版低音量、可独立控制；按语义／场景动态配乐、片头片尾属于后续模块，须遵守音乐许可并验证听感。\n- 本地优先：书籍和位置本地保存；开源依赖尽量本地固定版本，避免外部 CDN 成为阅读前提。\n\n## 三、当前代码定位\n- 原正式入口：`portal/index.html` → `portal/read-with-you-v01.html`。\n- 新集成分支：`c01-foliate-reader-integration`；草稿 PR #26（https://github.com/foxlongfei/zero-one-workbench/pull/26）。\n- 新集成页：`portal/read-with-you-v01.html`；主逻辑：`portal/reader-integrated.js`；开源阅读器：`portal/vendor/foliate-js/`。\n- 测试：`tests/c01-reader/make-books.py`（构造实际 EPUB/TXT）、`tests/c01-reader/check.mjs`（Chromium 导入／目录／正文／朗读接口／进度恢复）；工作流：`.github/workflows/c01-reader-integration.yml`。\n- 既有 `portal/reading-library.html`、`portal/classical-radio.html` 暂保留历史与功能，不作为新阅读主流程的额外必经页面。\n\n## 四、能力状态（不得用“代码存在”代替“通过验收”）\n| 能力 | 当前状态 |\n| --- | --- |\n| foliate-js 源码接入、书架/目录/正文 UI 代码 | 已提交到 PR #26，未合并 |\n| EPUB/TXT 浏览器自动化 | 测试已编写并启动，最终结果需按 Actions 记录核对 |\n| MOBI/AZW3/FB2/CBZ | 已接入解析路径，未完成真实样本逐格式验证 |\n| 连续朗读 | 已接入浏览器 TTS 流程；自动测试使用模拟语音，真实音频长时测试未完成 |\n| 阅读位置恢复 | 已编写保存/恢复逻辑，需核对浏览器测试结果 |\n| PDF、个性化声音、智能配乐 | NOT_IMPLEMENTED |\n| 合并、公开 Pages 发布读回、两轮独立盲测、用户验收 | NOT_DONE |\n\n## 五、发布硬门\n1. 检查源码许可、依赖完整性、安全边界与离线行为。\n2. 使用**实际书籍样本**完成导入、目录、正文、跨章节朗读、暂停续读、关闭重开位置恢复。每个格式单独标记 PASS/FAIL/UNTESTED。\n3. Chromium 自动化不能替代真实设备语音听感与长期连续朗读测试；保留日志、截图、失败案例。\n4. 两轮独立任务盲测、主分支合并、Pages 部署、外部 HTTPS 读回及用户验收均需真实证据。未达门槛不得标 ACCEPTED。\n5. 失败则修复原 PR 与原工单，不另开同质化施工主线。\n\n## 六、任务与追溯\n沿用 #10 RW-00、#11 RW-01（Q博士阅读）、#12 RW-02（D博士语音）、#13 RW-03（C博士集成），以及现有 PR #14；新集成 PR #26 为实施增量，不能抹去旧工作。每次变更记录提交 SHA、测试链接、失败项和下一个验收门。\n\n## 七、更新记录\n- 2026-10-14：首次建立固定核心开发文档，归拢产品形态、技术内核、源文件、任务编号与真实验收边界。创建文档本身不代表功能完成。\n----\nportal/test-books:\nzero-one-full-book-test.txt\n\nportal/vendor:\nfoliate-js\nlicense-melotts-vits-zh_en.txt\nlunar-javascript\nmediapipe\n----\nfrom pathlib import Path\nfrom zipfile import ZipFile, ZIP_DEFLATED, ZIP_STORED\np=Path('tests/c01-reader/fixtures')\np.mkdir(parents=True,exist_ok=True)\n(p/'real-book.txt').write_text('第一章 早晨\\\\n'+'太阳升起。'*600+'\\\\n第二章 夜晚\\\\n'+'月亮出现。'*600,encoding='utf-8')\nwith ZipFile(p/'real-book.epub','w') as z:\n    z.writestr('mimetype','application/epub+zip',compress_type=ZIP_STORED)\n    z.writestr('META-INF/container.xml','<?xml version=\"1.0\"?><container xmlns=\"urn:oasis:names:tc:opendocument:xmlns:container\" version=\"1.0\"><rootfiles><rootfile full-path=\"OEBPS/content.opf\" media-type=\"application/oebps-package+xml\"/></rootfiles></container>')\n    z.writestr('OEBPS/content.opf','''<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<package xmlns=\"http://www.idpf.org/2007/opf\" version=\"3.0\" unique-identifier=\"uid\"><metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\"><dc:identifier id=\"uid\">test-book-001</dc:identifier><dc:title>实际章节测试书</dc:title><dc:creator>零一测试