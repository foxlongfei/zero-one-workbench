tion: 'speed', value: Number(key) * 0.2 + 0.4 };\n  return null;\n}\n\nexport function setupMediaSession({ onPlay, onPause, onNext, onPrev, onStop }) {\n  if (!('mediaSession' in navigator)) return { update() {} };\n  const handlers = { play: onPlay, pause: onPause, nexttrack: onNext, previoustrack: onPrev, stop: onStop };\n  for (const [action, handler] of Object.entries(handlers)) {\n    try { navigator.mediaSession.setActionHandler(action, handler ? () => handler() : null); } catch {}\n  }\n  return {\n    update(meta) {\n      try {\n        if ('MediaMetadata' in window && meta) {\n          const artwork = meta.artwork ? [{ src: meta.artwork, sizes: '512x512' }] : [];\n          navigator.mediaSession.metadata = new MediaMetadata({\n            title: meta.title || '', artist: meta.artist || '陪你读书', album: meta.album || '', artwork,\n          });\n        }\n        if ('playbackState' in navigator.mediaSession) navigator.mediaSession.playbackState = meta?.state || 'none';\n        if (meta?.positionState && navigator.mediaSession.setPositionState) {\n          try { navigator.mediaSession.setPositionState(meta.positionState); } catch {}\n        }\n      } catch {}\n    },\n  };\n}\n\nexport function keepScreenAwake() {\n  let lock = null;\n  const request = async () => {\n    try {\n      if ('wakeLock' in navigator && !lock) lock = await navigator.wakeLock.request('screen');\n    } catch {}\n  };\n  const release = () => { try { lock?.release?.(); } catch {} lock = null; };\n  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') request(); });\n  return { request, release };\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/layout.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":74927,"output_tokens":838,"cache_read_input_tokens":73728,"total_tokens":75765}}},{"type":"user","uuid":"3f20210d-61d4-4ded-a6bd-834a71bc3dae","session_id":"c6dbe816-3183-4562-8b6d-