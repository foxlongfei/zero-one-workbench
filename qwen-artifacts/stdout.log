ansparent}\n.segmented button[aria-pressed=\"true\"]{background:var(--accent);color:var(--paper-raised)}\n.bookmark-item{display:flex;justify-content:space-between;gap:8px;align-items:center;border-bottom:1px dashed var(--line);padding:9px 0}\n.bookmark-item button{border:0;background:transparent;text-align:left;padding:4px}\n.voice-card{border:1px solid var(--line);border-radius:12px;padding:12px;display:grid;gap:8px;margin-bottom:10px}\n.voice-card .voice-head{display:flex;justify-content:space-between;gap:8px;align-items:center}\n.voice-card[data-status=\"revoked\"],.voice-card[data-status=\"deleted\"]{opacity:.62}\n.voice-actions{display:flex;gap:6px;flex-wrap:wrap}\n.voice-actions button{font-size:12px;padding:5px 9px}\n.consent-form{display:grid;gap:10px}\n.consent-form fieldset{border:1px solid var(--line);border-radius:10px;padding:10px;margin:0;display:grid;gap:6px}\n.consent-form legend{font-size:12px;color:var(--muted);padding:0 4px}\n.consent-form label.check{display:flex;gap:8px;align-items:flex-start;font-size:14px}\n.consent-form input[type=text],.consent-form textarea,.consent-form select{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px;background:var(--paper)}\n.notice{background:var(--accent-soft);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--ink)}\n.notice.warn{background:color-mix(in srgb,var(--warm) 18%,var(--paper-raised))}\n.empty-note{color:var(--muted);font-size:13px;padding:10px 0}\n@media(max-width:900px){\n  .shelf-hero{grid-template-columns:1fr}\n  .panel{position:fixed;inset:auto 0 0 0;width:100%;height:min(78vh,640px);border-left:0;border-top:1px solid var(--line);border-radius:18px 18px 0 0;box-shadow:var(--shadow)}\n  .book-paged{grid-template-columns:1fr;height:auto}\n  .paged-toc{display:flex;gap:6px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line);padding-bottom:8px}\n  .paged-toc li{flex:0 0 auto}\n  .paged-toc-item{white-space:nowrap}\n}\n@media(max-width:560px){\n  .shelf-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 14px}\n  .reader-bar{padding:8px 10px;gap:6px}\n  .reader-tools button{padding:7px 8px;font-size:13px}\n  .book-area{padding:16px 14px 150px}\n  .playbar{gap:6px}\n  #speakButton{min-width:88px}\n}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}\n</style>\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <header class=\"topbar\">\n    <div class=\"brand\">\n      <div class=\"brand-mark\" aria-hidden=\"true\">读</div>\n      <div>\n        <h1>陪你读书</h1>\n        <small>Read With You · 本机书库 · 连续朗读</small>\n      </div>\n    </div>\n    <span class=\"server-dot\" id=\"serverDot\" data-online=\"false\" title=\"家庭服务器连接状态\"><i></i><span id=\"serverLabel\">正在检查家庭服务器…</span></span>\n    <a href=\"index.html\" class=\"muted\" style=\"font-size:13px\">← 零一空间</a>\n  </header>\n\n  <section class=\"shelf-hero\" id=\"shelfHero\" aria-live=\"polite\"></section>\n\n  <div class=\"section-head\">\n    <h2>我的书架</h2>\n    <span class=\"count\" id=\"shelfCount\"></span>\n    <label>搜索 <input id=\"shelfSearch\" type=\"search\" placeholder=\"书名 / 作者 / 格式\" autocomplete=\"off\"></label>\n  </div>\n  <section class=\"shelf-grid\" id=\"shelfGrid\" aria-label=\"书架\"></section>\n\n  <section class=\"voices-strip\">\n    <div>\n      <p><strong>家庭声音</strong> <span class=\"muted\">经本人授权才可录制与合成；随时可撤回授权、删除样本。</span></p>\n    </div>\n    <div class=\"actions\"><button type=\"button\" id=\"openVoices\" class=\"ghost\">管理声音与授权 →</button></div>\n  </section>\n\n  <footer class=\"library-foot\">\n    <span>书籍、阅读位置与背景音乐只保存在这台设备。</span>\n    <span>笔记与听书记忆可与家庭服务器同步。</span>\n    <a href=\"classical-radio.html\">听世界 · 电台与播客 →</a>\n    <a href=\"reader-integrated.html\">经典整页阅读器 →</a>\n  </footer>\n</div>\n\n<section id=\"readerScreen\" hidden aria-label=\"阅读器\">\n  <div class=\"progress-line\" aria-hidden=\"true\"><span id=\"readingProgress\"></span></div>\n  <div class=\"reader-bar\">\n    <button type=\"button\" id=\"closeReader\" class=\"icon\" aria-label=\"返回书架\">←</button>\n    <div class=\"book-id\">\n      <strong id=\"readerTitle\"></strong>\n      <small id=\"readerPlace\"></small>\n    </div>\n    <div class=\"reader-tools\">\n      <button type=\"button\" id=\"tocButton\" title=\"目录 (T)\">目录</button>\n      <button type=\"button\" id=\"notesButton\" title=\"笔记 (N)\">笔记 <span id=\"noteCount\" class=\"muted\"></span></button>\n      <button type=\"button\" id=\"bookmarkAdd\" title=\"添加书签 (B)\">☆ 书签</button>\n      <button type=\"button\" id=\"layoutButton\" title=\"切换连续/分页\">分页</button>\n      <button type=\"button\" id=\"settingsButton\" title=\"朗读设置\">设置</button>\n    </div>\n  </div>\n  <div class=\"reader-body\">\n    <div class=\"book-area\" id=\"bookArea\" tabindex=\"0\" aria-label=\"正文\">\n      <div id=\"bookRoot\"></div>\n    </div>\n    <aside class=\"panel\" id=\"tocPanel\" hidden aria-label=\"目录\">\n      <header><h3>目录</h3><button type=\"button\" class=\"icon\" data-close=\"toc\" aria-label=\"关闭目录\">✕</button></header>\n      <div class=\"panel-body\"><ol class=\"toc-list\" id=\"tocList\"></ol></div>\n    </aside>\n    <aside class=\"panel\" id=\"notesPanel\" hidden aria-label=\"笔记\">\n      <header><h3>笔记与讨论</h3><button type=\"button\" class=\"icon\" data-close=\"notes\" aria-label=\"关闭笔记\">✕</button></header>\n      <div class=\"panel-body\" id=\"notesBody\"></div>\n    </aside>\n    <aside class=\"panel\" id=\"settingsPanel\" hidden aria-label=\"朗读设置\">\n      <header><h3>朗读与阅读</h3><button type=\"button\" class=\"icon\" data-close=\"settings\" aria-label=\"关闭设置\">✕</button></header>\n      <div class=\"panel-body\" id=\"settingsBody\"></div>\n    </aside>\n    <aside class=\"panel\" id=\"voicesPanel\" hidden aria-label=\"家庭声音\">\n      <header><h3>家庭声音</h3><button type=\"button\" class=\"icon\" data-close=\"voices\" aria-label=\"关闭声音面板\">✕</button></header>\n      <div class=\"panel-body\" id=\"voicesBody\"></div>\n    </aside>\n  </div>\n  <div class=\"playbar\">\n    <button type=\"button\" id=\"prevSegment\" class=\"icon\" aria-label=\"上一段\" title=\"上一段 (←)\">⏮</button>\n    <button type=\"button\" id=\"speakButton\" class=\"primary\" aria-label=\"开始朗读\" title=\"朗读 / 暂停 (1-6 调速)\">▶ 朗读</button>\n    <button type=\"button\" id=\"nextSegment\" class=\"icon\" aria-label=\"下一段\" title=\"下一段 (→)\">⏭</button>\n    <div class=\"now\">\n      <strong id=\"nowTitle\">—</strong>\n      <span id=\"nowDetail\">按「朗读」开始，或按键 T 打开目录</span>\n    </div>\n    <span class=\"engine\" id=\"engineBadge\">引擎：检测中</span>\n  </div>\n</section>\n\n<div class=\"status\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n<input type=\"file\" id=\"fileInput\" accept=\".epub,.mobi,.azw3,.fb2,.cbz,.txt,.text,.md\" multiple hidden>\n<input type=\"file\" id=\"musicInput\" accept=\"audio/*\" hidden>\n<script type=\"module\" src=\"js/read-with-you/main.js\"></script>\n</body>\n</html>\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/read-with-you.html"}}],"stop_reason":"tool_use","usage":{"input_tokens":84780,"output_tokens":7059,"cache_read_input_tokens":82432,"total_tokens":91839}}},{"type":"user","uuid":"01c48a15-bfe5-488b-a993-7b69b142cf31","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_KSE3Tu4rZXw45OfTv25W3964","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/read-with-you.html. This file was automatically recorded as a workspace artifact with workspacePath \"portal/read-with-you.html\". No extra artifact registration step is needed."}]}},{"type":"system","subtype":"retry","uuid":"f75c3eb0-887c-4869-9f3d-5c85dce2f0ce","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"data":{"reason":"retry","discardedToolCalls":1,"preserveText":false}},{"type":"assistant","uuid":"f951ebfe-d83c-4ffa-960c-b0dcd84ef24e","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"f951ebfe-d83c-4ffa-960c-b0dcd84ef24e","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_4qwZx4eNzoBBc76jmT4S8933","name":"write_file","input":{"content":"// Reader shell: wires the shelf, the reading view, narration, notes, voices and\n// background music to the DOM in read-with-you.html.\nimport { buildBookRecord, chaptersOf, extensionOf, ALL_EXTENSIONS } from './books.js';\nimport { api, probeServer, server } from './api.js';\nimport {\n  allBooks, clearPosition, findDuplicate, readPosition, removeBook, saveBook, sortShelf, writePosition,\n} from './store.js';\nimport { createLayout } from './layout.js';\nimport { AudioSession } from './audio.js';\nimport { BackgroundMusic } from './music.js';\nimport { renderContinue, renderShelf } from './shelf.js';\nimport { readSettings, writeSettings } from './store.js';\nimport { shortcutFor, setupMediaSession, keepScreenAwake, timeLabel } from './layout-helpers.js';\nimport { toast, closePanels, openPanel } from './ui.js';\nimport { NotesController } from './notes.js';\nimport { VoicesController } from './voices.js';\nimport { SettingsPanel } from './settings.js';\n\nconst $ = id => document.getElementById(id);\n\nconst app = {\n  books: [],\n  book: null,\n  chapters: [],\n  segments: [], // [{ chapter, index, text }]\n  layout: null,\n  layoutKind: 'scrolled',\n  settings: readSettings(),\n  session: null,\n  music: new BackgroundMusic(),\n  listening: null,\n  dirty: false,\n  media: null,\n  wake: null,\n  playhead: 0,\n};\n\n// ------------------------------------------------------------------- helpers\nconst flatIndex = (chapter, segment) => {\n  const target = app.chapters[chapter];\n  return target ? target.start + Math.min(segment, Math.max(0, target.segments.length - 1)) : 0;\n};\nconst positionOf = index => {\n  const item = app.segments[Math.max(0, Math.min(index, app.segments.length - 1))];\n  return item ? { chapter: item.chapter, segment: item.index } : { chapter: 0, segment: 0 };\n};\nconst currentSegmentText = () => app.segments[app.playhead]?.text || '';\n\nfunction applyTheme() {\n  document.documentElement.dataset.theme = app.settings.theme || 'paper';\n  document.documentElement.style.setProperty('--font-scale', String(app.settings.fontScale || 1));\n}\n\nasync function refreshShelf() {\n  app.books = sortShelf(await allBooks());\n  const { visible, total } = renderShelf($('shelfGrid'), app.books, {\n    query: $('shelfSearch').value,\n    onOpen: openBook,\n    onDelete: deleteBook,\n    onReset: resetProgress,\n  });\n  $('shelfCount').textContent = total ? (visible === total ? `共 ${total} 本` : `找到 ${visible} / ${total} 本`) : '';\n  $('shelfHero').replaceChildren();\n  renderContinue($('shelfHero'), app.books, {\n    listening: app.listening,\n    onOpen: (book, options) => openBook(book, options),\n    onStop: () => { app.listening = null; refreshShelf(); },\n  });\n  const importCard = document.createElement('section');\n  importCard.className = 'import-card';\n  importCard.id = 'importCard';\n  importCard.innerHTML = `<p class=\"eyebrow\">添加书籍</p><h3>把整本书放进来</h3>\n    <p class=\"muted\">支持 TXT（自动识别 UTF-8 / GB18030）、EPUB、MOBI、AZW3、FB2、CBZ。文件留在本机，不上传。</p>`;\n  const dropzone = document.createElement('div');\n  dropzone.className = 'dropzone';\n  dropzone.id = 'dropzone';\n  const button = document.createElement('button');\n  button.type = 'button';\n  button.id = 'importButton';\n  button.className = 'primary';\n  button.textContent = app.books.length ? '＋ 导入电子书' : '＋ 导入第一本书';\n  button.onclick = () => $('fileInput').click();\n  const hint = document.createElement('span');\n  hint.className = 'muted';\n  hint.textContent = '也可以把文件拖到这里';\n  dropzone.append(button, hint);\n  importCard.append(dropzone);\n  $('shelfHero').append(importCard);\n  wireDropzone(dropzone);\n}\n\nfunction wireDropzone(zone) {\n  if (!zone || zone.dataset.wired) return;\n  zone.dataset.wired = '1';\n  const over = event => { event.preventDefault(); zone.classList.add('is-over'); };\n  const leave = () => zone.classList.remove('is-over');\n  zone.addEventListener('dragover', over);\n  zone.addEventListener('dragleave', leave);\n  zone.addEventListener('drop', event => {\n    event.preventDefault();\n    leave();\n    const files = [...(event.dataTransfer?.files || [])];\n    if (files.length) importFiles(files);\n  });\n}\n\nasync function deleteBook(book) {\n  const title = book.title || book.filename;\n  if (!confirm(`从本机书架删除《${title}》？\\n阅读位置、书签与这本的笔记会一并删除。`)) {\n    toast(`已取消删除《${title}》，一切保持不变`);\n    return;\n  }\n  await removeBook(book.id);\n  if (server.online) await api.deleteBook(book.id).catch(() => {});\n  if (app.listening?.bookId === book.id) app.listening = null;\n  if (app.book?.id === book.id) closeReader();\n  await refreshShelf();\n  toast(`已删除《${title}》`);\n}\n\nfunction resetProgress(book) {\n  const title = book.title || book.filename;\n  if (!confirm(`清除《${title}》的阅读位置，从头开始？`)) { toast(`已取消，阅读位置保持不变`); return; }\n  clearPosition(book.id);\n  if (app.listening?.bookId === book.id) app.listening = null;\n  refreshShelf();\n  toast(`已清除《${title}》的阅读位置`);\n}\n\n// -------------------------------------------------------------------- import\nasync function importFiles(files) {\n  let imported = 0, duplicates = 0, skipped = 0, empty = 0, failed = 0;\n  const errors = [];\n  for (const file of files) {\n    const ext = extensionOf(file.name);\n    if (!ALL_EXTENSIONS.includes(ext)) { skipped++; continue; }\n    try {\n      toast(`正在解析《${file.name}》…`);\n      const { record, empty: blank } = await buildBookRecord(file);\n      if (blank) { empty++; continue; }\n      const duplicate = await findDuplicate(record.fingerprint);\n      if (duplicate) { duplicates++; continue; }\n      await saveBook(record);\n      imported++;\n      if (server.online) {\n        api.saveBook({ id: record.id, title: record.title, author: record.author, charset: record.charset, paragraphCount: record.segmentCount }).catch(() => {});\n      }\n    } catch (err) {\n      failed++;\n      errors.push(`${file.name}：${err.message}`);\n    }\n  }\n  await refreshShelf();\n  const parts = [`已导入 ${imported} 本`];\n  if (duplicates) parts.push(`${duplicates} 本已在书架`);\n  if (empty) parts.push(`跳过 ${empty} 本空白书`);\n  if (skipped) parts.push(`跳过 ${skipped} 个不支持的文件`);\n  if (failed) parts.push(`${failed} 本失败（${errors[0]}）`);\n  toast(parts.join('；'), { tone: failed ? 'error' : 'info', ms: 5200 });\n}\n\n$('fileInput').addEventListener('change', event => {\n  const files = [...event.target.files];\n  event.target.value = '';\n  if (files.length) importFiles(files);\n});\n\n// -------------------------------------------------------------------- reader\nasync function openBook(book, { autoplay = false } = {}) {\n  closePanels();\n  const chapters = chaptersOf(book);\n  if (!chapters.some(chapter => chapter.segments.length)) {\n    toast(`《${book.title || book.filename}》没有可读文字，请重新导入`, { tone: 'error' });\n    return;\n  }\n  app.book = book;\n  app.chapters = chapters;\n  app.segments = [];\n  for (const chapter of chapters) {\n    chapter.start = app.segments.length;\n    for (const [index, text] of chapter.segments.entries()) app.segments.push({ chapter: chapter.index, index, text });\n  }\n  app.layoutKind = app.settings.layout || 'scrolled';\n  $('readerTitle').textContent = book.title || book.filename;\n  $('readerScreen').hidden = false;\n  document.body.style.overflow = 'hidden';\n  const position = readPosition(book.id);\n  await buildLayout(position ? flatIndex(position.chapter, position.segment) : 0);\n\n  app.session = new AudioSession({ speed: app.settings.speed, voice: app.settings.voice, engine: app.settings.engine });\n  app.session.addEventListener('statechange', onSpeechState);\n  app.session.addEventListener('segment', () => { /* view follows via statechange */ });\n  app.session.addEventListener('fallback', event => {\n    toast(event.detail.reason, { tone: 'error', ms: 6000 });\n    $('engineBadge').textContent = '引擎：系统语音';\n  });\n  app.session.addEventListener('engine', event => toast(event.detail.reason));\n  app.session.addEventListener('error', event => toast(event.detail.message, { tone: 'error' }));\n  app.session.addEventListener('ended', () => {\n    app.music.setDucked(false);\n    $('nowDetail').textContent = '本书已读完';\n    toast('本书读完');\n  });\n\n  const queue = app.segments.map(segment => segment.text);\n  await app.session.play(queue, app.playhead, { play: false });\n  if (autoplay) await startSpeech();\n\n  app.notes = new NotesController({ book: book, container: $('notesBody'), onSeek: seekTo, current: () => positionOf(app.playhead) });\n  await app.notes.load();\n  updateNoteCount();\n  renderToc();\n  app.music.setDucked(false);\n  $('bookArea').focus({ preventScroll: true });\n  updateBookmarkButton();\n  await app.music.start().catch(() => {});\n  app.wake = keepScreenAwake();\n  syncMedia();\n}\n\nasync function buildLayout(startIndex) {\n  app.layout?.destroy();\n  const root = $('bookRoot');\n  app.layout = createLayout(app.layoutKind, root);\n  app.layout.setChapters(app.chapters);\n  app.layout.onVisibleChange = chapter => {\n    const chapterInfo = app.chapters[chapter];\n    $('readerPlace').textContent = `第 ${chapter + 1} / ${app.chapters.length} 章 · ${chapterInfo?.title || ''}`;\n    markTocCurrent(chapter);\n    updateReadingProgress(chapter);\n    scheduleProgress(chapter);\n  };\n  app.layout.onChapter = chapter => {\n    const target = app.chapters[chapter];\n    if (!target) return;\n    seekTo(flatIndex(chapter, 0), { speak: true });\n  };\n  app.layout.onSeek = index => seekTo(index, { speak: true });\n  app.layout.render();\n  app.playhead = Math.max(0, Math.min(startIndex, app.segments.length - 1));\n  app.layout.markPosition(app.playhead);\n  $('l