[0, 1, 0],\n        joints: { wrist_l: [-0.14, 0.9, 0.06] },\n        ik: ARM_DOWN,\n        feet: { l: { toe: [-0.1, 0.02, 0.1] } },\n        ground: feetLine,\n      }),\n    },\n    {\n      label: '下蹲',\n      seq: 0.5,\n      pose: P({\n        root: [0, 0.55, 0.14],\n        up: [0, 0.94, -0.34],\n        joints: { wrist_l: [-0.14, 1.0, 0.24], ankle_l: [-0.11, 0.09, 0.02] },\n        ik: ARM_DOWN,\n        feet: { l: { toe: [-0.1, 0.02, 0.1] } },\n        ground: feetLine,\n      }),\n    },\n    { label: '站起', seq: 1, same: '站立' },\n  ],\n  'glute-bridge': [\n    {\n      label: '落地',\n      seq: 0,\n      pose: P({\n        shoulder: [0, 0.14, -0.14],\n        up: [0, 0.04, -1],\n        joints: { wrist_l: [-0.3, 0.06, 0.06], ankle_l: [-0.14, 0.1, 0.36] },\n        ik: { armPole_l: [0, -1, -0.4], armPole_r: [0, -1, -0.4], ...LEG_DOWN },\n        feet: { l: { toe: [-0.14, 0.02, 0.5] } },\n        ground: [floor('hand', 'l', 'CIRCLE'), floor('foot', 'l')],\n      }),\n    },\n    {\n      label: '抬髋',\n      seq: 0.5,\n      pose: P({\n        shoulder: [0, 0.16, -0.16],\n        up: [0, 0.33, -0.94],\n        joints: { wrist_l: [-0.3, 0.06, 0.06], ankle_l: [-0.14, 0.1, 0.36] },\n        ik: { armPole_l: [0, -1, -0.4], armPole_r: [0, -1, -0.4], ...LEG_DOWN },\n        feet: { l: { toe: [-0.14, 0.02, 0.5] } },\n        ground: [floor('hand', 'l', 'CIRCLE'), floor('foot', 'l')],\n      }),\n    },\n    { label: '回落', seq: 1, same: '落地' },\n  ],\n  'reverse-lunge': [\n    {\n      label: '站立',\n      seq: 0,\n      pose: P({\n        root: [0, 0.995, -0.033],\n        up: [0, 1, 0],\n        joints: { wrist_l: [-0.14, 0.9, 0.06] },\n        ik: ARM_DOWN,\n        feet: { l: { toe: [-0.1, 0.02, 0.1] } },\n        ground: feetLine,\n      }),\n    },\n    {\n      label: '后撤下沉',\n      seq: 0.5,\n      pose: P({\n        root: [0, 0.75, -0.12],\n        up: [0, 0.995, -0.1],\n        joints: {\n          wrist_l: [-0.14, 0.9, 0.06],\n          ankle_l: [-0.1, 0.09,