tor:'a[href=\"movement-mediapipe.html\"]'},\n  {name:'A01',path:'/portal/movement-mediapipe.html',selector:'main'},\n  {name:'fortune-teller',path:'/portal/fortune-teller/index.html',selector:'#panel-bazi'},\n  {name:'C01',path:'/portal/reader-integrated.html',selector:'#shelfScreen'},\n  {name:'watch-world',path:'/portal/watch-world.html',selector:'body'}\n];\n(async()=>{\n const browser=await chromium.launch({headless:true});\n const results=[];let failed=false;\n try{\n  for(const target of targets){\n   const page=await browser.newPage({viewport:{width:1280,height:800}});\n   const errors=[];\n   page.on('pageerror',e=>errors.push(String(e)));\n   const response=await page.goto(base+target.path,{waitUntil:'domcontentloaded',timeout:30000});\n   await page.locator(target.selector).first().waitFor({timeout:10000});\n   if(!response||response.status()>=400)errors.push('HTTP '+response?.status());\n   if(target.name==='portal'){\n    for(const href of ['movement-mediapipe.html','fortune-teller/index.html','reader-integrated.html','watch-world.html']){\n     if(await page.locator('a[href=\"'+href+'\"]').count()!==1)errors.push('missing/duplicate product link '+href);\n    }\n   }\n   if(target.name==='watch-world'){\n    const response=await page.request.get(base+'/portal/watch-world-sources.json');\n    if(!response.ok())errors.push('catalog HTTP '+response.status());\n    else {\n     const data=await response.json();\n     if(!Array.isArray(data.channels)||!data.channels.some(c=>c.streamUrl&&c.mediaCheckStatus==='passed'))errors.push('no verified stream in catalog');\n    }\n   }\n   await page.screenshot({path:'artifacts/portal-delivery/'+target.name+'.png',fullPage:true});\n   results.push({name:target.name,url:base+target.path,http:response?.status(),errors});\n   if(errors.length)failed=true;\n   await page.close();\n  }\n }finally{await browser.close()}\n fs.writeFileSync('artifacts/portal-delivery/results.json',JSON.stringify({testedAt:new Date().toISOString(),kind:'browser navigation and catalog smoke test; NOT end-to-end product acceptance',results},null,2));\n console.log(JSON.stringify(results,null,2));\n if(failed)process.exitCode=1;\n})().catch(e=>{console.error(e);process.exitCode=1});"}]}},{"type":"assistant","uuid":"44938e96-c0dc-4bd9-9384-2db5b7c8baa8","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"44938e96-c0dc-4bd9-9384-2db5b7c8baa8","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"text","text":"Now let me write the native TTS bridge (sherpa-onnx via Node)."}],"stop_reason":null,"usage":{"input_tokens":0,"output_tokens":0}}},{"type":"assistant","uuid":"f5ef90b1-4b26-4e3a-bfad-346ded492193","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"f5ef90b1-4b26-4e3a-bfad-346ded492193","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_hxN936DioVb9ho9eVs8X9580","name":"write_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/server/native_tts_bridge.mjs","content":"#!/usr/bin/env node\n// Long-lived JSON-lines bridge to sherpa-onnx offline TTS (Apache-2.0).\n// The book server spawns this once; the Python side keeps the ONNX VITS model\n// loaded so each paragraph only costs inference time, not model loading.\nimport { spawn } from 'node:child_process';\n\nconst python = process.env.PYTHON_BIN || 'python3';\nconst program = `\nimport sys, json, array, base64, wave, io\nimport sherpa_onnx\n\ndef make(cfg):\n    m = cfg[\"model\"]\n    model = sherpa_onnx.OfflineTtsModelConfig(\n        vits=sherpa_onnx.OfflineTtsVitsModelConfig(\n            model=m[\"model\"], lexicon=m[\"lexicon\"], tokens=m[\"tokens\"],\n            dict_dir=m[\"dict_dir\"]),\n        num_threads=int(m.get(\"threads\", 2)), debug=False)\n    return sherpa_onnx.OfflineTts(sherpa_onnx.OfflineTtsConfig(model=model))\n\nengines = {}\ndef engine_for(cfg):\n    key = json.dumps(cfg, sort_keys=True)\n    if key not in engines:\n        engines[key] = make(cfg)\n    return engines[key]\n\ndef wav_b64(samples, rate):\n    buf = io.BytesIO()\n    w = wave.open(buf, \"wb\")\n    w.setnchannels(1); w.setsampwidth(2); w.setframerate(rate)\n    w.writeframes(array.array(\"h\", [int(max(-1.0, min(1.0, s)) * 32767) for s in samples]).tobytes())\n    w.close()\n    return base64.b64encode(buf.getvalue()).decode()\n\ndef reply(obj):\n    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + \"\\\\n\"); sys.stdout.flush()\n\nfor line in sys.stdin:\n    line = line.strip()\n    if not line: continue\n    req = json.loads(line)\n    op = req.get(\"op\")\n    try:\n        if op == \"ping\":\n            reply({\"id\": req.get(\"id\"), \"ok\": True})\n        elif op == \"synth\":\n            tts = engine_for(req[\"model\"])\n            audio = tts.generate(req[\"text\"], sid=int(req.get(\"sid\", 0)), speed=float(req.get(\"speed\", 1.0)))\n            reply({\"id\": req.get(\"id\"), \"ok\": True, \"sampleRate\": audio.sample_rate,\n                   \"duration\": len(audio.samples) / audio.sample_rate,\n                   \"wav\": wav_b64(audio.samples, audio.sample_rate)})\n        elif op == \"exit\":\n            break\n        else:\n            reply({\"id\": req.get(\"id\"), \"ok\": False, \"error\": \"unknown op \" + str(op)})\n    except Exception as e:\n        reply({\"id\": req.get(\"id\"), \"ok\": False, \"error\": str(e)})\n`;\nconst child = spawn(python, ['-c', program], { stdio: ['pipe', 'pipe', 'pipe'] });\nchild.stderr.on('data', d => process.stderr.write(d));\nconst pending = new Map();\nlet seq = 0;\nlet buffer = '';\nchild.stdout.setEncoding('utf8');\nchild.stdout.on('data', chunk => {\n  buffer += chunk;\n  let at;\n  while ((at = buffer.indexOf('\\n')) >= 0) {\n    const line = buffer.slice(0, at);\n    buffer = buffer.slice(at + 1);\n    if (!line.trim()) continue;\n    let msg;\n    try { msg = JSON.parse(line); } catch { continue; }\n    const resolve = pending.get(msg.id);\n    if (resolve) { pending.delete(msg.id); resolve(msg); }\n  }\n});\nchild.on('exit', code => {\n  for (const resolve of pending.values()) resolve({ ok: false, error: `sherpa-onnx exited (${code})` });\n  pending.clear();\n  process.exit(Number.isInteger(code) ? code : 1);\n});\nconst call = req => new Promise(resolve => {\n  const id = ++seq;\n  pending.set(id, resolve);\n  child.stdin.write(JSON.stringify({ ...req, id }) + '\\n');\n});\nlet input = '';\nprocess.stdin.setEncoding('utf8');\nprocess.stdin.on('data', chunk => {\n  input += chunk;\n  let at;\n  while ((at = input.indexOf('\\n')) >= 0) {\n    const line = input.slice(0, at);\n    input = input.slice(at + 1);\n    if (!line.trim()) continue;\n    let req;\n    try { req = JSON.parse(line); } catch { continue; }\n    if (req.op === 'exit') child.stdin.write(JSON.stringify({ op: 'exit' }) + '\\n');\n    else call(req).then(msg => process.stdout.write(JSON.stringify({ ...msg, id: req.id }) + '\\n'));\n  }\n});\nprocess.stdin.on('end', () => { child.stdin.end(); });\n"}}],"stop_reason":"tool_use","usage":{"input_tokens":51462,"output_tokens":1186,"cache_read_input_tokens":50304,"total_tokens":52648}}},{"type":"user","uuid":"a7bdbc4b-7683-4717-859a-62fbe3637a53","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_hxN936DioVb9ho9eVs8X9580","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/server/native_tts_bridge.mjs."}]}},{"type":"assistant","uuid":"936244ee-7b6e-45cb-a7bc-671708b012e2","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"936244ee-7b6e-45cb-a7bc-671708b012e2","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_qXn5Pcg6W2OwqG3oDmOY9474","name":"write_file","input":{"content":"// Content-addressed cache for synthesized narration.\nimport { createHash } from 'node:crypto';\nimport { mkdir, readFile, writeFile, readdir, stat, unlink } from 'node:fs/promises';\nimport { join } from 'node:path';\n\nexport class AudioCache {\n  constructor(dir, { maxBytes = 512 * 1024 * 1024 } = {}) {\n    this.dir = dir;\n    this.maxBytes = maxBytes;\n  }\n\n  async init() {\n    await mkdir(this.dir, { recursive: true });\n  }\n\n  static key({ engine, voice, speed, text }) {\n    return createHash('sha256')\n      .update([engine, voice, String(speed), text].join('\\u0000'))\n      .digest('hex')\n      .slice(0, 40);\n  }\n\n  path(key) {\n    return join(this.dir, `${key}.wav`);\n  }\n\n  async get(key) {\n    try {\n      return await readFile(this.path(key));\n    } catch {\n      return null;\n    }\n  }\n\n  async set(key, buffer) {\n    await writeFile(this.path(key), buffer);\n    await this.evictIfNeeded();\n  }\n\n  async evictIfNeeded() {\n    let names;\n    try {\n      names = await readdir(this.dir);\n    } catch {\n      return;\n    }\n    const stats = [];\n    let total = 0;\n    for (const name of names) {\n      if (!name.endsWith('.wav')) continue;\n      try {\n        const info = await stat(join(this.dir, name));\n        total += info.size;\n        stats.push({ name, size: info.size, mtime: info.mtimeMs });\n      } catch {}\n    }\n    if (total <= this.maxBytes) return;\n    stats.sort((a, b) => a.mtime - b.mtime);\n    for (const entry of stats) {\n      if (total <= this.maxBytes) break;\n      await unlink(join(this.dir, entry.name)).catch(() => {});\n      total -= entry.size;\n    }\n  }\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/server/tts-cache.mjs"}}],"stop_reason":"tool_use","usage":{"input_tokens":52694,"output_tokens":524,"cache_read_input_tokens":51200,"total_tokens":53218}}},{"type":"user","uuid":"201faafb-bd3f-405b-9713-f9d104393e7c","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_qXn5Pcg6W2OwqG3oDmOY9474","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/server/tts-cache.mjs."}]}},{"type":"assistant","uuid":"a9880dba-eb0c-49b7-8f28-810bd1d6269a","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"a9880dba-eb0c-49b7-8f28-810bd1d6269a","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"text","text":"Now the server itself."}],"stop_reason":null,"usage":{"input_tokens":0,"output_tokens":0}}},{"type":"assistant","uuid":"0eeafeb8-af14-4bab-a318-4dd846b0209a","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"0eeafeb8-af14-4bab-a318-4dd846b0209a","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_uWig9O6u2yspthlYTLVL5799","name":"write_file","input":{"content":"// 陪你读书 / Read With You — local-first product server.\n// Serves the reader app, stores the family's books and narration-synced notes,\n// and (when configured) renders natural Chinese narration with sherpa-onnx.\n//\n//   node server/app.mjs              # http://127.0.0.1:8787\n//\n// Environment: PORT, FAMILY_DATA_DIR, READER_TTS_MODEL_DIR, READER_TTS_LEXICON,\n// READER_TTS_TOKENS, READER_TTS_DICT, PYTHON_BIN, TTS_THREADS.\nimport http from 'node:http';\nimport { spawn } from 'node:child_process';\nimport { createReadStream } from 'node:fs';\nimport { mkdir, readFile, rename, stat, writeFile } from 'node:fs/promises';\nimport { createHash, randomUUID } from 'node:crypto';\nimport { dirname, extname, join, normalize, resolve, sep } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { AudioCache } from './tts-cache.mjs';\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst root = resolve(here, '..');\nconst dataDir = resolve(process.env.FAMILY_DATA_DIR || join(root, 'var', 'family'));\nconst stateFile = join(dataDir, 'family-state.json');\nconst port = Number(process.env.PORT || 8787);\nconst host = process.env.HOST || '127.0.0.1';\n\nconst STATIC_ROOTS = new Map([\n  ['/portal/', join(root, 'portal')],\n  ['/server/', join(root, 'server')],\n]);\nconst MIME = {\n  '.html': 'text/html; charset=utf-8',\n  '.js': 'text/javascript; charset=utf-8',\n  '.mjs': 'text/javascript; charset=utf-8',\n  '.css': 'text/css; charset=utf-8',\n  '.json': 'application/json; charset=utf-8',\n  '.wav': 'audio/wav',\n  '.mp3': 'audio/mpeg',\n  '.ogg': 'audio/ogg',\n  '.svg': 'image/svg+xml',\n  '.png': 'image/png',\n  '.txt': 'text/plain; charset=utf-8',\n  '.wasm': 'application/wasm',\n};\n\n// ---------------------------------------------------------------- persistence\nconst defaultState = () => ({\n  version: 1,\n  books: {}, // id -> { id, title, author, charset, addedAt, paragraphCount }\n  notes: {}, // noteId -> { id, bookId, text, chapterTitle, chapterIndex, segmentIndex, quote, kind, createdAt }\n  bookmarks: {}, // id -> { id, bookId, chapterIndex, segmentIndex, label, createdAt }\n  listening: {}, // bookId -> { bookId, chapterIndex, segmentIndex, updatedAt }\n  voices: {}, // voiceId -> consent record\n  settings: { preferredVoice: 'system', background: { source: null, level: 0.18 } },\n});\nlet state = defaultState();\nlet saveChain = Promise.resolve();\n\nasync function loadState() {\n  await mkdir(dataDir, { recursive: true });\n  try {\n    const parsed = JSON.parse(await readFile(stateFile, 'utf8'));\n    state = { ...defaultState(), ...parsed };\n  } catch {\n    state = defaultState();\n  }\n}\nfunction persist() {\n  const snapshot = JSON.stringify(state, null, 2);\n  const tmp = `${stateFile}.${randomUUID()}.tmp`;\n  saveChain = saveChain.then(async () => {\n    await writeFile(tmp, snapshot);\n    await rename(tmp, stateFile);\n  }).catch(err => console.error('could not persist family state', err));\n  return saveChain;\n}\n\n// ---------------------------------------------------------------------- TTS\nconst modelDir = process.env.READER_TTS_MODEL_DIR ? resolve(process.env.READER_TTS_MODEL_DIR) : null;\nconst vitsConfig = modelDir && {\n  model: join(modelDir, 'model.onnx'),\n  lexicon: resolve(process.env.READER_TTS_LEXICON || join(modelDir, 'lexicon.txt')),\n  tokens: resolve(process.env.READER_TTS_TOKENS || join(modelDir, 'tokens.txt')),\n  dict_dir: resolve(process.env.READER_TTS_DICT || join(modelDir, 'dict')),\n  threads: Number(process.env.TTS_THREADS || 2),\n};\nconst ttsCache = new AudioCache(join(dataDir, 'tts-cache'), { maxBytes: 768 * 1024 * 1024 });\n\nlet bridge = null;\nlet bridgeQueue = Promise.resolve();\nfunction ttsBridge() {\n  if (!bridge) {\n    const child = spawn(process.execPath, [join(here, 'native_tts_bridge.mjs')], {\n      stdio: ['pipe', 'pipe', 'inherit'],\n      env: { ...process.env, PYTHON_BIN: process.env.PYTHON_BIN || 'python3' },\n    });\n    child.stdout.setEncoding('utf8');\n    let buf = '';\n    const waiting = new Map();\n    let seq = 0;\n    child.stdout.on('data', chunk => {\n      buf += chunk;\n      let at;\n      while ((at = buf.indexOf('\\n')) >= 0) {\n        const line = buf.slice(0, at);\n        buf = buf.slice(at + 1);\n        try {\n          const msg = JSON.parse(line);\n          const done = waiting.get(msg.id);\n          if (done) { waiting.delete(msg.id); done(msg); }\n        } catch {}\n      }\n    });\n    child.on('exit', () => {\n      bridge = null;\n      for (const done of waiting.values()) done({ ok: false, error: 'tts engine stopped' });\n      waiting.clear();\n    });\n    bridge = {\n      child,\n      request(req) {\n        return new Promise(done => {\n          const id = ++seq;\n          waiting.set(id, done);\n          child.stdin.write(JSON.stringify({ ...req, id }) + '\\n');\n        });\n      },\n    };\n  }\n  return bridge;\n}\nasync function synthesize(text, { speed = 1, voice = 'narrator-zh' } = {}) {\n  return (bridgeQueue = bridgeQueue.then(async () => {\n    const reply = await ttsBridge().request({ op: 'synth', text, speed, sid: 0, model: vitsConfig });\n    if (!reply.ok) throw new Error(reply.error || 'tts failed');\n    return Buffer.from(reply.wav, 'base64');\n  }));\n}\nconst ttsStatus = async () => {\n  if (!vitsConfig) return { available: false, reason: 'READER_TTS_MODEL_DIR is not configured; the reader falls back to the device voice.' };\n  try {\n    await stat(vitsConfig.model);\n    await stat(vitsConfig.lexicon);\n  } catch {\n    return { available: false, reason: 'Narration model files are missing on this machine.' };\n  }\n  return { available: true, engine: 'sherpa-onnx VITS (MeloTTS zh_en)', license: 'Apache-2.0 (sherpa-onnx) / MIT (MeloTTS model)', sampleRate: 44100 };\n};\n\nconst speakingClock = new Map();\nlet sampleRateAssumption = 44100;\nfunction estimateDuration(text) {\n  const zh = (text.match(/[\\u4e00-\\u9fff]/g) || []).length;\n  const rest = text.length - zh;\n  return (zh / 4.6 + rest / 14);\n}\n\n// -------------------------------------------------------------------- routes\nconst json = (res, status, body) => {\n  res.writeHead(status, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' });\n  res.end(JSON.stringify(body));\n};\nconst readBody = req => new Promise((done, fail) => {\n  let size = 0;\n  const chunks = [];\n  req.on('data', c => {\n    size += c.length;\n    if (size > 8 * 1024 * 1024) { fail(new Error('payload too large')); req.destroy(); return; }\n    chunks.push(c);\n  });\n  req.on('end', () => {\n    if (!chunks.length) return done({});\n    try { done(JSON.parse(Buffer.concat(chunks).toString('utf8'))); } catch { fail(new Error('invalid JSON')); }\n  });\n  req.on('error', fail);\n});\n\nfunction cleanText(value, max = 4000) {\n  const s = String(value ?? '').replace(/\\u0000/g, '').trim();\n  return s.length > max ? s.slice(0, max) : s;\n}\n\nfunction voiceView(record) {\n  const now = Date.now();\n  return {\n    id: record.id,\n    voiceName: record.voiceName,\n    displayName: record.displayName,\n    languages: record.languages || 'zh-CN',\n    provider: record.provider,\n    consent: record.consent,\n    status: record.deletedAt ? 'deleted' : record.revokedAt ? 'revoked' : 'active',\n    createdAt: record.createdAt,\n    revokedAt: record.revokedAt,\n    deletedAt: record.deletedAt,\n    expiresAt: record.expiresAt || null,\n    expired: Boolean(record.expiresAt && record.expiresAt < now),\n    purposes: record.purposes || [],\n    samplesStored: record.deletedAt ? 0 : (record.sampleBytes ? 1 : 0),\n    canSynthesize: !record.deletedAt && !record.revokedAt && !(record.expiresAt && record.expiresAt < now),\n  };\n}\n\nasync function api(req, res, url) {\n  const p = url.pathname;\n  const method = req.method;\n\n  if (p === '/api/health') {\n    return json(res, 200, {\n      ok: true,\n      product: '陪你读书 / Read With You',\n      narration: await ttsStatus(),\n      books: Object.keys(state.books).length,\n      voices: Object.values(state.voices).filter(v => voiceView(v).status === 'active').length,\n    });\n  }\n\n  if (p === '/api/books' && method === 'GET') {\n    return json(res, 200, { books: Object.values(state.books).sort((a, b) => (b.addedAt || '').localeCompare(a.addedAt || '')) });\n  }\n  if (p === '/api/books' && method === 'POST') {\n    const body = await readBody(req);\n    const title = cleanText(body.title, 300);\n    if (!title) return json(res, 400, { error: '书名不能为空' });\n    const id = cleanText(body.id, 80) || randomUUID();\n    const existing = state.books[id];\n    state.books[id] = {\n      id,\n      title,\n      author: cleanText(body.author, 200),\n      charset: ['utf-8', 'gb18030'].includes(body.charset) ? body.charset : 'utf-8',\n      paragraphCount: Number(body.paragraphCount) || 0,\n      addedAt: existing?.addedAt || new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n    };\n    await persist();\n    return json(res, 200, { book: state.books[id] });\n  }\n  const bookMatch = p.match(/^\\/api\\/books\\/([\\w-]+)$/);\n  if (bookMatch) {\n    const id = bookMatch[1];\n    if (method === 'GET') {\n      if (!state.books[id]) return json(res, 404, { error: '找不到这本书' });\n      return json(res, 200, {\n        book: state.books[id],\n        notes: Object.values(state.notes).filter(n => n.bookId === id).sort((a, b) => a.createdAt - b.createdAt),\n        bookmarks: Object.values(state.bookmarks).filter(n => n.bookId === id),\n        listening: state.listening[id] || null,\n      });\n    }\n    if (method === 'DELETE') {\n      delete state.books[id];\n      for (const [k, n] of Object.entries(state.notes)) if (n.bookId === id) delete state.notes[k];\n      for (const [k, n] of Object.entries(state.bookmarks)) if (n.bookId === id) delete state.bookmarks[k];\n      delete state.listening[id];\n      await persist();\n      return json(res, 200, { ok: true });\n    }\n  }\n  if (p === '/api/bookmarks' && method === 'POST') {\n    const body = await readBody(req);\n    const id = randomUUID();\n    state.bookmarks[id] = {\n      id,\n      bookId: cleanText(body.bookId, 80),\n      chapterIndex: Number(body.chapterIndex) || 0,\n      segmentIndex: Number(body.segmentIndex) || 0,\n      label: cleanText(body.label, 160),\n      createdAt: Date.now(),\n    };\n    await persist();\n    return json(res, 200, { bookmark: state.bookmarks[id] });\n  }\n  const bookmarkMatch = p.match(/^\\/api\\/bookmarks\\/([\\w-]+)$/);\n  if (bookmarkMatch && method === 'DELETE') {\n    delete state.bookmarks[bookmarkMatch[1]];\n    await persist();\n    return json(res, 200, { ok: true });\n  }\n  if (p === '/api/notes' && method === 'POST') {\n    const body = await readBody(req);\n    const text = cleanText(body.text);\n    if (!text) return json(res, 400, { error: '笔记内容不能为空' });\n    const id = randomUUID();\n    state.notes[id] = {\n      id,\n      bookId: cleanText(body.bookId, 80),\n      text,\n      kind: body.kind === 'thought' ? 'thought' : 'note',\n      quote: cleanText(body.quote, 600),\n      chapterTitle: cleanText(body.chapterTitle, 200),\n      chapterIndex: Number(body.chapterIndex) || 0,\n      segmentIndex: Number(body.segmentIndex) || 0,\n      createdAt: Date.now(),\n    };\n    await persist();\n    return json(res, 200, { note: state.notes[id] });\n  }\n  const noteMatch = p.match(/^\\/api\\/notes\\/([\\w-]+)$/);\n  if (noteMatch) {\n    const id = noteMatch[1];\n    if (!state.notes[id]) return json(res, 404, { error: '找不到这条笔记' });\n    if (method === 'DELETE') {\n      delete state.notes[id];\n      await persist();\n      return json(res, 200, { ok: true });\n    }\n    if (method === 'PATCH') {\n      const body = await readBody(req);\n      const text = cleanText(body.text);\n      if (!text) return json(res, 400, { error: '笔记内容不能为空' });\n      state.notes[id].text = text;\n      state.notes[id].editedAt = Date.now();\n      await persist();\n      return json(res, 200, { note: state.notes[id] });\n    }\n  }\n  if (p === '/api/notes' && method === 'GET') {\n    const bookId = url.searchParams.get('bookId');\n    const items = Object.values(state.notes).filter(n => !bookId || n.bookId === bookId).sort((a, b) => a.createdAt - b.createdAt);\n    return json(res, 200, { notes: items });\n  }\n  if (p === '/api/listening' && method === 'PUT') {\n    const body = await readBody(req);\n    const bookId = cleanText(body.bookId, 80);\n    if (!bookId) return json(res, 400, { error: '缺少 bookId' });\n    state.listening[bookId] = {\n      bookId,\n      chapterIndex: Number(body.chapterIndex) || 0,\n      segmentIndex: Number(body.segmentIndex) || 0,\n      updatedAt: Date.now(),\n    };\n    await persist();\n    return json(res, 200, { listening: state.listening[bookId] });\n  }\n\n  // ---- voices: explicit, revocable family voice consent records\n  if (p === '/api/voices' && method === 'GET') {\n    return json(res, 200, {\n      voices: Object.values(state.voices).map(voiceView).sort((a, b) => b.createdAt - a.createdAt),\n      preferredVoice: state.settings.preferredVoice,\n    });\n  }\n  if (p === '/api/voices' && method === 'POST') {\n    const body = await readBody(req);\n    const voiceName = cleanText(body.voiceName, 120);\n    const consent = body.consent || {};\n    const problems = [];\n    if (!voiceName) problems.push('需要填写声音本人的称呼');\n    if (consent.authorizedBy !== 'voice-owner') problems.push('必须由声音本人确认授权，才能使用家庭声音');\n    if (!Array.isArray(consent.purposes) || !consent.purposes.length) problems.push('需要选择授权用途');\n    if (!cleanText(consent.statement, 2000)) problems.push('需要填写授权说明');\n    if (problems.length) return json(res, 400, { error: problems.join('；'), problems });\n    const id = randomUUID();\n    state.voices[id] = {\n      id,\n      voiceName,\n      displayName: cleanText(body.displayName, 120) || `${voiceName}的声音`,\n      languages: cleanText(body.languages, 60) || 'zh-CN',\n      provider: cleanText(body.provider, 80) || 'pending-training',\n      consent: {\n        authorizedBy: 'voice-owner',\n        purposes: consent.purposes.map(x => cleanText(x, 40)).slice(0, 8),\n        statement: cleanText(consent.statement, 2000),\n        allowChildReading: Boolean(consent.allowChildReading),\n        recordedAt: Date.now(),\n        expiresAt: Number(consent.expiresAt) || null,\n      },\n      expiresAt: Number(consent.expiresAt) || null,\n      createdAt: Date.now(),\n      audit: [{ at: Date.now(), action: 'granted' }],\n    };\n    await persist();\n    return json(res, 200, { voice: voiceView(state.voices[id]) });\n  }\n  const voiceMatch = p.match(/^\\/api\\/voices\\/([\\w-]+)(\\/revoke|\\/sample)?$/);\n  if (voiceMatch) {\n    const record = state.voices[voiceMatch[1]];\n    if (!record) return json(res, 404, { error: '找不到这个声音' });\n    const action = voiceMatch[2];\n    if (action === '/revoke' && method === 'POST') {\n      record.revokedAt = Date.now();\n      record.audit.push({ at: record.revokedAt, action: 'consent-revoked' });\n      if (state.settings.preferredVoice === record.id) state.settings.preferredVoice = 'system';\n      await purgeVoiceAudio(record.id);\n      await persist();\n      return json(res, 200, { voice: voiceView(record) });\n    }\n    if (action === '/sample' && method === 'DELETE') {\n      record.sampleBytes = 0;\n      record.audit.push({ at: Date.now(), action: 'samples-deleted' });\n      await purgeVoiceAudio(record.id);\n      await persist();\n      return json(res, 200, { voice: voiceView(record) });\n    }\n    if (!action && method === 'DELETE') {\n      record.deletedAt = Date.now();\n      record.sampleBytes = 0;\n      record.audit.push({ at: record.deletedAt, action: 'deleted' });\n      if (state.settings.preferredVoice === record.id) state.settings.preferredVoice = 'system';\n      await purgeVoiceAudio(record.id);\n      await persist();\n      return json(res, 200, { voice: voiceView(record) });\n    }\n    if (!action && method === 'PATCH') {\n      const body = await readBody(req);\n      state.settings.preferredVoice = cleanText(body.preferredVoice, 80) || 'system';\n      await persist();\n      return json(res, 200, { preferredVoice: state.settings.preferredVoice });\n    }\n  }\n  if (p === '/api/voices/preferred' && method === 'PUT') {\n    const body = await readBody(req);\n    const id = cleanText(body.voiceId, 80);\n    if (id && id !== 'system' && !state.voices[id]?.consent) return json(res, 400, { error: '这个声音没有有效的授权记录' });\n    state.settings.preferredVoice = id || 'system';\n    await persist();\n    return json(res, 200, { preferredVoice: state.settings.preferredVoice });\n  }\n\n  // ---- narration\n  if (p === '/api/narration' && method === 'GET') {\n    return json(res, 200, { ...(await ttsStatus()), preferredVoice: state.settings.preferredVoice });\n  }\n  const narrationMatch = p.match(/^\\/api\\/narration\\/([\\w-]+)$/);\n  if (narrationMatch && method === 'GET') {\n    const text = cleanText(url.searchParams.get('text'), 1200);\n    const speed = Math.min(1.6, Math.max(0.6, Number(url.searchParams.get('speed')) || 1));\n    if (!text) return json(res, 400, { error: '没有要朗读的文字' });\n    const voiceId = cleanText(url.searchParams.get('voice'), 80);\n    let engine = 'native';\n    if (voiceId && voiceId !== 'system') {\n      const record = state.voices[voiceId];\n      const view = record && voiceView(record);\n      if (!view?.canSynthesize) return json(res, 403, { error: '这个家庭声音没有有效授权，已停止合成' });\n      if (view.provider === 'pending-training') return json(res, 409, { error: '这个声音已授权，但训练尚未完成，不能用于朗读' });\n      engine = `voice:${voiceId}`;\n    }\n    const key = AudioCache.key({ engine, voice: voiceId || 'system', speed, text });\n    const cached = await ttsCache.get(key);\n    if (cached) {\n      res.writeHead(200, {\n        'content-type': 'audio/wav',\n        'content-length': cached.length,\n        'x-narration-cache': 'hit',\n        'x-narration-duration': String(estimateDuration(text) / speed),\n        'cache-control': 'private, max-age=86400',\n      });\n      return res.end(cached);\n    }\n    const started = Date.now();\n    const wav = await synthesize(text, { speed });\n    await ttsCache.set(key, wav);\n    res.writeHead(200, {\n      'content-type': 'audio/wav',\n      'content-length': wav.length,\n      'x-narration-cache': 'miss',\n      'x-narration-ms': String(Date.now() - started),\n      'cache-control': 'private, max-age=86400',\n    });\n    return res.end(wav);\n  }\n  return json(res, 404, { error: 'unknown API', path: p });\n}\n\nasync function purgeVoiceAudio(voiceId) {\n  // Voices are consent records only; any cached speech attributed to them is removed.\n  const names = await import('node:fs/promises').then(m => m.readdir(join(dataDir, 'tts-cache')).catch(() => []));\n  for (const name of names) {\n    if (name.includes(voiceId)) await import('node:fs/promises').then(m => m.unlink(join(dataDir, 'tts-cache', name))).catch(() => {});\n  }\n}\n\nfunction serveStatic(req, res, url) {\n  let pathname = decodeURIComponent(url.pathname);\n  if (pathname === '/') { res.writeHead(302, { location: '/portal/read-with-you.html' }); return res.end(); }\n  if (pathname === '/read-with-you') { res.writeHead(302, { location: '/portal/read-with-you.html' }); return res.end(); }\n  for (const [prefix, base] of STATIC_ROOTS) {\n    if (!pathname.startsWith(prefix)) continue;\n    const rel = normalize(pathname.slice(prefix.length));\n    const file = resolve(base, rel);\n    if (!file.startsWith(base + sep) && file !== base) return json(res, 403, { error: 'forbidden' });\n    return streamFile(req, res, file);\n  }\n  return json(res, 404, { error: 'not found' });\n}\n\nasync function streamFile(req, res, file) {\n  let info;\n  try { info = await stat(file); } catch { return json(res, 404, { error: 'not found' }); }\n  if (!info.isFile()) return json(res, 404, { error: 'not found' });\n  const etag = `W/\"${info.size}-${Math.floor(info.mtimeMs)}\"`;\n  if (req.headers['if-none-match'] === etag) { res.writeHead(304); return res.end(); }\n  const headers = {\n    'content-type': MIME[extname(file).toLowerCase()] || 'application/octet-stream',\n    'content-length': info.size,\n    'etag': etag,\n    'cache-control': file.includes(`${sep}vendor${sep}`) ? 'public, max-age=86400' : 'no-cache',\n    'x-content-type-options': 'nosniff',\n  };\n  res.writeHead(200, headers);\n  if (req.method === 'HEAD') return res.end();\n  createReadStream(file).pipe(res);\n}\n\nconst server = http.createServer(async (req, res) => {\n  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);\n  try {\n    if (url.pathname.startsWith('/api/')) {\n      await api(req, res, url);\n      return;\n    }\n    if (req.method ===