font-size:10px;letter-spacing:.12em;background:rgba(20,30,24,.7);color:#f4efe2;border-radius:6px;padding:2px 6px}\n.shelf-meta{display:grid;gap:2px;min-width:0}\n.shelf-meta strong{font-size:15px;line-height:1.45;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.shelf-meta small{color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.shelf-actions{display:flex;gap:6px;flex-wrap:wrap}\n.shelf-actions button{font-size:12px;padding:5px 9px;border-radius:9px}\n.shelf-empty{grid-column:1/-1;padding:34px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:var(--radius)}\n.status{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);max-width:min(92vw,620px);background:#22332b;color:#f2eee2;padding:11px 18px;border-radius:99px;box-shadow:var(--shadow);font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s ease;z-index:80}\n.status.is-visible{opacity:1}\n.status[data-tone=\"error\"]{background:var(--danger)}\n.voices-strip{display:flex;gap:12px;align-items:center;flex-wrap:wrap;background:var(--accent-soft);border-radius:var(--radius);padding:16px 20px;margin-top:36px}\n.voices-strip p{margin:0;color:var(--ink)}\n.voices-strip .muted{color:var(--muted)}\n.voices-strip .actions{margin-left:auto}\n.library-foot{margin:36px 0 60px;color:var(--muted);font-size:12px;display:flex;gap:18px;flex-wrap:wrap}\n\n/* ---------------------------------------------------------------- reader */\n#readerScreen{position:fixed;inset:0;background:var(--paper);z-index:40;display:flex;flex-direction:column}\n.reader-bar{display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--line);background:var(--paper-raised);flex-wrap:wrap}\n.reader-bar .book-id{flex:1;min-width:0;display:grid}\n.reader-bar .book-id strong{font-family:var(--font-book);font-weight:500;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.reader-bar .book-id small{color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.reader-tools{display:flex;gap:6px;flex-wrap:wrap}\n.reader-body{flex:1;min-height:0;display:flex;overflow:hidden}\n.book-area{flex:1;min-width:0;overflow:auto;scroll-behavior:smooth;padding:clamp(18px,4vw,56px) clamp(14px,5vw,60px) 140px}\n.book-flow{max-width:70ch;margin:0 auto;font-size:calc(19px * var(--font-scale,1));line-height:2.05;font-family:var(--font-book)}\n.chapter{margin:0 0 44px}\n.chapter-title{font-size:1.35em;font-weight:600;margin:1.4em 0 .9em;letter-spacing:.04em}\n.chapter-title::after{content:\"\";display:block;width:52px;height:2px;background:var(--warm);margin-top:.5em;opacity:.6}\n.chapter-body p{margin:0 0 1.05em;text-indent:2em;overflow-wrap:anywhere;border-radius:6px;padding:2px 3px;margin-left:-3px;scroll-margin:40vh 0 40vh;transition:background .25s ease}\n.seg.is-position{background:var(--accent-soft)}\n.seg.is-speaking{background:color-mix(in srgb,var(--accent-soft) 70%,var(--warm) 30%);box-shadow:-3px 0 0 var(--warm)}\n.book-paged{display:grid;grid-template-columns:minmax(150px,220px) minmax(0,1fr);gap:24px;max-width:1050px;margin:0 auto;height:100%}\n.paged-toc{list-style:none;margin:0;padding:0 6px 0 0;overflow:auto;border-right:1px solid var(--line)}\n.paged-toc-item{width:100%;text-align:left;border:0;background:transparent;border-radius:8px;padding:8px 10px;font-size:14px;color:var(--muted)}\n.paged-toc-item.is-current{background:var(--accent-soft);color:var(--ink);font-weight:600}\n.paged-page{font-family:var(--font-book);max-width:62ch}\n.paged-heading{font-size:19px;font-weight:600;margin:0 0 18px;display:flex;justify-content:space-between;gap:12px;align-items:baseline}\n.paged-progress{font-size:12px;color:var(--muted);font-family:var(--font-ui);font-weight:400}\n.paged-seg{font-size:calc(24px * var(--font-scale,1));line-height:1.95;margin:0 0 26px;padding:18px 20px;border-radius:14px;background:var(--paper-raised);box-shadow:var(--shadow);overflow-wrap:anywhere}\n.paged-neighbours{display:grid;gap:8px;color:var(--muted);font-size:14px}\n.paged-neighbour{margin:0;cursor:pointer;padding:8px 10px;border-radius:10px;opacity:.75}\n.paged-neighbour:hover{background:var(--accent-soft);opacity:1}\n.playbar{display:flex;align-items:center;gap:10px;padding:10px 16px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--paper-raised);flex-wrap:wrap}\n.playbar .now{flex:1;min-width:150px;display:grid;font-size:12px;color:var(--muted)}\n.playbar .now strong{font-size:14px;color:var(--ink);font-weight:550;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.playbar .engine{padding:3px 9px;border-radius:99px;font-size:11px;background:var(--accent-soft)}\n#speakButton{min-width:104px}\n.progress-line{height:3px;background:var(--line);position:relative}\n.progress-line span{display:block;height:100%;width:0;background:var(--warm);transition:width .3s ease}\n.panel{width:min(400px,92vw);max-width:100%;border-left:1px solid var(--line);background:var(--paper-raised);display:flex;flex-direction:column;overflow:hidden}\n.panel header{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}\n.panel header h3{margin:0;font-family:var(--font-book);font-weight:500;font-size:18px;flex:1}\n.panel .panel-body{overflow:auto;padding:14px 16px;flex:1}\n.panel .panel-foot{padding:12px 16px;border-top:1px solid var(--line);display:flex;gap:8px}\n.toc-list{list-style:none;margin:0;padding:0}\n.toc-list button{display:block;width:100%;text-align:left;border:0;background:transparent;padding:9px 10px;border-radius:9px}\n.toc-list button.is-current{background:var(--accent-soft);font-weight:600}\n.note-form{display:grid;gap:8px}\n.note-form textarea{width:100%;min-height:92px;resize:vertical;border:1px solid var(--line);border-radius:10px;padding:10px;background:var(--paper)}\n.quote{cursor:pointer;border-left:3px solid var(--warm);padding:4px 10px;color:var(--muted);font-size:13px;margin:0 0 8px;border-radius:0 8px 8px 0;background:var(--accent-soft)}\n.note-item{border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px;display:grid;gap:6px}\n.note-item p{margin:0;white-space:pre-wrap}\n.note-item .note-meta{font-size:11px;color:var(--muted);display:flex;gap:8px;align-items:center;flex-wrap:wrap}\n.note-item .note-meta button{font-size:11px;padding:2px 7px}\n.setting-row{display:grid;gap:6px;margin-bottom:16px}\n.setting-row label{font-size:13px;font-weight:600}\n.setting-row input[type=range]{width:100%}\n.setting-row .choice{display:flex;gap:6px;flex-wrap:wrap}\n.segmented{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}\n.segmented button{border:0;border-radius:0;padding:6px 11px;font-size:13px;background:transparent}\n.segmented button[aria-pressed=\"true\"]{background:var(--accent);color:var(--paper-raised)}\n.bookmark-item{display:flex;justify-content:space-between;gap:8px;align-items:center;border-bottom:1px dashed var(--line);padding:9px 0}\n.bookmark-item button{border:0;background:transparent;text-align:left;padding:4px}\n.voice-card{border:1px solid var(--line);border-radius:12px;padding:12px;display:grid;gap:8px;margin-bottom:10px}\n.voice-card .voice-head{display:flex;justify-content:space-between;gap:8px;align-items:center}\n.voice-card[data-status=\"revoked\"],.voice-card[data-status=\"deleted\"]{opacity:.62}\n.voice-actions{display:flex;gap:6px;flex-wrap:wrap}\n.voice-actions button{font-size:12px;padding:5px 9px}\n.consent-form{display:grid;gap:10px}\n.consent-form fieldset{border:1px solid var(--line);border-radius:10px;padding:10px;margin:0;display:grid;gap:6px}\n.consent-form legend{font-size:12px;color:var(--muted);padding:0 4px}\n.consent-form label.check{display:flex;gap:8px;align-items:flex-start;font-size:14px}\n.consent-form input[type=text],.consent-form textarea,.consent-form select{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px;background:var(--paper)}\n.notice{background:var(--accent-soft);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--ink)}\n.notice.warn{background:color-mix(in srgb,var(--warm) 18%,var(--paper-raised))}\n.empty-note{color:var(--muted);font-size:13px;padding:10px 0}\n@media(max-width:900px){\n  .shelf-hero{grid-template-columns:1fr}\n  .panel{position:fixed;inset:auto 0 0 0;width:100%;height:min(78vh,640px);border-left:0;border-top:1px solid var(--line);border-radius:18px 18px 0 0;box-shadow:var(--shadow)}\n  .book-paged{grid-template-columns:1fr;height:auto}\n  .paged-toc{display:flex;gap:6px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line);padding-bottom:8px}\n  .paged-toc li{flex:0 0 auto}\n  .paged-toc-item{white-space:nowrap}\n}\n@media(max-width:560px){\n  .shelf-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 14px}\n  .reader-bar{padding:8px 10px;gap:6px}\n  .reader-tools button{padding:7px 8px;font-size:13px}\n  .book-area{padding:16px 14px 150px}\n  .playbar{gap:6px}\n  #speakButton{min-width:88px}\n}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}\n</style>\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <header class=\"topbar\">\n    <div class=\"brand\">\n      <div class=\"brand-mark\" aria-hidden=\"true\">读</div>\n      <div>\n        <h1>陪你读书</h1>\n        <small>Read With You · 本机书库 · 连续朗读</small>\n      </div>\n    </div>\n    <span class=\"server-dot\" id=\"serverDot\" data-online=\"false\" title=\"家庭服务器连接状态\"><i></i><span id=\"serverLabel\">正在检查家庭服务器…</span></span>\n    <a href=\"index.html\" class=\"muted\" style=\"font-size:13px\">← 零一空间</a>\n  </header>\n\n  <section class=\"shelf-hero\" id=\"shelfHero\" aria-live=\"polite\"></section>\n\n  <div class=\"section-head\">\n    <h2>我的书架</h2>\n    <span class=\"count\" id=\"shelfCount\"></span>\n    <label>搜索 <input id=\"shelfSearch\" type=\"search\" placeholder=\"书名 / 作者 / 格式\" autocomplete=\"off\"></label>\n  </div>\n  <section class=\"shelf-grid\" id=\"shelfGrid\" aria-label=\"书架\"></section>\n\n  <section class=\"voices-strip\">\n    <div>\n      <p><strong>家庭声音</strong> <span class=\"muted\">经本人授权才可录制与合成；随时可撤回授权、删除样本。</span></p>\n    </div>\n    <div class=\"actions\"><button type=\"button\" id=\"openVoices\" class=\"ghost\">管理声音与授权 →</button></div>\n  </section>\n\n  <footer class=\"library-foot\">\n    <span>书籍、阅读位置与背景音乐只保存在这台设备。</span>\n    <span>笔记与听书记忆可与家庭服务器同步。</span>\n    <a href=\"classical-radio.html\">听世界 · 电台与播客 →</a>\n    <a href=\"reader-integrated.html\">经典整页阅读器 →</a>\n  </footer>\n</div>\n\n<section id=\"readerScreen\" hidden aria-label=\"阅读器\">\n  <div class=\"progress-line\" aria-hidden=\"true\"><span id=\"readingProgress\"></span></div>\n  <div class=\"reader-bar\">\n    <button type=\"button\" id=\"closeReader\" class=\"icon\" aria-label=\"返回书架\">←</button>\n    <div class=\"book-id\">\n      <strong id=\"readerTitle\"></strong>\n      <small id=\"readerPlace\"></small>\n    </div>\n    <div class=\"reader-tools\">\n      <button type=\"button\" id=\"tocButton\" title=\"目录 (T)\">目录</button>\n      <button type=\"button\" id=\"notesButton\" title=\"笔记 (N)\">笔记 <span id=\"noteCount\" class=\"muted\"></span></button>\n      <button type=\"button\" id=\"bookmarkAdd\" title=\"添加书签 (B)\">☆ 书签</button>\n      <button type=\"button\" id=\"layoutButton\" title=\"切换连续/分页\">分页</button>\n      <button type=\"button\" id=\"settingsButton\" title=\"朗读设置\">设置</button>\n    </div>\n  </div>\n  <div class=\"reader-body\">\n    <div class=\"book-area\" id=\"bookArea\" tabindex=\"0\" aria-label=\"正文\">\n      <div id=\"bookRoot\"></div>\n    </div>\n    <aside class=\"panel\" id=\"tocPanel\" hidden aria-label=\"目录\">\n      <header><h3>目录</h3><button type=\"button\" class=\"icon\" data-close=\"toc\" aria-label=\"关闭目录\">✕</button></header>\n      <div class=\"panel-body\"><ol class=\"toc-list\" id=\"tocList\"></ol></div>\n    </aside>\n    <aside class=\"panel\" id=\"notesPanel\" hidden aria-label=\"笔记\">\n      <header><h3>笔记与讨论</h3><button type=\"button\" class=\"icon\" data-close=\"notes\" aria-label=\"关闭笔记\">✕</button></header>\n      <div class=\"panel-body\" id=\"notesBody\"></div>\n    </aside>\n    <aside class=\"panel\" id=\"settingsPanel\" hidden aria-label=\"朗读设置\">\n      <header><h3>朗读与阅读</h3><button type=\"button\" class=\"icon\" data-close=\"settings\" aria-label=\"关闭设置\">✕</button></header>\n      <div class=\"panel-body\" id=\"settingsBody\"></div>\n    </aside>\n    <aside class=\"panel\" id=\"voicesPanel\" hidden aria-label=\"家庭声音\">\n      <header><h3>家庭声音</h3><button type=\"button\" class=\"icon\" data-close=\"voices\" aria-label=\"关闭声音面板\">✕</button></header>\n      <div class=\"panel-body\" id=\"voicesBody\"></div>\n    </aside>\n  </div>\n  <div class=\"playbar\">\n    <button type=\"button\" id=\"prevSegment\" class=\"icon\" aria-label=\"上一段\" title=\"上一段 (←)\">⏮</button>\n    <button type=\"button\" id=\"speakButton\" class=\"primary\" aria-label=\"开始朗读\" title=\"朗读 / 暂停 (1-6 调速)\">▶ 朗读</button>\n    <button type=\"button\" id=\"nextSegment\" class=\"icon\" aria-label=\"下一段\" title=\"下一段 (→)\">⏭</button>\n    <div class=\"now\">\n      <strong id=\"nowTitle\">—</strong>\n      <span id=\"nowDetail\">按「朗读」开始，或按键 T 打开目录</span>\n    </div>\n    <span class=\"engine\" id=\"engineBadge\">引擎：检测中</span>\n  </div>\n</section>\n\n<div class=\"status\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n<input type=\"file\" id=\"fileInput\" accept=\".epub,.mobi,.azw3,.fb2,.cbz,.txt,.text,.md\" multiple hidden>\n<input type=\"file\" id=\"musicInput\" accept=\"audio/*\" hidden>\n<script type=\"module\" src=\"js/read-with-you/main.js\"></script>\n</body>\n</html>\n"}]}},{"type":"assistant","uuid":"97b0cfef-a73a-45ad-a84b-74da5348fa3f","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"97b0cfef-a73a-45ad-a84b-74da5348fa3f","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_UVUG7MnGseOOUkFS543n2337","name":"read_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/store.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":39840,"output_tokens":61,"cache_read_input_tokens":32512,"total_tokens":39901}}},{"type":"user","uuid":"6c4c6d0c-a0c3-4412-a7c5-156c0ca02801","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_UVUG7MnGseOOUkFS543n2337","is_error":false,"content":"// On-device persistence. Books (including their original files), reading\n// positions and the background-music track never leave the browser; the\n// server only ever sees titles, positions and notes for sync.\nconst DB_NAME = 'zero-one-reader-library';\nconst DB_VERSION = 3;\nconst POSITION_PREFIX = 'rwy-pos-';\nconst SETTINGS_PREFIX = 'rwy-settings';\nconst MAX_MUSIC_BYTES = 80 * 1024 * 1024;\n\nlet dbPromise = null;\n\nexport function openLibrary() {\n  if (dbPromise) return dbPromise;\n  dbPromise = new Promise((resolve, reject) => {\n    const request = indexedDB.open(DB_NAME, DB_VERSION);\n    request.onupgradeneeded = () => {\n      const db = request.result;\n      // Version 1/2 stores are kept untouched so the earlier reader's shelf\n      // records remain readable; new records simply carry more fields.\n      if (!db.objectStoreNames.contains('books')) db.createObjectStore('books', { keyPath: 'id' });\n      if (!db.objectStoreNames.contains('settings')) db.createObjectStore('settings', { keyPath: 'id' });\n    };\n    request.onsuccess = () => resolve(request.result);\n    request.onerror = () => reject(request.error);\n  });\n  return dbPromise;\n}\n\nconst wrap = request => new Promise((resolve, reject) => {\n  request.onsuccess = () => resolve(request.result);\n  request.onerror = () => reject(request.error);\n});\n\nexport async function allBooks() {\n  const db = await openLibrary();\n  const items = await wrap(db.transaction('books').objectStore('books').getAll());\n  return items.filter(book => book && book.blob);\n}\n\nexport async function saveBook(book) {\n  const db = await openLibrary();\n  await wrap(db.transaction('books', 'readwrite').objectStore('books').put(book));\n  return book;\n}\n\nexport async function getBook(id) {\n  const db = await openLibrary();\n  return wrap(db.transaction('books').objectStore('books').get(id));\n}\n\nexport async function removeBook(id) {\n  const db = await openLibrary();\n  await wrap(db.transaction('books', 'readwrite').objectStore('books').delete(id));\n  localStorage.removeItem(POSITION_PREFIX + id);\n  localStorage.removeItem(`reader-bookmarks-${id}`);\n}\n\nexport async function findDuplicate(fingerprint) {\n  const books = await allBooks();\n  return books.find(book => book.fingerprint === fingerprint) || null;\n}\n\n// ------------------------------------------------------------------ positions\nexport function readPosition(bookId) {\n  try { return JSON.parse(localStorage.getItem(POSITION_PREFIX + bookId) || 'null'); } catch { return null; }\n}\n\nexport function writePosition(bookId, position) {\n  try { localStorage.setItem(POSITION_PREFIX + bookId, JSON.stringify({ ...position, lastReadAt: Date.now() })); } catch {}\n}\n\nexport function clearPosition(bookId) {\n  localStorage.removeItem(POSITION_PREFIX + bookId);\n}\n\n// ------------------------------------------------------------------- settings\nexport function readSettings() {\n  try {\n    return {\n      speed: 1,\n      voice: 'system',\n      engine: 'auto',\n      fontScale: 1,\n      theme: 'paper',\n      musicLevel: 0.18,\n      ducking: true,\n      ...JSON.parse(localStorage.getItem(SETTINGS_PREFIX) || '{}'),\n    };\n  } catch {\n    return { speed: 1, voice: 'system', engine: 'auto', fontScale: 1, theme: 'paper', musicLevel: 0.18, ducking: true };\n  }\n}\n\nexport function writeSettings(patch) {\n  const next = { ...readSettings(), ...patch };\n  localStorage.setItem(SETTINGS_PREFIX, JSON.stringify(next));\n  return next;\n}\n\n// ------------------------------------------------------------ background music\nexport async function saveBackground(file) {\n  if (file.size > MAX_MUSIC_BYTES) throw new Error('背景音乐文件不能超过 80 MB');\n  if (file.type && !file.type.startsWith('audio')) throw new Error('请选择音频文件');\n  const db = await openLibrary();\n  await wrap(db.transaction('settings', 'readwrite').objectStore('settings').put({\n    id: 'background-audio', name: file.name, type: file.type, blob: file,\n    license: 'user-supplied', updatedAt: Date.now(),\n  }));\n  return { name: file.name, type: file.type };\n}\n\nexport async function readBackground() {\n  const db = await openLibrary();\n  const saved = await wrap(db.transaction('settings').objectStore('settings').get('background-audio'));\n  return saved?.blob instanceof Blob ? saved : null;\n}\n\nexport async function clearBackground() {\n  const db = await openLibrary();\n  await wrap(db.transaction('settings', 'readwrite').objectStore('settings').delete('background-audio'));\n}\n\n// ---------------------------------------------------------------- shelf order\nexport function sortShelf(books) {\n  const stamp = book => {\n    const position = readPosition(book.id);\n    return position ? Number(position.lastReadAt) || 0 : Date.parse(book.addedAt || book.added || 0) || 0;\n  };\n  return [...books].sort((a, b) => {\n    const pa = readPosition(a.id), pb = readPosition(b.id);\n    if (Boolean(pa) !== Boolean(pb)) return pb ? 1 : -1;\n    return stamp(b) - stamp(a);\n  });\n}\n"}]}},{"type":"assistant","uuid":"2f62a73c-e084-4ae6-9f46-5df2917c568b","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"2f62a73c-e084-4ae6-9f46-5df2917c568b","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_uxSQUYP9qUt0LIFkBecD9433","name":"read_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/layout.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":41118,"output_tokens":62,"cache_read_input_tokens":39552,"total_tokens":41180}}},{"type":"user","uuid":"5ade446f-2797-4d06-aa5e-3d9255f26670","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_uxSQUYP9qUt0LIFkBecD9433","is_error":false,"content":"// Keyboard, MediaSession and screen-wake helpers shared by the reader shell.\nexport function shortcutFor(event, layout) {\n  if (event.defaultPrevented) return null;\n  if (event.target.closest?.('input,textarea,select,[contenteditable=\"true\"]')) return null;\n  if (event.metaKey || event.ctrlKey || event.altKey) return null;\n  const key = event.key;\n  if (key === 'ArrowRight' || key === 'PageDown' || key === 'j' || key === 'J') return { action: 'next' };\n  if (key === 'ArrowLeft' || key === 'PageUp' || key === 'k' || key === 'K') return { action: 'prev' };\n  if (key === ' ') return { action: layout === 'scrolled' ? 'page-next' : 'toggle-speech' };\n  if (key === 'Escape') return { action: 'close-panels' };\n  if (key === 'n' || key === 'N') return { action: 'toggle-panel', panel: 'notes' };\n  if (key === 't' || key === 'T') return { action: 'toggle-panel', panel: 'toc' };\n  if (key === 'b' || key === 'B') return { action: 'add-bookmark' };\n  if (key === 'Home') return { action: 'start' };\n  if (['1', '2', '3', '4', '5', '6'].includes(key)) return { action: 'speed', value: 0.4 + Number(key) * 0.2 };\n  return null;\n}\n\nexport function setupMediaSession(handlers) {\n  if (!('mediaSession' in navigator)) return { update() {}, clear() {} };\n  const map = { play: handlers.play, pause: handlers.pause, nexttrack: handlers.next, previoustrack: handlers.prev, stop: handlers.stop };\n  for (const [action, handler] of Object.entries(map)) {\n    try { navigator.mediaSession.setActionHandler(action, handler ? () => handler() : null); } catch {}\n  }\n  return {\n    update(meta = {}) {\n      try {\n        if ('MediaMetadata' in window && meta.title !== undefined) {\n          navigator.mediaSession.metadata = new MediaMetadata({\n            title: meta.title || '', artist: meta.artist || '陪你读书', album: meta.album || '',\n            artwork: meta.artwork ? [{ src: meta.artwork, sizes: '512x512' }] : [],\n          });\n        }\n        if ('playbackState' in navigator.mediaSession) navigator.mediaSession.playbackState = meta.state || 'none';\n      } catch {}\n    },\n    clear() {\n      try {\n        navigator.mediaSession.metadata = null;\n        if ('playbackState' in navigator.mediaSession) navigator.mediaSession.playbackState = 'none';\n      } catch {}\n    },\n  };\n}\n\nexport function keepScreenAwake() {\n  let lock = null;\n  let wanted = false;\n  const acquire = async () => {\n    if (!wanted || lock || document.visibilityState !== 'visible') return;\n    try {\n      if ('wakeLock' in navigator) lock = await navigator.wakeLock.request('screen');\n    } catch {}\n  };\n  const release = () => {\n    wanted = false;\n    try { lock?.release?.(); } catch {}\n    lock = null;\n  };\n  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') acquire(); });\n  return { request() { wanted = true; acquire(); }, release };\n}\n\nexport function timeLabel(seconds) {\n  if (!Number.isFinite(seconds)) return '';\n  const total = Math.max(0, Math.round(seconds));\n  const m = Math.floor(total / 60);\n  const s = String(total % 60).padStart(2, '0');\n  return `${m}:${s}`;\n}\n"}]}},{"type":"assistant","uuid":"3a166305-62d8-44c5-b1e2-9cdc7c6b0044","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"3a166305-62d8-44c