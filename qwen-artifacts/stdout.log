(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#8c654f,#4e3433)}\n.book:nth-child(5n+3) .book-cover{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#67788c,#35465c)}\n.book:nth-child(5n+4) .book-cover{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#8c8159,#575b3e)}\n.book:nth-child(5n+5) .book-cover{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#7d6479,#4a374c)}\n.book-cover::after{content:\"\";position:absolute;inset:12px;border:1px solid rgba(255,255,255,.3);pointer-events:none}\n.book-cover>span{font-family:Georgia,\"Noto Serif SC\",serif;font-size:clamp(17px,1.7vw,23px);line-height:1.45;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}\n.book-cover small{font-size:12px;letter-spacing:.18em;color:#eee7da}.book:hover .book-cover{transform:translateY(-5px)}\n.book-cover.has-image{padding:0;background:#e8e4da}.book-cover.has-image::after{inset:0;border-color:rgba(0,0,0,.1);border-radius:inherit}.book-cover.has-image img{display:block;width:100%;height:100%;object-fit:cover}\n.book-details{display:grid;gap:5px}.book-details strong{font-size:15px;line-height:1.45;overflow-wrap:anywhere}.book-details small{color:var(--muted);font-size:12px}.book-details .toolbar{gap:6px}.book-details button{font-size:12px;padding:6px 8px}\nbutton{background:#fff;border:1px solid #d5ded5}button:hover{border-color:var(--accent)}#importButton,#speak{background:var(--accent);color:#fff;border-color:var(--accent)}\n#readerScreen{max-width:1100px;margin:auto}#readerScreen>.toolbar:first-child{position:sticky;top:0;z-index:10;background:rgba(250,248,242,.96);backdrop-filter:blur(10px);padding:12px 0;border-bottom:1px solid var(--line)}\n#bookTitle{font-family:Georgia,\"Noto Serif SC\",serif;font-size:19px;flex:1}#bookView{background:#fff;border:1px solid var(--line);b