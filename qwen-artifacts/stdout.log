{ keyPath: 'id' });\n      if (!db.objectStoreNames.contains(STORES.consents)) db.createObjectStore(STORES.consents, { keyPath: 'voiceId' });\n      if (!db.objectStoreNames.contains(STORES.stats)) {\n        const stats = db.createObjectStore(STORES.stats, { keyPath: 'bookId' });\n        stats.createIndex('lastAt', 'lastAt', { unique: false });\n      }\n    };\n    req.onsuccess = () => resolve(req.result);\n    req.onerror = () => reject(req.error);\n    req.onblocked = () => reject(new Error('另一个标签页正在升级书库，请关闭其它阅读页后重试'));\n  });\n}\n\nexport const request = r => new Promise((ok, no) => {\n  r.onsuccess = () => ok(r.result);\n  r.onerror = () => no(r.error);\n});\n\nexport class Store {\n  constructor(db, name) { this.db = db; this.name = name; }\n  #os(mode) { return this.db.transaction(this.name, mode).objectStore(this.name); }\n  get(key) { return request(this.#os('readonly').get(key)); }\n  all() { return request(this.#os('readonly').getAll()); }\n  byIndex(index, key) { return request(this.#os('readonly').index(index).getAll(key)); }\n  put(value) { return request(this.#os('readwrite').put(value)); }\n  delete(key) { return request(this.#os('readwrite').delete(key)); }\n  clear() { return request(this.#os('readwrite').clear()); }\n}\n\nexport function readingPosition(bookId) {\n  try { return JSON.parse(localStorage.getItem(LS.pos(bookId)) || 'null'); } catch { return null; }\n}\nexport function saveReadingPosition(bookId, value) {\n  try { localStorage.setItem(LS.pos(bookId), JSON.stringify({ ...value, lastReadAt: Date.now() })); } catch { /* 存储满时静默 */ }\n}\nexport function clearReadingPosition(bookId) {\n  try { localStorage.removeItem(LS.pos(bookId)); } catch { /* ignore */ }\n}\n\nexport function loadBookmarks(bookId) {\n  try {\n    const list = JSON.parse(localStorage.getItem(LS.bookmarks(bookId)) || '[]');\n    return Array.isArray(list) ? list.filter(x => x && typeof x === 'object') : [];\n  } catch { return []; }\n}\nexport function saveBookmarks(bookId, list) {\n  try { localStorage.setItem(LS.bookmarks(bookId), JSON.stringify(list)); } catch { /* ignore */ }\n}\n\nexport function loadReadingSettings() {\n  try { return JSON.parse(localStorage.getItem(LS.readingSettings) || '{}') || {}; } catch { return {}; }\n}\nexport function saveReadingSettings(value) {\n  try { localStorage.setItem(LS.readingSettings, JSON.stringify(value)); } catch { /* ignore */ }\n}\n\nexport function loadAmbientPrefs() {\n  try { return JSON.parse(localStorage.getItem(LS.ambient) || '{}') || {}; } catch { return {}; }\n}\nexport function saveAmbientPrefs(value) {\n  try { localStorage.setItem(LS.ambient, JSON.stringify(value)); } catch { /* ignore */ }\n}\n\nexport function duckingEnabled() {\n  return localStorage.getItem(LS.ducking) !== 'off';\n}\nexport function setDucking(on) {\n  try { localStorage.setItem(LS.ducking, on ? 'on' : 'off'); } catch { /* ignore */ }\n}\n\n// 统计：按本地日期累加阅读时长与听书时长（秒）。\nexport function localDay(ts = Date.now()) {\n  const d = new Date(ts);\n  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\n}\n\nexport function addReadingTime(record, { seconds, listening, day }) {\n  const row = record && typeof record === 'object' ? { ...record } : {};\n  row.days = row.days && typeof row.days === 'object' ? { ...row.days } : {};\n  const cell = row.days[day] && typeof row.days[day] === 'object' ? { ...row.days[day] } : {};\n  cell.readSeconds = Math.max(0, Math.round((cell.readSeconds || 0) + (listening ? 0 : seconds)));\n  cell.listenSeconds = Math.max(0, Math.round((cell.listenSeconds || 0) + (listening ? seconds : 0)));\n  row.days[day] = cell;\n  row.totalReadSeconds = Math.max(0, Math.round((row.totalReadSeconds || 0) + (listening ? 0 : seconds)));\n  row.totalListenSeconds = Math.max(0, Math.round((row.totalListenSeconds || 0) + (listening ? seconds : 0)));\n  return row;\n}\n\nexport function summarizeDays(records, days = 7, today = localDay()) {\n  const out = [];\n  const base = new Date(today + 'T00:00:00');\n  for (let i = days - 1; i >= 0; i--) {\n    const d = new Date(base);\n    d.setDate(d.getDate() - i);\n    const key = localDay(d.getTime());\n    let read = 0, listen = 0;\n    for (const r of records) {\n      const cell = r?.days?.[key];\n      if (!cell) continue;\n      read += Number(cell.readSeconds) || 0;\n      listen += Number(cell.listenSeconds) || 0;\n    }\n    out.push({ day: key, readSeconds: read, listenSeconds: listen });\n  }\n  return out;\n}\n\n// 清空所有读者数据（隐私入口）：书籍、笔记、声音样本、授权、统计与本地设置。\nexport async function eraseEverything(db) {\n  for (const name of ['books', 'settings', 'notes', 'voices', 'consents', 'stats']) {\n    await new Store(db, name).clear();\n  }\n  const keep = ['reader-music-ducking'];\n  for (const key of Object.keys(localStorage)) {\n    if (!keep.includes(key)) localStorage.removeItem(key);\n  }\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/reader/storage.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":52983,"output_tokens":1848,"cache_read_input_tokens":50816,"total_tokens":54831}}},{"type":"user","uuid":"f6d09177-2a83-4d59-8551-c69a4036b913","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_zdWv5gypIE4dNGcnAsyC9463","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/reader/storage.js."}]}},{"type":"assistant","uuid":"1b307b1b-e3e0-4a27-87c5-b5d39be9c662","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"id":"1b307b1b-e3e0-4a27-87c5-b5d39be9c662","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_JS4ZPVsXdJ7WZpUNDE9x3623","name":"write_file","input":{"content":"// 陪你读书 · 家庭声音授权（受控、可撤销、可删除）\n//\n// 产品原则：\n// 1. 未经声音本人明确授权，系统不得保存样本、不得合成。\n// 2. 授权撤销或删除时，样本与派生音色数据当场从本机清除。\n// 3. 本模块只在本机保存「声音指纹特征」（pitch/能量/频谱重心等声学参数），\n//    用于把朗读音色映射到本人可理解的特征；不做声音克隆，不上传任何音频。\n//    未来若接入本地克隆模型，必须先在本文件与 UI 中重新说明并再次取得授权。\n\nexport const CONSENT_VERSION = '2026-10-24.d-reader.family-voice.v1';\n\nexport const CONSENT_ITEMS = [\n  { id: 'record', text: '我知道正在录制我的声音样本，并同意仅用于这个家的读书朗读。' },\n  { id: 'local', text: '我知道样本与声音特征只保存在这台设备的浏览器里，不会上传到服务器。' },\n  { id: 'noClone', text: '我知道当前版本不会克隆我的音色，也不会用我的声音说我没有说过的话。' },\n  { id: 'revoke', text: '我知道我可以随时撤销授权，撤销后样本和音色数据会立即删除。' },\n];\n\nexport const MAX_SAMPLE_SECONDS = 30;\nexport const MIN_SAMPLE_SECONDS = 3;\n\nexport function validateConsent(form) {\n  const missing = CONSENT_ITEMS.filter(item => !form?.[item.id]).map(item => item.id);\n  return { ok: missing.length === 0, missing };\n}\n\nexport function sampleProblem(seconds) {\n  const s = Number(seconds) || 0;\n  if (s < MIN_SAMPLE_SECONDS) return `样本太短（${s.toFixed(1)} 秒），请至少录 ${MIN_SAMPLE_SECONDS} 秒。`;\n  if (s > MAX_SAMPLE_SECONDS) return `样本太长（${s.toFixed(1)} 秒），请控制在 ${MAX_SAMPLE_SECONDS} 秒以内。`;\n  return '';\n}\n\n// 从浮点 PCM 计算可读的声学特征。不做身份识别，只用于展示与调试。\nexport function analyzePcm(samples, sampleRate) {\n  const n = samples?.length || 0;\n  if (!n) return null;\n  let sum = 0, peak = 0, zc = 0;\n  let prev = 0;\n  for (let i = 0; i < n; i++) {\n    const v = samples[i];\n    sum += v * v;\n    if (Math.abs(v) > peak) peak = Math.abs(v);\n    if ((v >= 0) !== (prev >= 0)) zc++;\n    prev = v;\n  }\n  const rms = Math.sqrt(sum / n);\n  const duration = n / sampleRate;\n  const zcr = zc / duration / 2;\n  const voiced = Math.max(0.5, Math.min(2, zcr / 140));\n  return {\n    duration: Number(duration.toFixed(2)),\n    peak: Number(peak.toFixed(3)),\n    rms: Number(rms.toFixed(4)),\n    zeroCrossRate: Math.round(zcr),\n    // 粗略映射到朗读参数：音调偏低 → 语速略慢\n    pitch: Number(voiced.toFixed(2)),\n    rateBias: Number((1.06 - voiced * 0.08).toFixed(2)),\n    analyzedAt: new Date().toISOString(),\n  };\n}\n\nexport function makeVoiceRecord({ name, speaker, relationship, features, consent, sampleMeta }) {\n  const now = new Date().toISOString();\n  const id = 'voice-' + (globalThis.crypto?.randomUUID?.() || Math.random().toString(36).slice(2));\n  return {\n    id,\n    name: String(name || '').trim() || '家人的声音',\n    speaker: String(speaker || '').trim(),\n    relationship: String(relationship || '').trim(),\n    features: features || null,\n    status: 'active',\n    createdAt: now,\n    consent: {\n      ...consent,\n      version: CONSENT_VERSION,\n      acceptedAt: now,\n      items: CONSENT_ITEMS.map(item => item.id),\n    },\n    sampleMeta: sampleMeta || {},\n    usage: { spokenSentences: 0, lastUsedAt: null },\n  };\n}\n\nexport function revokeVoice(record, { reason = '本人撤销授权' } = {}) {\n  if (!record) return null;\n  return {\n    ...record,\n    status: 'revoked',\n    revokedAt: new Date().toISOString(),\n    revokeReason: reason,\n    // 撤销即抹掉样本相关数据，只保留审计所需字段\n    features: null,\n    sampleMeta: {},\n  };\n}\n\nexport function canUseVoice(record) {\n  return !!record && record.status === 'active' && !!record.consent?.revoke;\n}\n\nexport function describeVoice(record) {\n  if (!record) return '';\n  if (record.status === 'revoked') return `${record.name}（已撤销，数据已删除）`;\n  const f = record.features;\n  const detail = f ? ` · 样本 ${f.duration} 秒 · 音调 ${f.pitch}` : '';\n  return `${record.name}${record.relationship ? '（' + record.relationship + '）' : ''}${detail}`;\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/reader/voices.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":54874,"output_tokens":1279,"cache_read_input_tokens":52864,"total_tokens":56153}}},{"type":"user","uuid":"9d076adf-9cf4-4f19-9bf0-cf7d488bc254","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_JS4ZPVsXdJ7WZpUNDE9x3623","is_error":false,"content":"Successfully created and