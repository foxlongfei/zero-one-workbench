ze:14px}\n.panel{background:transparent;border:0;border-radius:0;padding:12px 0;box-shadow:none}\n#shelfScreen>h2{font-size:21px;font-weight:550;margin:20px 0}#shelfScreen>.toolbar{background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 16px;justify-content:space-between}#shelfScreen input[type=search]{min-width:190px;background:#fafaf7;border:0}\n#shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:30px 22px;margin:32px 0}\n.book{display:flex;flex-direction:column;gap:12px;border:0;background:transparent;padding:0;margin:0;min-width:0}\n.book-cover{position:relative;aspect-ratio:3/4.1;border-radius:4px 10px 10px 4px;display:flex;flex-direction:column;justify-content:space-between;padding:22px 17px;color:#f9f4e9;background:linear-gradient(125deg,rgba(255,255,255,.16),transparent 28%),linear-gradient(145deg,#486354,#243e38);box-shadow:inset 5px 0 8px rgba(0,0,0,.2),4px 8px 18px rgba(40,55,43,.17);overflow:hidden;transition:transform .18s ease}\n.book:nth-child(5n+2) .book-cover{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#8c654f,#4e3433)}\n.book:nth-child(5n+3) .book-cover{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#67788c,#35465c)}\n.book:nth-child(5n+4) .book-cover{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#8c8159,#575b3e)}\n.book:nth-child(5n+5) .book-cover{background:linear-gradient(125deg,rgba(255,255,255,.14),transparent 28%),linear-gradient(145deg,#7d6479,#4a374c)}\n.book-cover::after{content:\"\";position:absolute;inset:12px;border:1px solid rgba(255,255,255,.3);pointer-events:none}\n.book-cover>span{font-family:Georgia,\"Noto Serif SC\",serif;font-size:clamp(17px,1.7vw,23px);line-height:1.45;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}\n.book-cover small{font-size:12px;letter-spacing:.18em;color:#eee7da}.book:hover .book-cover{transform:translateY(-5px)}\n.book-cover.has-image{padding:0;background:#e8e4da}.book-cover.has-image::after{inset:0;border-color:rgba(0,0,0,.1);border-radius:inherit}.book-cover.has-image img{display:block;width:100%;height:100%;object-fit:cover}\n.book-details{display:grid;gap:5px}.book-details strong{font-size:15px;line-height:1.45;overflow-wrap:anywhere}.book-details small{color:var(--muted);font-size:12px}.book-details .toolbar{gap:6px}.book-details button{font-size:12px;padding:6px 8px}\nbutton{background:#fff;border:1px solid #d5ded5}button:hover{border-color:var(--accent)}#importButton,#speak{background:var(--accent);color:#fff;border-color:var(--accent)}\n#readerScreen{max-width:1100px;margin:auto}#readerScreen>.toolbar:first-child{position:sticky;top:0;z-index:10;background:rgba(250,248,242,.96);backdrop-filter:blur(10px);padding:12px 0;border-bottom:1px solid var(--line)}\n#bookTitle{font-family:Georgia,\"Noto Serif SC\",serif;font-size:19px;flex:1}#bookView{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;margin:18px 0;min-height:55vh}foliate-view{height:67vh}\n#textView{background:#fff;border:1px solid var(--line);border-radius:14px;padding:clamp(20px,5vw,56px);margin:18px auto;font-family:Georgia,\"Noto Serif SC\",serif;font-size:19px;line-height:2.1;max-width:76ch}\n#readerScreen>.toolbar:last-child{justify-content:center;position:sticky;bottom:0;background:rgba(250,248,242,.96);backdrop-filter:blur(10px);padding:12px 4px;border-top:1px solid var(--line)}\n#position{font-size:13px;color:var(--muted);min-width:120px;text-align:center}#settings,#tocPanel,#bookmarkPanel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px}#bookmarkList{padding-left:20px}#bookmarkList li{margin:.55rem 0}#bookmarkList button{margin-right:.45rem}\n@media(max-width:600px){#shelf{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 14px}.book-cover{padding:18px 12px}.book-details .tool