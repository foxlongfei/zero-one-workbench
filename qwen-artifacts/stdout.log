hes a learner.\n *\n *   node scripts/movement/author-phases.mjs          rewrite phases\n *   node scripts/movement/author-phases.mjs --check  report only, no writes (CI friendly)\n */\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport { phase, reachErrors } from './author-poses.mjs';\n\nconst DATA_PATH = fileURLToPath(new URL('../../portal/data/movement-exercises-v1.json', import.meta.url));\nconst RIG_PATH = fileURLToPath(new URL('../../portal/data/movement-rig-v1.json', import.meta.url));\n\nconst ARM_POLE_DOWN = { armPole_l: [0, -0.2, -0.6], armPole_r: [0, -0.2, -0.6] };\nconst ARM_POLE_BACK = { armPole_l: [0, -0.5, -0.6], armPole_r: [0, -0.5, -0.6] };\nconst LEG_POLE_FORWARD = { legPole_l: [0, 0.35, 1], legPole_r: [0, 0.35, 1] };\n\nconst floor = (part, side, contact = 'LINE') => ({ part, side, contact });\nconst feetLine = [floor('foot', 'l'), floor('foot', 'r')];\nconst handsCircle = [floor('hand', 'l', 'CIRCLE'), floor('hand', 'r', 'CIRCLE')];\n\n/** Everything in this file is authored for the left side and mirrored to the right. */\nexport function mirror(patch) {\n  const flip = (v) => [0, v[1], v[2]];\n  const joints = {};\n  for (const [key, value] of Object.entries(patch.joints || {})) {\n    const other = key.endsWith('_l') ? `${key.slice(0, -2)}_r` : key.endsWith('_r') ? `${key.slice(0, -2)}_l` : null;\n    joints[key] = value;\n    if (other) joints[other] = flip(value);\n  }\n  const ik = {};\n  for (const [key, value] of Object.entries(patch.ik || {})) {\n    const other = key.endsWith('_l') ? `${key.slice(0, -2)}_r` : key.endsWith('_r') ? `${key.slice(0, -2)}_l` : key;\n    ik[key] = flip(value);\n    ik[other] = flip(value);\n  }\n  const hands = patch.hands\n    ? { l: patch.hands.l, r: patch.hands.r || patch.hands.l }\n    : undefined;\n  const feet = patch.feet\n    ? { l: patch.feet.l, r: patch.feet.r || { ...patch.feet.l, toe: flip(patch.feet.l.toe) } }\n    : undefined;\n  return { ..