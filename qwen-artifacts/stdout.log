`);\n    const plan = buildBlocks(exercise, { level });\n    return { exercise, plan, blocks: plan.blocks };\n  });\n\n  let cursor = { exercise: 0, block: 0 };\n  let remaining = 0;\n  let running = false;\n  let reps = 0;\n  let timer = null;\n  const done = [];\n\n  const current = () => sequence[cursor.exercise];\n  const block = () => current()?.blocks[cursor.block] || null;\n\n  function emit(type, payload = {}) {\n    onEvent?.({ type, ...payload });\n  }\n\n  function startTimer() {\n    stopTimer();\n    timer = setInterval(() => {\n      remaining -= 1;\n      if (remaining > 0) {\n        onTick?.(snapshot());\n        return;\n      }\n      advance();\n    }, 1000);\n  }\n\n  function stopTimer() {\n    if (timer) clearInterval(timer);\n    timer = null;\n  }\n\n  function advance() {\n    const seq = current();\n    const finished = block();\n    if (!seq || !finished) return finish();\n    if (finished.kind === 'reps') done.push({ exerciseId: seq.exercise.id, reps: finished.logged ?? 0, holdSeconds: 0, sets: 1 });\n    if (finished.kind === 'hold') done.push({ exerciseId: seq.exercise.id, reps: 0, holdSeconds: finished.target, sets: 1 });\n    cursor.block += 1;\n    if (cursor.block >= seq.blocks.length) {\n      cursor.exercise += 1;\n      cursor.block = 0;\n    }\n    emit('block-change', snapshot());\n    load();\n  }\n\n  function load() {\n    const seq = current();\n    if (!seq) return finish();\n    const b = block();\n    if (!b) return finish();\n    const seconds = b.kind === 'rest' && b.target ? b.target : (b.kind === 'hold' ? b.target : seq.exercise.estimateRepsSeconds?.(b.target) ?? 0);\n    remaining = seconds || 0;\n    reps = 0;\n    emit('block-start', snapshot());\n    if (running && remaining > 0) startTimer();\n  }\n\n  function snapshot() {\n    const seq = current();\n    const b = block();\n    if (!seq || !b) return { finished: true, done };\n    return {\n      exercise: seq.exercise,\n      block: b,\n      remaining,\n      reps,\n      running,\n      total: sequence.length,\n      index: cursor.exercise,\n      progress: sequenceProgress(),\n    };\n  }\n\n  function sequenceProgress() {\n    const seq = current();\n    if (!seq) return 1;\n    const before = sequence.slice(0, cursor.exercise).reduce((n, s) => n + s.blocks.length, 0);\n    const here = before + cursor.block;\n    const all = sequence.reduce((n, s) => n + s.blocks.length, 0);\n    return all ? here / all : 0;\n  }\n\n  function finish() {\n    running = false;\n    stopTimer();\n    emit('finished', { done });\n    onTick?.({ finished: true, done });\n  }\n\n  return {\n    start() {\n      running = true;\n      emit('start', snapshot());\n      load();\n    },\n    pause() {\n      running = false;\n      stopTimer();\n      onTick?.(snapshot());\n    },\n    resume() {\n      running = true;\n      if (remaining > 0) startTimer();\n      onTick?.(snapshot());\n    },\n    skip() {\n      advance();\n    },\n    /** Camera or tap signal: one completed rep on the current work block. */\n    rep() {\n      const b = block();\n      if (!b || b.kind === 'rest') return;\n      reps += 1;\n      emit('rep', { reps, target: b.target });\n      onTick?.(snapshot());\n      if (b.kind === 'reps' && reps >= b.target) advance();\n    },\n    snapshot,\n    stop() {\n      running = false;\n      stopTimer();\n    },\n  };\n}\n\n/**\n * Turn a live pose (33 landmarks normalized) into the depth signal the rep counter uses.\n * Depth is measured on the joint that actually travels: elbow for pushes, hip height for\n * squats. Returns null when the needed landmarks are missing rather than guessing.\n */\nexport function depthFromLandmarks(exercise, landmarks) {\n  const pick = (i) => landmarks[i];\n  const metric = exercise.capacityLoads?.depthMetric || 'elbow';\n  if (metric === 'hipHeight') {\n    const hip = [pick(23), pick(24)].filter((p) => p && p.visibility > 0.5);\n    if (hip.length < 2) return null;\n    const y = (hip[0].y + hip[1].y) / 2;\n    return { value: y, kind: 'normalized-height' };\n  }\n  const shoulder = pick(11), elbow = pick(13), wrist = pick(15);\n  if (!shoulder || !elbow || !wrist) return null;\n  if ([shoulder, elbow, wrist].some((p) => p.visibility < 0.5)) return null;\n  const angle = (a, b, c) => {\n    const u = [a.x - b.x, a.y - b.y], w = [c.x - b.x, c.y - b.y];\n    const dot = u[0] * w[0] + u[1] * w[1];\n    const lu = Math.hypot(...u), lw = Math.hypot(...w) || 1;\n    return Math.acos(Math.max(-1, Math.min(1, dot / (lu * lw)))) * 180 / Math.PI;\n  };\n  return { value: angle(shoulder, elbow, wrist), kind: 'elbow-degrees' };\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/runner.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":54658,"output_tokens":1502,"cache_read_input_tokens":54016,"total_tokens":56160}}},{"type":"user","uuid":"d1005209-6392-48f9-bbcc-be87efc599af","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_OWVJxnZsewIX6hkO1rKn7696","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/runner.js."}]}},{"type":"assistant","uuid":"13b2fa72-a469-4665-a338-c568a5cee653","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"id":"13b2fa72-a469-4665-a338-c568a5cee653","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_YLvZS73FlfQBltQrxt4m6984","name":"read_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/runner.js","offset":60,"limit":40}}],"stop_reason":"tool_use","usage":{"input_tokens":56204,"output_tokens":92,"cache_read_input_tokens":54400,"total_tokens":56296}}},{"type":"user","uuid":"f1e2ceaa-54f9-4eb4-949c-ca6473a32bd3","session_id":"eb902ebe-bf82-46