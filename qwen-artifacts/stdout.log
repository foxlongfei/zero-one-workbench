n still be anatomically wrong, so the angles are asserted, not just eyeballed.\n */\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport { phase, reachErrors, ARM, LEG } from './author-poses.mjs';\n\nconst DATA_PATH = fileURLToPath(new URL('../../portal/data/movement-exercises-v1.json', import.meta.url));\nconst RIG_PATH = fileURLToPath(new URL('../../portal/data/movement-rig-v1.json', import.meta.url));\n\nconst ARM_DOWN = { armPole_l: [0, -0.2, -0.6], armPole_r: [0, -0.2, -0.6] };\nconst ARM_BACK = { armPole_l: [0, -0.5, -0.6], armPole_r: [0, -0.5, -0.6] };\nconst LEG_FORWARD = { legPole_l: [0, 0.35, 1], legPole_r: [0, 0.35, 1] };\nconst LEG_BACK = { legPole_l: [0, 0.4, -1], legPole_r: [0, 0.4, -1] };\nconst LEG_DOWN = { legPole_l: [0, 1, 0], legPole_r: [0, 1, 0] };\nconst LEG_DOWN_BACK = { legPole_l: [0, 1, 0.4], legPole_r: [0, 1, 0.4] };\n\nconst floor = (part, side, contact = 'LINE') => ({ part, side, contact });\nconst feetLine = [floor('foot', 'l'), floor('foot', 'r')];\nconst flatHand = { l: { offset: [0, 0.005, 0], rotation: [-1.35, 0, 0] } };\n\n/** Everything is authored for the left side and mirrored to the right. */\nexport function mirror(patch) {\n  const flip = (v) => [0, v[1], v[2]];\n  const other = (key) => (key.endsWith('_l') ? `${key.slice(0, -2)}_r` : key.endsWith('_r') ? `${key.slice(0, -2)}_l` : key);\n  const joints = {};\n  for (const [key, value] of Object.entries(patch.joints || {})) {\n    joints[key] = value;\n    joints[other(key)] = flip(value);\n  }\n  const ik = {};\n  for (const [key, value] of Object.entries(patch.ik || {})) {\n    ik[key] = flip(value);\n    ik[other(key)] = flip(value);\n  }\n  const hands = patch.hands ? { l: patch.hands.l, r: patch.hands.r || patch.hands.l } : undefined;\n  const feet = patch.feet ? { l: patch.feet.l, r: patch.feet.r || { toe: flip(patch.feet.l.toe) } } : undefined;\n  return { ...patch, joints, ik, hands, feet };\n}\n\nconst P = (o) => phase(o);\n\n/** Push-ups share their shape: slope of the body, hand height, how far the toes reach back. */\nfunction pushUp({ shoulder, wrist, ankle, knee, armPole, ground }) {\n  const up = [0, shoulder[1], shoulder[2] - wrist[2]];\n  const joints = { wrist_l: wrist, ankle_l: ankle };\n  if (knee) joints.knee_l = knee;\n  return P({\n    shoulder,\n    up,\n    joints,\n    ik: { ...armPole, ...(knee ? LEG_DOWN_BACK : LEG_FORWARD) },\n    hands: flatHand,\n    feet: { l: { toe: [ankle[0], 0.02, ankle[2] + 0.12] } },\n    ground,\n  });\n}\n\nconst PHASES = {\n  'push-up': [\n    {\n      label: '支撑位',\n      seq: 0,\n      pose: pushUp({\n        shoulder: [0, 0.52, 0.02],\n        wrist: [-0.2, 0.08, 0.22],\n        ankle: [-0.1, 0.12, -0.48],\n        armPole: ARM_DOWN,\n        ground: [floor('hand', 'l', 'CIRCLE'), floor('foot', 'l')],\n      }),\n    },\n    {\n      label: '下放位',\n      seq: 0.5,\n      pose: pushUp({\n        shoulder: [0, 0.42, 0.06],\n        wrist: [-0.2, 0.08, 0.18],\n        ankle: [-0.1, 0.12, -0.48],\n        armPole: ARM_BACK,\n        ground: [floor('hand', 'l', 'CIRCLE'), floor('foot', 'l')],\n      }),\n    },\n    { label: '回到支撑位', seq: 1, same: '支撑位' },\n  ],\n  'push-up-wall': [\n    {\n      label: '起始',\n      seq: 0,\n      pose: P({\n        shoulder: [0, 1.31, -0.12],\n        up: [0, 1, 0],\n        joints: { wrist_l: [-0.2, 1.2, 0.12], ankle_l: [-0.09, 0.09, -0.24] },\n        ik: { armPole_l: [0, -0.6, -1], armPole_r: [0, -0.6, -1], ...LEG_FORWARD },\n        feet: { l: { toe: [-0.09, 0.02, -0.1] } },\n        ground: feetLine,\n      }),\n    },\n    {\n      label: '贴近墙',\n      seq: 0.5,\n      pose: P({\n        shoulder: [0, 1.28, -0.02],\n        up: [0, 0.99, 0.14],\n        joints: { wrist_l: [-0.2, 1.2, 0.12], ankle_l: [-0.09, 0.09, -0.24] },\n        ik: { armPole_l: [0, -0.6, -1], armPole_r: [0, -0.6, -1], ...LEG_FORWARD },\n        feet: { l: { toe: [-0.09, 0.02, -0.1] } },\n        ground: feetLine,\n      }