:var(--muted);font-size:12px;display:flex;gap:18px;flex-wrap:wrap}\n\n/* ---------------------------------------------------------------- reader */\n#readerScreen{position:fixed;inset:0;background:var(--paper);z-index:40;display:flex;flex-direction:column}\n.reader-bar{display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--line);background:var(--paper-raised);flex-wrap:wrap}\n.reader-bar .book-id{flex:1;min-width:0;display:grid}\n.reader-bar .book-id strong{font-family:var(--font-book);font-weight:500;font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.reader-bar .book-id small{color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.reader-tools{display:flex;gap:6px;flex-wrap:wrap}\n.reader-body{flex:1;min-height:0;display:flex;overflow:hidden}\n.book-area{flex:1;min-width:0;overflow:auto;scroll-behavior:smooth;padding:clamp(18px,4vw,56px) clamp(14px,5vw,60px) 140px}\n.book-flow{max-width:70ch;margin:0 auto;font-size:calc(19px * var(--font-scale,1));line-height:2.05;font-family:var(--font-book)}\n.chapter{margin:0 0 44px}\n.chapter-title{font-size:1.35em;font-weight:600;margin:1.4em 0 .9em;letter-spacing:.04em}\n.chapter-title::after{content:\"\";display:block;width:52px;height:2px;background:var(--warm);margin-top:.5em;opacity:.6}\n.chapter-body p{margin:0 0 1.05em;text-indent:2em;overflow-wrap:anywhere;border-radius:6px;padding:2px 3px;margin-left:-3px;scroll-margin:40vh 0 40vh;transition:background .25s ease}\n.seg.is-position{background:var(--accent-soft)}\n.seg.is-speaking{background:color-mix(in srgb,var(--accent-soft) 70%,var(--warm) 30%);box-shadow:-3px 0 0 var(--warm)}\n.book-paged{display:grid;grid-template-columns:minmax(150px,220px) minmax(0,1fr);gap:24px;max-width:1050px;margin:0 auto;height:100%}\n.paged-toc{list-style:none;margin:0;padding:0 6px 0 0;overflow:auto;border-right:1px solid var(--line)}\n.paged-toc-item{width:100%;text-align:left;border:0;background:transparent;border-radius:8px;padding:8px 10px;font-size:14px;color:var(--muted)}\n.paged-toc-item.is-current{background:var(--accent-soft);color:var(--ink);font-weight:600}\n.paged-page{font-family:var(--font-book);max-width:62ch}\n.paged-heading{font-size:19px;font-weight:600;margin:0 0 18px;display:flex;justify-content:space-between;gap:12px;align-items:baseline}\n.paged-progress{font-size:12px;color:var(--muted);font-family:var(--font-ui);font-weight:400}\n.paged-seg{font-size:calc(24px * var(--font-scale,1));line-height:1.95;margin:0 0 26px;padding:18px 20px;border-radius:14px;background:var(--paper-raised);box-shadow:var(--shadow);overflow-wrap:anywhere}\n.paged-neighbours{display:grid;gap:8px;color:var(--muted);font-size:14px}\n.paged-neighbour{margin:0;cursor:pointer;padding:8px 10px;border-radius:10px;opacity:.75}\n.paged-neighbour:hover{background:var(--accent-soft);opacity:1}\n.playbar{display:flex;align-items:center;gap:10px;padding:10px 16px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--paper-raised);flex-wrap:wrap}\n.playbar .now{flex:1;min-width:150px;display:grid;font-size:12px;color:var(--muted)}\n.playbar .now strong{font-size:14px;color:var(--ink);font-weight:550;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.playbar .engine{padding:3px 9px;border-radius:99px;font-size:11px;background:var(--accent-soft)}\n#speakButton{min-width:104px}\n.progress-line{height:3px;background:var(--line);position:relative}\n.progress-line span{display:block;height:100%;width:0;background:var(--warm);transition:width .3s ease}\n.panel{width:min(400px,92vw);max-width:100%;border-left:1px solid var(--line);background:var(--paper-raised);display:flex;flex-direction:column;overflow:hidden}\n.panel header{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}\n.panel header h3{margin:0;font-family:var(--font-book);font-weight:500;font-size:18px;flex:1}\n.panel .panel-bo