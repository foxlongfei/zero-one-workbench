x dashed var(--line);font-size:14px}.consent-item input{margin-top:3px;width:18px;height:18px;accent-color:var(--accent)}\n.voice-card{border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin:10px 0;background:#fff;display:grid;gap:6px}.voice-card.revoked{opacity:.65}\n.stat-row{display:flex;gap:10px;flex-wrap:wrap}.stat{flex:1;min-width:120px;background:#eef3ec;border-radius:14px;padding:12px}.stat strong{display:block;font-size:22px;font-family:Georgia,serif}.stat small{color:var(--ink-soft)}\n.bars{display:flex;gap:8px;align-items:flex-end;height:110px;margin-top:14px}.bars .bar{flex:1;display:flex;flex-direction:column;justify-content:flex-end;gap:2px;height:100%;font-size:11px;color:var(--ink-soft);text-align:center}.bars .bar i{display:block;background:linear-gradient(180deg,#6c9b7c,#3f6b55);border-radius:6px 6px 0 0;min-height:2px}\n.muted{color:var(--ink-soft);font-size:13px}.danger{color:#9a2f26}\n.hint{background:#f3efe2;border-radius:12px;padding:10px 14px;font-size:13px;color:#5d5540;margin:10px 0}\ndialog{border:0;border-radius:18px;padding:22px;max-width:520px;width:calc(100% - 32px);box-shadow:0 24px 60px rgba(0,0,0,.22);background:var(--card)}dialog::backdrop{background:rgba(25,35,28,.45)}\ndialog h3{margin:0 0 10px}\n@media(max-width:640px){.shelf{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 14px}.cover{padding:16px 11px}.page{max-height:56vh;padding:20px 18px}.reader-bar{gap:6px}.page p{text-indent:0}}\n</style></head>\n<body><main>\n<header class=\"app-header\">\n  <div><a href=\"index.html\" class=\"muted\">← 零一空间</a><h1>陪你读书</h1><div class=\"sub\">读整本，也听整本 · 你的书只留在这台设备</div></div>\n  <div class=\"header-actions\"><button id=\"openImport\">＋ 添加书籍</button><button id=\"openStats\">📊 阅读统计</button><button id=\"openVoices\">🎙 家人声音</button></div>\n</header>\n<input id=\"files\" type=\"file\" accept=\".epub,.mobi,.azw3,.fb2,.cbz,.txt\" multiple hidden>\n<p id=\"status\" class=\"status\" role=\"status\" aria-live=\"polite\">正在准备书库……</p>\n\n<section id=\"shelfScreen\">\n  <div id=\"continueSlot\"></div>\n  <div class=\"shelf-toolbar\">\n    <div class=\"left\"><div class=\"search\">🔍<input id=\"shelfSearch\" type=\"search\" placeholder=\"书名、作者、格式\" aria-label=\"搜索书籍\"></div></div>\n    <div class=\"chips\" role=\"group\" aria-label=\"书架筛选\"><button class=\"chip\" data-filter=\"all\" aria-pressed=\"true\">全部</button><button class=\"chip\" data-filter=\"reading\" aria-pressed=\"false\">在读</button><button class=\"chip\" data-filter=\"finished\" aria-pressed=\"false\">读完</button></div>\n    <span id=\"shelfSummary\" class=\"muted\"></span>\n  </div>\n  <div id=\"shelf\" class=\"shelf\"></div>\n  <p class=\"muted\">支持 EPUB / MOBI / AZW3 / FB2 / CBZ / TXT。请只导入你合法拥有副本的书籍；加密 DRM 书籍暂不支持。</p>\n  <div class=\"hint\">想先试试？<button class=\"ghost\" id=\"addDemo\" style=\"padding:2px 6px\">加入一本内置试读书</button>（本仓库原创测试文本，可直接体验整书朗读、笔记与统计）。</div>\n</section>\n\n<section id=\"readerScreen\" class=\"reader\" hidden>\n  <div class=\"reader-bar\">\n    <button id=\"back\" class=\"ghost\">← 书架</button>\n    <h2 id=\"bookTitle\"></h2>\n    <div class=\"tabs\" role=\"tablist\"><button role=\"tab\" data-tab=\"content\" aria-selected=\"true\">正文</button><button role=\"tab\" data-tab=\"toc\" aria-selected=\"false\">目录</button><button role=\"tab\" data-tab=\"notes\" aria-selected=\"false\">笔记 <span id=\"noteCount\"></span></button><button role=\"tab\" data-tab=\"sound\" aria-selected=\"false\">声音</button></div>\n    <button id=\"bookmarkAdd\" class=\"ghost\" title=\"在当前朗读位置加书签\">🔖</button>\n  </div>\n  <div id=\"tab-content\">\n    <div id=\"bookView\" class=\"page\" role=\"region\" aria-label=\"正文\"></div>\n    <div class=\"serif-left\" id=\"renderMode\"></div>\n  </div>\n  <div id=\"tab-toc\" class=\"panel\" hidden><h3>目录</h3><ol id=\"tocList\" class=\"toc-list\"></ol><div id=\"bookmarkArea\"><h4>书签</h4><ol id=\"bookmarkList\" class=\"toc-list\"></ol><p id=\"bookmarkEmpty\" class=\"muted\">还没有书签。朗读或阅读时点 🔖 即可保存。</p></div></div>\n  <div id=\"tab-notes\" class=\"panel\" hidden>\n    <h3>笔记与交流</h3>\n    <p class=\"muted\">写给自己，也可以把一段心得分享给家人。笔记只保存在本机。</p>\n    <div id=\"quoteBox\" class=\"hint\" hidden><strong>引用：</strong><span id=\"quoteText\"></span> <button class=\"ghost\" id=\"clearQuote\" style=\"padding:0 6px\">清除</button></div>\n    <div class=\"field\"><span>想法 / 问题</span><textarea id=\"noteText\" placeholder=\"读到这一段，我想到了……\"></textarea></div>\n    <div class=\"row-2\"><label class=\"field\"><span>标签（逗号分隔）</span><input id=\"noteTags\" type=\"text\" placeholder=\"例如：孩子、疑问\"></label><label class=\"field\"><span>搜索笔记</span><input id=\"noteSearch\" type=\"search\" placeholder=\"关键词\"></label></div>\n    <div class=\"row-2\"><button id=\"noteSave\" class=\"primary\">保存笔记</button><button id=\"noteCancel\" hidden>取消编辑</button></div>\n    <p id=\"noteStatus\" class=\"muted\" aria-live=\"polite\"></p>\n    <div id=\"noteList\"></div>\n  </div>\n  <div id=\"tab-sound\" class=\"panel\" hidden>\n    <h3>声音</h3>\n    <div class=\"row-2\">\n      <label class=\"field\"><span>朗读声音</span><select id=\"voice\"></select></label>\n      <label class=\"field\"><span>语速 <output id=\"rateOut\">1.0×</output></span><input id=\"rate\" type=\"range\" min=\"0.6\" max=\"1.8\" step=\"0.05\" value=\"1\"></label>\n    </div>\n    <label class=\"field\"><span><input type=\"checkbox\" id=\"autoContinue\" checked> 读完一章后自动继续下一章</span></label>\n    <h4>背景音</h4>\n    <p class=\"muted\">内置音景由浏览器实时合成，不含任何录音素材；也可导入你有权使用本机音频。</p>\n    <div id=\"ambientGrid\" class=\"vibe-grid\"></div>\n    <label class=\"field\"><span>背景音量 <output id=\"volumeOut\">20%</output></span><input id=\"volume\" type=\"range\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.2\"></label>\n    <label class=\"field\"><span><input id=\"ducking\" type=\"checkbox\" checked> 朗读时自动压低背景音</span></label>\n    <label class=\"field\"><span>导入本机背景音</span><input id=\"musicFile\" type=\"file\" accept=\"audio/*\"></label>\n    <div id=\"musicStatus\" class=\"muted\">尚未选择本机背景音</div>\n    <h4>阅读外观</h4>\n    <label class=\"field\"><span>字号 <output id=\"sizeOut\">19px</output></span><input id=\"fontSize\" type=\"range\" min=\"15\" max=\"28\" step=\"1\" value=\"19\"></label>\n    <label class=\"field\"><span>行距 <output id=\"leadingOut\">2.0</output></span><input id=\"leading\" type=\"range\" min=\"1.4\" max=\"2.6\" step=\"0.1\" value=\"2\"></label>\n  </div>\n  <div class=\"narration\" id=\"narration\">\n    <div class=\"row\"><div class=\"meta\" id=\"position\" aria-live=\"polite\"></div><span class=\"now\" id=\"nowSentence\"></span></div>\n    <div class=\"row controls\">\n      <button id=\"prev\" class=\"icon\" title=\"上一章\">⏮</button>\n      <button id=\"back15\" class=\"icon\" title=\"回退 15 秒\">↺</button>\n      <button id=\"speak\" class=\"icon primary\" title=\"朗读 / 暂停\">🔊</button>\n      <button id=\"forward15\" class=\"icon\" title=\"前进 15 秒\">↻</button>\n      <button id=\"next\" class=\"icon\" title=\"下一章\">⏭</button>\n      <input id=\"chapterProgress\" type=\"range\" min=\"0\" max=\"0\" value=\"0\" aria-label=\"本章朗读进度\">\n      <span id=\"chapterTime\" class=\"muted\" style=\"min-width:96px;text-align:right\"></span>\n    </div>\n  </div>\n</section>\n</main>\n\n<dialog id=\"voicesDialog\"><div id=\"voicesBody\"></div><div style=\"display:flex;gap:8px;justify-content:flex-end;margin-top:14px\"><button id=\"closeVoices\">关闭</button></div></dialog>\n<dialog id=\"confirmDialog\"><h3 id=\"confirmTitle\">确认</h3><p id=\"confirmText\"></p><div style=\"display:flex;gap:8px;justify-content:flex-end;margin-top:14px\"><button id=\"confirmNo\">取消</button><button id=\"confirmYes\" class=\"primary\">确定</button></div></dialog>\n<dialog id=\"recordDialog\"><h3>录制声音样本</h3><p class=\"muted\">请声音本人在安静房间里朗读一段话，3–30 秒。录制前请勾选全部授权说明。</p><div id=\"consentList\"></div><div class=\"field\"><span>朗读这段话（示例）</span><textarea id=\"recordScript\">今天我们一起读书。窗外的风很轻，书页在手里慢慢翻过去。</textarea></div><div class=\"row-2\"><button id=\"recordStart\" class=\"primary\">开始录制</button><button id=\"recordStop\" disabled>停止</button></div><p id=\"recordStatus\" class=\"muted\" aria-live=\"polite\"></p><div style=\"display:flex;gap:8px;justify-content:flex-end\"><button id=\"recordCancel\">取消</button><button id=\"recordSave\" class=\"primary\" disabled>保存并启用</button></div></dialog>\n<dialog id=\"statsDialog\"><div id=\"statsBody\"></div><div style=\"display:flex;gap:8px;justify-content:flex-end;margin-top:14px\"><button id=\"closeStats\">关闭</button></div></dialog>\n<script type=\"module\" src=\"reader-app.js\"></script>\n</body></html>\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/reader-integrated.html"}}],"stop_reason":"tool_use","usage":{"input_tokens":63635,"output_tokens":6199,"cache_read_input_tokens":59904,"total_tokens":69834}}},{"type":"user","uuid":"91b20cc5-4fa8-449b-ba2c-20b340ebfa47","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_UhIsDnnYtf5pY8iN11Jy1067","is_error":false,"content":"Successfully overwrote file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/reader-integrated.html. This file was automatically recorded as a workspace artifact with workspacePath \"portal/reader-integrated.html\". No extra artifact registration step is needed."}]}},{"type":"system","subtype":"retry","uuid":"81e3ab5b-3a25-413a-b85b-0f04dbc802c5","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"data":{"reason":"retry","discardedToolCalls":1,"preserveText":false}},{"type":"assistant","uuid":"65aa28fc-4ce4-4b7d-9984-54aee38d8c25","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"id":"65aa28fc-4ce4-4b7d-9984-54aee38d8c25","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_6pL3aMOKmL70siiO9zLx7607","name":"write_file","input":{"content":"import { makeBook } from './vendor/foliate-js/view.js';\nimport { Narrator, sliceParagraphs, estimateMinutes } from './reader/narrator.js';\nimport {\n  openDatabase, Store, STORES, request,\n  readingPosition, saveReadingPosition, clearReadingPosition,\n  loadBookmarks, saveBookmarks, loadReadingSettings, saveReadingSettings,\n  loadAmbientPrefs, saveAmbientPrefs, duckingEnabled, setDucking,\n  addReadingTime, summarizeDays, localDay, eraseEverything,\n} from './reader/storage.js';\nimport { SCENES, SCENE_IDS, AmbientMixer, sceneById } from './reader/ambient.js';\nimport { splitTxtChapters, txtParagraphs, htmlToParagraphs, makeNote, noteMatches, formatDuration } from './reader/text.js';\nimport {\n  CONSENT_ITEMS, CONSENT_VERSION, validateConsent, sampleProblem, analyzePcm,\n  makeVoiceRecord, revokeVoice, canUseVoice, describeVoice,\n} from './reader/voices.js';\n\nconst $ = id => document.getElementById(id);\nconst synth = window.speechSynthesis;\nconst SUPPORTED = ['epub', 'mobi', 'azw3', 'fb2', 'cbz', 'txt'];\nconst statusEl = $('status');\nconst setStatus = (msg, isError = false) => {\n  statusEl.textContent = msg;\n  statusEl.classList.toggle('error', !!isError);\n};\n\nlet db = null;\nlet booksStore = null;\nconst notesStore = () => new Store(db, STORES.notes);\nconst statsStore = () => new Store(db, STORES.stats);\nconst settingsStore = () => new Store(db, STORES.settings);\nconst voicesStore = () => new Store(db, STORES.voices);\nconst consentsStore = () => new Store(db, STORES.consents);\n\nlet books = [];\nlet notesCache = [];\nconst settings = Object.assign({ voiceURI: '', rate: 1, autoContinue: true, fontSize: 19, leading: 2 }, loadReadingSettings());\nconst coverURLs = new Set();\nlet filter = 'all';\nlet draftQuote = null;\nlet editingNoteId = null;\n\n// ---------- 通用 UI ----------\nfunction confirmDialog(title, text, okText = '确定') {\n  return new Promise(resolve => {\n    const dlg = $('confirmDialog');\n    $('confirmTitle').textContent = title;\n    $('confirmText').textContent = text;\n    $('confirmYes').textContent = okText;\n    const done = value => { dlg.close(); cleanup(); resolve(value); };\n    const onYes = () => done(true);\n    const onNo = () => done(false);\n    const cleanup = () => {\n      $('confirmYes').removeEventListener('click', onYes);\n      $('confirmNo').removeEventListener('click', onNo);\n    };\n    $('confirmYes').addEventListener('click', onYes);\n    $('confirmNo').addEventListener('click', onNo);\n    dlg.showModal();\n  });\n}\n\n// ---------- 数据加载 ----------\nasync function loadLibrary() {\n  const all = await booksStore.all();\n  books = all.filter(b => b && b.blob).sort((a, b) => {\n    const ap = readingPosition(a.id), bp = readingPosition(b.id);\n    if (Boolean(ap) !== Boolean(bp)) return bp ? 1 : -1;\n    return (bp?.lastReadAt || Date.parse(b.added || 0) || 0) - (ap?.lastReadAt || Date.parse(a.added || 0) || 0);\n  });\n  notesCache = await notesStore().all();\n}\n\nfunction formatOf(book) {\n  return String(book.format || book.filename?.split('.').pop() || '').toLowerCase();\n}\n\nfunction progressText(book, saved) {\n  if (!saved) return '尚未开始';\n  if (formatOf(book) === 'txt' && Number.isInteger(Number(saved.sentIndex)) === false && saved.chapterIndex != null) {\n    return `第 ${Number(saved.chapterIndex) + 1} 章`;\n  }\n  if (saved.label) return saved.label;\n  if (saved.fraction != null) return `约 ${Math.round(saved.fraction * 100)}%`;\n  return '已有进度';\n}\n\nfunction progressFraction(saved) {\n  if (!saved) return 0;\n  if (Number(saved.fraction) >= 0 && Number(saved.fraction) <= 1) return Number(saved.fraction);\n  return saved.sentIndex != null ? Math.min(0.98, 0.02 + Number(saved.sentIndex) / 1000) : 0;\n}\n\nfunction releaseCovers() {\n  for (const url of coverURLs) URL.revokeObjectURL(url);\n  coverURLs.clear();\n}\n\nfunction matchFilter(book) {\n  const saved = readingPosition(book.id);\n  if (filter === 'reading') return Boolean(saved);\n  if (filter === 'finished') return Boolean(saved?.finished);\n  return true;\n}\n\nfunction bookCard(book, { compact = false } = {}) {\n  const saved = readingPosition(book.id);\n  const el = document.createElement(compact ? 'div' : 'article');\n  el.className = compact ? 'continue-card' : 'book';\n  el.dataset.bookId = book.id;\n  const title = book.title || book.filename || '未命名';\n  const cover = document.createElement('div');\n  cover.className = 'cover';\n  cover.setAttribute('role', 'button');\n  cover.tabIndex = 0;\n  cover.setAttribute('aria-label', `打开《${title}》`);\n  if (book.cover instanceof Blob && book.cover.size) {\n    const url = URL.createObjectURL(book.cover);\n    coverURLs.add(url);\n    cover.classList.add('has-image');\n    const img = document.createElement('img');\n    img.src = url; img.alt = ''; img.loading = 'lazy';\n    cover.append(img);\n  } else {\n    const g = document.createElement('span'); g.className = 'glyph'; g.textContent = title;\n    const f = document.createElement('span'); f.className = 'fmt'; f.textContent = formatOf(book).toUpperCase();\n    cover.append(g, f);\n  }\n  if (saved?.finished) {\n    const b = document.createElement('span'); b.className = 'badge'; b.textContent = '读完';\n    cover.append(b);\n  }\n  const open = () => openBook(book);\n  cover.onclick = open;\n  cover.onkeydown = e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } };\n\n  const meta = document.createElement('div');\n  meta.className = 'book-meta';\n  const strong = document.createElement('strong'); strong.textContent = title;\n  const sub = document.createElement('small');\n  sub.textContent = [book.author, formatOf(book).toUpperCase()].filter(Boolean).join(' · ');\n  const prog = document.createElement('small');\n  prog.dataset.role = 'progress';\n  prog.textContent = progressText(book, saved);\n  const line = document.createElement('div'); line.className = 'progress-line';\n  const fill = document.createElement('i'); fill.style.width = `${Math.round(progressFraction(saved) * 100)}%`;\n  line.append(fill);\n  meta.append(strong, sub, prog);\n  if (!compact) {\n    const actions = document.createElement('div');\n    actions.className = 'book-actions';\n    const read = document.createElement('button'); read.dataset.action = 'open'; read.type = 'button';\n    read.textContent = saved ? '继续' : '阅读';\n    read.onclick = e => { e.stopPropagation(); open(); };\n    const reset = document.createElement('button'); reset.type = 'button'; reset.dataset.action = 'reset';\n    reset.textContent = '从头'; reset.hidden = !saved;\n    reset.onclick = e => { e.stopPropagation(); resetProgress(book); };\n    const del = document.createElement('button'); del.type = 'button'; del.dataset.action = 'delete';\n    del.textContent = '删除';\n    del.onclick = e => { e.stopPropagation(); removeBook(book); };\n    actions.append(read, reset, del);\n    meta.append(line, actions, ...[]);\n    el.append(cover, meta);\n    return el;\n  }\n  meta.append(line);\n  const actions = document.createElement('div');\n  actions.className = 'book-actions';\n  actions.style.marginTop = '8px';\n  const cont = document.createElement('button'); cont.className = 'primary'; cont.textContent = '继续阅读';\n  cont.onclick = open;\n  actions.append(cont);\n  meta.append(actions);\n  el.append(cover, meta);\n  const body = document.createElement('div');\n  body.className = 'body';\n  body.append(document.createElement('div'));\n  body.firstChild.append(...meta.childNodes);\n  const h3 = document.createElement('h3'); h3.textContent = title;\n  body.firstChild.prepend(h3);\n  const head = document.createElement('div'); head.className = 'muted'; head.textContent = '上一次读到这里';\n  body.prepend(head);\n  return body;\n}\n\nfunction renderShelf() {\n  const query = $('shelfSearch').value.trim().toLocaleLowerCase('zh-CN');\n  releaseCovers();\n  const visible = books.filter(b => matchFilter(b) && (!query || `${b.title || ''} ${b.author || ''} ${b.filename || ''} ${formatOf(b)}`.toLocaleLowerCase('zh-CN').includes(query)));\n  const shelf = $('shelf');\n  shelf.replaceChildren(...visible.map(b => bookCard(b)));\n  $('shelfSummary').textContent = `共 ${visible.length} 本 · 笔记 ${notesCache.length} 条`;\n  if (!books.length) {\n    const empty = document.createElement('div');\n    empty.className = 'empty';\n    empty.textContent = '书架还是空的。点右上角「＋ 添加书籍」导入 EPUB / TXT，或先加入内置试读书。';\n    shelf.replaceChildren(empty);\n  } else if (!visible.length) {\n    const empty = document.createElement('div');\n    empty.className = 'empty';\n    empty.textContent = query ? `没有找到“${$('shelfSearch').value.trim()}”` : '这个筛选下还没有书。';\n    shelf.replaceChildren(empty);\n  }\n  renderContinue();\n}\n\nfunction renderContinue() {\n  const slot = $('continueSlot');\n  slot.replaceChildren();\n  const last = books\n    .map(b => ({ b, saved: readingPosition(b.id) }))\n    .filter(x => x.saved && !x.saved.finished)\n    .sort((a, b) => (b.saved.lastReadAt || 0) - (a.saved.lastReadAt || 0))[0];\n  if (!last) return;\n  const card = bookCard(last.b, { compact: true });\n  const label = document.createElement('div');\n  label.className = 'muted';\n  label.textContent = `上次 ${new Date(last.saved.lastReadAt || Date.now()).toLocaleString('zh-CN')} · ${progressText(last.b, last.saved)}`;\n  card.querySelector('.body').prepend(label);\n  slot.append(card);\n}\n\nasync function resetProgress(book) {\n  const title = book.title || book.filename;\n  if (!(await confirmDialog('从头开始', `清除《${title}》的阅读位置和朗读进度？书签与笔记会保留。`, '清除进度'))) return;\n  clearReadingPosition(book.id);\n  await renderShelf();\n  setStatus(`已清除《${title}》的进度`);\n}\n\nasync function removeBook(book) {\n  const title = book.title || book.filename;\n  const noteCount = notesCache.filter(n => n.bookId === book.id).length;\n  if (!(await confirmDialog('从书架删除', `删除《${title}》？${noteCount ? `这本书的 ${noteCount} 条笔记也会一起删除。` : ''}`, '删除'))) return;\n  await booksStore.delete(book.id);\n  for (const n of notesCache.filter(n => n.bookId === book.id)) await notesStore().delete(n.id);\n  clearReadingPosition(book.id);\n  try { localStorage.removeItem('reader-bookmarks-' + book.id); } catch { /* ignore */ }\n  await statsStore().delete(book.id);\n  await loadLibrary();\n  renderShelf();\n  setStatus(`已删除《${title}》`);\n}\n\nfunction metadataText(v) {\n  if (typeof v === 'string') return v.trim();\n  if (Array.isArray(v)) return v.map(metadataText).find(Boolean) || '';\n  if (v && typeof v === 'object') return Object.values(v).map(metadataText).find(Boolean) || '';\n  return '';\n}\n\nasync function fingerprint(file) {\n  if (!crypto?.subtle) return `${file.name}:${file.size}:${file.lastModified}`;\n  const bytes = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());\n  return [...new Uint8Array(bytes)].map(x => x.toString(16).padStart(2, '0')).join('');\n}\n\nasync function inspectBook(file) {\n  let parsed;\n  try {\n    parsed = await makeBook(file);\n    const title = metadataText(parsed.metadata?.title);\n    const author = metadataText(parsed.metadata?.author);\n    const cover = await parsed.getCover?.();\n    return { title, author, cover: cover instanceof Blob && cover.size ? cover : null, toc: parsed.toc || [] };\n  } catch (err) {\n    console.warn('无法预读书籍元数据', err);\n    return {};\n  } finally { parsed?.destroy?.(); }\n}\n\nasync function importFiles(fileList) {\n  let imported = 0, dup = 0, skipped = 0, failed = 0;\n  const errors = [];\n  for (const file of fileList) {\n    try {\n      const ext = file.name.split('.').pop().toLowerCase();\n      if (!SUPPORTED.includes(ext)) { skipped++; continue; }\n      if (ext === 'txt' && !(await file.text()).trim()) { skipped++; errors.push(`${file.name}: 空白 TXT`); continue; }\n      const digest = await fingerprint(file);\n      if (books.some(b => b.fingerprint === digest)) { dup++; continue; }\n      const meta = ext === 'txt' ? {} : await inspectBook(file);\n      const record = {\n        id: 'local-' + crypto.randomUUID(),\n        title: meta.title || file.name.replace(/\\.[^.]+$/, ''),\n        author: meta.author || '',\n        cover: meta.cover || null,\n        format: ext,\n        filename: file.name,\n        size: file.size,\n        fingerprint: digest,\n        blob: file,\n        local: true,\n        added: new Date().toISOString(),\n      };\n      await booksStore.put(record);\n      imported++;\n      await loadLibrary();\n      renderShelf();\n    } catch (err) {\n      failed++;\n      errors.push(`${file.name}: ${err?.message || err}`);\n    }\n  }\n  const notes = [];\n  if (dup) notes.push(`${dup} 本已在书架`);\n  if (skipped) notes.push(`跳过 ${skipped} 个文件`);\n  if (failed) notes.push(`${failed} 本失败：${errors.slice(0, 2).join('；')}`);\n  setStatus(`已导入 ${imported} 本${notes.length ? '；' + notes.join('；') : ''}`, failed > 0);\n}\n\n$('openImport').onclick = () => $('files').click();\n$('files').onchange = async e => {\n  try { await importFiles(e.target.files); } finally { e.target.value = ''; }\n};\n$('shelfSearch').addEventListener('input', renderShelf);\ndocument.querySelectorAll('[data-filter]').forEach(btn => btn.addEventListener('click', () => {\n  filter = btn.dataset.filter;\n  document.querySelectorAll('[data-filter]').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));\n  renderShelf();\n}));\n\n$('addDemo').onclick = async () => {\n  try {\n    const res = await fetch('test-books/zero-one-full-book-test.txt');\n    if (!res.ok) throw new Error('HTTP ' + res.status);\n    const text = await res.text();\n    const file = new File([text], '零一·整书朗读试读.txt', { type: 'text/plain' });\n    await importFiles([file]);\n  } catch (err) {\n    setStatus('无法加入试读书：' + err.message, true);\n  }\n};\n\n// ---------- 阅读器状态 ----------\nlet active = null;               // 当前书籍\nlet activeView = null;           // foliate-view（非 TXT）\nlet chapters = [];               // [{title, paragraphs:[...], href?, index}]\nlet chapterIndex = 0;\nlet sentences = [];              // 当前章节句子\nlet sentIndex = 0;\nlet foliateSection = 0;\nlet foliateParagraphs = [];\nlet readingSeconds = 0;\nlet listeningSeconds = 0;\nlet sessionTimer = null;\nlet openRun = 0;\nlet textMode = false;\nlet voiceRecords = [];\n\nfunction currentSentencesForSpeech() {\n  return sentences;\n}\n\nconst narrator = new Narrator({\n  speak(sentence, done, fail, run) {\n    if (!synth) { fail(new Error('当前浏览器不支持语音朗读')); return; }\n    const u = new SpeechSynthesisUtterance(sentence.text);\n    u.lang = /[\\u4e00-\\u9fff]/.test(sentence.text) ? 'zh-CN' : 'en-US';\n    u.rate = Number(settings.rate) || 1;\n    const voice = pickVoice();\n    if (voice) u.voice = voice;\n    u.onend = () => {\n      if (selectorMatchesRun(run)) done();\n    };\n    u.onerror = e => {\n      if (e.error === 'interrupted' || e.error === 'canceled') return;\n      fail(new Error(e.error || '朗读失败'));\n    };\n    window.__lastUtterance = u;\n    synth.speak(u);\n  },\n  cancel() { try { synth?.cancel(); } catch { /* ignore */ } },\n  pause() { try { synth?.pause(); } catch { /* ignore */ } },\n  resume() { try { synth?.resume(); } catch { /* ignore */ } },\n});\n\n// 朗读器内部 token 每次被 seek/stop 递增，用于丢弃旧回调\nlet selectorRun = 0;\nnarrator.addEventListener('load', () => { selectorRun++; });\nfunction selectorMatchesRun(run) {\n  return run === narratorRun();\n}\nfunction narratorRun() {\n  return selectorRun + narratorIndex();\n}\nfunction narratorIndex() {\n  return narrator.index;\n}\n\nfunction pickVoice() {\n  const all = synth?.getVoices?.() || [];\n  let v = all.find(x => x.voiceURI === settings.voiceURI);\n  if (!v) v = all.find(x => x.lang?.toLowerCase().startsWith('zh'));\n  return v || all[0] || null;\n}\n\nnarrator.addEventListener('statechange', () => {\n  const speaking = narrator.state === 'speaking';\n  ambient.setSpeaking(speaking);\n  updateNarrationUI();\n  trackListening(speaking);\n});\nnarrator.addEventListener('position', e => {\n  sentIndex = e.detail.index;\n  highlightParagraph(e.detail.sentence?.paragraphIndex);\n  updateNarrationUI();\n  persistProgress();\n});\nnarrator.addEventListener('ended', async () => {\n  if (settings.autoContinue) await goChapter(chapterIndex + 1, { autoplay: true, sentence: 0 });\n});\nnarrator.addEventListener('error', e => {\n  setStatus('朗读中断：' + (e.detail.error?.message || e.detail.error) + '。可以点 🔊 从当前句继续。', true);\n});\n\nfunction updateNarrationUI() {\n  const state = narrator.state;\n  $('speak').textContent = state === 'speaking' ? '⏸' : state === 'paused' ? '▶' : '🔊';\n  $('speak').setAttribute('aria-label', state === 'speaking' ? '暂停朗读' : state === 'paused' ? '继续朗读' : '开始朗读');\n  const cur = narrator.current;\n  $('nowSentence').textContent = cur ? `「${cur.text.slice(0, 28)}${cur.text.length > 28 ? '…' : ''}」` : '';\n  const range = $('chapterProgress');\n  range.max = String(Math.max(0, sentences.length - 1));\n  range.value = String(Math.min(sentIndex, sentences.length - 1));\n  const total = sentences.length;\n  $('chapterTime').textContent = total ? `${sentIndex + 1} / ${total} 句` : '';\n}\n\nfunction highlightParagraph(pIndex) {\n  const view = $('bookView');\n  view.querySelectorAll('p.active').forEach(p => p.classList.remove('active'));\n  if (pIndex == null) return;\n  const target = view.querySelector(`p[data-p=\"${pIndex}\"]`);\n  if (target) {\n    target.classList.add('active');\n    target.scrollIntoView({ block: 'center', behavior: 'smooth' });\n  }\n}\n\nfunction persistProgress() {\n  if (!active) return;\n  const saved = {\n    chapterIndex, href: active.href, section: foliateSection, cfi: active.cfi,\n    sentIndex, label: chapters[chapterIndex]?.title || active.label || '',\n    fraction: chapters.length ? Math.min(1, (chapterIndex + (sentences.length ? sentIndex / sentences.length : 0)) / chapters.length) : (active.fraction || 0),\n    finished: active.finished,\n  };\n  saveReadingPosition(active.id, saved);\n}\n\nfunction trackListening(on) {\n  if (on) {\n    if (!sessionTimer) sessionTimer = setInterval(() => { listeningSeconds += 30; }, 30000);\n  } else if (sessionTimer) {\n    clearInterval(sessionTimer); sessionTimer = null;\n  }\n}\n\nasync function flushStats() {\n  if (!active || (!readingSeconds && !listeningSeconds)) return;\n  try {\n    const prev = await statsStore().get(active.id);\n    const next = addReadingTime(prev || { bookId: active.id }, { seconds: 0, day: localDay() });\n    next.bookId = active.id;\n    next.title = active.title;\n    next.lastAt = Date.now();\n    next.days = next.days || {};\n    const cell = next.days[localDay()] || {};\n    cell.readSeconds = (cell.readSeconds || 0) + Math.round(readingSeconds);\n    cell.listenSeconds = (cell.listenSeconds || 0) + Math.round(listeningSeconds);\n    next.days[localDay()] = cell;\n    next.totalReadSeconds = Object.values(next.days).reduce((s, d) => s + (d.readSeconds || 0), 0);\n    next.totalListenSeconds = Object.values(next.days).reduce((s, d) => s + (d.listenSeconds || 0), 0);\n    await statsStore().put(next);\n  } catch (err) { console.warn('统计写入失败', err); }\n  readingSeconds = 0; listeningSeconds = 0;\n}\n\n// ---------- 打开书籍 ----------\nfunction showShelf() {\n  openRun++;\n  narrator.stop();\n  ambient.setSpeaking(false);\n  activeView?.close?.();\n  activeView?.remove?.();\n  activeView = null;\n  active = null;\n  $('readerScreen').hidden = true;\n  $('shelfScreen').hidden = false;\n  releaseCovers();\n  renderShelf();\n}\n\n$('back').onclick = () => { flushStats().finally(showShelf); };\n\nasync function openBook(book) {\n  const run = ++openRun;\n  narrator.stop();\n  activeView?.close?.();\n  activeView?.remove?.();\n  activeView = null;\n  active = { ...book };\n  chapterIndex = 0; sentIndex = 0; sentences = []; chapters = []; foliateSection = 0;\n  readingSeconds = 0; listeningSeconds = 0;\n  $('shelfScreen').hidden = true;\n  $('readerScreen').hidden = false;\n  $('bookTitle').textContent = active.title || active.filename;\n  $('bookView').replaceChildren();\n  selectTab('content');\n  $('noteSearch').value = '';\n  draftQuote = null; editingNoteId = null;\n  renderNotes();\n  renderBookmarks();\n  updateNarrationUI();\n  const saved = readingPosition(book.id);\n  try {\n    if (formatOf(book) === 'txt') {\n      textMode = true;\n      $('renderMode').textContent = '本地 TXT · 按章节分页';\n      await openTxt(book, saved, run);\n    } else {\n      textMode = false;\n      $('renderMode').textContent = 'foliate-js 排版引擎 · 支持 EPUB / MOBI / AZW3 / FB2 / CBZ';\n      await openFoliate(book, saved, run);\n    }\n  } catch (err) {\n    console.error(err);\n    if (run === openRun) {\n      setStatus(`打开《${book.title || book.filename}》失败：${err.message}`, true);\n      showShelf();\n    }\n  }\n}\n\nasync function openTxt(book, saved, run) {\n  const text = await book.blob.text();\n  if (run !== openRun) return;\n  const split = splitTxtChapters(text);\n  chapters = split.map(c => ({ title: c.title, paragraphs: txtParagraphs(c.text) }));\n  if (!chapters.length) chapters = [{ title: '全文', paragraphs: [] }];\n  renderToc();\n  const start = Math.max(0, Math.min(Number(saved?.chapterIndex) || 0, chapters.length - 1));\n  await goChapter(start, { sentence: Number(saved?.sentIndex) || 0 });\n  setStatus(`已打开《${book.title}》· ${chapters.length} 章`);\n}\n\nasync function openFoliate(book, saved, run) {\n  const view = document.createElement('foliate-view');\n  activeView = view;\n  $('bookView').append(view);\n  view.style.height = '100%';\n  view.addEventListener('relocate', e => {\n    if (run !== openRun || !e.detail) return;\n    const { cfi, tocItem, fraction } = e.detail;\n    foliateSection = view.renderer?.getContents?.()?.[0]?.index ?? foliateSection;\n    if (cfi) active.cfi = cfi;\n    if (tocItem?.label) active.label = tocItem.label;\n    if (fraction != null) active.fraction = fraction;\n    persistReadSeconds();\n    persistProgress();\n    updatePosition();\n  });\n  await view.open(book.blob);\n  if (run !== openRun) { view.close(); view.remove(); return; }\n  activeView = view;\n  const toc = view.book?.toc || [];\n  chapters = flattenToc(toc);\n  if (!chapters.length) {\n    chapters = (view.book?.sections || []).map((s, i) => ({ title: `第 ${i + 1} 节`, href: s.id ?? i, section: i }));\n  }\n  renderToc();\n  try {\n    await view.init({ lastLocation: saved?.cfi || null, showTextStart: true });\n  } catch (err) {\n    console.warn('恢复位置失败，回到书首', err);\n    try { await view.goToTextStart(); } catch { /* ignore */ }\n  }\n  if (run !== openRun) return;\n  foliateSection = view.renderer?.getContents?.()?.[0]?.index ?? 0;\n  chapterIndex = sectionToChapter(foliateSection);\n  await loadFoliateSection({ sentence: Number(saved?.sentIndex) || 0 });\n  setStatus(`已打开《${book.title}》· ${chapters.length} 章`);\n}\n\nfunction flattenToc(items, depth = 0, out = []) {\n  for (const item of items || []) {\n    const label = item.label || '';\n    out.push({ title: `${'　'.repeat(depth)}${label}`, href: item.href, section: item.subitems?.length ? undefined : out.length });\n    if (item.subitems?.length) flattenToc(item.subitems, depth + 1, out);\n  }\n  return out;\n}\n\nfunction sectionToChapter(section) {\n  const direct = chapters.findIndex(c => c.section === section);\n  if (direct >= 0) return direct;\n  // 目录项未显式标注 section 时，按 href 在 spine 中定位\n  const spine = activeView?.book?.sections || [];\n  const href = spine[section]?.id;\n  const byHref = chapters.findIndex(c => c.href != null && String(c.href) === String(href));\n  return byHref >= 0 ? byHref : 0;\n}\n\nasync function loadFoliateSection({ sentence = 0 } = {}) {\n  const section = activeView?.book?.sections?.[foliateSection];\n  if (!section) throw new Error('章节不存在');\n  const doc = await section.createDocument();\n  foliateParagraphs = htmlToParagraphs(doc.documentElement.innerHTML);\n  chapters[chapterIndex].paragraphs = foliateParagraphs;\n  buildChapter({ sentence });\n}\n\nfunction buildChapter({ sentence = 0 } = {}) {\n  const chapter = chapters[chapterIndex] || { title: '', paragraphs: [] };\n  sentences = sliceParagraphs(chapter.paragraphs).map(s => ({\n    ...s,\n    href: chapter.href,\n    section: foliateSection,\n    chapterIndex,\n  }));\n  narrator.load(sentences, sentence);\n  sentIndex = Math.min(sentence, Math.max(0, sentences.length - 1));\n  renderToc();\n  updatePosition();\n  updateNarrationUI();\n  persistProgress();\n}\n\nfunction renderToc() {\n  const list = $('tocList');\n  list.replaceChildren();\n  chapters.forEach((c, i) => {\n    const li = document.createElement('li');\n    const b = document.createElement('button');\n    b.type = 'button';\n    b.textContent = c.title || `第 ${i + 1} 章`;\n    if (i === chapterIndex) b.classList.add('current');\n    b.onclick = () => goChapter(i);\n    li.append(b);\n    list.append(li);\n  });\n}\n\nfunction updatePosition() {\n  const chapter = chapters[chapterIndex];\n  const when = textMode\n    ? `${chapterIndex + 1} / ${chapters.length} 章`\n    : active?.cfi ? `${chapter?.title || ''}`.trim() || '阅读中' : '';\n  const pct = chapters.length ? Math.round(((chapterIndex + (sentences.length ? sentIndex / sentences.length : 0)) / chapters.length) * 100) : 0;\n  $('position').textContent = `${when}${when ? ' · ' : ''}${pct}% · 约剩 ${estimateMinutes((chapters.length - chapterIndex - 1) * 400)} 分钟`;\n}\n\nasync function goChapter(index, { autoplay = false, sentence = 0 } = {}) {\n  if (!active) return;\n  if (index < 0) { setStatus('已经是第一章'); return; }\n  if (index >= chapters.length) {\n    narrator.stop();\n    active.finished = true;\n    persistProgress();\n    setStatus(`《${active.title}》已读完全书，可以在书架看到「读完」。`);\n    return;\n  }\n  await flushStats();\n  narrator.stop();\n  const chapter = chapters[index];\n  chapterIndex = index;\n  sentIndex = sentence;\n  if (textMode) {\n    renderChapterHtml();\n    buildChapter({ sentence });\n  } else {\n    const target = chapter.href;\n    if (target != null) await activeView.goTo