bookmarkPanel').hidden=true;status(`已跳转到书签：${item.label||'保存的位置'}`)}catch(e){status(`书签跳转失败：${e.message}；可删除后重新添加`)}};remove.type='button';remove.dataset.action='delete-bookmark';remove.textContent='删除';remove.setAttribute('aria-label','删除书签 '+jump.textContent);remove.onclick=()=>{writeBookmarks(readBookmarks().filter(x=>x.id!==item.id));renderBookmarks();status(`已删除书签：${item.label||'保存的位置'}`)};li.append(jump,remove);$('bookmarkList').append(li)}}\nfunction addBookmark(){const pos=getPos();if(!active||!pos||(view&&!pos.cfi)){status('当前位置尚未就绪，请翻页或等待正文载入后再添加书签');return}const item={id:crypto.randomUUID(),createdAt:Date.now(),label:pos.label||$('position').textContent||'保存的位置',...(view?{cfi:pos.cfi}:{index:textIndex})};const items=readBookmarks();const same=view?items.some(x=>x.cfi===item.cfi):items.some(x=>Number(x.index)===textIndex);if(same){status('当前位置已有书签');return}items.push(item);writeBookmarks(items);renderBookmarks();status(`已添加书签：${item.label}`)}\nfunction addToc(items,depth=0){if(!items||depth>8)return;for(const item of items){const li=document.createElement('li'),b=document.createElement('button'),label=item.label||item.title||'章节';b.textContent='　'.repeat(depth)+label;b.onclick=async()=>{stop();const target=view;try{await target.goTo(item.href);if(view===target){$('tocPanel').hidden=true;status(`已跳转到 ${label}`)}}catch(e){if(view===target)status(`目录“${label}”跳转失败：${e.message}；可选择其他章节或返回书架`)}};li.append(b);$('tocList').append(li);addToc(item.subitems||item.children,depth+1)}}\nfunction splitTXT(text){const chunks=[];const chapters=text.split(/(?=^\\s*(?:第[一二三四五六七八九十百千0-9]+[章节回卷]|Chapter\\s+\\d+)(?:\\s|$))/gim).filter(Boolean);for(const chapter of chapters){for(let i=0;i<chapter.length;i+=3000)chunks.push(chapter.slice(i,i+3000))}return chunks.length?chunks:['（空文件）']}\nfunction restoredTextIndex(saved,length){const index=Number(saved?.index);return Number.isInteger(index)&&index>=0&&index<length?index:0}\nasync function openBook(b){const run=++openRun;stop();view?.close();view?.remove();view=null;active=b;$('shelfScreen').hidden=true;$('readerScreen').hidden=false;$('bookTitle').textContent=b.title||b.filename;$('tocButton').disabled=true;$('tocList').replaceChildren();$('tocPanel').hidden=true;$('bookmarkPanel').hidden=true;renderBookmarks();$('position').textContent='';$('textView').hidden=true;$('textView').replaceChildren();$('bookView').querySelector('foliate-view')?.remove();status('正在打开 '+b.title);\ntry{if(format(b)==='txt'){const contents=await b.blob.text();if(run!==openRun||active!==b)return;textPages=splitTXT(contents);const saved=getPos();textIndex=restoredTextIndex(saved,textPages.length);const recovered=Boolean(saved)&&textIndex!==Number(saved.index);$('textView').hidden=false;renderText();$('tocButton').disabled=false;for(let i=0;i<textPages.length;i++){const li=document.createElement('li'),btn=document.createElement('button');const heading=textPages[i].trim().split('\\n')[0].slice(0,55);btn.textContent=(heading&&/^(第.{1,12}[章节回卷]|Chapter\\s+\\d+)/i.test(heading)?heading:'第 '+(i+1)+' 页');btn.onclick=()=>{stop();textIndex=i;renderText();$('tocPanel').hidden=true};li.append(btn);$('tocList').append(li)}status(recovered?'保存的 TXT 阅读位置已失效，已从第一页打开 '+b.title:'已打开 '+b.title)}else{const nextView=document.createElement('foliate-view');view=nextView;$('bookView').append(nextView);nextView.addEventListener('relocate',e=>{if(run===openRun&&active===b){const cfi=e.detail?.cfi,label=e.detail?.tocItem?.label||'';if(cfi)savePos({cfi,label});$('position').textContent=label||'已保存阅读位置'}});await nextView.open(b.blob);if(run!==openRun||active!==b){nextView.close();nextView.remove();return}addToc(nextView.book?.toc);$('tocButton').disabled=false;const savedCFI=getPos()?.cfi||null;let recovered=false;try{await nextView.init({lastLocation:savedCFI,showTextStart:true})}catch(e){if(!savedCFI)throw e;localStorage.removeItem('reader-pos-'+b.id);updateProgressCard(b,null);await nextView.goToTextStart();recovered=true}if(run===openRun&&active===b)status(recovered?'保存的阅读位置已失效，已从书首打开 '+b.title:'已打开 '+b.title)}}catch(e){if(run===openRun){const title=b.title||b.filename||'未命名';console.error(e);view?.close();view?.remove();view=null;active=null;$('readerScreen').hidden=true;$('shelfScreen').hidden=false;$('tocPanel').hidden=true;$('settings').hidden=true;await refresh();status(`打开《${title}》失败：${e.message}；书籍仍保留在书架，可重新导入或删除`)}}}\nfunction renderText(){$('textView').textContent=textPages[textIndex]||'';$('position').textContent='第 '+(textIndex+1)+' / '+textPages.length+' 页';savePos({index:textIndex})}\n$('tocButton').onclick=()=>{const show=$('tocPanel').hidden;$('tocPanel').hidden=!show;if(show)$('bookmarkPanel').hidden=true};\n$('bookmarkButton').onclick=()=>{renderBookmarks();const show=$('bookmarkPanel').hidden;$('bookmarkPanel').hidden=!show;if(show)$('tocPanel').hidden=true};\n$('bookmarkAdd').onclick=addBookmark;\n$('settingsButton').onclick=()=>$('settings').hidden=!$('settings').hidden;\nasync function page(direction){stop();if(view){const target=view,label=direction>0?'下一页':'上一页';try{await(direction>0?target.next():target.prev());if(view===target)status('已翻到'+label)}catch(e){if(view===target)status(`${label}加载失败：${e.message}；可重试、使用目录或返回书架`)}}else if(active){textIndex=Math.min(textPages.length-1,Math.max(0,textIndex+direction));renderText()}}\n$('prev').onclick=()=>page(-1);$('next').onclick=()=>page(1);\nfunction voices(){return synth?.getVoices()||[]}\nfunction refreshVoices(){const all=voices();$('voice').replaceChildren(...all.map((v,i)=>new Option(v.name+' · '+v.lang,String(i))));const zh=all.findIndex(v=>v.lang.toLowerCase().startsWith('zh'));if(zh>=0)$('voice').value=String(zh)}\nrefreshVoices();synth?.addEventListener?.('voiceschanged',refreshVoices);\nfunction speechFailure(e){stop();status(`连续朗读中断：${e.message||e}；可重试、使用目录或返回书架`)}\nasync function speakSection(index,run){if(run!==token||!active)return;let txt='';if(view){const section=view.book?.sections[index];if(!section){stop();status('已朗读到结尾');return}await view.goTo(index);const doc=await section.createDocument();doc.querySelectorAll('script,style,nav').forEach(x=>x.remove());txt=(doc.body||doc.documentElement)?.textContent||''}else{if(index>=textPages.length){stop();status('已朗读到结尾');return}textIndex=index;renderText();txt=textPages[index]}if(run!==token)return;txt=txt.replace(/\\s+/g,' ').trim();if(!txt){await speakSection(index+1,run);return}let offset=0;const pieces=txt.match(/[\\s\\S]{1,550}/g)||[];function nextPiece(){if(run!==token)return;if(offset>=pieces.length){speakSection(index+1,run).catch(speechFailure);return}const u=new SpeechSynthesisUtterance(pieces[offset++]);utter=u;u.lang='zh-CN';u.rate=Number($('rate').value);const v=voices()[Number($('voice').value)];if(v)u.voice=v;u.onend=nextPiece;u.onerror=e=>{stop();status('朗读失败：'+e.error)};synth.speak(u)}nextPiece()}\n$('speak').onclick=async()=>{if(!supported){status('当前浏览器没有语音朗读能力');return}if(speaking){if(synth.paused){synth.resume();syncMusicVolume();$('speak').textContent='⏸ 暂停'}else{synth.pause();syncMusicVolume();$('speak').textContent='▶ 继续'}return}stop();speaking=true;syncMusicVolume();$('speak').textContent='⏸ 暂停';const run=token;try{const index=view?(view.renderer?.getContents()?.[0]?.index??0):textIndex;await speakSection(index,run)}catch(e){speechFailure(e)}};\nfunction setMusicSource(blob,name){const audio=$('music');if(audio.dataset.url)URL.revokeObjectURL(audio.dataset.url);audio.dataset.url=URL.createObjectURL(blob);audio.src=audio.dataset.url;$('musicName').textContent=name||'本机背景音';$('clearMusic').hidden=false;syncMusicVolume()}\nasync function restoreMusic(){const saved=await request(settingsTx().get('background-audio'));if(saved?.blob instanceof Blob&&saved.blob.size)setMusicSource(saved.blob,saved.name)}\n$('musicFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{await libraryReady;await request(settingsTx('readwrite').put({id:'background-audio',name:f.name,type:f.type,blob:f,updatedAt:Date.now()}));setMusicSource(f,f.name);status(`背景音“${f.name}”已保存在本机，下次打开仍可使用`)}catch(err){status(`背景音保存失败：${err.message}`)}finally{e.target.value=''}};\n$('clearMusic').onclick=async()=>{try{await request(settingsTx('readwrite').delete('background-audio'));const audio=$('music');audio.pause();if(audio.dataset.url)URL.revokeObjectURL(audio.dataset.url);delete audio.dataset.url;audio.removeAttribute('src');audio.load();$('musicName').textContent='尚未选择背景音';$('clearMusic').hidden=true;status('已清除本机背景音')}catch(err){status(`背景音清除失败：${err.message}`)}};\n$('volume').oninput=syncMusicVolume;$('ducking').checked=localStorage.getItem('reader-music-ducking')!=='off';$('ducking').onchange=()=>{localStorage.setItem('reader-music-ducking',$('ducking').checked?'on':'off');syncMusicVolume()};syncMusicVolume();\nwindow.addEventListener('pagehide',()=>{stop();clearCoverURLs();if($('music').dataset.url)URL.revokeObjectURL($('music').dataset.url)});\nlibraryReady=openDB().then(async()=>{await refresh();await restoreMusic()}).then(()=>{$('importButton').disabled=false;$('importButton').textContent='＋ 添加电子书'});\nlibraryReady.catch(e=>status('书库不可用：'+e.message));\n"}]}},{"type":"assistant","uuid":"4e1308b3-ed52-42fa-bf30-5f77ce6c0439","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"4e1308b3-ed52-42fa-bf30-5f77ce6c0439","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_TlQEbrjBwkBC8iMlYjBT3597","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && cat portal/read-with-you-v01.html portal/reading-library.html | head -40; echo ====; cat tests/c01-reader/check.mjs | head -60; echo ====; cat tests/c01-reader/make-books.py | head -50; echo ===; head -c 1500 portal/vendor/foliate-js/view.js; echo; wc -l portal/vendor/foliate-js/*.js; grep -n \"version\" portal/vendor/foliate-js/*.js | head","description":"Inspect entry pages, tests, foliate vendor"}}],"stop_reason":"tool_use","usage":{"input_tokens":30827,"output_tokens":195,"cache_read_input_tokens":24704,"total_tokens":31022}}},{"type":"user","uuid":"825e6fb5-657e-40df-ada7-c1da09a50c20","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_TlQEbrjBwkBC8iMlYjBT3597","is_error":false,"content":"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'none'\"><title>陪你读书｜书架</title><style>\n:root{font-family:system-ui,-apple-system,\"Noto Sans SC\",sans-serif;color:#292e29;background:#f3f0e9}*{box-sizing:border-box}body{margin:0}main{max-width:1060px;margin:auto;padding:18px}header{display:flex;align-items:center;justify-content:space-between;gap:12px}h1{font-size:clamp(25px,4vw,38px);margin:18px 0}button,select,input{font:inherit}button{border:1px solid #d3d3c9;background:white;border-radius:10px;padding:10px 14px;cursor:pointer}button:hover{background:#eef1e9}a{color:#245942}section{background:#fff;border:1px solid #e1ded5;border-radius:16px;padding:18px;margin:15px 0}.muted{color:#66706b;font-size:14px}#shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:15px}.book{min-height:205px;background:#e7e3d7;border:1px solid #d1cbbb;border-radius:12px;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;text-align:left;padding:17px;overflow-wrap:anywhere}.book strong{font-size:18px}.toolbar{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.toolbar button{padding:8px 11px}#readerScreen[hidden],#shelfScreen[hidden],#tocPanel[hidden],#settings[hidden]{display:none}#bookView{height:min(73vh,790px);min-height:430px;border-radius:12px;overflow:hidden;background:#fff}foliate-view{display:block;width:100%;height:100%}#textView{font:20px/1.85 Georgia,\"Noto Serif SC\",serif;overflow:auto;height:100%;padding:24px;white-space:pre-wrap}#tocPanel{max-height:50vh;overflow:auto}#tocList{list-style:none;padding:0}#tocList button{display:block;width:100%;text-align:left;margin:4px 0}#status{min-height:1.5em;color:#245942}#settings{background:#f5f5f0}#settings label{display:inline-block;margin:7px}#settings audio{width:100%}@media(max-width:600px){main{padding:10px}section{padding:12px}#bookView{height:73vh}}\n</style></head><body><main><header><a href=\"index.html\">← 零一空间</a><span>陪你读书 · 阅读与聆听</span></header>\n<section id=\"shelfScreen\"><h1>我的书架</h1><p class=\"muted\">选书阅读，轻触喇叭开始朗读。目录、进度、声音与背景音都留在阅读器里。</p><p class=\"muted\">选一本书，进入正文。书籍仅保存在本机浏览器；原有书库可直接使用。</p><div class=\"toolbar\"><label>搜索书名或格式 <input id=\"shelfSearch\" type=\"search\" autocomplete=\"off\" placeholder=\"例如：西游记、EPUB\"></label><span id=\"searchSummary\" class=\"muted\" aria-live=\"polite\"></span></div><label><button id=\"importButton\" type=\"button\" disabled>正在准备书库…</button><input id=\"files\" type=\"file\" accept=\".epub,.mobi,.azw3,.fb2,.cbz,.txt\" multiple hidden></label><p class=\"muted\"><a href=\"test-books/zero-one-full-book-test.txt\" download>下载原创三章测试书（TXT）</a>，导入后可直接验证目录、连续朗读和位置恢复。</p><p class=\"muted\">已接入 foliate-js：EPUB / MOBI / AZW3 / FB2 / CBZ；TXT 使用本地纯文本阅读。加密书籍不支持；PDF 尚未接入。</p><div id=\"shelf\"></div></section>\n<section id=\"readerScreen\" hidden><div class=\"toolbar\"><button id=\"back\">← 书架</button><strong id=\"bookTitle\"></strong><button id=\"tocButton\">☰ 目录</button><button id=\"speak\" aria-label=\"朗读或暂停\">🔊 朗读</button><button id=\"settingsButton\">⚙ 阅读设置</button></div><div id=\"tocPanel\" hidden><h3>目录</h3><ul id=\"tocList\"></ul></div><div id=\"settings\" hidden><label>声音 <select id=\"voice\"></select></label><label>速度 <select id=\"rate\"><option value=\".8\">0.8×</option><option value=\"1\" selected>1×</option><option value=\"1.2\">1.2×</option><option value=\"1.5\">1.5×</option></select></label><p class=\"muted\">使用设备现有声音；个性化声音训练尚未接入。</p><label>背景音乐（本机音频）<input type=\"file\" id=\"musicFile\" accept=\"audio/*\"></label><audio id=\"music\" controls loop></audio><label>背景音量 <input id=\"volume\" type=\"range\" min=\"0\" max=\"0.5\" step=\".05\" value=\".15\"></label></div><div id=\"bookView\" role=\"region\" aria-label=\"电子书正文阅读区\"><div id=\"textView\" hidden></div></div><div class=\"toolbar\"><button id=\"prev\">← 上一页</button><button id=\"next\">下一页 →</button><span id=\"position\" class=\"muted\" aria-live=\"polite\"></span></div></section><p id=\"status\" role=\"status\" aria-live=\"polite\"></p><p class=\"muted\">本机阅读与浏览器朗读；可通过「阅读设置」选择声音、速度及背景音。书籍不会上传。阅读内核：foliate-js（MIT），zip.js（BSD-3-Clause），fflate（MIT）。当前为待验收集成版，尚未通过公开设备及整书朗读测试。</p></main><script type=\"module\" src=\"reader-integrated.js\"></script></body></html>\n<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>陪你读书｜我的书库</title><style>body{font:17px/1.6 system-ui;background:#f6f4ee;color:#26352c;margin:0}main{max-width:980px;margin:auto;padding:24px}section,article{background:#fff;border:1px solid #ddd;border-radius:14px;padding:18px;margin:14px 0}button,input{font:inherit;padding:9px}button{cursor:pointer}small{color:#666}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}a{color:#145b44}</style></head><body><main><p><a href=\"index.html\">← 零一空间唯一入口</a></p><h1>陪你读书｜书库目录</h1><section style=\"border:2px solid #145b44\"><h2>进入整书阅读器</h2><p>完整阅读 EPUB/TXT、目录、朗读及进度恢复，请从这里进入。若新版页面暂时无法打开，此页仍保留原书库功能。</p><p><a href=\"./reader-integrated.html\" style=\"display:inline-block;padding:10px 16px;background:#145b44;color:white;border-radius:8px\">打开整书阅读器 →</a></p></section><p>先建立书籍目录，再接入整本阅读。用户自行导入的书保存在当前浏览器的本地存储中，不上传服务器。仅目录信息可公开，书籍全文不随网页发布。</p><section><h2>用户导入电子书</h2><label>选择 EPUB 或 TXT 文件 <input id=\"files\" type=\"file\" accept=\".epub,.txt,application/epub+zip,text/plain\" multiple></label><p id=\"message\" role=\"status\">EPUB 会尝试读取内置书名与作者；无法读取时使用文件名。仅支持本地文件，不提供云端同步。</p><button id=\"clear\">清除本机导入书籍</button><p><small>导入即保存原始文件于此浏览器的 IndexedDB；浏览器清理站点数据会删除书籍。请自行保留原件。大文件可能超过设备可用存储空间。</small></p></section><h2>书库</h2><div id=\"catalog\" class=\"grid\"></div><section><h2>当前开发边界</h2><p>目录与文件保存功能不代表整书阅读、背景音、家人声音训练已完成。后续从书库进入同一个整书阅读器，保留章节、进度和书名。仅对具有使用权的作品进行个人导入；出版社版本、译文、校注及插图可能仍受版权保护。</p><p><a href=\"read-with-you-v01.html\">现有短文朗读实验 →</a> · <a href=\"v02-control.html\">C01 施工与验收状态 →</a></p></section></main><script>\nconst seed=[{id:'reference-dost',title:'陀思妥耶夫斯基全集（全二十二卷）',authors:'【俄】陀思妥耶夫斯基',language:'zh-CN',format:'EPUB',volumes:'22卷',local:false},{id:'reference-classics',title:'四大名著（彩皮版）：全八册',authors:'曹雪芹、无名氏、程伟元、高鹗、中国艺术研究院红楼梦研究所、罗贯中、施耐庵、吴承恩（EPUB元数据）',publisher:'人民文学出版社（EPUB元数据）',language:'zh',format:'EPUB',volumes:'8册',local:false}];\nconst $=id=>document.getElementById(id);let db;\nfunction openDb(){return new Promise((resolve,reject)=>{const r=indexedDB.open('zero-one-reader-library',1);r.onupgradeneeded=()=>r.result.createObjectStore('books',{keyPath:'id'});r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}\nfunction tx(mode){return db.transaction('books',mode).objectStore('books')}\nfunction all(){return new Promise((resolve,reject)=>{const r=tx('readonly').getAll();r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}\nfunction put(book){return new Promise((resolve,reject)=>{const r=tx('readwrite').put(book);r.onsuccess=resolve;r.onerror=()=>reject(r.error)})}\nfunction del(id){return new Promise((resolve,reject)=>{const r=tx('readwrite').delete(id);r.onsuccess=resolve;r.onerror=()=>reject(r.error)})}\nfunction card(b){const el=document.createElement('article');const h=document.createElement('h3');h.textContent=b.title;el.append(h);const p=document.createElement('p');p.textContent=[b.authors||'作者未识别',b.volumes||'',b.format||'',b.local?'已保存在本机':'示例书目：未存储全文'].filter(Boolean).join(' · ');el.append(p);if(b.local){const btn=document.createElement('button');btn.textContent='导出原文件';btn.onclick=()=>{const u=URL.createObjectURL(b.blob);const a=document.createElement('a');a.href=u;a.download=b.filename;a.click();setTimeout(()=>URL.revokeObjectURL(u),60000)};el.append(btn);const remove=document.createElement('button');remove.textContent='删除本机副本';remove.onclick=async()=>{if(confirm('删除这本书的本机副本？')){await del(b.id);render()}};el.append(remove)}else{const p=document.createElement('p');p.innerHTML='<small>请使用上方文件选择器导入你持有的合法电子书。</small>';el.append(p)}return el}\nasync function render(){const books=await all(),box=$('catalog');box.replaceChildren();[...books,...seed].forEach(b=>box.append(card(b)));$('message').textContent='本机已导入 '+books.length+' 本；示例书目 '+seed.length+' 条。'}\n$('files').onchange=async e=>{let ok=0;for(const f of e.target.files){const ext=f.name.split('.').pop().toLowerCase();if(!['epub','txt'].includes(ext))continue;const title=f.name.replace(/\\.(epub|txt)$/i,'');try{await put({id:'local-'+crypto.randomUUID(),title,authors:'待从文件元数据识别',format:ext.toUpperCase(),filename:f.name,blob:f,local:true,added:new Date().toISOString()});ok++}catch(err){$('message').textContent='保存失败：'+err.message;return}}await render();$('message').textContent='已保存 '+ok+' 本本机电子书；书名目前来自文件名，EPUB内部元数据解析待集成。'}\n$('clear').onclick=async()=>{if(!confirm('清空所有本机导入的电子书？'))return;for(const b of await all())await del(b.id);render()};\nopenDb().then(x=>{db=x;render()}).catch(e=>$('message').textContent='本机书库不可用：'+e.message);\n</script></body></html>====\nimport { chromium } from 'playwright';\nimport { spawn } from 'node:child_process';\nimport { mkdir, writeFile } from 'node:fs/promises';\nimport { resolve } from 'node:path';\nconst server=spawn('python3',['-m','http.server','8765','--bind','127.0.0.1'],{stdio:'ignore'});\nawait new Promise(r=>setTimeout(r,1200));\nconst browser=await chromium.launch({headless:true,args:['--no-sandbox']});\nconst evidence={checks:[],errors:[]};\nconst check=(name,ok,details='')=>{evidence.checks.push({name,pass:!!ok,details});if(!ok)throw Error(name+' failed: '+details)};\ntry{\nconst page=await browser.newPage({viewport:{width:1200,height:900}});\npage.on('pageerror',e=>evidence.errors.push(e.message));\nawait page.addInitScript(()=>{\nwindow.__spoken=[];\nclass Utterance{constructor(text){this.text=text;this.rate=1}}\nwindow.SpeechSynthesisUtterance=Utterance;\nObject.defineProperty(window,'speechSynthesis',{configurable:true,value:{paused:false,cancel(){this.paused=false},pause(){this.paused=true},resume(){this.paused=false},getVoices(){return [{name:'Test Mandarin',lang:'zh-CN',voiceURI:'test'}]},addEventListener(){},speak(u){window.__spoken.push(u.text);setTimeout(()=>u.onend?.(),120)}}});\n});\nawait page.goto('http://127.0.0.1:8765/portal/reader-integrated.html');\nawait page.waitForSelector('#importButton:enabled');\ncheck('shelf visible',await page.locator('#shelfScreen').isVisible());\nawait page.locator('#musicFile').setInputFiles({name:'forest.wav',mimeType:'audio/wav',buffer:Buffer.from('RIFF-test-background-audio')});\nawait page.waitForFunction(()=>document.querySelector('#status')?.textContent.includes('已保存在本机'));\ncheck('background audio saved locally',(await page.locator('#musicName').innerText())==='forest.wav'&&await page.locator('#music').getAttribute('src')?.then(Boolean),await page.locator('#status').innerText());\nawait page.reload();\nawait page.waitForSelector('#importButton:enabled');\ncheck('background audio restored after reload',(await page.locator('#musicName').innerText())==='forest.wav'&&await page.locator('#music').getAttribute('src')?.then(Boolean),await page.locator('#musicName').innerText());\nawait page.locator('#clearMusic').evaluate(button=>button.click());\nawait page.waitForFunction(()=>document.querySelector('#status')?.textContent.includes('已清除本机背景音'));\nawait page.reload();\nawait p