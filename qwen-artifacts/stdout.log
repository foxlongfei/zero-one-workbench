_testInit=proto.init;proto.init=function(options){if(options.lastLocation==='bad-cfi')return Promise.reject(Error('test stale cfi'));return proto.__testInit.call(this,options)}});\nawait epub.locator('[data-action=\"open\"]').click();\nawait page.waitForFunction(()=>document.querySelector('#status')?.textContent.includes('阅读位置已失效'));\ncheck('stale EPUB position falls back to book start',await page.locator('#readerScreen').isVisible()&&(await page.locator('#position').innerText()).includes('第一章'),await page.locator('#status').innerText()+' | '+await page.locator('#position').innerText());\ncheck('stale EPUB position is replaced',await page.evaluate(id=>!localStorage.getItem('reader-pos-'+id)?.includes('bad-cfi'),epubId),await page.evaluate(id=>localStorage.getItem('reader-pos-'+id),epubId));\nawait page.evaluate(()=>{const proto=customElements.get('foliate-view').prototype;proto.init=proto.__testInit;delete proto.__testInit});\nawait page.locator('#back').click();\ncheck('EPUB position exists before delete',await page.evaluate(id=>localStorage.getItem('reader-pos-'+id)!==null,epubId),epubId);\npage.once('dialog',dialog=>dialog.dismiss());\nawait epub.locator('[data-action=\"delete\"]').click();\nawait page.waitForFunction(()=>document.querySelector('#status')?.textContent.includes('已取消删除'));\ncheck('delete cancellation receipt',(await page.locator('#status').innerText()).includes('书籍、阅读位置和书签保持不变'),await page.locator('#status').innerText());\ncheck('cancelled delete keeps EPUB on shelf',await epub.count()===1,await page.locator('#shelf').innerText());\ncheck('cancelled delete keeps EPUB position',await page.evaluate(id=>localStorage.getItem('reader-pos-'+id)!==null,epubId),epubId);\npage.once('dialog',dialog=>dialog.accept());\nawait epub.locator('[data-action=\"delete\"]').click();\nawait page.waitForFunction(id=>!document.querySelector(`#shelf .book[data-book-id=\"${id}\"]`),epubId);\ncheck('EPUB removed from shelf',await epub.count()===0,await page.locator('#shelf').innerText());\ncheck('EPUB position removed with book',await page.evaluate(id=>localStorage.getItem('reader-pos-'+id)===null,epubId),epubId);\nawait page.reload();\nawait page.waitForSelector('#importButton:enabled');\ncheck('deleted EPUB stays removed after reload',await page.locator('#shelf .book').filter({hasText:'EPUB'}).count()===0,await page.locator('#shelf').innerText());\nawait page.locator('#files').setInputFiles(resolve('tests/c01-reader/fixtures/real-book.epub'));\nconst reimportedEpub=page.locator('#shelf .book').filter({hasText:'EPUB'});\nawait page.waitForFunction(()=>document.querySelectorAll('#shelf .book').length===1);\nconst reimportedEpubId=await reimportedEpub.getAttribute('data-book-id');\ncheck('reimport creates a clean EPUB record',reimportedEpubId!==epubId,`${epubId} -> ${reimportedEpubId}`);\nawait reimportedEpub.locator('[data-action=\"open\"]').click();\nawait page.waitForFunction(()=>document.querySelector('#position')?.textContent.includes('第一章'));\ncheck('reimport does not inherit deleted position',!(await page.locator('#position').innerText()).includes('第二章'),await page.locator('#position').innerText());\nawait page.locator('#back').click();\nawait page.locator('#files').setInputFiles(resolve('tests/c01-reader/fixtures/real-book.txt'));\nconst txt=page.locator('#shelf .book').filter({hasText:'TXT'});\nawait txt.locator('[data-action=\"open\"]').click();\nawait page.waitForSelector('#textView:visible');\ncheck('TXT opened',await page.locator('#textView').isVisible());\nawait page.locator('#next').click();\ncheck('TXT pagination',await page.locator('#position').innerText().then(x=>x.includes('2 /')));\nawait page.reload();\nawait page.waitForSelector('#importButton:enabled');\nconst resumedTxt=page.locator('#shelf .book').filter({hasText:'TXT'});\ncheck('most recently read book sorts first',(await page.locator('#shelf .book').first().getAttribute('data-book-id'))===(await resumedTxt.getAttribute('data-book-id')),await page.locator('#sh