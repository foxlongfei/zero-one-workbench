.querySelectorAll('#shelf .book')].find(x=>x.dataset.bookId===book.id);if(!card)return;card.querySelector('[data-role=\"progress\"]').textContent=progressText(book,saved);card.querySelector('[data-action=\"open\"]').textContent=saved?'继续阅读':'阅读';card.querySelector('[data-action=\"reset\"]').hidden=!saved}\nfunction shelfOrder(a,b){const ap=storedPos(a.id),bp=storedPos(b.id);if(Boolean(ap)!==Boolean(bp))return bp?1:-1;const at=Number(ap?.lastReadAt)||Date.parse(a.added||0)||0,bt=Number(bp?.lastReadAt)||Date.parse(b.added||0)||0;return bt-at}\nconst searchText=book=>`${book.title||''} ${book.author||''} ${book.filename||''} ${format(book)}`.toLocaleLowerCase('zh-CN');\nfunction clearCoverURLs(){for(const url of coverURLs)URL.revokeObjectURL(url);coverURLs.clear()}\nfunction renderShelf(){const query=$('shelfSearch').value.trim().toLocaleLowerCase('zh-CN');const visible=query?books.filter(book=>searchText(book).includes(query)):books;clearCoverURLs();$('shelf').replaceChildren();$('searchSummary').textContent=query?`找到 ${visible.length} / ${books.length} 本`:`共 ${books.length} 本`;for(const b of visible){const saved=storedPos(b.id);const card=document.createElement('article');card.className='book';card.dataset.bookId=b.id;const name=document.createElement('strong');name.textContent=b.title||b.filename||'未命名';const meta=document.createElement('small');meta.textContent=[b.author,format(b).toUpperCase()].filter(Boolean).join(' · ');const progress=document.createElement('small');progress.dataset.role='progress';progress.textContent=progressText(b,saved);const actions=document.createElement('div');actions.className='toolbar';const open=document.createElement('button');open.type='button';open.dataset.action='open';open.textContent=saved?'继续阅读':'阅读';open.onclick=()=>openBook(b);const reset=document.createElement('button');reset.type='button';reset.dataset.action='reset';reset.textContent='从头开始';reset.hidden=!saved;reset.setAttribute('aria-label','清除阅读位置并从头开始 '+name.textContent);reset.onclick=()=>clearProgress(b);const remove=document.createElement('button');remove.type='button';remove.dataset.action='delete';remove.textContent='从书架删除';remove.setAttribute('aria-label','从书架删除 '+name.textContent);remove.onclick=()=>deleteBook(b);actions.append(open,reset,remove);const cover=document.createElement('div');cover.className='book-cover';cover.setAttribute('aria-hidden','true');if(b.cover instanceof Blob&&b.cover.size){const url=URL.createObjectURL(b.cover);coverURLs.add(url);const image=document.createElement('img');image.src=url;image.alt='';image.loading='lazy';cover.classList.add('has-image');cover.append(image)}else{const coverTitle=document.createElement('span');coverTitle.textContent=b.title||b.filename||'未命名';const coverType=document.createElement('small');coverType.textContent=format(b).toUpperCase();cover.append(coverTitle,coverType)}const details=document.createElement('div');details.className='book-details';details.append(name,meta,progress,actions);card.append(cover,details);card.addEventListener('dblclick',e=>{if(!e.target.closest('button'))openBook(b)});$('shelf').append(card)}if(!books.length)$('shelf').textContent='书架还是空的。点击「添加电子书」开始。';else if(!visible.length)$('shelf').textContent=`没有找到“${$('shelfSearch').value.trim()}”`}\nasync function refresh(){books=(await request(tx().getAll())).filter(b=>b.blob).sort(shelfOrder);renderShelf()}\n$('shelfSearch').addEventListener('input',renderShelf);\nfunction clearProgress(book){const title=book.title||book.filename||'未命名';if(!confirm(`清除《${title}》的阅读位置并从开头重新开始？`)){status(`已取消重置《${title}》，阅读位置保持不变`);return}localStorage.removeItem('reader-pos-'+book.id);updateProgressCard(book,null);status(`已清除《${title}》的阅读位置，下次将从开头开始`)}\nasync function deleteBook(book){const title=book.title||book.filename||'未命名';if(!confirm(`从本机书架删除《${title}》？\\n该书的阅读位置和书签也会一并清除。`)){status(`已取消删除《${title}》，书籍、阅读位置和书签保持不变`);return}try{await request(tx('readwrite').delete(book.id));localStorage.removeItem('reader-pos-'+book.id);localStorage.removeItem('reader-bookmarks-'+book.id);await refresh();status(`已从本机书架删除《${title}》，阅读位置和书签已清除`)}catch(err){status('删除失败：'+err.message)}}\n$('importButton').onclick=()=>$('files').click();\nasync function fingerprint(file){const bytes=await crypto.subtle.digest('SHA-256',await file.arrayBuffer());return [...new Uint8Array(bytes)].map(x=>x.toString(16).padStart(2,'0')).join('')}\nfunction metadataText(value){if(typeof value==='string')return value.trim();if(Array.isArray(value))return value.map(metadataText).find(Boolean)||'';if(value&&typeof value==='object')return Object.values(value).map(metadataText).find(Boolean)||'';return''}\nasync function inspectBook(file){let parsed;try{parsed=await makeBook(file);const title=metadataText(parsed.metadata?.title);const author=metadataText(parsed.metadata?.author);const cover=await parsed.getCover?.();return{title,author,cover:cover instanceof Blob&&cover.size?cover:null}}catch(err){console.warn('无法预读书籍元数据，将使用文件名与默认封面',err);return{}}finally{parsed?.destroy?.()}}\n$('files').onchange=async e=>{let imported=0,duplicates=0,skipped=0,emptyTxt=0,failed=0;const errors=[];try{await libraryReady;for(const f of e.target.files){try{const ext=f.name.split('.').pop().toLowerCase();if(!['epub','mobi','azw3','fb2','cbz','txt'].includes(ext)){skipped++;continue}if(ext==='txt'&&!(await f.text()).trim()){emptyTxt++;continue}const digest=await fingerprint(f);const existing=books.find(b=>b.fingerprint===digest||(!b.fingerprint&&b.filename===f.name&&b.blob?.size===f.size));if(existing){duplicates++;continue}const metadata=ext==='txt'?{}:await inspectBook(f);await request(tx('readwrite').put({id:'local-'+crypto.randomUUID(),title:metadata.title||f.name.replace(/\\.[^.]+$/,''),author:metadata.author||'',cover:metadata.cover||null,format:ext.toUpperCase(),filename:f.name,size:f.size,fingerprint:digest,blob:f,local:true,added:new Date().toISOString()}));imported++;await refresh()}catch(err){failed++;errors.push(`${f.name}: ${err?.mes