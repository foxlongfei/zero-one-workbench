saved.chapter || 0) + 1} 章`;\n  return `${saved.listening ? '听到' : '读到'} ${chapter} · ${percent(saved.fraction ?? 0)}`;\n}\n\nasync function refreshShelf() {\n  books = (await store.listBooks()).sort((a, b) => {"}]}},{"type":"user","uuid":"c5e16247-5be8-4bd0-a627-eee96bb6cfe0","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_01_PMVcimHOehmUGIwfDCJe1862","is_error":false,"content":"`今日朗读 ${secondsToMinutes((stats.days[today] || 0) / 60000)}，累计 ${secondsToMinutes((stats.listenedMs || 0) / 60000)}。`,\n    settings.endpoint.apiKey ? `神经网络音频已启用：文本只发往 ${settings.endpoint.baseUrl}，密钥仅保存在本机。` : '神经网络语音未设置密钥：文本不会离开本机。',\n    libraryConfigured() ? `家庭声音库：${settings.library.baseUrl}（仅发送当前朗读文本与声音 id）。` : '家庭声音库未连接。',\n  ];\n  lines.forEach(line => { const p = document.createElement('p'); p.textContent = line; el.append(p); });\n}\n\nfunction updateEngineControls() {\n  refreshVoiceScreens();\n  refreshEngineBadge();\n  const browser = $('browserVoice');\n  const voices = window.speechSynthesis?.getVoices?.() ?? [];\n  browser.replaceChildren(...voices.map(voice => new Option(`${voice.name} · ${voice.lang}`, voice.voiceURI, false, voice.voiceURI === settings.browserVoiceURI)));\n  $('fieldBrowserVoice').hidden = settings.engine !== 'browser';\n  $('rate').value = String(settings.rate);\n  $('endpointUrl').value = settings.endpoint.baseUrl;\n  $('endpointModel').value = settings.endpoint.model;\n  $('endpointVoice').value = settings.endpoint.voice;\n  $('endpointKey').value = settings.endpoint.apiKey ? '••••••••' : '';\n  $('libraryUrl').value = settings.library.baseUrl;\n  $('libraryToken').value = settings.library.token ? '••••••••' : '';\n  $('ducking').checked = settings.music.ducking;\n  $('musicVolume').value = String(settings.music.volume);\n}\n\nfunction switchEngine(kind) {\n  settings.engine = kind;\n  saveSettings();\n  currentEngine = null;\n  updateEngineControls();\n  refreshEngineBadge();\n  if (kind === 'endpoint' && !settings.endpoint.baseUrl) status('神经网络语音还没有配置服务地址，请到「声音」页填写。', 'warn');\n  if (kind === 'library' && !activeVoice) status('还没有选择家庭授权声音，请到「声音」页选择或录制。', 'warn');\n}\n\nasync function loadVoices() {\n  if (!libraryConfigured()) { renderVoiceList(); return; }\n  renderVoiceList('正在读取声音库…');\n  try {\n    const response = await libraryFetch('/api/voices');\n    if (!response.ok) throw new Error(`声音库返回 ${response.status}`);"}]}},{"type":"assistant","uuid":"c455e96b-e42c-448d-bedb-dbc39dd5ec4d","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"id":"c455e96b-e42c-448d-bedb-dbc39dd5ec4d","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"text","text":"I have the full picture of the engine selection logic. Now let me make the product changes: a truthful readiness indicator (what works out of the box, what needs credentials) and first-open guidance."}],"stop_reason":null,"usage":{"input_tokens":0,"output_tokens":0}}},{"type":"assistant","uuid":"507bf2bc-a001-4f94-83a4-c963cf76d511","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"id":"507bf2bc-a001-4f94-83a4-c963cf76d511","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_qtbSJjXyEB9CiVpVn9Lk2126","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && grep -n \"engineBadge\\|engineHint\\|shelfEmpty\\|id=\\\"reader\\\"\\|id=\\\"shelf\\\"\\|id=\\\"voices\\\"\" portal/reader-v03/index.html | head -40","description":"Locate UI anchors in index.html"}},{"type":"tool_use","id":"call_01_pip7zlneqk1eBc0GI7Lg3101","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && sed -n '1,80p' portal/reader-v03/index.html","description":"Read index.html head"}}],"stop_reason":"tool_use","usage":{"input_tokens":31772,"output_tokens":239,"cache_read_input_tokens":29696,"total_tokens":32011}}},{"type":"user","uuid":"431dd976-2ad9-4c1e-8af2-c093b28f0051","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_qtbSJjXyEB9CiVpVn9Lk2126","is_error":false,"content":"151:    <ul class=\"shelf\" id=\"shelf\" aria-label=\"书列表\"></ul>\n152:    <div id=\"shelfEmpty\" class=\"card\" hidden>\n163:      <span class=\"badge\" id=\"engineBadge\">引擎</span>\n204:          <p class=\"hint\" id=\"engineHint\"></p>"}]}},{"type":"user","uuid":"27490aee-995e-4e89-b1c9-c1ee96d84007","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_01_pip7zlneqk1eBc0GI7Lg3101","is_error":false,"content":"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#f7f3e9\">\n<title>陪你读书 V0.3</title>\n<style>\n:root{\n  --paper:#f7f3e9;--card:#fffdf8;--ink:#26342c;--muted:#6b776e;--line:#e3ddd0;\n  --accent:#3f6653;--accent-ink:#fff;--warm:#b4693f;--danger:#a33a32;--ok:#3f7a58;\n  --shadow:0 10px 30px rgba(46,58,48,.09);--radius:16px;\n  --serif:Georgia,\"Songti SC\",\"Noto Serif SC\",\"Source Han Serif SC\",serif;\n  --sans:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.65}\nbutton,input,select,textarea{font:inherit;color:inherit}\nbutton{cursor:pointer;border:1px solid var(--line);background:var(--card);border-radius:10px;padding:.5rem .8rem;min-height:40px;transition:border-color .15s,background .15s}\nbutton:hover{border-color:var(--accent)}\nbutton:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:3px solid rgba(63,102,83,.35);outline-offset:2px}\nbutton.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}\nbutton.ghost{background:transparent;border-color:transparent}\nbutton.danger{color:var(--danger);border-color:#e6cdc9}\nbutton.big{font-size:1.15rem;padding:.8rem 1.4rem;min-height:56px;border-radius:999px}\nbutton[aria-pressed=\"true\"]{background:#e6efe7;border-color:var(--accent)}\ninput[type=range]{accent-color:var(--accent);min-height:32px}\na{color:var(--accent)}\nh1,h2,h3{font-family:var(--serif);font-weight:600;margin:0 0 .4rem}\nheader{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;padding:1rem clamp(1rem,4vw,2.5rem);border-bottom:1px solid var(--line);background:rgba(247,243,233,.92);position:sticky;top:0;z-index:20;backdrop-filter:blur(10px)}\nheader .brand{font-family:var(--serif);font-size:1.5rem;letter-spacing:.04em}\nheader .version{font-size:.75rem;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:.05rem .5rem}\nnav.tabs{display:flex;gap:.25rem;margin-left:auto;flex-wrap:wrap}\nnav.tabs button{border-radius:999px;padding:.35rem .9rem;min-height:36px;background:transparent;border-color:transparent}\nnav.tabs button[aria-current=\"page\"]{background:var(--card);border-color:var(--line);box-shadow:var(--shadow)}\nmain{max-width:1180px;margin:0 auto;padding:clamp(1rem,3vw,2rem)}\nsection[data-screen][hidden]{display:none!important}\n.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:1.1rem 1.2rem;box-shadow:var(--shadow)}\n.row{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}\n.spread{justify-content:space-between}\n.muted{color:var(--muted);font-size:.9rem}\n.status{padding:.6rem .9rem;border-radius:10px;background:#eef3ec;border:1px solid #d7e3d7;font-size:.92rem;min-height:2.4rem}\n.status[data-tone=\"warn\"]{background:#fbf3e6;border-color:#eeddc2}\n.status[data-tone=\"error\"]{background:#fbebea;border-color:#eed3cf}\n.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n\n/* shelf */\n.shelf-tools{display:grid;grid-template-columns:1fr auto;gap:.8rem;align-items:center;margin:1.2rem 0 1.6rem}\n.shelf-tools input[type=search]{width:100%;padding:.7rem 1rem;border-radius:12px;border:1px solid var(--line);background:var(--card);min-height:48px}\n.shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1.8rem 1.2rem;list-style:none;margin:0;padding:0}\n.book{display:flex;flex-direction:column;gap:.6rem;min-width:0}\n.book .cover{position:relative;aspect-ratio:3/4.15;border-radius:4px 10px 10px 4px;overflow:hidden;background:linear-gradient(145deg,#49685a,#233b35);color:#f6efe0;padding:1.2rem 1rem;display:flex;flex-direction:column;justify-content:space-between;box-shadow:inset 6px 0 9px rgba(0,0,0,.18),5px 9px 20px rgba(40,55,43,.16);transition:transform .18s ease}\n.book:nth-child(4n+2) .cover{background:linear-gradient(145deg,#94694f,#4b3130)}\n.book:nth-child(4n+3) .cover{background:linear-gradient(145deg,#6f8298,#33465c)}\n.book:nth-child(4n+4) .cover{background:linear-gradient(145deg,#948859,#585b3c)}\n.book:hover .cover,.book:focus-within .cover{transform:translateY(-4px)}\n.book .cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n.book .cover .t{font-family:var(--serif);font-size:1.1rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}\n.book .cover .f{font-size:.72rem;letter-spacing:.16em;opacity:.85}\n.book .progress{height:4px;background:#e6e0d3;border-radius:2px;overflow:hidden}\n.book .progress i{display:block;height:100%;background:var(--accent)}\n.book .name{font-weight:600;line-height:1.4;overflow-wrap:anywhere}\n.book .actions{display:flex;gap:.4rem;flex-wrap:wrap}\n.book .actions button{font-size:.85rem;padding:.3rem .6rem;min-height:34px}\n.resume-card{display:flex;gap:1rem;align-items:center;justify-content:space-between;flex-wrap:wrap;border-left:4px solid var(--accent)}\n\n/* reader */\n#screen-reader{padding:0}\n.reader-bar{display:flex;gap:.5rem;align-items:center;width:100%}\n.reader-bar .title{font-family:var(--serif);font-size:1.15rem;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.reader-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:1.6rem;align-items:start}\n@media(max-width:980px){.reader-grid{grid-template-columns:1fr}}\n.reader-stage{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);min-height:62vh;padding:clamp(.6rem,2vw,1.6rem);position:relative}\nfoliate-view{display:block;height:70vh}\n#txtPage{font-family:var(--serif);font-size:clamp(1.05rem,1.15vw,1.22rem);line-height:2;max-width:38em;margin:0 auto;padding:clamp(1rem,3vw,2.5rem) 0}\n#txtPage .chap{font-size:1.5rem;margin:0 0 1.2rem;text-align:center}\n#txtPage p{margin:0 0 .9em;text-indent:2em}\n#txtPage p.active{background:#f1efe2;border-radius:6px;box-shadow:0 0 0 .35rem #f1efe2}\n.reader-foot{display:flex;gap:.6rem;align-items:center;justify-content:center;padding:.9rem 0 .2rem;flex-wrap:wrap}\n.reader-foot .pos{min-width:9rem;text-align:center;color:var(--muted);font-size:.9rem}"}]}},{"type":"assistant","uuid":"55def40a-a700-4546-acc2-4a4dbf6e6746","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"id":"55def40a-a700-4546-acc2-4a4dbf6e6746","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_updw8lHBTAcUVxkunkSR8086","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && sed -n '140,215p' portal/reader-v03/index.html","description":"Read shelf and reader markup"}},{"type":"tool_use","id":"call_01_24SrfypPtv2sAFywf5cS2740","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && sed -n '215,340p' portal/reader-v03/index.html","description":"Read voices/world markup"}}],"stop_reason":"tool_use","usage":{"input_tokens":34495,"output_tokens":173,"cache_read_input_tokens":31488,"total_tokens":34668}}},{"type":"user","uuid":"961fa8da-9cb0-481f-b38d-f3822c733af9","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_updw8lHBTAcUVxkunkSR8086","is_error":false,"content":"<section data-screen=\"shelf\" id=\"screen-shelf\" aria-label=\"我的书架\">\n    <div class=\"shelf-tools\">\n      <input id=\"shelfSearch\" type=\"search\" placeholder=\"搜索书名、作者或文件名\" aria-label=\"搜索书架\">\n      <button id=\"importButton\" class=\"primary\" type=\"button\" disabled>＋ 导入电子书</button>\n      <input id=\"files\" type=\"file\" accept=\".epub,.txt,.mobi,.azw3,.fb2,.cbz\" multiple hidden data-testid=\"import-input\">\n    </div>\n    <div id=\"resumeCard\" class=\"card resume-card\" hidden>\n      <div><div class=\"muted\">继续上次</div><div id=\"resumeTitle\" style=\"font-family:var(--serif);font-size:1.2rem\"></div><div id=\"resumeMeta\" class=\"muted\"></div></div>\n      <div class=\"row\"><button id=\"resumeRead\" class=\"primary\" type=\"button\">继续阅读</button><button id=\"resumeListen\" type=\"button\">继续听书</button></div>\n    </div>\n    <h2 style=\"margin-top:1.6rem\">我的书架 <span class=\"muted\" id=\"shelfCount\"></span></h2>\n    <ul class=\"shelf\" id=\"shelf\" aria-label=\"书列表\"></ul>\n    <div id=\"shelfEmpty\" class=\"card\" hidden>\n      <h3>书架还空着</h3>\n      <p class=\"muted\">导入你自己的 EPUB 或 TXT 电子书即可开始。书籍只保存在这台设备的浏览器里，不会上传。请只导入你有权阅读的文件。</p>\n    </div>\n  </section>\n\n  <!-- ============ READER ============ -->\n  <section data-screen=\"reader\" id=\"screen-reader\" aria-label=\"阅读器\" hidden>\n    <div class=\"reader-bar\">\n      <button id=\"backToShelf\" class=\"ghost\" type=\"button\">← 书架</button>\n      <span class=\"title\" id=\"readerTitle\">未打开书籍</span>\n      <span class=\"badge\" id=\"engineBadge\">引擎</span>\n    </div>\n    <div class=\"reader-grid\">\n      <div>\n        <div class=\"reader-stage\" id=\"readerStage\">\n          <div id=\"bookView\"></div>\n          <div id=\"txtPage\" aria-live=\"off\"></div>\n        </div>\n        <div class=\"reader-foot\">\n          <button id=\"prevPage\" type=\"button\" aria-label=\"上一页\">← 上一页</button>\n          <span class=\"pos\" id=\"position\">—</span>\n          <button id=\"nextPage\" type=\"button\" aria-label=\"下一页\">下一页 →</button>\n        </div>\n      </div>\n\n      <aside class=\"card player\" aria-label=\"听书与设置\">\n        <div class=\"now\">\n          <button id=\"playButton\" class=\"play\" type=\"button\" aria-label=\"开始朗读\" data-testid=\"play\">▶</button>\n          <div style=\"min-width:0\">\n            <div id=\"nowChapter\" style=\"font-weight:600\">选一本书开始</div>\n            <div class=\"meta\" id=\"nowSentence\">—</div>\n          </div>\n        </div>\n        <div class=\"skip\">\n          <button id=\"prevPara\" type=\"button\">⏮ 上一段</button>\n          <button id=\"nextPara\" type=\"button\">下一段 ⏭</button>\n          <button id=\"prevChapter\" type=\"button\">上一章</button>\n          <button id=\"nextChapter\" type=\"button\">下一章</button>\n        </div>\n        <div class=\"meta\" id=\"listenStats\" data-testid=\"listen-stats\">今日已听 0 分钟</div>\n\n        <div class=\"panel-title\"><h2>目录</h2><span class=\"muted\" id=\"chapterCount\"></span></div>\n        <ol class=\"chapter-list\" id=\"chapterList\"></ol>\n\n        <details open>\n          <summary>朗读声音</summary>\n          <label class=\"field\">声音来源\n            <select id=\"engineSelect\" aria-label=\"声音来源\"></select>\n          </label>\n          <label class=\"field\" id=\"fieldBrowserVoice\">本机声音<select id=\"browserVoice\" aria-label=\"本机声音\"></select></label>\n          <label class=\"field\" id=\"fieldRate\">语速 <input id=\"rate\" type=\"range\" min=\".6\" max=\"1.8\" step=\".05\" value=\"1\"></label>\n          <p class=\"hint\" id=\"engineHint\"></p>\n          <p class=\"hint\"><button id=\"toVoices\" type=\"button\" class=\"ghost\" style=\"padding:0;min-height:0;text-decoration:underline\">声音设置与家庭授权声音 →</button></p>\n        </details>\n\n        <details>\n          <summary>背景音</summary>\n          <label class=\"field\">背景音乐（本机文件）\n            <input id=\"musicFile\" type=\"file\" accept=\"audio/*\">\n          </label>\n          <div class=\"row spread\"><span id=\"musicName\" class=\"muted\">尚未添加背景音乐</span><button id=\"clearMusic\" type=\"button\" hidden>移除</button></div>\n          <label class=\"field\">音量 <input id=\"musicVolume\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\".18\"></label>\n          <label class=\"row\" style=\"gap:.5rem;margin:.3rem 0\"><input id=\"ducking\" type=\"checkbox\" checked> 朗读时自动压低背景音</label>"}]}},{"type":"user","uuid":"41850e1c-03fa-473f-8065-c8fbb2c5af63","session_id":"e72cd3ef-e244-4066-bf6b-fdf4dce035d6","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_01_24SrfypPtv2sAFywf5cS2740","is_error":false,"content":"<label class=\"row\" style=\"gap:.5rem;margin:.3rem 0\"><input id=\"ducking\" type=\"checkbox\" checked> 朗读时自动压低背景音</label>\n          <div class=\"row\"><button id=\"musicPlay\" type=\"button\">播放背景音</button><audio id=\"music\" loop preload=\"auto\"></audio></div>\n        </details>\n\n        <details>\n          <summary>笔记 <span class=\"badge\" id=\"noteCount\">0</span></summary>\n          <div id=\"noteList\"></div>\n          <label class=\"field\">写下想法<textarea id=\"noteText\" placeholder=\"读到这一段的感受、疑问或想和孩子讨论的问题\"></textarea></label>\n          <div class=\"row\"><button id=\"saveNote\" class=\"primary\" type=\"button\">保存笔记</button><button id=\"aiNote\" type=\"button\">问 AI 讨论</button></div>\n          <div id=\"aiAnswer\" class=\"note\" hidden></div>\n        </details>\n      </aside>\n    </div>\n  </section>\n\n  <!-- ============ VOICES ============ -->\n  <section data-screen=\"voices\" id=\"screen-voices\" aria-label=\"声音设置\" hidden>\n    <h1>声音与隐私</h1>\n    <p class=\"muted\">朗读可以完全留在本机，也可以连接你自选的神经网络语音服务，或使用家人授权录制的声音。任何声音克隆都必须由声音本人明确授权；没有授权的声音不能在本系统创建。</p>\n\n    <div class=\"grid2\" style=\"margin:1.2rem 0\">\n      <div class=\"card\">\n        <h2>朗读引擎</h2>\n        <label class=\"field\">当前引擎<select id=\"voiceEngineSelect\"></select></label>\n        <div class=\"row\" style=\"margin:.6rem 0\"><button id=\"testVoice\" class=\"primary\" type=\"button\">试听</button><span class=\"hint\" id=\"testVoiceResult\"></span></div>\n        <div id=\"engineStatus\" class=\"hint\"></div>\n      </div>\n      <div class=\"card\">\n        <h2>神经网络语音服务</h2>\n        <p class=\"hint\">兼容 OpenAI 的 <code>/v1/audio/speech</code> 接口，例如自建或托管的 Kokoro-FastAPI、Piper 网关。地址与密钥只保存在本机浏览器；密钥不会写入代码或公开页面。</p>\n        <label class=\"field\">服务地址（如 https://your-kokoro.example/v1）<input id=\"endpointUrl\" type=\"url\" placeholder=\"https://…\" autocomplete=\"off\"></label>\n        <label class=\"field\">模型 <input id=\"endpointModel\" type=\"text\" placeholder=\"kokoro\" autocomplete=\"off\"></label>\n        <label class=\"field\">声音名 <input id=\"endpointVoice\" type=\"text\" placeholder=\"af_heart / zf_xiaobei …\" autocomplete=\"off\"></label>\n        <label class=\"field\">API 密钥（可选，仅本机）<input id=\"endpointKey\" type=\"password\" autocomplete=\"off\"></label>\n        <div class=\"row\"><button id=\"saveEndpoint\" class=\"primary\" type=\"button\">保存服务</button><button id=\"clearEndpoint\" type=\"button\">清除</button></div>\n      </div>\n      <div class=\"card\">\n        <h2>家庭声音库（服务端）</h2>\n        <p class=\"hint\">由声音库服务生成、验证并留痕授权记录。页面只保存声音 id；撤销或删除由声音本人执行。</p>\n        <label class=\"field\">声音库地址 <input id=\"libraryUrl\" type=\"url\" placeholder=\"https://voice-library.example\" autocomplete=\"off\"></label>\n        <label class=\"field\">访问令牌（可选）<input id=\"libraryToken\" type=\"password\" autocomplete=\"off\"></label>\n        <div class=\"row\"><button id=\"saveLibrary\" class=\"primary\" type=\"button\">保存声音库</button><button id=\"refreshVoices\" type=\"button\">刷新声音列表</button></div>\n      </div>\n      <div class=\"card\">\n        <h2>数据与费用透明</h2>\n        <p class=\"hint\">本机朗读不产生网络流量。神经网络语音按你的服务商计费，每次朗读把一到几句文本发送到该服务；家庭声音库只发送当前朗读的文本。你的书库、进度、笔记永远只在本机。</p>\n        <div id=\"privacyStats\" class=\"hint\"></div>\n      </div>\n    </div>\n\n    <h2 style=\"margin-top:1.6rem\">可用声音</h2>\n    <div id=\"voiceList\" class=\"card\"></div>\n\n    <h2 style=\"margin-top:2rem\">录制家庭声音（须声音本人授权）</h2>\n    <div class=\"card\">\n      <ol class=\"hint\">\n        <li>邀请声音本人在场，阅读下面的授权说明后点击「开始授权录制」。</li>\n        <li>依次朗读屏幕上显示的三段文字，每段约 5–8 秒，保持安静环境。</li>\n        <li>上传到声音库后，声音本人可以随时暂停使用、撤销授权；撤销后系统立即拒绝合成，并可删除样本与音色。</li>\n      </ol>\n      <fieldset style=\"border:1px solid var(--line);border-radius:12px;padding:.8rem;margin:1rem 0\">\n        <legend><strong>授权声明</strong></legend>\n        <label class=\"row\" style=\"gap:.5rem;align-items:flex-start\"><input id=\"consentCheck\" type=\"checkbox\"> <span>我本人是这段声音的主人，或者我已取得声音本人对本系统使用这段声音进行语音合成和试听的明确授权。我了解声音样本会上传到声音库服务，并可以随时撤销授权与删除样本。</span></label>\n        <label class=\"field\">我的名字 / 称呼<input id=\"consentName\" type=\"text\" placeholder=\"例如：妈妈、爷爷、小雨\"></label>\n        <label class=\"field\">关系（可选）<input id=\"consentRelation\" type=\"text\" placeholder=\"例如：孩子、长辈\"></label>\n      </fieldset>\n      <div class=\"row\"><button id=\"startRecording\" class=\"primary\" type=\"button\" disabled>开始授权录制</button><span id=\"recordStatus\" class=\"hint\"></span></div>\n      <div id=\"recordArea\" hidden style=\"margin-top:1rem\">\n        <p id=\"recordPrompt\" style=\"font-family:var(--serif);font-size:1.25rem;line-height:1.8;background:#fff;border:1px solid var(--line);border-radius:12px;padding:1rem\"></p>\n        <div class=\"row\"><button id=\"recordSample\" class=\"primary\" type=\"button\">开始 / 停止录制第 <span id=\"recordIndex\">1</span> 段</button><button id=\"cancelRecording\" type=\"button\">取消</button></div>\n        <audio id=\"recordPreview\" controls hidden style=\"width:100%;margin-top:.8rem\"></audio>\n      </div>\n      <div id=\"recordDone\" hidden style=\"margin-top:1rem\">\n        <p>三段录音已完成，可以上传到声音库，由声音本人确认后生成声音。</p>\n        <label class=\"field\">声音名称<input id=\"voiceName\" type=\"text\" placeholder=\"例如：妈妈的声音\"></label>\n        <button id=\"uploadVoice\" class=\"primary\" type=\"button\">上传并申请生成声音</button>\n        <p class=\"hint\" id=\"uploadResult\"></p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ WORLD ============ -->\n  <section data-screen=\"world\" id=\"screen-world\" aria-label=\"听世界\" hidden>\n    <h1>听世界</h1>\n    <p class=\"muted\">读书时可以在身后放一点声音：自备的背景音乐、古典音乐电台、世界电台与播客。本站只链接持权方官方发布的直播地址，不转存、不重新分发音频；版权与归属显示在每条内容下方。</p>\n    <div class=\"card\" style=\"margin:1rem 0\">\n      <div class=\"row spread\">\n        <div><strong>当前时段推荐</strong> <span class=\"muted\" id=\"daypartLabel\"></span></div>\n        <button id=\"worldPlayButton\" class=\"primary\" type=\"button\">播放推荐</button>\n      </div>\n      <p class=\"hint\" id=\"worldNow\">—</p>\n      <audio id=\"worldAudio\" controls preload=\"none\" style=\"width:100%;margin-top:.5rem\"></audio>\n    </div>\n    <div class=\"chips\" id=\"worldFilters\" role=\"group\" aria-label=\"分类\"></div>\n    <div id=\"worldList\" style=\"margin-top:1rem\"></div>\n  </section>\n</main>\n\n<footer>\n  <div>陪你读书 V0.3 · 本机优先的整书阅读与连续听书原型机</div>\n  <div>阅读引擎 <a href=\"https://github.com/johnfactotum/foliate-js\" rel=\"noreferrer\">foliate-js</a>（MIT）· 本站不提供任何受版权保护的书籍或声音素材</div>\n  <div><a href=\"../reader-integrated.html\">旧版阅读器（C01）</a> · <a href=\"../index.html\">返回零一空间</a></div>\n</footer>\n\n<script type=\"module\" src=\"./app.mjs\"></script>\n</body>\n</html>"}]}},{"type":"assistant","uuid":"ca407557-7c78-4931-9301