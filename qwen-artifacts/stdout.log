;\n  if (!/^[\\u4e00-\\u9fff]{3,}$/.test(term)) return false;\n  let from = 0;\n  for (const ch of term) {\n    const at = field.indexOf(ch, from);\n    if (at < 0) return false;\n    from = at + 1;\n  }\n  return true;\n}\n\nfunction wordMatches(fields, word) {\n  if (/^[\\u4e00-\\u9fff]{3,}$/.test(word)) {\n    // 先整词，再相邻双字：双字片段原样出现即视为记住了这个词。\n    const parts = [word, ...bigrams(word)];\n    return parts.some(t => fields.some(v => v.includes(t)) || fields.some(v => termMatches(v, t)));\n  }\n  return fields.some(v => v.includes(word));\n}\n\nexport function noteMatches(note, query) {\n  const q = norm(query).trim();\n  if (!q) return true;\n  const fields = [note?.text, note?.quote, note?.chapter, ...(Array.isArray(note?.tags) ? note.tags : [])].map(norm);\n  if (fields.some(v => v.includes(q))) return true;\n  const words = q.split(/\\s+/).filter(Boolean);\n  return words.every(w => wordMatches(fields, w));\n}"}}],"stop_reason":"tool_use","usage":{"input_tokens":39517,"output_tokens":1066,"cache_read_input_tokens":38400,"total_tokens":40583}}},{"type":"user","uuid":"ef03666b-3211-49cd-865b-da8d87b76689","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_mpFzDgbvpK7Kp0x6M1U66068","is_error":false,"content":"The file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/reader/text.js has been updated. Showing lines 66-86 of 108 from the edited file:\n\n---\n\n}\n\n// 搜索按「词」而不要求整串：用户记得住几个词，记不住原句。\n// 「童年 窗户」这种多词查询，每个词都要出现，顺序随意，可以分散在正文和标签里。\nfunction bigrams(w) {\n  const out = [];\n  for (let i = 0; i < w.length - 1; i++) out.push(w.slice(i, i + 2));\n  return out;\n}\n\nconst norm = v => String(v || '').toLowerCase();\n\n// 一个字一个词地找：双字片段（「窗户」）只认原样出现，避免拆字误中「窗户外」；\n// 三字以上的连写中文按字序宽松匹配，用来兜住「童年的窗户」对「小时候的窗户」。\nfunction wordMatches(fields, word) {\n  if (/^[\\u4e00-\\u9fff]{3,}$/.test(word)) {\n    return [word, ...bigrams(word)].some(t => fields.some(v 