s } from '/home/runner/work/zero-one-workbench/zero-one-workbench/portal/movement/app/pose.js';\n\nconst rig = JSON.parse(readFileSync('portal/data/movement-rig-v1.json', 'utf8'));\nconst skeleton = buildSkeleton(rig);\nconst neutral = JSON.parse(readFileSync('portal/data/movement-exercises-v1.json', 'utf8')).poseTemplates.neutral;\nconst f = (v) => (v ? v.map((n) => n.toFixed(2)).join(',') : '-');\n\nconst cases = [\n  // label, root, trunkUp, wrist, ankle\n  ['支撑位', [0, 0.44, 0.10], [0, 0.52, -0.85], [0.62, 0.06], [-0.66]],\n  ['下放位', [0, 0.33, 0.12], [0, 0.52, -0.85], [0.62, 0.06], [-0.66]],\n];\nfor (const [label, root, up, [wz, wy], [az]] of cases) {\n  const pose = mergePose(neutral, {\n    root,\n    trunkUp: up,\n    trunkFwd: [0, -up[2], up[1]],\n    joints: {\n      wrist_l: [-0.2, wy, wz], wrist_r: [0.2, wy, wz],\n      ankle_l: [-0.1, 0.09, az], ankle_r: [0.1, 0.09, az],\n    },\n  });\n  const { joints: j, grounded } = solvePose(rig, skeleton, pose);\n  console.log(label, 'grounded', grounded.toFixed(3), JSON.stringify(jointAngles(j, 'l')));\n  for (const k of ['hip_l', 'knee_l', 'ankle_l', 'shoulder_l', 'elbow_l', 'wrist_l', 'head_top']) console.log('  ', k.padEnd(11), f(j[k]));\n}\n","file_path":"/tmp/layout.mjs"}}],"stop_reason":"tool_use","usage":{"input_tokens":87652,"output_tokens":623,"cache_read_input_tokens":86784,"total_tokens":88275}}},{"type":"user","uuid":"579c436d-1f9a-4c3d-bda9-2afbde4155f0","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_UOmLtEoDsqeaviB8J3AV0599","is_error":false,"content":"Successfully created and wrote to new file: /tmp/layout.mjs."}]}},{"type":"assistant","uuid":"c4bd3438-8421-4dd2-8ae7-dfa464c6ed4b","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"id":"c4bd3438-8421-4dd2-8ae7-dfa464c6ed4b","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":