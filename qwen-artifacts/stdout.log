a6f5bc14177d6f4c1a126ae54499f4\nAuthor: foxlongfei <71594571+foxlongfei@users.noreply.github.com>\nDate:   Sat Oct 24 14:56:08 2026 +0000\n\n    feat(reader-v03): ship V0.3 reader with continuous listening and consented family voices\n    \n    Real product increment over C01: a modular reader (text/book/narration/engines/\n    store/listening-world) that imports EPUB+TXT, renders covers and TOC, reads the\n    whole book without stopping at chapter breaks, resumes the interrupted\n    paragraph, ducks background music while speaking, keeps notes and progress,\n    and offers a local voice library that refuses to synthesise a revoked voice.\n    \n    Fixes found by real browser runs: lazy foliate TOC was empty, goTo/lastLocation\n    needed spine indices instead of objects, TOC order could point at the wrong\n    section, and the chosen family voice was never persisted.\n    \n    Verified: 19 unit tests + 36 Playwright checks (artifacts/reader-v03).\n\n .gitignore                                 |    3 +\n docs/v0.3/2026-10-24-read-with-you-v03.md  |   58 ++\n portal/index.html                          |    2 +-\n portal/reader-v03/app.mjs                  | 1490 ++++++++++++++++++++++++++++\n portal/reader-v03/index.html               |  321 ++++++\n portal/reader-v03/lib/book.mjs             |   83 ++\n portal/reader-v03/lib/engines.mjs          |  268 +++++\n portal/reader-v03/lib/listening-world.mjs  |   99 ++\n portal/reader-v03/lib/narration.mjs        |  277 ++++++\n portal/reader-v03/lib/store.mjs            |   87 ++\n portal/reader-v03/lib/text.mjs             |  103 ++\n portal/reading-library.html                |    2 +-\n server/voice-library/server.mjs            |  164 +++\n server/voice-library/store.mjs             |  184 ++++\n server/voice-library/synth.mjs             |  124 +++\n tests/reader-v03/browser-check.mjs         |  270 +++++\n tests/reader-v03/core.test.mjs             |  190 ++++\n tests/reader-v03/fixtures/morning.txt      |   18 +\n tests/reader-v03/fixtures/quiet-house.epub |  Bin 0 -> 2792 bytes\n tests/reader-v03/make-fixtures.py          |   45 +\n tests/reader-v03/voice-library.test.mjs    |  142 +++\n 21 files changed, 3928 insertions(+), 2 deletions(-)\n=== engines.mjs ===\n// Speech engines for \"陪你读书\".\n//\n// Every engine implements the same tiny contract so the listening loop does not\n// care where audio comes from:\n//   speak(text, { signal }) -> Promise<void>  (resolves when audio finished)\n//   name, kind ('browser' | 'endpoint' | 'library'), needsNetwork\n//\n// * BrowserEngine   – Web Speech API, zero setup, built-in voices (offline on macOS/iOS/Windows,\n//                     network-assisted in Chrome).\n// * EndpointEngine  – any OpenAI-compatible `POST /v1/audio/speech` endpoint (Kokoro-FastAPI,\n//                     openai-edge-tts, Piper/LocalAI gateways, self-hosted Kokoro). This is how a\n//                     high-quality neural voice is used without shipping model weights, and how\n//                     keyed cloud voices can be used with a key stored only in this browser.\n// * LibraryVoiceEngine – voices served by server/voice-library (cloned / customised family\n//                     voices, see server docs). Authorisation and consent are enforced server\n//                     side, never trusted from the client.\n\nlet audioContext = null;\n\nconst getAudioContext = () => {\n  if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();\n  return audioContext;\n};\n\nconst decodeArrayBuffer = async buffer => {\n  const ctx = getAudioContext();\n  return await ctx.decodeAudioData(buffer.slice(0));\n};\n\nconst playBuffer = (ctx, audioBuffer, { signal, onStart } = {}) => new Promise((resolve, reject) => {\n  const source = ctx.createBufferSource();\n  source.buffer = audioBuffer;\n  source.connect(ctx.destination);\n  const abort = () => {\n    try { source.stop(); } catch {}\n    reject(abortError());\n  };\n  signal?.addEventListener('abort', abort, { once: true });\n  source.onended = () => {\n    signal?.removeEventListener('abort', abort);\n    resolve();\n  };\n  onStart?.();\n  source.start();\n});\n\nexport const abortError = () => {\n  const error = new Error('speech aborted');\n  error.name = 'AbortError';\n  return error;\n};\n\nexport const isAbort = error => error?.name === 'AbortError';\n\nexport class BrowserEngine {\n  kind = 'browser';\n  needsNetwork = false;\n  name = '本机浏览器语音';\n  constructor({ voiceURI = '', rate = 1, pitch = 1, volume = 1 } = {}) {\n    Object.assign(this, { voiceURI, rate, pitch, volume });\n    this.synth = window.speechSynthesis;\n  }\n  static get available() {\n    return Boolean(window.speechSynthesis && window.SpeechSynthesisUtterance);\n  }\n  voices() {\n    return this.synth?.getVoices() ?? [];\n  }\n  speak(text, { signal } = {}) {\n    return new Promise((resolve, reject) => {\n      if (!this.synth) return reject(new Error('此浏览器不支持语音合成'));\n      const utterance = new SpeechSynthesisUtterance(text);\n      const voice = this.voices().find(v => v.voiceURI === this.voiceURI);\n      if (voice) utterance.voice = voice;\n      utterance.lang = voice?.lang || 'zh-CN';\n      utterance.rate = this.rate;\n      utterance.pitch = this.pitch;\n      utterance.volume = this.volume;\n      let settled = false;\n      const finish = fn => value => {\n        if (settled) return;\n        settled = true;\n        signal?.removeEventListener('abort', abort);\n        fn(value);\n      };\n      const abort = () => {\n        try { this.synth.cancel(); } catch {}\n        finish(reject)(abortError());\n      };\n      signal?.addEventListener('abort', abort, { once: true });\n      utterance.onend = finish(resolve);\n      utterance.onerror = event => {\n        if (event.error === 'interrupted' || event.error === 'canceled') finish(reject)(abortError());\n        else finish(reject)(new Error(`语音合成失败：${event.error || 'unknown'}`));\n      };\n      // Chrome occasionally drops short utterances when another one was cancelled\n      // right before; a microtask delay keeps cancel()+speak() in order.\n      setTimeout(() => { if (!signal?.aborted) this.synth.speak(utterance); }, 0);\n    });\n  }\n  stop() {\n    try { this.synth?.cancel(); } catch {}\n  }\n}\n\nconst toWav = ({ channels, sampleRate, samples }) => {\n  const frameCount = samples[0].length;\n  const channelCount = channels;\n  const buffer = new ArrayBuffer(44 + frameCount * channelCount * 2);\n  const view = new DataView(buffer);\n  const writeString = (offset, value) => {\n    for (let i = 0; i < value.length; i++) view.setUint8(offset + i, value.charCodeAt(i));\n  };\n  writeString(0, 'RIFF');\n  view.setUint32(4, 36 + frameCount * channelCount * 2, true);\n  writeString(8, 'WAVE');\n  writeString(12, 'fmt ');\n  view.setUint32(16, 16, true);\n  view.setUint16(20, 1, true);\n  view.setUint16(22, channelCount, true);"}]}},{"type":"assistant","uuid":"d8ea1cb3-e0ba-4a22-adab-3f5c99b3e4a5","session_id":"cf38db47-6a60-40d2-9f45-ef7feaff938c","parent_tool_use_id":null,"message":{"id":"d8ea1cb3-e0ba-4a22-adab-3f5c99b3e4a5","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_xHERQwz6SWo6cSBVyXcj3449","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && git show origin/feat/read-with-you-v03:portal/reader-v03/app.mjs | head -80 && echo \"...\" && git show origin/feat/read-with-you-v03:portal/reader-v03/app.mjs | grep -n \"^\\s*\\(function\\|const [a-zA-Z]* = (\\|async function\\)\" | head -60 && echo \"=== voice server ===\" && git show origin/feat/read-with-you-v03:server/voice-library/synth.mjs | head -40","description":"Inspect remote V0.3 app structure and voice server"}}],"stop_reason":"tool_use","usage":{"input_tokens":52781,"output_tokens":195,"cache_read_input_tokens":50432,"total_tokens":52976}}},{"type":"user","uuid":"8f038560-64c3-49b6-b3a7-50e840073b50","session_id":"cf38db47-6a60-40d2-9f45-ef7feaff938c","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_xHERQwz6SWo6cSBVyXcj3449","is_error":false,"content":"// 陪你读书 V0.3 application wiring.\n//\n// Sections: settings, shelf, reading (foliate-js EPUB + TXT), continuous\n// listening (Narration + pluggable speech engines), notes, household voices,\n// 听世界. DOM-first, no framework: every screen is a section in index.html and\n// all persistence goes through lib/store.mjs (IndexedDB, local only).\n\nimport { makeBook } from '../vendor/foliate-js/view.js';\nimport { splitChapters, percent, secondsToMinutes } from './lib/text.mjs';\nimport { Narration, State } from './lib/narration.mjs';\nimport { bookFromTxt, mapEpubSections, pickText, paragraphsFromHtml, totalParagraphs } from './lib/book.mjs';\nimport { BrowserEngine, EndpointEngine, LibraryVoiceEngine, ToneEngine, isAbort } from './lib/engines.mjs';\nimport * as store from './lib/store.mjs';\nimport { BUILTIN_SOURCES, resolveDaypart, resolvePlaylist } from './lib/listening-world.mjs';\n\nconst $ = id => document.getElementById(id);\nconst params = new URLSearchParams(location.search);\nconst status = (message, tone = '') => {\n  const el = $('status');\n  el.textContent = message;\n  el.dataset.tone = tone;\n};\nconst now = () => new Date().toISOString();\n\n// --------------------------------------------------------------------------\n// Settings (localStorage holds small preferences; books/notes live in IndexedDB)\n// --------------------------------------------------------------------------\nconst SETTINGS_KEY = 'rw03-settings';\nconst DEFAULT_SETTINGS = {\n  engine: 'browser',\n  browserVoiceURI: '',\n  rate: 1,\n  endpoint: { baseUrl: '', model: '', voice: '', apiKey: '' },\n  library: { baseUrl: params.get('voiceLibrary') || '', token: '', voiceId: '' },\n  music: { volume: 0.18, ducking: true },\n  statistics: { days: {}, listenedMs: 0 },\n  worldFavourites: [],\n};\nconst mergeSettings = patch => ({\n  ...settings,\n  ...patch,\n  endpoint: { ...settings.endpoint, ...patch.endpoint },\n  library: { ...settings.library, ...patch.library },\n  music: { ...settings.music, ...patch.music },\n  statistics: { ...settings.statistics, ...patch.statistics },\n});\n\nlet settings = DEFAULT_SETTINGS;\ntry {\n  settings = mergeSettings(JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}'));\n} catch { /* corrupted preferences fall back to defaults */ }\nconst saveSettings = () => localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));\n\n// --------------------------------------------------------------------------\n// Speech engines\n// --------------------------------------------------------------------------\nlet narration = null;\nlet currentEngine = null;\nlet activeVoice = null;\n\nconst buildEngine = (kind = settings.engine) => {\n  if (kind === 'endpoint' && settings.endpoint.baseUrl) {\n    try {\n      return new EndpointEngine({ ...settings.endpoint, speed: settings.rate, name: settings.endpoint.model || '神经网络语音' });\n    } catch (error) {\n      status(`没接通语音服务：${error.message}`, 'warn');\n    }\n  }\n  if (kind === 'library' && activeVoice) {\n    return new LibraryVoiceEngine({\n      voiceId: activeVoice.id, name: activeVoice.name, speed: settings.rate,\n      baseUrl: settings.library.baseUrl, licenseToken: settings.library.token,\n    });\n  }\n  if (params.get('ttsTone') === '1') {\n    // Test-only voice, opted in per URL: it exists so the listening loop can be\n    // verified in a real browser without a network or model download.\n    return new ToneEngine({ speed: settings.rate });\n  }\n  return new BrowserEngine({ voiceURI: settings.browserVoiceURI, rate: settings.rate });\n...\n18:const status = (message, tone = '') => {\n23:const now = () => new Date().toISOString();\n52:const saveSettings = () => localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));\n61:const buildEngine = (kind = settings.engine) => {\n103:const saveProgress = (id, position) => {\n111:function progressLabel(book) {\n119:async function refreshShelf() {\n130:function renderShelf() {\n187:function renderResume() {\n198:async function importFiles(fileList) {\n253:async function removeBook(book) {\n274:async function openBook(book, { listen = false } = {}) {\n308:async function openTxt(book, token) {\n320:const parseNavDocument = (text, dir) => {\n330:    const label = (link?.textContent || '').trim();\n339:const parseNcxDocument = (text, dir) => {\n345:    const label = (point.querySelector('navLabel > text')?.textContent || '').trim();\n355:async function readEpubToc(epub) {\n373:async function openEpub(book, saved, token) {\n413:  const startSection = (saved.chapter ?? 0) >= 0 && narration?.active !== true ? Math.min(saved.chapter ?? 0, epub.sections.length - 1) : 0;\n421:function chapterIndexFromCfi(cfi) {\n431:function onEpubSectionLoad({ doc, index } = {}, bookId) {\n453:function setCursor(chapter, paragraph) {\n467:function renderChapterList() {\n485:function markCurrentChapter(index) {\n493:async function showParagraph(chapterIndex, paragraphIndex, { scroll = false } = {}) {\n534:function renderTxtPage(chapterIndex, { scroll = false } = {}) {\n552:async function goToChapter(index) {\n563:async function page(direction) {\n583:function closeBook() {\n600:const positionFromProgress = () => {\n605:function createNarration() {\n679:async function ensureNarration() {\n697:const isFinished = () => {\n703:function startPosition() {\n712:async function narrationFor(position) {\n719:async function startListening(position = null) {\n728:function togglePlay() {\n746:const toggleFromKeyboard = () => {\n756:function renderStats() {\n762:function recordListening(milliseconds) {\n773:function refreshEngineBadge() {\n786:const currentParagraphText = () => bookModel?.chapters[narration?.chapter ?? 0]?.paragraphs[currentParagraph] ?? '';\n788:async function renderNotes() {\n790:  const notes = (await store.listNotes(activeBook.id)).sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)));\n845:async function saveNote({ text, quote = '', ai = '' }) {\n865:async function askAI(question) {\n890:const baseVolume = () => Number($('musicVolume').value) || 0;\n892:function syncDucking() {\n898:function setMusicSource(blob, name) {\n908:async function restoreMusic() {\n916:const libraryFetch = (path, options = {}) => fetch(`${settings.library.baseUrl.replace(/\\/+$/, '')}${path}`, {\n921:const libraryConfigured = () => Boolean(settings.library.baseUrl);\n926:function chooseVoice(voice) {\n936:function restoreVoice() {\n944:function voiceCard(voice) {\n987:function renderVoiceList(statusText = '') {\n998:function refreshVoiceScreens() {\n1011:function renderPrivacyStats() {\n1026:function updateEngineControls() {\n=== voice server ===\n// A small, honest formant synthesiser used as the built-in voice of the\n// household voice library.\n//\n// It is NOT a neural voice clone and does not pretend to be one: it renders a\n// robotic but intelligible singing tone shaped by the consenting speaker's\n// sample pitch, so a family can immediately hear \"their\" voice slot working\n// end-to-end while a real cloning provider is configured. The README states this\n// limitation explicitly; the UI never claims a synthesised phrase is the\n// speaker's own recording.\n//\n// Pure function, no dependencies: text in, WAV bytes out. Deterministic.\n\nconst PUNCTUATION_PAUSE = 0.18;\n\nconst isSentenceEnd = ch => '。！？!?；;…\\n'.includes(ch);\n\n// Fallback vowel targets (F1, F2 Hz) — used when the text is not Chinese.\nconst VOWELS = {\n  a: [800, 1200], e: [500, 1800], i: [300, 2300], o: [500, 900], u: [350, 800], v: [320, 1900],\n};\n\n// Pinyin finals → approximate formant targets, enough for a recognisable,\n// pleasant robotic Mandarin reading.\nconst FINALS = [\n  [/iang$|uang$/i, [350, 2100]],\n  [/ang$|uan$|an$/i, [750, 1100]],\n  [/eng$|ing$|ong$|un$|en$|in$/i, [520, 1500]],\n  [/ian$/i, [400, 1900]],\n  [/iao$|ao$|iao/i, [720, 1050]],\n  [/iu$|ou$|uo$|o$/i, [520, 900]],\n  [/ai$|ei$/i, [600, 1700]],\n  [/u$/i, [350, 800]],\n  [/i$/i, [300, 2300]],\n];\n\nconst formantsFor = syllable => {\n  for (const [pattern, f] of FINALS) if (pattern.test(syllable)) return f;\n  const vowel = syllable.match(/[aeiou]/i)?.[0]?.toLowerCase();\n  return VOWELS[vowel] || [520, 1300];\n};"}]}},{"type":"assistant","uuid":"a7096bee-f67e-4436-aa53-e90fdf7e089b","session_id":"cf38db47-6a60-40d2-9f45-ef7feaff938c","parent_tool_use_id":null,"message":{"id":"a7096bee-f67e-4436-aa53-e90fdf7e089b","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_6sQVfm1MlVWEIjZyA3iB7448","name":"run_shell_command","input":{"command":"cd /home/runner/work/zero-one-workbench/zero-one-workbench && git show origin/feat/read-with-you-v03:portal/reader-v03/lib/narration.mjs | head -60 && echo \"=== store.mjs ===\" && git show origin/feat/read-with-you-v03:portal/reader-v03/lib/store.mjs | head -40 && echo \"=== book.mjs ===\" && git show origin/feat/read-with-you-v03:portal/reader-v03/lib/book.mjs | head -40","description":"Inspect remote V0.3 narration, store, book modules"}}],"stop_reason":"tool_use","usage":{"input_tokens":55322,"output_tokens":183,"cache_read_input_tokens":52480,"total_tokens":55505}}},{"type":"user","uuid":"d6c18bf2-6097-4fa2-ab00-8bd0136fd4b6","session_id":"cf38db47-6a60-40d2-9f45-ef7feaff938c","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_6sQVfm1MlVWEIjZyA3iB7448","is_error":false,"content":"// Book text model + playback state for continuous, cross-chapter listening.\n//\n// The reader builds one Book from either an EPUB (via foliate-js sections) or a\n// TXT (split into chapters). The narration queue walks paragraphs in order and\n// never stops at a chapter boundary: when a chapter ends it advances, continues\n// speaking, and reports the chapter change so the UI can turn the page behind\n// the audio. All position is expressed in paragraph units so it survives reloads\n// and works while the reading pane is hidden (screen locked / tab in background).\n//\n// Dependencies are injected (speak, onStateChange, onChunk, clock) so this core\n// is fully unit-testable in Node with fake timers.\n\nimport { chunkText, normalizeText } from './text.mjs';\n\nexport const State = Object.freeze({\n  IDLE: 'idle',\n  SPEAKING: 'speaking',\n  PAUSED: 'paused',\n  ENDED: 'ended',\n});\n\nexport class Narration {\n  constructor({ speak, onState = () => {}, onProgress = () => {}, onChunk = () => {}, onError = () => {}, clock = () => Date.now(), chunker = chunkText } = {}) {\n    this.speak = speak;\n    this.onState = onState;\n    this.onProgress = onProgress;\n    this.onChunk = onChunk;\n    this.onError = onError;\n    this.clock = clock;\n    this.chunker = chunker;\n    this.book = null;\n    this.state = State.IDLE;\n    this.resumeState = State.IDLE;\n    this.chapter = 0;\n    this.paragraph = 0;\n    this.chunkIndex = 0;\n    this.resumeAt = { chapter: 0, paragraph: 0 };\n    this.chunks = [];\n    this.listenedMs = 0;\n    this.startedAt = 0;\n    this.controller = null;\n    this.rate = 1;\n  }\n\n  load(book, position = null) {\n    this.book = book;\n    this.stop({ keepPosition: false });\n    this.state = State.IDLE;\n    this.jump(position ?? { chapter: 0, paragraph: 0 });\n  }\n\n  get active() {\n    return this.state === State.SPEAKING || this.state === State.PAUSED;\n  }\n\n  setState(state) {\n    this.state = state;\n    this.onState(state);\n  }\n\n=== store.mjs ===\n// IndexedDB persistence for the V0.3 reader.\n// The `books` store is shared with the previous C01 reader so an existing\n// library keeps working; settings, notes and audio storage use new, versioned\n// stores created by an additive migration (old data is never dropped).\n\nconst DB_NAME = 'zero-one-reader-library';\nconst DB_VERSION = 4;\n\nlet dbPromise = null;\n\nconst request = req => new Promise((resolve, reject) => {\n  req.onsuccess = () => resolve(req.result);\n  req.onerror = () => reject(req.error);\n});\n\nexport function openReaderDb() {\n  if (dbPromise) return dbPromise;\n  dbPromise = new Promise((resolve, reject) => {\n    const open = indexedDB.open(DB_NAME, DB_VERSION);\n    open.onupgradeneeded = () => {\n      const db = open.result;\n      if (!db.objectStoreNames.contains('books')) db.createObjectStore('books', { keyPath: 'id' });\n      if (!db.objectStoreNames.contains('settings')) db.createObjectStore('settings', { keyPath: 'id' });\n      if (!db.objectStoreNames.contains('notes')) {\n        const notes = db.createObjectStore('notes', { keyPath: 'id' });\n        notes.createIndex('bookId', 'bookId');\n      }\n      if (!db.objectStoreNames.contains('blobs')) db.createObjectStore('blobs', { keyPath: 'id' });\n    };\n    open.onsuccess = () => resolve(open.result);\n    open.onerror = () => reject(open.error);\n  });\n  return dbPromise;\n}\n\nlet current = null;\n\n// Resolves after the transaction commits, so callers can await durability\n// (IndexedDB fires `success` for the request slightly before commit).\nconst run = async (store, mode, fn) => {\n=== book.mjs ===\n// Book building: EPUB (via foliate-js in the browser) and TXT (pure).\n// Kept free of DOM APIs so TXT books can be built in tests.\n\nconst ENTITIES = { amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\", nbsp: ' ', mdash: '—', ndash: '–', hellip: '…', middot: '·', ldquo: '“', rdquo: '”', lsquo: '‘', rsquo: '’' };\n\nexport const decodeEntities = value => String(value ?? '')\n  .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))\n  .replace(/&#(\\d+);/g, (_, dec) => String.fromCodePoint(Number(dec)))\n  .replace(/&([a-z]+);/gi, (match, name) => ENTITIES[name.toLowerCase()] ?? match);\n\n// Extract paragraphs from an XHTML document s