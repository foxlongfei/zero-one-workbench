lf-contained rigged mesh pack for the Movement human model) and calibrate the skeleton against real bone geometry."}],"stop_reason":null,"usage":{"input_tokens":0,"output_tokens":0}}},{"type":"assistant","uuid":"3cafdf2c-fa9a-4e07-98e9-8dcfe5583f66","session_id":"eb902ebe-bf82-46d6-8e5c-a035c59e1ff7","parent_tool_use_id":null,"message":{"id":"3cafdf2c-fa9a-4e07-98e9-8dcfe5583f66","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_xbGkOnB44MHyXcUuCZzU8710","name":"write_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/scripts/movement/slice-atlas.py","content":"#!/usr/bin/env python3\n\"\"\"Build the Movement rigged-body mesh pack from the vendored Human Atlas.\n\nThe Human Atlas (portal/anatomy) is a 2,234-mesh BodyParts3D 4.0 release stored as\nquantized chunk binaries. That is an excellent anatomy viewer but far too heavy to\nskin for animation. This script reads only the chunks it needs, keeps a curated set of\nskeletal + muscular parts, stores them as float32 positions/normals and emits a\nclient-side skinning plan (weighted bones per mesh) that the Movement page applies.\n\nOutput: portal/data/movement-body-pack-v1.json  (+ printed calibration report)\n\nLicense: BodyParts3D 4.0, CC BY 4.0 (see portal/anatomy/ATTRIBUTION.md).\n\"\"\"\nimport base64\nimport json\nimport struct\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nATLAS = ROOT / \"portal/anatomy/models\"\nOUT = ROOT / \"portal/data/movement-body-pack-v1.json\"\n\nS = \"skeletal\"\nM = \"muscular\"\n\n# Curated parts. Every id was located in atlas.json by exact name during calibration\n# (see tools/movement-rig-calibration.json). Left-side names get mirrored bones in the UI.\nPARTS = [\n    # --- skeletal, trunk ---\n    (\"FJ3152\", \"hip_bone_r\", S, \"pelvis\"),\n    (\"FJ3288\", \"hip_bone_l\", S, \"pelvis\"),\n    (\"FJ3393\", \"sacrum\", S, \"pelvis\"),\n    (\"FJ3157\", \"vertebra_l1\", S, \"spine_lumbar\"),\n    (\"FJ3159\", \"vertebra_l2\", S, \"spine_lumbar\"),\n    (\"FJ3162\", \"vertebra_l3\", S, \"spine_lumbar\"),\n    (\"FJ3165\", \"vertebra_l4\", S, \"spine_lumbar\"),\n    (\"FJ3168\", \"vertebra_l5\", S, \"pelvis\"),\n    (\"FJ3156\", \"vertebra_t12\", S, \"spine_thoracic_low\"),\n    (\"FJ3155\", \"vertebra_t11\", S, \"spine_thoracic_low\"),\n    (\"FJ3154\", \"vertebra_t10\", S, \"spine_thoracic_low\"),\n    (\"FJ3173\", \"vertebra_t7\", S, \"spine_thoracic_upper\"),\n    (\"FJ3172\", \"vertebra_c7\", S, \"spine_thoracic_upper\"),\n    (\"FJ3290\", \"manubrium\", S, \"clavicle_r\"),\n    (\"FJ3178\", \"sternum_body\", S, \"clavicle_r\"),\n    (\"FJ3153\", \"xiphoid\", S, \"clavicle_r\"),\n    (\"FJ3334\", \"rib1_r\", S, \"clavicle_r\"),\n    (\"FJ3335\", \"rib2_r\", S, \"clavicle_r\"),\n    (\"FJ3336\", \"rib3_r\", S, \"clavicle_r\"),\n    (\"FJ3338\", \"rib4_r\", S, \"clavicle_r\"),\n    (\"FJ3342\", \"rib5_r\", S, \"clavicle_r\"),\n    (\"FJ3343\", \"rib6_r\", S, \"clavicle_r\"),\n    (\"FJ3228\", \"rib1_l\", S, \"clavicle_l\"),\n    (\"FJ3229\", \"rib2_l\", S, \"clavicle_l\"),\n    (\"FJ3230\", \"rib3_l\", S, \"clavicle_l\"),\n    (\"FJ3231\", \"rib4_l\", S, \"clavicle_l\"),\n    (\"FJ3232\", \"rib5_l\", S, \"clavicle_l\"),\n    (\"FJ3233\", \"rib6_l\", S, \"clavicle_l\"),\n    # --- skeletal, arms ---\n    (\"FJ3362\", \"clavicle_r\", S, \"clavicle_r\"),\n    (\"FJ3237\", \"clavicle_l\", S, \"clavicle_l\"),\n    (\"FJ3384\", \"scapula_r\", S, \"shoulder_r\"),\n    (\"FJ3279\", \"scapula_l\", S, \"shoulder_l\"),\n    (\"FJ3368\", \"humerus_r\", S, \"shoulder_r\"),\n    (\"FJ3262\", \"humerus_l\", S, \"shoulder_l\"),\n    (\"FJ3391\", \"ulna_r\", S, \"elbow_r\"),\n    (\"FJ3286\", \"ulna_l\", S, \"elbow_l\"),\n    (\"FJ3349\", \"radius_r\", S, \"elbow_r\"),\n    (\"FJ3277\", \"radius_l\", S, \"elbow_l\"),\n    # --- skeletal, legs ---\n    (\"FJ3365\", \"femur_r\", S, \"hip_r\"),\n    (\"FJ3259\", \"femur_l\", S, \"hip_l\"),\n    (\"FJ3381\", \"patella_r\", S, \"knee_r\"),\n    (\"FJ3275\", \"patella_l\", S, \"knee_l\"),\n    (\"FJ3387\", \"tibia_r\", S, \"knee_r\"),\n    (\"FJ3282\", \"tibia_l\", S, \"knee_l\"),\n    (\"FJ3366\", \"fibula_r\", S, \"knee_r\"),\n    (\"FJ3260\", \"fibula_l\", S, \"knee_l\"),\n    (\"FJ3360\", \"calcaneus_r\", S, \"ankle_r\"),\n    (\"FJ3256\", \"calcaneus_l\", S, \"ankle_l\"),\n    (\"FJ3353\", \"metatarsal2_r\", S, \"ankle_r\"),\n    (\"FJ3244\", \"metatarsal2_l\", S, \"ankle_l\"),\n    # --- chest / shoulder girdle muscles ---\n    (\"FJ1447\", \"pec_major_clav_r\", M, \"shoulder_r\"),\n    (\"FJ1464\", \"pec_major_stern_r\", M, \"shoulder_r\"),\n    (\"FJ1446\", \"pec_major_abd_r\", M, \"shoulder_r\"),\n    (\"FJ1447M\", \"pec_major_clav_l\", M, \"shoulder_l\"),\n    (\"FJ1464M\", \"pec_major_stern_l\", M, \"shoulder_l\"),\n    (\"FJ1446M\", \"pec_major_abd_l\", M, \"shoulder_l\"),\n    (\"FJ1468\", \"deltoid_front_r\", M, \"shoulder_r\"),\n    (\"FJ1467\", \"deltoid_side_r\", M, \"shoulder_r\"),\n    (\"FJ1513\", \"deltoid_back_r\", M, \"shoulder_r\"),\n    (\"FJ1468M\", \"deltoid_front_l\", M, \"shoulder_l\"),\n    (\"FJ1467M\", \"deltoid_side_l\", M, \"shoulder_l\"),\n    (\"FJ1513M\", \"deltoid_back_l\", M, \"shoulder_l\"),\n    (\"FJ1459\", \"serratus_r\", M, \"clavicle_r\"),\n    (\"FJ1459M\", \"serratus_l\", M, \"clavicle_l\"),\n    # --- arm muscles (rigid with humerus / forearm) ---\n    (\"FJ1479\", \"triceps_long_r\", M, \"shoulder_r\"),\n    (\"FJ1477\", \"triceps_lat_r\", M, \"shoulder_r\"),\n    (\"FJ1480\", \"triceps_med_r\", M, \"shoulder_r\"),\n    (\"FJ1479M\", \"triceps_long_l\", M, \"shoulder_l\"),\n    (\"FJ1477M\", \"triceps_lat_l\", M, \"shoulder_l\"),\n    (\"FJ1480M\", \"triceps_med_l\", M, \"shoulder_l\"),\n    (\"FJ1478\", \"biceps_long_r\", M, \"shoulder_r\"),\n    (\"FJ1512\", \"biceps_short_r\", M, \"shoulder_r\"),\n    (\"FJ1478M\", \"biceps_long_l\", M, \"shoulder_l\"),\n    (\"FJ1512M\", \"biceps_short_l\", M, \"shoulder_l\"),\n    # --- back muscles ---\n    (\"FJ1536\", \"rhomboid_major_r\", M, \"shoulder_r\"),\n    (\"FJ1536M\", \"rhomboid_major_l\", M, \"shoulder_l\"),\n    (\"FJ1507\", \"teres_major_r\", M, \"shoulder_r\"),\n    (\"FJ1507M\", \"teres_major_l\", M, \"shoulder_l\"),\n    (\"FJ1508\", \"teres_minor_r\", M, \"shoulder_r\"),\n    (\"FJ1508M\", \"teres_minor_l\", M, \"shoulder_l\"),\n    (\"FJ1500\", \"infraspinatus_r\", M, \"shoulder_r\"),\n    (\"FJ1500M\", \"infraspinatus_l\", M, \"shoulder_l\"),\n    (\"FJ1506\", \"supraspinatus_r\", M, \"shoulder_r\"),\n    (\"FJ1506M\", \"supraspinatus_l\", M, \"shoulder_l\"),\n    (\"FJ1504\", \"subscapularis_r\", M, \"shoulder_r\"),\n    (\"FJ1504M\", \"subscapularis_l\", M, \"shoulder_l\"),\n    (\"FJ1521\", \"trapezius_upper_r\", M, \"clavicle_r\"),\n    (\"FJ1554\", \"trapezius_mid_r\", M, \"spine_thoracic_upper\"),\n    (\"FJ1520\", \"trapezius_lower_r\", M, \"spine_thoracic_upper\"),\n    (\"FJ1521M\", \"trapezius_upper_l\", M, \"clavicle_l\"),\n    (\"FJ1554M\", \"trapezius_mid_l\", M, \"spine_thoracic_upper\"),\n    (\"FJ1520M\", \"trapezius_lower_l\", M, \"spine_thoracic_upper\"),\n    (\"FJ1535\", \"longissimus_r\", M, \"spine_thoracic_low\"),\n    (\"FJ1535M\", \"longissimus_l\", M, \"spine_thoracic_low\"),\n    (\"FJ1528\", \"iliocostalis_r\", M, \"spine_thoracic_low\"),\n    (\"FJ1528M\", \"iliocostalis_l\", M, \"spine_thoracic_low\"),\n    (\"FJ1540\", \"semispinalis_r\", M, \"spine_thoracic_upper\"),\n    (\"FJ1540M\", \"semispinalis_l\", M, \"spine_thoracic_upper\"),\n    (\"FJ1544\", \"spinalis_r\", M, \"spine_thoracic_low\"),\n    (\"FJ1544M\", \"spinalis_l\", M, \"spine_thoracic_low\"),\n    # --- trunk / core / hip muscles ---\n    (\"FJ1452\", \"ext_oblique_r\", M, \"spine_thoracic_low\"),\n    (\"FJ1452M\", \"ext_oblique_l\", M, \"spine_thoracic_low\"),\n    (\"FJ1461\", \"transv_thoracis_r\", M, \"spine_thoracic_low\"),\n    (\"FJ1461M\", \"transv_thoracis_l\", M, \"spine_thoracic_low\"),\n    (\"FJ3131\", \"diaphragm\", M, \"spine_thoracic_low\"),\n    (\"FJ1451\", \"intercostal_r\", M, \"clavicle_r\"),\n    (\"FJ1451M\", \"intercostal_l\", M, \"clavicle_l\"),\n    (\"FJ1431\", \"psoas_r\", M, \"pelvis\"),\n    (\"FJ1431M\", \"psoas_l\", M, \"pelvis\"),\n    (\"FJ1418\", \"gluteus_max_r\", M, \"hip_r\"),\n    (\"FJ1418M\", \"gluteus_max_l\", M, \"hip_l\"),\n    (\"FJ1419\", \"gluteus_med_r\", M, \"pelvis\"),\n    (\"FJ1419M\", \"gluteus_med_l\", M, \"pelvis\"),\n    (\"FJ1420\", \"gluteus_min_r\", M, \"pelvis\"),\n    (\"FJ1420M\", \"gluteus_min_l\", M, \"pelvis\"),\n    # --- thigh ---\n    (\"FJ1433\", \"rectus_femoris_r\", M, \"hip_r\"),\n    (\"FJ1442\", \"vastus_lateralis_r\", M, \"hip_r\"),\n    (\"FJ1443\", \"vastus_medialis_r\", M, \"hip_r\"),\n    (\"FJ1441\", \"vastus_intermedius_r\", M, \"hip_r\"),\n    (\"FJ1434\", \"sartorius_r\", M, \"hip_r\"),\n    (\"FJ1402\", \"adductor_longus_r\", M, \"hip_r\"),\n    (\"FJ1403\", \"adductor_magnus_r\", M, \"hip_r\"),\n    (\"FJ1395\", \"biceps_femoris_long_r\", M, \"hip_r\"),\n    (\"FJ1444\", \"biceps_femoris_short_r\", M, \"hip_r\"),\n    (\"FJ1436\", \"semitendinosus_r\", M, \"hip_r\"),\n    (\"FJ1433M\", \"rectus_femoris_l\", M, \"hip_l\"),\n    (\"FJ1442M\", \"vastus_lateralis_l\", M, \"hip_l\"),\n    (\"FJ1443M\", \"vastus_medialis_l\", M, \"hip_l\"),\n    (\"FJ1441M\", \"vastus_intermedius_l\", M, \"hip_l\"),\n    (\"FJ1434M\", \"sartorius_l\", M, \"hip_l\"),\n    (\"FJ1402M\", \"adductor_longus_l\", M, \"hip_l\"),\n    (\"FJ1403M\", \"adductor_magnus_l\", M, \"hip_l\"),\n    (\"FJ1395M\", \"biceps_femoris_long_l\", M, \"hip_l\"),\n    (\"FJ1444M\", \"biceps_femoris_short_l\", M, \"hip_l\"),\n    (\"FJ1436M\", \"semitendinosus_l\", M, \"hip_l\"),\n    # --- lower leg ---\n    (\"FJ1397\", \"gastrocnemius_med_r\", M, \"knee_r\"),\n    (\"FJ1394\", \"gastrocnemius_lat_r\", M, \"knee_r\"),\n    (\"FJ1437\", \"soleus_r\", M, \"knee_r\"),\n    (\"FJ1439\", \"tibialis_anterior_r\", M, \"knee_r\"),\n    (\"FJ1439M\", \"tibialis_anterior_l\", M, \"knee_l\"),\n    (\"FJ1397M\", \"gastrocnemius_med_l\", M, \"knee_l\"),\n    (\"FJ1394M\", \"gastrocnemius_lat_l\", M, \"knee_l\"),\n    (\"FJ1437M\", \"soleus_l\", M, \"knee_l\"),\n]\n\n# Regions of one body part, if a single mesh spans two bones (e.g. the gluteus\n# maximus extends from the iliac crest to the femur). Bones are chosen by the\n# fraction of the part's own extent along +Y (0 = lowest vertex).\nSPLITS = {\n    \"gluteus_max_r\": [(0.30, \"hip_r\", \"pelvis\"), (1.01, \"pelvis\", \"hip_r\")],\n    \"gluteus_max_l\": [(0.30, \"hip_l\", \"pelvis\"), (1.01, \"pelvis\", \"hip_l\")],\n    \"semispinalis_r\": [(0.45, \"spine_thoracic_low\", \"spine_thoracic_upper\"), (1.01, \"spine_thoracic_upper\", \"spine_thoracic_low\")],\n    \"semispinalis_l\": [(0.45, \"spine_thoracic_low\", \"spine_thoracic_upper\"), (1.01, \"spine_thoracic_upper\", \"spine_thoracic_low\")],\n    \"trapezius_lower_r\": [(0.55, \"spine_thoracic_upper\", \"clavicle_r\"), (1.01, \"clavicle_r\", \"spine_thoracic_upper\")],\n    \"trapezius_lower_l\": [(0.55, \"spine_thoracic_upper\", \"clavicle_l\"), (1.01, \"clavicle_l\", \"spine_thoracic_upper\")],\n    \"trapezius_mid_r\": [(0.5, \"spine_thoracic_upper\", \"clavicle_r\"), (1.01, \"clavicle_r\", \"spine_thoracic_upper\")],\n    \"trapezius_mid_l\": [(0.5, \"spine_thoracic_upper\", \"clavicle_l\"), (1.01, \"clavicle_l\", \"spine_thoracic_upper\")],\n    \"serratus_r\": [(0.5, \"clavicle_r\", \"spine_thoracic_low\"), (1.01, \"spine_thoracic_low\", \"clavicle_r\")],\n    \"serratus_l\": [(0.5, \"clavicle_l\", \"spine_thoracic_low\"), (1.01, \"spine_thoracic_low\", \"clavicle_l\")],\n}\n\nSYSTEM_COLORS = {\n    \"skeletal\": [0.86, 0.83, 0.74],\n    \"muscular\": [0.72, 0.30, 0.28],\n}\n\n\ndef read_chunk(index):\n    \"\"\"Yield part geometry keyed by id from a quantized chunk binary.\"\"\"\n    meta = CHUNKS[index]\n    data = (ATLAS / f\"body-{index}.bin\").read_bytes()\n    by_id = {}\n    for part in meta[\"parts\"]:\n        def take(offset, count, struct_fmt, itemsize):\n            raw = data[offset: offset + count * itemsize]\n            return struct.unpack(\"<\" + struct_fmt * count, raw)\n\n        if part.get(\"quantized\"):\n            scale = part[\"quantScale\"]\n            origin = part[\"quantOrigin\"]\n            pos = take(part[\"positions\"], part[\"vertexCount\"] * 3, \"h\", 2)\n            pos = [pos[i] * scale[i % 3] + origin[i % 3] for i in range(len(pos))]\n            nrm = take(part[\"normals\"], part[\"vertexCount\"] * 3, \"h\", 2)\n            nrm = [max(-1.0, min(1.0, nrm[i] / 32767.0)) for i in range(len(nrm))]\n        else:\n            pos = take(part[\"positions\"], part[\"vertexCount\"] * 3, \"f\", 4)\n            nrm = take(part[\"normals\"], part[\"vertexCount\"] * 3, \"f\", 4)\n        idx = take(part[\"indices\"], part[\"indexCount\"], \"I\", 4)\n        by_id[part[\"id\"]] = {\"pos\": pos, \"nrm\": nrm, \"idx\": idx}\n    return by_id\n\n\ndef main():\n    global CHUNKS\n    manifest = json.loads((ATLAS / \"atlas.json\").read_text())\n    CHUNKS = []\n    for part in manifest[\"parts\"]:\n        chunk = part[\"chunk\"]\n        while len(CHUNKS) <= chunk:\n            CHUNKS.append({\"parts\": []})\n        CHUNKS[chunk][\"parts\"].append(part)\n\n    wanted = {}\n    for pid, slug, system, bone in PARTS:\n        wanted.setdefault(pid, []).append((slug, system, bone))\n\n    packs = []\n    used_chunks = sorted({next(p[\"chunk\"] for p in manifest[\"parts\"] if p[\"id\"] == pid) for pid in wanted})\n    for chunk in used_chunks:\n        geometry = read_chunk(chunk)\n        for pid in [pid for pid in wanted if next(p[\"chunk\"] for p in manifest[\"parts\"] if p[\"id\"] == pid) == chunk]:\n            if pid not in geometry:\n                raise SystemExit(f\"missing geometry for {pid}\")\n        for pid, metas in list(wanted.items()):\n            names = {m[\"slug\"] for m in metas}\n            if not names: