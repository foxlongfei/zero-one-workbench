nt.getElementById(`${name}Panel`);\n  return Boolean(panel) && !panel[HIDDEN_KEY];\n}\n\nexport function el(tag, props = {}, ...children) {\n  const node = document.createElement(tag);\n  for (const [key, value] of Object.entries(props)) {\n    if (value == null) continue;\n    if (key === 'class') node.className = value;\n    else if (key === 'dataset') Object.assign(node.dataset, value);\n    else if (key === 'text') node.textContent = value;\n    else if (key.startsWith('on') && typeof value === 'function') node.addEventListener(key.slice(2).toLowerCase(), value);\n    else if (key in node) node[key] = value;\n    else node.setAttribute(key, value);\n  }\n  node.append(...children.filter(child => child != null));\n  return node;\n}\n\nexport function formatTime(stamp) {\n  if (!stamp) return '';\n  try {\n    return new Date(stamp).toLocaleString('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });\n  } catch {\n    return '';\n  }\n}\n\nexport function clipped(text, length = 90) {\n  const value = String(text ?? '').replace(/\\s+/g, ' ').trim();\n  return value.length > length ? `${value.slice(0, length)}…` : value;\n}\n"}]}},{"type":"assistant","uuid":"a7422680-7b78-401f-92aa-6a5f0f66f75b","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"a7422680-7b78-401f-92aa-6a5f0f66f75b","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_UJvJYK7lmuYWw5L0N4vv1439","name":"edit","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/ui.js","new_string":"export function openPanel(name) {\n  closePanels();\n  const panel = document.getElementById(`${name}Panel`);\n  if (!panel) return null;\n  // `hidden` is an HTML boolean attribute; writing the `hidden` JS property does\n  // not remove it, so set the attribute itself.\n  panel.removeAttribute('hidden');\n  document.body.classList.add('panels-open');\n