romium\n        run: |\n          mkdir -p artifacts/portal-delivery\n          node scripts/portal-delivery-smoke.cjs\n      - name: Verify fortune-teller product journeys\n        env:\n          FORTUNE_BASE_URL: http://127.0.0.1:4173\n        run: node scripts/fortune-teller-browser-verify.cjs\n      - name: Save screenshots and machine-readable results\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: portal-delivery-${{ github.sha }}\n          path: artifacts/portal-delivery/\n          if-no-files-found: warn\n=== d-reader-v03 ===\nname: D博士 V0.3 独立原型交付\non:\n  workflow_dispatch:\n  push:\n    paths:\n      - '.github/workflows/d-reader-v03-delivery.yml'\npermissions:\n  contents: write\n  pull-requests: write\n  issues: write\nconcurrency:\n  group: d-reader-v03-${{ github.run_id }}\n  cancel-in-progress: false\njobs:\n  develop:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 55\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - name: Gather latest user instructions\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          mkdir -p /tmp/reader-v03\n          gh issue view 42 --json title,body,comments > /tmp/reader-v03/issue-42.json\n          git ls-files > /tmp/reader-v03/files.txt\n      - name: D博士自主开发V0.3原型\n        uses: QwenLM/qwen-code-action@v1\n        with:\n          openai_api_key: ${{ secrets.DEEPSEEK_API_KEY }}\n          openai_base_url: https://api.deepseek.com/v1\n          openai_model: deepseek-chat\n          prompt: |\n            You are D博士 (DeepSeek), independent product owner for 陪你读书 V0.3.\n            Read /tmp/reader-v03/issue-42.json, especially the newest user instructions.\n            Only V0.3 is active. Older C01/V0.1/V0.2 implementations and PRs are historical optional references, not tasks to continue.\n            The user authorizes immediate implementation without a plan-only waiting gate.\n           