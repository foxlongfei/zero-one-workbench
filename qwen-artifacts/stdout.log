-bar{position:sticky;top:0;z-index:20;display:flex;gap:8px;align-items:center;padding:10px 0;background:rgba(246,242,233,.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);flex-wrap:wrap}\n.reader-bar h2{flex:1;min-width:120px;margin:0;font-size:16px;font-weight:550;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.tabs{display:flex;gap:4px;background:#ece7db;padding:4px;border-radius:12px}.tabs button{border:0;background:transparent;padding:6px 12px;border-radius:9px;font-size:13px}.tabs button[aria-selected=\"true\"]{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.08)}\n.page{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(20px,5vw,52px);margin:18px 0;font-family:Georgia,\"Noto Serif SC\",\"Songti SC\",serif;font-size:var(--reader-size,19px);line-height:var(--reader-leading,2);max-height:62vh;overflow:auto;scroll-behavior:smooth}\n.page p{margin:0 0 1.1em;text-indent:2em}.page h2{font-size:1.25em;margin:1.4em 0 .8em;text-indent:0}\n.page p.active{background:linear-gradient(90deg,rgba(63,107,85,.14),rgba(63,107,85,.02));border-radius:6px;box-shadow:0 0 0 6px rgba(63,107,85,.08);text-indent:2em}\n.serif-left{color:var(--ink-soft);font-size:13px;text-align:center}\n.narration{position:sticky;bottom:12px;z-index:30;display:grid;gap:8px;background:rgba(255,253,248,.98);border:1px solid var(--line);border-radius:18px;padding:12px 16px;box-shadow:0 14px 34px rgba(40,50,40,.16);margin:8px auto 0;max-width:820px}\n.narration .row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n.narration .meta{font-size:12px;color:var(--ink-soft);flex:1;min-width:120px}\n.narration .now{font-size:13px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}\n.narration .controls{display:flex;gap:6px;align-items:center;flex-wrap:wrap}\n.narration input[type=range]{flex:1;min-width:120px;accent-color:var(--accent)}\n.panel{background:var(--card);border:1px solid var(--line);