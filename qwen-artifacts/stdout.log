onst n = new Narrator({\n    speak(sentence, done) { spoken.push(sentence.text); queueMicrotask(done); },\n    cancel() {},\n  });\n  const events = [];\n  n.addEventListener('ended', () => events.push('ended'));\n  n.load([{ text: 'a' }, { text: 'b' }]);\n  await n.play();\n  assert.deepEqual(spoken, ['a', 'b']);\n  assert.equal(n.state, 'ended');\n  assert.deepEqual(events, ['ended']);\n});\n\ntest('Narrator.pause/resume 保持同一句继续', async () => {\n  let finish = null;\n  const n = new Narrator({\n    speak(_s, done) { finish = done; },\n    cancel() {},\n  });\n  n.load([{ text: 'a' }, { text: 'b' }]);\n  const playing = n.play();\n  await Promise.resolve();\n  assert.equal(n.state, 'speaking');\n  n.pause();\n  assert.equal(n.state, 'paused');\n  n.resume();\n  assert.equal(n.state, 'speaking');\n  // 第一句结束，第二句让 speak 立刻完成\n  const first = finish;\n  finish = null;\n  const n2 = new Narrator({ speak(_s, done) { queueMicrotask(done); }, cancel() {} });\n  n2.load([{ text: 'a' }, { text: 'b' }], 1);\n  await n2.play();\n  assert.equal(n2.state, 'ended');\n  first();\n  n.stop();\n  await playing;\n});\n\ntest('Narrator.seek 取消旧句子，中止后不再前进', async () => {\n  const calls = [];\n  let cancels = 0;\n  const n = new Narrator({\n    speak(sentence, done) { calls.push(sentence.text); if (sentence.text !== 'a') queueMicrotask(done); },\n    cancel() { cancels++; },\n  });\n  n.load([{ text: 'a' }, { text: 'b' }, { text: 'c' }]);\n  const playing = n.play();\n  await Promise.resolve();\n  assert.deepEqual(calls, ['a']);\n  n.seek(2);\n  await playing;\n  await new Promise(r => setTimeout(r, 10));\n  assert.ok(cancels >= 1);\n  assert.ok(calls.includes('c'));\n});\n\ntest('Narrator.load 派发 load 事件，供页面使旧回调失效', () => {\n  const n = new Narrator({ speak() {}, cancel() {} });\n  let detail = null;\n  n.addEventListener('load', e => { detail = e.detail; });\n  n.load([{ text: 'a' }, { text: 'b' }], 1);\n  assert.deepEqual(detail, { length: 2, startIndex: 1 });\n  assert.equal(n.index, 1);\n});\n\ntest('Narrator 朗读失败时上报 error 并回到 idle', async () => {\n  const n = new Narrator({\n    speak(_s, _done, fail) { fail(new Error('not-allowed')); },\n    cancel() {},\n  });\n  let error = null;\n  n.addEventListener('error', e => { error = e.detail.error; });\n  n.load([{ text: 'a' }]);\n  await n.play();\n  assert.equal(error?.message, 'not-allowed');\n  assert.equal(n.state, 'idle');\n});\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/tests/reader/unit/narrator.test.mjs"}}],"stop_reason":"tool_use","usage":{"input_tokens":58395,"output_tokens":1162,"cache_read_input_tokens":57600,"total_tokens":59557}}},{"type":"user","uuid":"cd4cdb10-e98e-46ca-9726-1fb273a66526","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_9X6WWcoV63w95lGVWY4x4707","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/tests/reader/unit/narrator.test.mjs."}]}},{"type":"assistant","uuid":"f22e51f9-2cb8-4ff4-9518-2390bc03057d","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"id":"f22e51f9-2cb8-4ff4-9518-2390bc03057d","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_rKh8U1FArtYKXusvICYb5457","name":"write_file","input":{"content":"// 文字与笔记工具的单元测试：node --test tests/reader/unit\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {\n  splitTxtChapters, txtParagraphs, makeNote, noteMatches, formatDuration,\n} from '../../../portal/reader/text.js';\n\ntest('splitTxtChapters 识别「第X章」并把开篇独立成章', () => {\n  const chapters = splitTxtChapters('书名\\n\\n第一章 清晨\\n第一段。\\n\\n第二章 小路\\n第二段。');\n  assert.equal(chapters.length, 3);\n  assert.equal(chapters[0].title, '开篇');\n  assert.equal(chapters[1].title, '第一章 清晨');\n  assert.ok(chapters[2].text.includes('第二段。'));\n});\n\ntest('splitTxtChapters 兼容 Chapter N 与 CRLF', () => {\n  const chapters = splitTxtChapters('Chapter 1\\r\\nHello there.\\r\\nChapter 2\\r\\nBye.');\n  assert.deepEqual(chapters.map(c => c.title), ['Chapter 1', 'Chapter 2']);\n  assert.equal(chapters[0].text, 'Hello there.');\n});\n\ntest('splitTxtChapters 对空文本返回空数组', () => {\n  assert.deepEqual(splitTxtChapters('   \\n\\n '), []);\n});\n\ntest('txtParagraphs 去掉空行并 trim', () => {\n  assert.deepEqual(txtParagraphs(' a \\n\\n\\n b \\n'), ['a', 'b']);\n});\n\ntest('makeNote 记录书籍、引用与时间', () => {\n  const note = makeNote({ bookId: 'b1', text: '  想法  ', quote: '引用  文字', tags: ['孩子', '问题'] });\n  assert.equal(note.bookId, 'b1');\n  assert.equal(note.text, '想法');\n  assert.equal(note.quote, '引用 文字');\n  assert.deepEqual(note.tags, ['孩子', '问题']);\n  assert.ok(note.id.startsWith('note-'));\n  assert.ok(note.createdAt > 0);\n});\n\ntest('makeNote 最多保留 5 个标签', () => {\n  const note = makeNote({ bookId: 'b1', text: 'x', tags: ['a', 'b', 'c', 'd', 'e', 'f'] });\n  assert.equal(note.tags.length, 5);\n});\n\ntest('noteMatches 匹配正文、引用、章节，空查询全部命中', () => {\n  const note = makeNote({ bookId: 'b', text: '关于风', quote: 'wind', chapter: '第三章' });\n  assert.equal(noteMatches(note, ''), true);\n  assert.equal(noteMatches(note, '风'), true);\n  assert.equal(noteMatches(note, 'WIND'), true);\n  assert.equal(noteMatches(note, '三'), true);\n  assert.equal(noteMatches(note, '雨'), false);\n});\n\ntest('formatDuration 输出中文时长', () => {\n  assert.equal(formatDuration(0), '0 秒');\n  assert.equal(formatDuration(90), '2 分钟');\n  assert.equal(formatDuration(3700), '1 小时 2 分');\n});\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/tests/reader/unit/text.test.mjs"}}],"stop_reason":"tool_use","usage":{"input_tokens":59605,"output_tokens":789,"cache_read_input_tokens":58112,"total_tokens":60394}}},{"type":"user","uuid":"35c6a674-54a3-492a-9c35-f5cb55b9c652","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_rKh8U1FArtYKXusvICYb5457","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/tests/reader/unit/text.test.mjs."}]}},{"type":"assistant","uuid":"ed6cde79-8faa-4929-8404-0c49d617b546","session_id":"f258c233-dbd5-43a1-9692-41d6f021d038","parent_tool_use_id":null,"message":{"id":"ed6cde79-8faa-4929-8404-0c49d617b546","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_LWTJFoOz8LUrmeOKufCu2363","name":"write_file","input":{"content":"// 家庭声音授权的单元测试：node --test tests/reader/unit\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {\n  CONSENT_ITEMS, CONSENT_VERSION, validateConsent, sampleProblem, analyzePcm,\n  makeVoiceRecord, revokeVoice, canUseVoice, describeVoice,\n} from '../../../portal/reader/voices.js';\n\nconst fullConsent = Object.fromEntries(CONSENT_ITEMS.map(i => [i.id, true]));\n\nfunction tone(n, sampleRate, hz = 220) {\n  const out = new Float32Array(n);\n  for (let i = 0; i < n; i++) out[i] = Math.sin((2 * Math.PI * hz * i) / sampleRate) * 0.5;\n  return out;\n}\n\ntest('validateConsent 要求全部条款，缺一项也拒绝', () => {\n  assert.equal(validateConsent(fullConsent).ok, true);\n  const partial = { ...fullConsent, revoke: false };\n  const res = validateConsent(partial);\n  assert.equal(res.ok, false);\n  assert.deepEqual(res.missing, ['revoke']);\n  assert.equal(validateConsent(null).ok, false);\n});\n\ntest('sampleProblem 限制 3–30 秒', () => {\n  assert.match(sampleProblem(1), /太短/);\n  assert.equal(sampleProblem(5), '');\n  assert.match(sampleProblem(45), /太长/);\n});\n\ntest('analyzePcm 给出时长、峰值与语速倾向', () => {\n  const features = analyzePcm(tone(48000, 48000), 48000);\n  assert.equal(features.duration, 1);\n  assert.ok(features.peak > 0.4);\n  assert.equal(typeof features.rateBias, 'number');\n  assert.ok(features.rateBias > 0.6 && features.rateBias < 1.8);\n  assert.ok(features.analyzedAt);\n});\n\ntest('analyzePcm 对空样本返回 null', () => {\n  assert.equal(analyzePcm(new Float32Array(0), 48000), null);\n  assert.equal(analyzePcm(null, 48000), null);\n});\n\ntest('makeVoiceRecord 固化授权版本与条款快照', () => {\n  const record = makeVoiceRecord({\n    name: '妈妈', speaker: '妈妈', features: analyzePcm(tone(48000, 48000), 48000), consent: fullConsent,\n  });\n  assert.equal(record.status, 'active');\n  assert.equal(record.consent.version, CONSENT_VERSION);\n  assert.deepEqual(record.consent.items, CONSENT_ITEMS.map(i => i.id));\n  assert.equal(canUseVoice(record), true);\n});\n\ntest('没有撤销条款的声音不可使用', () => {\n  const record = makeVoiceRecord({ name: 'x', features: null, consent: { ...fullConsent, revoke: false } });\n  assert.equal(canUseVoice(record), false);\n});\n\ntest('revokeVoice 抹掉特征与样本信息，并禁止再使用', () => {\n  const record = makeVoiceRecord({ name: '奶奶', features: { duration: 4, pitch: 1.1 }, consent: fullConsent, sampleMeta: { seconds: 4 } });\n  const revoked = revokeVoice(record);\n  assert.equal(revoked.status, 'revoked');\n  assert.equal(revoked.features, null);\n  assert.deepEqual(revoked.sampleMeta, {});\n  assert.ok(revoked.revokedAt);\n  assert.equal(canUseVoice(revoked), false);\n  assert.match(describeVoice(revoked), /已撤销/);\n});\n\ntest('revokeVoice 对空记录安全返回 null', () => {\n  assert.equal(revokeVoice(null), null);\n});\n\ntest('describeVoice 带出关系与样本时长', () => {\n  const record = makeVoiceRecord({ name: '爸爸', relationship: '父亲', features: { duration: 6, pitch: 0.9 }, consent: fullConsent });\n  assert.match(describeVoice(record), /爸爸（父亲）/);\n  assert.match(describeVoice(record), /6 秒/);\n});\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/tests/reader/unit/voices.test.mjs"}}],"stop_reason":"tool_use","usage":{"input_tokens":60440,"output_tokens":1021,"cache_read_input_tokens":59264,"total_tokens":61461}}},{"type":"user","uuid":"ee5c8d7d-c582-432d-a8e6-46f64a49a8a5","session_id"