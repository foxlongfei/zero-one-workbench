rk/zero-one-workbench/zero-one-workbench && python3 - <<'EOF'\nimport json,struct\na=json.load(open('portal/anatomy/models/atlas.json'))\nch=[None]*20\nimport glob,re\nfor f in glob.glob('portal/anatomy/models/body-*.bin'):\n    i=int(re.search(r'body-(\\d+)',f).group(1)); ch[i]=open(f,'rb').read()\ndef geo(pid):\n    p=next(x for x in a['parts'] if x['id']==pid)\n    b=ch[p['chunk']]\n    pos=struct.unpack_from('<%df'%(3*p['vertexCount']), b, p['positions'])\n    idx=struct.unpack_from('<%dH'%p['indexCount'], b, p['indices'])\n    return p,pos,idx\nfor pid in ['FJ3259','FJ3365','FJ3262','FJ3368','FJ3277','FJ3349','FJ3286','FJ3391','FJ3200','FJ3274']:\n    p,pos,idx=geo(pid)\n    print(pid,p['name'],p['vertexCount'],p['indexCount'],[round(v,3) for v in p['bounds'][0]],[round(v,3) for v in p['bounds'][1]])\nEOF","description":"Decode a few bones to confirm format"}}],"stop_reason":"tool_use","usage":{"input_tokens":38089,"output_tokens":373,"cache_read_input_tokens":37888,"total_tokens":38462}}},{"type":"user","uuid":"d645919c-04df-4583-a49f-b5f44ba7dc63","session_id":"cef6745e-92bb-4fe4-9624-333962f2ed08","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_rY1ejDPFHfhnVv8Q5SNg2674","is_error":false,"content":"FJ3259 Left femur 459 2652 [0.032, 0.446, -0.051] [0.15, 0.912, 0.012]\nFJ3365 Right femur 480 2790 [-0.15, 0.446, -0.05] [-0.032, 0.912, 0.012]\nFJ3262 Left humerus 586 2886 [0.14, 1.107, -0.049] [0.241, 1.415, 0.0]\nFJ3368 Right humerus 794 3210 [-0.241, 1.107, -0.049] [-0.14, 1.415, 0.0]\nFJ3277 Left radius 250 1218 [0.22, 0.884, -0.039] [0.279, 1.113, 0.027]\nFJ3349 Right radius 249 1224 [-0.28, 0.884, -0.039] [-0.22, 1.113, 0.027]\nFJ3286 Left ulna 283 1302 [0.197, 0.883, -0.055] [0.247, 1.131, 0.023]\nFJ3391 Right ulna 305 1446 [-0.247, 0.883, -0.055] [-0.197, 1.131, 0.023]\nFJ3200 Frontal bone 3315 15336 [-0.063, 1.599, 0.007] [0.062, 1.708, 0.077]\nFJ3274 Left parietal bone 2927 11196 [-0.008, 1.596, -0.115] [0.075, 1.714, 0.032]"}]}},{"type":"assistant","uuid":"4c73e6ba-0019-47e2-ace7-b5fe066e9c05","session_id":"cef6745e-92bb-4fe4-9624-333962f2ed08","parent_tool_use_id":null,"message":{"id":"4c73e6ba-0019-47e2-ace7-b5fe066e9c05","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_f17aJuRFJTaw9swmQrxo4514","name":"write_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/scripts/build-anatomy-map.mjs","content":"#!/usr/bin/env node\n// Builds the Movement anatomy mapping: wger muscle names -> BodyParts3D mesh ids.\n// The mapping is authored here (not imported from anywhere), reviewed as product content,\n// and emitted together with the actual mesh availability from Human Atlas, so the page can\n// state a real gap instead of drawing an invented muscle.\n\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst repo = path.resolve(here, '..');\nconst atlas = JSON.parse(fs.readFileSync(path.join(repo, 'portal/anatomy/models/atlas.json'), 'utf8'));\nconst byId = new Map(atlas.parts.map(p => [p.id, p]));\n\n// wger muscle name -> { terms: BodyParts3D FMA concept terms, zh, roles }\n// Role here is the *teaching* role of the muscle in general movement, not a per-rep\n// activation measurement. Per-exercise role comes from the wger record (primary/secondary).\nconst MAP = {\n  'Pectoralis major': { zh: '胸大肌', terms: ['Pectoralis major'] },\n  'Anterior deltoid': { zh: '三角肌前束', terms: ['Deltoid'] },\n  'Posterior deltoid': { zh: '三角肌后束', terms: ['Deltoid'] },\n  'Deltoid': { zh: '三角肌', terms: ['Deltoid'] },\n  'Biceps brachii': { zh: '肱二头肌', terms: ['Biceps brachii'] },\n  'Brachialis': { zh: '肱肌', terms: ['Brachialis'] },\n  'Brachioradialis': { zh: '肱桡肌', terms: ['Brachioradialis'] },\n  'Triceps brachii': { zh: '肱三头肌', terms: ['Triceps brachii'] },\n  'Latissimus dorsi': { zh: '背阔肌', terms: ['Latissimus dorsi'] },\n  'Trapezius': { zh: '斜方肌', terms: ['Trapezius'] },\n  'Rhomboid major': { zh: '菱形肌', terms: ['Rhomboid major', 'Rhomboid'] },\n  'Serratus anterior': { zh: '前锯肌', terms: ['Serratus anterior'] },\n  'Rectus abdominis': { zh: '腹直肌', terms: ['Rectus abdominis'] },\n  'Obliquus externus abdominis': { zh: '腹外斜肌', terms: ['Obliquus externus abdominis'] },\n  'Erector spinae': { zh: '竖脊肌', terms: ['Iliocostalis', 'Longissimus', 'Spinalis'] },\n  'Gluteus maximus': { zh: '臀大肌', terms: ['Gluteus maximus'] },\n  'Gluteus medius': { zh: '臀中肌', terms: ['Gluteus medius'] },\n  'Quadriceps femoris': { zh: '股四头肌', terms: ['Rectus femoris', 'Vastus lateralis', 'Vastus medialis', 'Vastus intermedius'] },\n  'Biceps femoris': { zh: '股二头肌', terms: ['Biceps femoris'] },\n  'Semitendinosus': { zh: '半腱肌', terms: ['Semitendinosus'] },\n  'Gastrocnemius': { zh: '腓肠肌', terms: ['Gastrocnemius'] },\n  'Soleus': { zh: '比目鱼肌', terms: ['Soleus'] },\n  'Tibialis anterior': { zh: '胫骨前肌', terms: ['Tibialis anterior'] },\n  'Iliopsoas': { zh: '髂腰肌', terms: ['Iliacus', 'Psoas major'] },\n  'Adductor magnus': { zh: '大收肌', terms: ['Adductor magnus'] },\n  'Gluteus minimus': { zh: '臀小肌', terms: ['Gluteus minimus'] },\n  'Gastrocnemius / Soleus': { zh: '小腿三头肌', terms: ['Gastrocnemius', 'Soleus'] },\n};\n\n// A concept term is matched against part names with whole-word, case-insensitive prefix rules.\n// \"Pectoralis major\" must not swallow \"Pectoralis minor\"; BodyParts3D has no side suffix in\n// the name, so left/right is expressed by the mirrored mesh id (…M) where it exists.\nfunction matches(name, term) {\n  const n = name.toLowerCase();\n  const t = term.toLowerCase();\n  if (n === t) return true;\n  if (!n.startsWith(t + ' ')) return false;\n  const rest = n.slice(t.length + 1);\n  // Reject explicit \"minor\"/\"accessory\" style different muscles.\n  return !/(^| )(minor|accessory|anterior belly|posterior belly)$/.test(rest);\n}\n\nconst muscular = atlas.parts.filter(p => p.system === 'muscular');\n\nconst out = {\n  schema: 'zero-one.movement.anatomy-map.v1',\n  builtAt: new Date().toISOString(),\n  source: {\n    model: 'BodyParts3D 4.0 via ashemag/human-atlas',\n    license: 'CC BY 4.0 (BodyParts3D, Database Center for Life Science)',\n    note: 'This file maps exercise muscle names to anatomical mesh ids. It is authored by this project; it is not an upstream muscle-activation dataset.',\n  },\n  roleSemantics: 'ROLE_FROM_EXERCISE_RECORD_NOT_EMG',\n  muscles: {},\n  gaps: [],\n};\n\nfor (const [name, def] of Object.entries(MAP)) {\n  const ids = [];\n  const found = [];\n  for (const term of def.terms) {\n    for (const part of muscular) {\n      if (matches(part.name, term)) {\n        ids.push({ id: part.id, name: part.name });\n        found.push(term);\n      }\n    }\n  }\n  const unique = [...new Map(ids.map(x => [x.id, x])).values()];\n  out.muscles[name] = {\n    zh: def.zh,\n    terms: found.length ? found : def.terms,\n    parts: unique,\n    status: unique.length ? 'MESH_AVAILABLE' : 'NO_MESH_IN_MODEL',\n  };\n  if (!unique.length) out.gaps.push({ muscle: name, zh: def.zh, searchedTerms: def.terms });\n}\n\nconst dir = path.join(repo, 'portal/data/movement');\nfs.mkdirSync(dir, { recursive: true });\nfs.writeFileSync(path.join(dir, 'anatomy-map.json'), JSON.stringify(out, null, 1) + '\\n');\n\nlet ok = 0;\nfor (const [k, v] of Object.entries(out.muscles)) {\n  if (v.parts.length) ok++;\n  console.log(`${v.parts.length ? 'OK ' : 'GAP'} ${k} (${v.zh}) -> ${v.parts.map(p => p.id).join(', ') || '—'}`);\n}\nconsole.log(`mapped ${ok}/${Object.keys(out.muscles).length} muscle names; ${out.gaps.length} explicit gaps`);\n"}}],"stop_reason":"tool_use","usage":{"input_tokens":39314,"output_tokens":1736,"cache_read_input_tokens":37760,"total_tokens":41050}}},{"type":"user","uuid":"7ce227a0-548c-48c8-b5a8-5699b37f3ddf","session_id":"cef6745e-92bb-4fe4-9624-333962f2ed08","parent_tool_use_id":null,"message":