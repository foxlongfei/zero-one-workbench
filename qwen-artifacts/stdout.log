av'&&await page.locator('#music').getAttribute('src')?.then(Boolean),await page.locator('#musicName').innerText());\nawait page.locator('#clearMusic').evaluate(button=>button.click());\nawait page.waitForFunction(()=>document.querySelector('#status')?.textContent.includes('已清除本机背景音'));\nawait page.reload();\nawait page.waitForSelector('#importButton:enabled');\ncheck('cleared background audio stays removed',(await page.locator('#musicName').innerText())==='尚未选择背景音'&&await page.locator('#music').getAttribute('src')===null,await page.locator('#musicName').innerText());\nawait page.locator('#files').setInputFiles({name:'blank.txt',mimeType:'text/plain',buffer:Buffer.from(' \\n\\t ')});\nawait page.waitForFunction(()=>document.querySelector('#status')?.textContent.includes('空白 TXT'));\ncheck('blank TXT is rejected before shelf import',await page.locator('#shelf .book').count()===0,await page.locator('#status').innerText());\ncheck('blank TXT rejection is explicit',(await page.locator('#status').innerText()).includes('已导入 0 本；跳过 1 本空白 TXT'),await page.locator('#status').innerText());\nawait page.locator('#files').setInputFiles(resolve('tests/c01-reader/fixtures/real-book.epub'));\nconst epub=page.locator('#shelf .book').filter({hasText:'EPUB'});\nawait page.waitForFunction(()=>document.querySelectorAll('#shelf .book').length===1);\ncheck('EPUB imported once',await epub.count()===1,await page.locator('#shelf').innerText());\ncheck('EPUB metadata title replaces filename',(await epub.locator('strong').innerText())==='实际章节测试书',await epub.innerText());\ncheck('EPUB author appears on shelf',(await epub.innerText()).includes('零一测试作者'),await epub.innerText());\ncheck('EPUB embedded cover appears on shelf',await epub.locator('.book-cover.has-image img').count()===1,await epub.locator('.book-cover').innerHTML());\nawait page.locator('#files').setInputFiles(resolve('tests/c01-reader/fixtures/real-book.epub'));\nawait page.waitForFunction(()=>document.querySelector('#status')?.textC