\n      return null;\n    }\n  }\n\n  async choose(file) {\n    const meta = await saveBackground(file);\n    this.#attach(file, meta.name);\n    this.#emit('change');\n    return meta;\n  }\n\n  async clear() {\n    this.element.pause();\n    if (this.url) URL.revokeObjectURL(this.url);\n    this.url = null;\n    this.currentName = '';\n    this.element.removeAttribute('src');\n    this.element.load?.();\n    await clearBackground();\n    this.#emit('change');\n  }\n\n  #attach(blob, name) {\n    if (this.url) URL.revokeObjectURL(this.url);\n    this.url = URL.createObjectURL(blob);\n    this.currentName = name || '本机背景乐';\n    this.element.src = this.url;\n    this.#applyVolume();\n  }\n\n  /** Called from a user gesture; browsers block audio until then. */\n  async start() {\n    if (!this.ready) return false;\n    try { await this.element.play(); return true; } catch (err) { this.#emit('blocked', { message: err.message }); return false; }\n  }\n\n  pause() { this.element.pause(); }\n\n  setDucked(ducked) {\n    this.ducked = ducked;\n    this.#applyVolume();\n    this.#emit('change');\n  }\n\n  setLevel(level) {\n    this.settings = writeSettings({ musicLevel: Math.max(0, Math.min(1, level)) });\n    this.#applyVolume();\n    this.#emit('change');\n  }\n\n  setDucking(enabled) {\n    this.settings = writeSettings({ ducking: Boolean(enabled) });\n    this.#applyVolume();\n    this.#emit('change');\n  }\n\n  #applyVolume() {\n    const level = Number(this.settings.musicLevel ?? 0.18);\n    const factor = this.settings.ducking !== false && this.ducked ? 0.25 : 1;\n    // Keep a faint bed of music under the voice instead of muting it entirely.\n    this.element.volume = Math.max(0, Math.min(1, level * factor));\n  }\n}\n"}]}},{"type":"assistant","uuid":"b9e70753-f15a-4477-acac-60872eed590e","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"b9e70753-f15a-4477-acac-60872eed590e","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_oX0VAG4UoGYsa8Bz50M66797","name":"read_file","input":{"file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/books.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":52473,"output_tokens":62,"cache_read_input_tokens":51328,"total_tokens":52535}}},{"type":"user","uuid":"fc3290ea-2272-4a4f-a7c5-8de79c973d8b","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_oX0VAG4UoGYsa8Bz50M66797","is_error":false,"content":"// Turn an imported file into a book the reader can open: detect the encoding of\n// plain text, split it into chapters and narration segments, and read the\n// table of contents out of EPUB/FB2/MOBI/CBZ containers through foliate-js.\nconst { makeBook } = await import('../vendor/foliate-js/view.js');\n\nexport const TXT_EXTENSIONS = ['txt', 'text', 'md'];\nexport const DOC_EXTENSIONS = ['epub', 'mobi', 'azw3', 'fb2', 'cbz'];\nexport const ALL_EXTENSIONS = [...DOC_EXTENSIONS, ...TXT_EXTENSIONS];\n\nexport const extensionOf = name => String(name || '').split('.').pop().toLowerCase();\nexport const isTxt = name => TXT_EXTENSIONS.includes(extensionOf(name));\n\n// ------------------------------------------------------------------ encoding\nconst decodeWith = (buffer, encoding) => {\n  try { return new TextDecoder(encoding).decode(buffer); } catch { return null; }\n};\n\nlet wasmDecoder = null;\nfunction decoderFromTransformers() {\n  if (wasmDecoder) return wasmDecoder;\n  // transformers.js ships an ONNX-build TextDecoder that understands GB18030\n  // even where the browser's own TextDecoder does not. Loading the bundle pulls\n  // in ONNX Runtime WASM (~22 MB), so opt in with `?wasm-decoder` instead of\n  // paying that cost on every shelf visit; the browser test uses the flag.\n  if (!new URLSearchParams(location.search).has('wasm-decoder')) return null;\n  wasmDecoder = import('../vendor/hf-transformers-3.7.5/transformers.min.js')\n    .then(mod => {\n      const Ctor = mod.TextDecoder;\n      if (typeof Ctor !== 'function') return null;\n      return bytes => new Ctor({ type: 'TextDecoder', name: 'gb18030', config: { ignoreBOM: false } })\n        .decode(new Uint8Array(bytes));\n    })\n    .catch(err => {\n      console.warn('GB18030 decoder unavailable', err);\n      return null;\n    });\n  return wasmDecoder;\n}\n\nfunction scoreChinese(text) {\n  const sample = text.slice(0, 20000);\n  if (!sample) return -1;\n  const common = (sample.match(/[\\u4e00-\\u9fff\\u3000-\\u303f\\uff00-\\uffef\\n\\r\\t]/g) || []).length;\n  const broken = (sample.match(/\\ufffd/g) || []).length;\n  return (common / sample.length) - broken * 2;\n}\n\n/**\n * Read a text file, tolerating BOMs and legacy Chinese encodings.\n * Returns { text, charset, source } where source names the decoder that won.\n */\nexport async function decodeText(blob) {\n  const buffer = await blob.arrayBuffer();\n  const bytes = new Uint8Array(buffer);\n  if (bytes[0] === 0xff && bytes[1] === 0xfe) return { text: new TextDecoder('utf-16le').decode(buffer), charset: 'utf-16le', source: 'native' };\n  if (bytes[0] === 0xfe && bytes[1] === 0xff) return { text: new TextDecoder('utf-16be').decode(buffer), charset: 'utf-16be', source: 'native' };\n\n  const utf8 = decodeWith(buffer, 'utf-8');\n  if (utf8 !== null && !utf8.includes('\\ufffd')) return { text: utf8, charset: 'utf-8', source: 'native' };\n\n  const tries = [];\n  if (utf8 !== null) tries.push({ text: utf8, charset: 'utf-8', source: 'native' });\n  for (const charset of ['gb18030', 'big5']) {\n    const native = decodeWith(buffer, charset);\n    if (native) tries.push({ text: native, charset, source: 'native' });\n  }\n  if (!tries.some(t => t.charset === 'gb18030')) {\n    const wasm = await decoderFromTransformers();\n    const text = wasm?.(buffer);\n    if (text) tries.push({ text, charset: 'gb18030', source: 'wasm' });\n  }\n  if (!tries.length) return { text: new TextDecoder('latin1').decode(buffer), charset: 'latin1', source: 'native' };\n  tries.sort((a, b) => scoreChinese(b.text) - scoreChinese(a.text));\n  return tries[0];\n}\n\n// --------------------------------------------------------------- segmentation\nconst CHAPTER_HEADING = /^\\s*(?:(?:第[0-9零一二三四五六七八九十百千万两]+[章节回卷篇部集])|(?:序章|楔子|引子|尾声|后记|前言|序言)|(?:Chapter|CHAPTER)\\s+[0-9IVXLC]+)/;\n\nexport function cleanText(text) {\n  return String(text || '')\n    .replace(/\\r\\n?/g, '\\n')\n    .replace(/\\u0000/g, '')\n    .replace(/[\\u00a0\\u2000-\\u200a]/g, ' ');\n}\n\nconst TARGET_SEGMENT = 150;\nconst SENTENCE_END = /[。！？!?；;…”」』]$/;\n\nexport function segmentParagraphs(paragraphs) {\n  const segments = [];\n  let buffer = '';\n  const push = value => {\n    const text = value.trim();\n    if (text) segments.push(text);\n  };\n  for (const raw of paragraphs) {\n    const paragraph = raw.replace(/[ \\t]+/g, ' ').trim();\n    if (!paragraph) {\n      if (buffer) { push(buffer); buffer = ''; }\n      continue;\n    }\n    if (paragraph.length > TARGET_SEGMENT * 2) {\n      if (buffer) { push(buffer); buffer = ''; }\n      for (let start = 0; start < paragraph.length; start += TARGET_SEGMENT) {\n        push(paragraph.slice(start, start + TARGET_SEGMENT));\n      }\n      continue;\n    }\n    if (!buffer) { buffer = paragraph; continue; }\n    const next = `${buffer} ${paragraph}`;\n    // Keep narration segments near one breath and prefer to cut after a full stop.\n    if (next.length > TARGET_SEGMENT && SENTENCE_END.test(buffer)) { push(buffer); buffer = paragraph; }\n    else if (next.length > TARGET_SEGMENT * 1.6) { push(buffer); buffer = paragraph; }\n    else buffer = next;\n  }\n  if (buffer) push(buffer);\n  return segments;\n}\n\nexport function structurePlainText(text) {\n  const lines = cleanText(text).split('\\n');\n  const chapterStarts = [];\n  lines.forEach((line, index) => {\n    const trimmed = line.trim();\n    if (trimmed.length > 0 && trimmed.length <= 32 && CHAPTER_HEADING.test(trimmed)) chapterStarts.push(index);\n  });\n\n  if (!chapterStarts.length) {\n    const body = lines.join('\\n');\n    if (!body.trim()) return null;\n    return { chapters: [{ href: 'text:0', title: '正文', segments: segmentParagraphs(body.split('\\n')) }] };\n  }\n\n  const chapters = [];\n  if (chapterStarts[0] > 0) {\n    const segments = segmentParagraphs(lines.slice(0, chapterStarts[0]));\n    if (segments.length) chapters.push({ href: 'text:front', title: '卷首', segments });\n  }\n  chapterStarts.forEach((start, i) => {\n    const end = i + 1 < chapterStarts.length ? chapterStarts[i + 1] : lines.length;\n    const body = lines.slice(start, end);\n    const title = body.find(l => l.trim()).trim();\n    chapters.push({ href: `text:${start}`, title, segments: segmentParagraphs(body.slice(1)) });\n  });\n  return { chapters: chapters.filter(c => c.segments.length || c.title) };\n}\n\n// ------------------------------------------------------------------ containers\nfunction readableText(doc) {\n  if (!doc) return '';\n  const clone = doc.cloneNode(true);\n  clone.querySelectorAll('script,style,nav,rt,rp').forEach(n => n.remove());\n  const root = clone.body || clone.documentElement;\n  if (!root) return '';\n  const blocks = [...root.querySelectorAll('h1,h2,h3,h4,h5,h6,p,li,blockquote,div,section,article,td,dd,pre')]\n    .filter(el => !el.querySelector('p,li,blockquote,div,section,article'));\n  const chunks = blocks.map(el => el.textContent).filter(t => t && t.trim());\n  return chunks.length ? chunks.join('\\n\\n') : (root.textContent || '');\n}\n\nfunction titleOf(doc) {\n  const heading = (doc?.querySelector('h1,h2,h3')?.textContent || '').trim();\n  return (heading || (doc?.title || '')).trim().slice(0, 60);\n}\n\nconst sectionOfCFI = cfi => {\n  const match = String(cfi || '').match(/!\\[([^!\\]]*)\\]/);\n  return match ? Number(match[1]) || 0 : 0;\n};\n\n/**\n * Inspect a container book: metadata, cover, table of contents and, for each\n * spine section, the narration segments extracted through foliate-js.\n */\nexport async function inspectContainer(file, onProgress = () => {}) {\n  let parsed;\n  try {\n    parsed = await makeBook(file);\n    const metadata = parsed.metadata || {};\n    const title = typeof metadata.title === 'string' ? metadata.title : '';\n    const author = typeof metadata.author === 'string' ? metadata.author : '';\n    const cover = await parsed.getCover?.().catch(() => null);\n    const sections = parsed.sections || [];\n    const chapters = [];\n    for (let i = 0; i < sections.length; i++) {\n      onProgress(i + 1, sections.length);\n      try {\n        const doc = await sections[i].createDocument();\n        chapters.push({\n          index: i,\n          title: titleOf(doc) || `第 ${i + 1} 部分`,\n          segments: segmentParagraphs(readableText(doc).split('\\n')),\n        });\n      } catch (err) {\n        chapters.push({ index: i, title: `第 ${i + 1} 部分`, segments: [], error: String(err) });\n      }\n      await new Promise(r => setTimeout(r, 0));\n    }\n    const toc = [];\n    const walk = (items, depth = 0) => {\n      if (depth > 6) return;\n      for (const item of items || []) {\n        const label = (item.label || '').trim();\n        if (label) toc.push({ label, section: sectionOfCFI(item.href), cfi: item.href });\n        walk(item.subitems || item.children, depth + 1);\n      }\n    };\n    walk(parsed.toc);\n    return {\n      title,\n      author,\n      cover: cover instanceof Blob && cover.size ? cover : null,\n      chapters,\n      toc,\n      sectionCount: sections.length,\n    };\n  } finally {\n    parsed?.destroy?.();\n  }\n}\n\n// ---------------------------------------------------------------- book record\nexport async function digestOf(blob) {\n  const bytes = await crypto.subtle.digest('SHA-256', await blob.arrayBuffer());\n  return [...new Uint8Array(bytes)].map(x => x.toString(16).padStart(2, '0')).join('');\n}\n\n/**\n * Fully parse an imported file into the record stored on the shelf. Both TXT\n * and container books end up with `chapters[].segments` so that reading,\n * narration, search and notes all work on the same index.\n */\nexport async function buildBookRecord(file, { onProgress } = {}) {\n  const ext = extensionOf(file.name);\n  const title = file.name.replace(/\\.[^.]+$/, '');\n  const base = {\n    id: `local-${crypto.randomUUID()}`,\n    format: ext.toUpperCase(),\n    filename: file.name,\n    size: file.size,\n    fingerprint: await digestOf(file),\n    local: true,\n    addedAt: new Date().toISOString(),\n    blob: file,\n  };\n  if (isTxt(file.name)) {\n    const { text, charset, source } = await decodeText(file);\n    const structure = structurePlainText(text);\n    if (!structure) return { empty: true };\n    const record = {\n      ...base,\n      title,\n      author: '',\n      cover: null,\n      charset,\n      charsetSource: source,\n      chapters: structure.chapters,\n      toc: structure.chapters.map((c, index) => ({ label: c.title, section: index })),\n    };\n    record.segmentCount = record.chapters.reduce((n, c) => n + c.segments.length, 0);\n    return { record };\n  }\n  const info = await inspectContainer(file, onProgress);\n  const record = {\n    ...base,\n    title: info.title || title,\n    author: info.author,\n    cover: info.cover,\n    charset: 'utf-8',\n    chapters: info.chapters,\n    toc: info.toc,\n  };\n  record.segmentCount = record.chapters.reduce((n, c) => n + c.segments.length, 0);\n  return { record };\n}\n\n/** Chapters with their narration segments, tolerant of legacy shelf records. */\nexport function chaptersOf(book) {\n  const source = book?.chapters || book?.structure?.chapters || [];\n  return source.map((chapter, index) => ({\n    index,\n    title: chapter.title || `第 ${index + 1} 部分`,\n    segments: chapter.segments || [],\n  }));\n}\n\nexport function flattenSegments(book) {\n  return chaptersOf(book).map(({ index, title, segments }) => ({ chapter: index, title, segments }));\n}\n"}]}},{"type":"assistant","uuid":"a573969f-b44d-48b0-af12-647a11d92805","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"a573969f-b44d-48b0-af12-647a11d92805","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_xj7A0Wzjcph5iakAJHcu4306","name":"write_file","input":{"content":"// Writes the narration panels: notes/discussion, family voices and settings.\n// Everything here is rendered from plain data so the shell can re-render after\n// any change without tracking state in the DOM.\nimport { formatStamp, clipped, el } from './ui.js';\nimport { chaptersOf } from './books.js';\n\n// --------------------------------------------------------------------- notes\nexport class NotesController {\n  constructor({ book, container, api, server, onSeek, current }) {\n    this.book = book;\n    this.container = container;\n    this.api = api;\n    this.server = server;\n    this.onSeek = onSeek;\n    this.current = current;\n    this.items = [];\n    this.draft = '';\n  }\n\n  async load() {\n    this.items = [];\n    if (this.server?.online) {\n      try { this.items = await this.api.notes(this.book.id); } catch { this.items = []; }\n    }\n    this.render();\n  }\n\n  quote() {\n    const position = this.current?.() || { chapter: 0, segment: 0 };\n    const chapter = chaptersOf(this.book)[position.chapter];\n    const text = chapter?.segments?.[position.segment] || '';\n    return { text: clipped(text, 120), chapter: position.chapter, segment: position.segment, chapterTitle: chapter?.title || '' };\n  }\n\n  render() {\n    if (!this.container) return;\n    this.container.replaceChildren();\n    const form = el('div', { class: 'note-form' });\n    const heading = el('p', { class: 'eyebrow', text: '写一条笔记' });\n    const quote = el('blockquote', { class: 'quote', text: this.quote().text || '（当前段落为空）' });\n    quote.onclick = () => this.onSeek?.(this.indexOfQuote());\n    const input = el('textarea', { placeholder: '记下想法、疑问，或念给孩子听的那句话…', value: this.draft });\n    input.addEventListener('input', () => { this.draft = input.value; });\n    const submit = el('button', { type: 'button', class: 'primary', text: '保存笔记' });\n    submit.onclick = async () => {\n      const text = input.value.trim();\n      if (!text) return;\n      const position = this.current?.() || { chapter: 0, segment: 0 };\n      const note = {\n        bookId: this.book.id, text, chapterIndex: position.chapter, segmentIndex: position.segment,\n        quote: this.quote().text, createdAt: new Date().toISOString(),\n      };\n      if (this.server?.online) {\n        try { await this.api.addNote(note); } catch { /* keep local copy below */ }\n      }\n      this.items = [{ id: `local-${crypto.randomUUID()}`, ...note, local: true }, ...this.items];\n      this.draft = '';\n      this.render();\n      this.onChange?.();\n    };\n    form.append(heading, quote, input, submit);\n\n    const list = el('div', { class: 'note-list' });\n    if (!this.items.length) list.append(el('p', { class: 'empty-note', text: '还没有笔记。读到喜欢的句子，写一句留下。' }));\n    for (const note of this.items) list.append(this.noteNode(note));\n    this.container.append(form, list);\n  }\n\n  indexOfQuote() {\n    const position = this.current?.() || { chapter: 0, segment: 0 };\n    return position;\n  }\n\n  noteNode(note) {\n    const card = el('article', { class: 'note-item' });\n    if (note.quote) {\n      const quote = el('p', { class: 'quote', text: note.quote });\n      quote.onclick = () => this.onSeek?.(this.flatFor(note));\n      card.append(quote);\n    }\n    card.append(el('p', { text: note.text }));\n    const meta = el('div', { class: 'note-meta' });\n    meta.append(el('span', { text: formatStamp(note.createdAt) || '刚刚' }));\n    const jump = el('button', { type: 'button', class: 'ghost', text: '回到原文' });\n    jump.onclick = () => this.onSeek?.(this.flatFor(note));\n    meta.append(jump);\n    const remove = el('button', { type: 'button', class: 'ghost', text: '删除' });\n    remove.onclick = async () => {\n      this.items = this.items.filter(item => item.id !== note.id);\n      if (this.server?.online && !note.local) this.api.removeNote(note.id).catch(() => {});\n      this.render();\n      this.onChange?.();\n    };\n    meta.append(remove);\n    card.append(meta);\n    return card;\n  }\n\n  flatFor(note) {\n    const chapters = chaptersOf(this.book);\n    let offset = 0;\n    for (let i = 0; i < (note.chapterIndex ?? 0); i++) offset += chapters[i]?.segments.length || 0;\n    return offset + (note.segmentIndex ?? 0);\n  }\n\n  updateQuote() { /* quote refreshes on next render */ }\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/notes.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":55625,"output_tokens":1218,"cache_read_input_tokens":52352,"total_tokens":56843}}},{"type":"user","uuid":"ec2cce90-1437-406e-936d-c2f425394cd5","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_xj7A0Wzjcph5iakAJHcu4306","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/notes.js."}]}},{"type":"assistant","uuid":"34afa5c3-1f0e-4a00-9622-108ea79de033","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"34afa5c3-1f0e-4a00-9622-108ea79de033","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_IvFhzMPDUyDQRR8fsEbk7885","name":"write_file","input":{"content":"// Family voices: recording a voice is only allowed with the speaker's explicit,\n// recorded consent. This panel collects that consent, shows what was agreed,\n// and gives the speaker one-tap revocation and sample deletion.\nimport { el, formatTime } from './ui.js';\n\nconst PURPOSES = [\n  { id: 'read-aloud', label: '朗读家庭书架里的书' },\n  { id: 'children-stories', label: '给孩子讲故事' },\n  { id: 'reminders', label: '家庭提醒与问候' },\n];\n\nexport class VoicesController {\n  constructor({ container, api, server, onPrefer, notify }) {\n    this.container = container;\n    this.api = api;\n    this.server = server;\n    this.onPrefer = onPrefer;\n    this.notify = notify || (() => {});\n    this.voices = [];\n    this.preferred = 'system';\n    this.loaded = false;\n    this.error = '';\n  }\n\n  async load() {\n    this.render();\n    if (!this.server?.online) { this.error = 'offline'; this.render(); return; }\n    try {\n      const bundle = await this.api.voices();\n      this.voices = bundle.voices || [];\n      this.preferred = bundle.preferredVoice || 'system';\n      this.error = '';\n    } catch (err) {\n      this.error = err.message;\n    }\n    this.loaded = true;\n    this.render();\n  }\n\n  render() {\n    if (!this.container) return;\n    this.container.replaceChildren();\n    this.container.append(el('div', {\n      class: 'notice',\n      text: '这里只保存\"授权记录\"，不会自动录音。没有本人勾选并签名，任何人都无法用这个声音朗读。',\n    }));\n    if (this.error === 'offline') {\n      this.container.append(el('div', { class: 'notice warn', text: '家庭服务器没有启动，暂时无法管理家庭声音。' }));\n    } else if (this.error) {\n      this.container.append(el('div', { class: 'notice warn', text: `读取失败：${this.error}` }));\n    }\n\n    this.container.append(el('h4', { text: '已登记的声音' }));\n    if (!this.voices.length) this.container.append(el('p', { class: 'empty-note', text: '还没有登记任何家庭声音。' }));\n    for (const voice of this.voices) this.container.append(this.voiceCard(voice));\n    this.container.append(this.consentForm());\n  }\n\n  voiceCard(voice) {\n    const card = el('article', { class: 'voice-card', dataset: { status: voice.status || 'active', voiceId: voice.id } });\n    const head = el('div', { class: 'voice-head' });\n    head.append(el('strong', { text: voice.name }));\n    head.append(el('span', { class: 'muted', text: statusLabel(voice.status) }));\n    card.append(head);\n\n    const consent = voice.consent || {};\n    const scope = (consent.purposes || []).map(id => PURPOSES.find(p => p.id === id)?.label || id).join('、') || '未填写用途';\n    card.append(el('p', { class: 'muted', text: `授权人：${consent.authorizedBy || '——'} · 用途：${scope}` }));\n    card.append(el('p', { class: 'muted', text: `登记时间：${formatTime(voice.createdAt) || '——'}${consent.expiresAt ? ` · 授权到 ${formatTime(consent.expiresAt)}` : ''}` }));\n\n    const chosen = this.preferred === voice.id;\n    const actions = el('div', { class: 'voice-actions' });\n    if (voice.status === 'active') {\n      const use = el('button', { type: 'button', text: chosen ? '当前默认声音' : '设为默认' });\n      use.disabled = chosen;\n      use.onclick = async () => { await this.onPrefer?.(voice.id); await this.load(); };\n      actions.append(use);\n    }\n    if (voice.sample) {\n      const play = el('button', { type: 'button', text: '试听样本' });\n      play.onclick = () => this.notify('样本试听需要先由家庭服务器生成，本次版本未包含录音上传。', { tone: 'info' });\n      actions.append(play);\n    }\n    if (voice.status === 'active') {\n      const revoke = el('button', { type: 'button', class: 'ghost', text: '撤回授权' });\n      revoke.onclick = async () => {\n        await this.api?.revokeVoice?.(voice.id).catch(err => this.notify(`撤回失败：${err.message}`, { tone: 'error' }));\n        this.notify(`已撤回「${voice.name}」的授权，相关合成音频已清理`);\n        await this.load();\n      };\n      actions.append(revoke);\n    }\n    const purge = el('button', { type: 'button', class: 'ghost', text: '删除样本' });\n    purge.onclick = async () => {\n      await this.api?.deleteVoiceSamples?.(voice.id).catch(err => this.notify(`删除失败：${err.message}`, { tone: 'error' }));\n      this.notify('样本与缓存音频已删除');\n      await this.load();\n    };\n    actions.append(purge);\n    card.append(actions);\n    return card;\n  }\n\n  consentForm() {\n    const form = el('form', { class: 'consent-form' });\n    form.append(el('h4', { text: '登记一个声音' }));\n    form.append(el('p', { class: 'muted', text: '必须由声音本人完成。请如实填写，事后可随时撤回。' }));\n\n    const nameLabel = el('label', { class: 'setting-row' });\n    nameLabel.append(el('span', { text: '声音名称' }));\n    const name = el('input', { type: 'text', placeholder: '例如：外婆的声音', required: true, name: 'voiceName' });\n    nameLabel.append(name);\n\n    const owner = el('label', { class: 'setting-row' });\n    owner.append(el('span', { text: '授权人（声音本人的姓名或称呼）' }));\n    const ownerInput = el('input', { type: 'text', placeholder: '必须与声音本人一致', required: true, name: 'authorizedBy' });\n    owner.append(ownerInput);\n\n    const purposes = el('fieldset');\n    purposes.append(el('legend', { text: '允许的用途（至少一项）' }));\n    const boxes = PURPOSES.map(purpose => {\n      const label = el('label', { class: 'check' });\n      const box = el('input', { type: 'checkbox', name: 'purpose', value: purpose.id });\n      label.append(box, el('span', { text: purpose.label }));\n      purposes.append(label);\n      return box;\n    });\n\n    const statement = el('fieldset');\n    statement.append(el('legend', { text: '本人声明' }));\n    const statementText = el('label', { class: 'check' });\n    const statementBox = el('input', { type: 'checkbox', name: 'statement' });\n    statementText.append(statementBox, el('span', { text: '我是这个声音的本人，自愿授权按上述用途合成朗读，并知道我可以随时撤回授权、删除样本。' }));\n    statement.append(statementText);\n\n    const expiry = el('label', { class: 'setting-row' });\n    expiry.append(el('span', { text: '授权有效期（可选）' }));\n    const expiryInput = el('input', { type: 'date', name: 'expiresAt' });\n    expiry.append(expiryInput);\n\n    const submit = el('button', { type: 'submit', class: 'primary', text: '登记并授权' });\n    const status = el('p', { class: 'muted', role: 'status' });\n\n    form.addEventListener('submit', async event => {\n      event.preventDefault();\n      const picked = boxes.filter(box => box.checked).map(box => box.value);\n      if (!name.value.trim() || !ownerInput.value.trim()) { status.textContent = '请填写声音名称与授权人。'; return; }\n      if (!picked.length) { status.textContent = '请至少选择一项用途。'; return; }\n      if (!statementBox.checked) { status.textContent = '需要声音本人勾选声明后才能登记。'; return; }\n      if (!this.server?.online) { status.textContent = '家庭服务器未启动，无法登记。'; return; }\n      submit.disabled = true;\n      try {\n        await this.api.addVoice({\n          name: name.value.trim(),\n          consent: {\n            authorizedBy: ownerInput.value.trim(),\n            purposes: picked,\n            statement: '本人自愿授权，可随时撤回',\n            recordedAt: new Date().toISOString(),\n            expiresAt: expiryInput.value || null,\n          },\n        });\n        status.textContent = '';\n        this.notify(`「${name.value.trim()}」已登记，可用于朗读`);\n        await this.load();\n      } catch (err) {\n        status.textContent = `登记失败：${err.message}`;\n      } finally {\n        submit.disabled = false;\n      }\n    });\n\n    form.append(nameLabel, owner, purposes, statement, expiry, submit, status);\n    return form;\n  }\n}\n\nfunction statusLabel(status) {\n  return ({ active: '有效授权', revoked: '已撤回授权', deleted: '已删除样本', expired: '授权已过期' })[status] || status;\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/voices.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":56889,"output_tokens":2181,"cache_read_input_tokens":55296,"total_tokens":59070}}},{"type":"user","uuid":"24e5aab8-6910-454f-ad4d-5b2886d29df3","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_IvFhzMPDUyDQRR8fsEbk7885","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/voices.js."}]}},{"type":"assistant","uuid":"fd543ca3-78d1-4dbb-988d-8f6b1d7043dd","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"fd543ca3-78d1-4dbb-988d-8f6b1d7043dd","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_nv58HYCYHYOdo1ZKzaYl8892","name":"write_file","input":{"content":"// Reading and narration settings. Rendered into the settings panel and written\n// straight to localStorage, so preferences survive reloads and other tabs.\nimport { el } from './ui.js';\n\nconst THEMES = [\n  { id: 'paper', label: '纸白' },\n  { id: 'sepia', label: '米黄' },\n  { id: 'night', label: '夜间' },\n];\n\nexport class SettingsPanel {\n  constructor({ container, settings, onChange, onMusic, onMusicClear, music, voices, onManageVoices }) {\n    this.container = container;\n    this.settings = settings;\n    this.onChange = onChange;\n    this.onMusic = onMusic;\n    this.onMusicClear = onMusicClear;\n    this.music = music;\n    this.voices = voices || (() => []);\n    this.onManageVoices = onManageVoices;\n  }\n\n  render() {\n    if (!this.container) return;\n    const s = this.settings;\n    this.container.replaceChildren();\n\n    const speed = el('div', { class: 'setting-row' });\n    const speedLabel = el('label', { text: `朗读语速 ${Number(s.speed || 1).toFixed(1)}×` });\n    const speedInput = el('input', { type: 'range', min: '0.6', max: '1.6', step: '0.1', value: String(s.speed || 1) });\n    speedInput.addEventListener('input', () => {\n      speedLabel.textContent = `朗读语速 ${Number(speedInput.value).toFixed(1)}×`;\n    });\n    speedInput.addEventListener('change', () => this.onChange({ speed: Number(speedInput.value) }));\n    speed.append(speedLabel, speedInput);\n\n    const voice = el('div', { class: 'setting-row' });\n    voice.append(el('label', { text: '朗读声音' }));\n    const select = el('select');\n    select.append(new Option('系统语音（本机）', 'system'));\n    for (const item of this.voices()) {\n      if (item.status && item.status !== 'active') continue;\n      select.append(new Option(`家庭声音 · ${item.name}`, item.id));\n    }\n    select.value = s.voice || 'system';\n    select.onchange = () => this.onChange({ voice: select.value });\n    voice.append(select);\n    const manage = el('button', { type: 'button', class: 'ghost', text: '管理家庭声音与授权 →' });\n    manage.onclick = () => this.onManageVoices?.();\n    voice.append(manage);\n\n    const layout = el('div', { class: 'setting-row' });\n    layout.append(el('label', { text: '阅读方式' }));\n    layout.append(this.segmented([{ id: 'scrolled', label: '连续' }, { id: 'paged', label: '分页' }], s.layout || 'scrolled', value => this.onChange({ layout: value })));\n\n    const font = el('div', { class: 'setting-row' });\n    const fontLabel = el('label', { text: `正文字号 ${Math.round((s.fontScale || 1) * 100)}%` });\n    const fontInput = el('input', { type: 'range', min: '0.85', max: '1.5', step: '0.05', value: String(s.fontScale || 1) });\n    fontInput.addEventListener('input', () => { fontLabel.textContent = `正文字号 ${Math.round(fontInput.value * 100)}%`; });\n    fontInput.addEventListener('change', () => this.onChange({ fontScale: Number(fontInput.value) }));\n    font.append(fontLabel, fontInput);\n\n    const theme = el('div', { class: 'setting-row' });\n    theme.append(el('label', { text: '配色' }));\n    theme.append(this.segmented(THEMES.map(t => ({ id: t.id, label: t.label })), s.theme || 'paper', value => this.onChange({ theme: value })));\n\n    const musicRow = el('div', { class: 'setting-row' });\n    musicRow.append(el('label', { text: '背景音乐' }));\n    const name = this.music?.name || '尚未选择';\n    musicRow.append(el('p', { class: 'muted', text: `当前：${name}（只保存在本机，不随笔记同步）` }));\n    const musicActions = el('div', { class: 'choice' });\n    const choose = el('button', { type: 'button', text: this.music?.ready ? '更换音乐' : '选择音乐文件' });\n    choose.onclick = () => this.onMusic?.();\n    musicActions.append(choose);\n    if (this.music?.ready) {\n      const clear = el('button', { type: 'button', class: 'ghost', text: '移除音乐' });\n      clear.onclick = () => this.onMusicClear?.();\n      musicActions.append(clear);\n    }\n    musicRow.append(musicActions);\n\n    const level = el('div', { class: 'setting-row' });\n    const levelLabel = el('label', { text: `音乐音量 ${Math.round((s.musicLevel ?? 0.18) * 100)}%` });\n    const levelInput = el('input', { type: 'range', min: '0', max: '0.6', step: '0.02', value: String(s.musicLevel ?? 0.18) });\n    levelInput.addEventListener('input', () => { levelLabel.textContent = `音乐音量 ${Math.round(levelInput.value * 100)}%`; });\n    levelInput.addEventListener('change', () => this.onChange({ musicLevel: Number(levelInput.value) }));\n    level.append(levelLabel, levelInput);\n\n    const duck = el('label', { class: 'check setting-row' });\n    const duckBox = el('input', { type: 'checkbox', checked: s.ducking !== false });\n    duckBox.onchange = () => this.onChange({ ducking: duckBox.checked });\n    duck.append(duckBox, el('span', { text: '朗读时自动降低音乐音量' }));\n\n    this.container.append(speed, voice, layout, font, theme, musicRow, level, duck);\n    this.container.append(el('p', { class: 'muted', text: '快捷键：空格 朗读/暂停 · ← → 上一段/下一段 · T 目录 · N 笔记 · B 书签 · 1–6 调速' }));\n  }\n\n  segmented(options, active, onPick) {\n    const group = el('div', { class: 'segmented', role: 'group' });\n    for (const option of options) {\n      const button = el('button', { type: 'button', text: option.label });\n      button.setAttribute('aria-pressed', String(option.id === active));\n      button.onclick = () => onPick(option.id);\n      group.append(button);\n    }\n    return group;\n  }\n}\n","file_path":"/home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/settings.js"}}],"stop_reason":"tool_use","usage":{"input_tokens":59116,"output_tokens":1618,"cache_read_input_tokens":56576,"total_tokens":60734}}},{"type":"user","uuid":"633038cf-b83e-420f-89a4-65569e96fb86","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00_nv58HYCYHYOdo1ZKzaYl8892","is_error":false,"content":"Successfully created and wrote to new file: /home/runner/work/zero-one-workbench/zero-one-workbench/portal/js/read-with-you/settings.js."}]}},{"type":"assistant","uuid":"67b56263-2e9b-4dde-b0ec-a1ae4f77de05","session_id":"c6dbe816-3183-4562-8b6d-5e4e98a760d9","parent_tool_use_id":null,"message":{"id":"67b56263-2e9b-4dde-b0ec-a1ae4f77de05","type":"message","role":"assistant","model":"deepseek-chat","content":[{"type":"tool_use","id":"call_00_kfE2sxfsX7vD5c1KwG2K5000","name":"write_file","input":{"content":"// Reader shell: wires the shelf, the reading view, narration, notes, voices and\n// background music to the DOM in read-with-you.html.\nimport { buildBookRecord, chaptersOf, extensionOf, ALL_EXTENSIONS } from './books.js';\nimport { api, probeServer, server } from './api.js';\nimport {\n  allBooks, clearPosition, findDuplicate, readPosition, readSettings, removeBook, saveBook,\n  sortShelf, writePosition, writeSettings,\n} from './store.js';\nimport { createLayout } from './layout.js';\nimport { AudioSession } from './audio.js';\nimport { BackgroundMusic } from './music.js';\nimport { renderContinue, renderShelf } from './shelf.js';\nimport { setupMediaSession, shortcutFor, formatStamp } from './layout-helpers.js';\nimport { toast, closePanels, openPanel } from './ui.js';\nimport { NotesController } from './notes.js';\nimport { VoicesController } from './voices.js';\nimport { SettingsPanel } from './settings.js';\n\nconst $ = id => document.getElementById(id);\n\nconst app = {\n  books: [],\n  book: null,\n  chapters: [],\n  segments: [],\n  layout: null,\n  layoutKind: 'scrolled',\n  settings: readSettings(),\n  session: null,\n  music: new BackgroundMusic(),\n  listening: null,\n  bookmarks: [],\n  playhead: 0,\n  notes: null,\n  voices: null,\n  voicesData: [],\n  media: null,\n};\n\nconst flatIndexOf = (chapter, segment) => {\n  const info = app.chapters[chapter];\n  return info ? info.start + Math.min(segment, Math.max(0, info.segments.length - 1)) : 0;\n};\nconst positionOf = index => {\n  const item = app.segments[index];\n  return item ? { chapter: item.chapter, segment: item.index } : { chapter: 0, segment: 0 };\n};\n\nfunction applyTheme() {\n  document.documentElement.dataset.theme = app.settings.theme || 'paper';\n  document.documentElement.style.setProperty('--font-scale', String(app.settings.fontScale || 1));\n}\n\n// --------------------------------------------------------------------- shelf\nasync function refreshShelf() {\n  app.books = sortShelf(await allBooks());\n  paintShelf();\n}\n\nfunction paintShelf() {\n  const query = $('shelfSearch').value;\n  const { visible, total } = renderShelf($('shelfGrid'), app.books, {\n    query, onOpen: openBook, onDelete: deleteBook, onReset: resetProgress,\n  });\n  $('shelfCount').textContent = total ? (visible === total ? `共 ${total} 本` : `找到 ${visible} / ${total} 本`) : '';\n  const hero = $('shelfHero');\n  hero.replaceChildren();\n  const resumed = renderContinue(hero, app.books, {\n    listening: app.listening,\n    onOpen: (book, options) => openBook(book, options),\n    onStop: () => { app.listening = null; paintShelf(); },\n  });\n  if (!resumed) hero.append(importCard());\n  else if (!app.books.length) hero.append(importCard());\n}\n\nfunction importCard() {\n  const card = document.createElement('section');\n  card.className = 'import-card';\n  card.id = 'importCard';\n  card.innerHTML = '<p class=\"eyebrow\">添加书籍</p><h3>把整本书放进来</h3>'\n    + '<p class=\"muted\">支持 TXT（自动识别 UTF-8 / GB18030 / Big5）、EPUB、MOBI、AZW3、FB2、CBZ。文件留在本机，不上传。</p>';\n  const zone = document.createElement('div');\n  zone.className = 'dropzone';\n  zone.id = 'importCard'.toLowerCase() + '-zone';\n  zone.dataset.dropzone = 'shelf';\n  const button = document.createElement('button');\n  button.type = 'button';\n  button.className = 'primary';\n  button.textContent = app.books.length ? '＋ 导入电子书' : '＋ 导入第一本书';\n  button.onclick = () => $('fileInput').click();\n  zone.append(button, document.createTextNode(' 也可以把文件拖到这里'));\n  card.append(zone);\n  wireDropzone(zone);\n  return card;\n}\n\nconst wiredZones = new WeakSet();\nfunction wireDropzone(zone) {\n  if (wiredZones.has(zone)) return;\n  wiredZones.add(zone);\n  zone.addEventListener('dragover', event => { event.preventDefault(); zone.classList.add('is-over'); });\n  zone.addEventListener('dragleave', () => zone.classList.remove('is-over'));\n  zone.addEventListener('drop', event => {\n    event.preventDefault();\n    zone.classList.remove('is-over');\n    const files = [...(event.dataTransfer?.files || [])];\n    if (files.length) importFiles(files);\n  });\n}\n\nasync function deleteBook(book) {\n  const title = book.title || book.filename;\n  const ok = typeof window.confirm === 'function'\n    ? window.confirm(`从本机书架删除《${title}》？阅读位置与这本书的本地记录会一并清空。`)\n    : true;\n  if (!ok) { toast(`已取消删除《${title}》`); return; }\n  await removeBook(book.id);\n  if (server.online) api.deleteBook(book.id).catch(() => {});\n  if (app.listening?.bookId === book.id) app.listening = null;\n  if (app.book?.id === book.id) closeReader();\n  await refreshShelf();\n  toast(`已删除《${title}》`);\n}\n\nfunction resetProgress(book) {\n  const title = book.title || book.filename;\n  const ok = typeof window.confirm === 'function' ? window.confirm(`从第一章重新开始读《${title}》？`) : true;\n  if (!ok) { toast('已取消，阅读位置保持不变'); return; }\n  clearPosition(book.id);\n  if (app.listening?.bookId === book.id) app.listening = null;\n  paintShelf();\n  toast(`《${title}》已回到开头`);\n}\n\n// -------------------------------------------------------------------- import\nasync function importFiles(files) {\n  let imported = 0, duplicates = 0, skipped = 0, blank = 0;\n  let firstError = '';\n  for (const file of files) {\n    const ext = extensionOf(file.name);\n    if (!ALL_EXTENSIONS.includes(ext)) { skipped++; continue; }\n    try {\n      const { record, empty } = await buildBookRecord(file);\n      if (empty) { blank++; continue; }\n      if (await findDuplicate(record.fingerprint)) { duplicates++; continue; }\n      await saveBook(record);\n      imported++;\n      if (server.online) {\n        api.saveBook({\n          id: record.id, title: record.title, author: record.author,\n          format: record.format, paragraphs: record.segmentCount,\n        }).catch(() => {});\n      }\n    } catch (err) {\n      if (!firstError) firstError = `${file.name}：${err.message}`;\n    }\n  }\n  await refreshShelf();\n  const parts = [`已导入 ${imported} 本`];\n  if (duplicates) parts.push(`${duplicates} 本已在书架，未重复添加`);\n  if (blank) parts.push(`跳过 ${blank} 本空白 TXT`);\n  if (skipped) parts.push(`跳过 ${skipped} 个不支持的文件`);\n  if (firstError) parts.push(`失败：${firstError}`);\n  toast(parts.join('；'), { tone: firstError ? 'error' : 'info', ms: 5600 });\n}\n\n$('fileInput').addEventListener('change', event => {\n  const files = [...event.target.files];\n  event.target.value = '';\n  if (files.length) importFiles(files);\n});\n\n// -------------------------------------------------------------------- reader\nasync function openBook(book, { autoplay = false } = {}) {\n  closePanels();\n  const chapters = chaptersOf(book);\n  if (!chapters.some(chapter => chapter.segments.length)) {\n    toast(`《${book.title || book.filename}》没有提取到正文，请换一个文件`, { tone: 'error' });\n    return;\n  }\n  app.book = book;\n  app.chapters = chapters;\n  app.segments = [];\n  for (const chapter of chapters) {\n    chapter.start = app.segments.length;\n    for (const [index, text] of chapter.segments.entries()) app.segments.push({ chapter: chapter.index, index, text });\n  }\n  app.layoutKind = app.settings.layout || 'scrolled';\n  const position = readPosition(book.id);\n  app.playhead = position ? flatIndexOf(position.chapter, position.segment) : 0;\n  app.bookmarks = [];\n\n  $('readerTitle').textContent = book.title || book.filename;\n  $('readerScreen').hidden = false;\n  document.body.style.overflow = 'hidden';\n\n  app.session?.stop();\n  app.session = new AudioSession({ speed: app.settings.speed, voice: app.settings.voice, engine: app.settings.engine });\n  app.session.addEventListener('statechange', onSpeechState);\n  app.session.addEventListener('fallback', event => {\n    toast(event.detail.reason, { tone: 'error', ms: 6000 });\n    $('engineBadge').textContent = '引擎：系统语音';\n  });\n  app.session.addEventListener('engine', event => toast(event.detail.reason));\n  app.session.addEventListener('error', event => toast(event.detail.message, { tone: 'error' }));\n\n  buildLayout(app.playhead);\n  await app.session.play(app.segments.map(segment => segment.text), app.playhead, { play: false });\n\n  app.notes = new NotesController({\n    book, container: $('notesBody'), api, server,\n    onSeek: index => seekTo(index),\n    current: () => positionOf(app.playhead),\n  });\n  app.notes.onChange = updateNoteCount;\n  await app.notes.load();\n  updateNoteCount();\n  renderToc();\n  app.music.setDucked(false);\n  app.music.start().catch(() => {});\n  if (autoplay) await startSpeech();\n}\n\nfunction buildLayout(startIndex) {\n  app.layout?.destroy();\n  app.layout = createLayout(app.layoutKind, $('bookRoot'));\n  app.layout.setChapters(app.chapters);\n  app.layout.onVisibleChange = chapter => {\n    markTocCurrent(chapter);\n    updateChapterLabel(chapter);\n    updateReadingProgress(chapter);\n    scheduleProgress();\n  };\n  app.layout.onChapter = chapter => seekTo(flatIndexOf(chapter, 0), { speak: true });\n  app.layout.onSeek = index => seekTo(index, { speak: true });\n  app.layout.render();\n  app.playhead = Math.max(0, Math.min(startIndex, app.segments.length - 1));\n  app.layout.markPosition(app.playhead);\n  if (app.layoutKind === 'paged') app.layout.show(app.playhead);\n  $('layoutButton').textContent = app.layoutKind === 'scrolled' ? '分页' : '连续';\n  const { chapter, segment } = positionOf(app.playhead);\n  updateChapterLabel(chapter);\n  $('nowTitle').textContent = app.chapters[chapter]?.title || '';\n  $('nowDetail').textContent = `第 ${segment + 1} 段 · 共 ${app.chapters[chapter]?.segments.length || 0} 段`;\n  markTocCurrent(chapter);\n  updateReadingProgress(chapter);\n  if (app.layoutKind === 'scrolled') app.layout.markActive(app.playhead);\n}\n\nfunction updateChapterLabel(chapter) {\n  const total = app.chapters.length;\n  $('readerPlace').textContent = `第 ${chapter + 1} / ${total} 章 · ${app.chapters[chapter]?.title || ''}`;\n}\n\nfunction updateReadingProgress(chapter) {\n  const ratio = app.chapters.length > 1 ? chapter / (app.chapters.length - 1) : 0;\n  $('readingProgress').style.width = `${Math.max(2, Math.round(ratio * 100))}%`;\n}\n\nfunction renderToc() {\n  const list = $('tocList');\n  list.replaceChildren();\n  app.chapters.forEach((chapter, index) => {\n    const item = document.createElement('li');\n    const button = document.createElement('button');\n    button.type = 'button';\n    button.dataset.chapter = String(index);\n    button.textContent = chapter.title;\n    button.onclick = () => { seekTo(flatIndexOf(index, 0), { speak: true }); closePanels(); };\n    item.append(button);\n    list.append(item);\n  });\n}\n\nfunction markTocCurrent(chapter) {\n  $('tocList').querySelectorAll('button').forEach(button => {\n    button.classList.toggle('is-current', button.dataset.chapter === String(chapter));\n  });\n}\n\nfunction updateNoteCount() {\n  const count = app.notes?.items.length || 0;\n  $('noteCount').textContent = count ? `(${count})` : '';\n}\n\n// ------------------------------------------------------------------ position\nlet progressTimer = null;\nfunction scheduleProgress() {\n  clearTimeout(progressTimer);\n  progressTimer = setTimeout(persistPosition, 500);\n}\n\nfunction persistPosition() {\n  if (!app.book) return;\n  const seen = app.layout?.visibleSegment?.() || positionOf(app.playhead);\n  writePosition(app.book.id, { chapter: seen.chapter, segment: seen.segment });\n  if (server.online) {\n    app.listening = { bookId: app.book.id, ...seen, lastReadAt: Date.now() };\n    api.saveListening({ bookId: app.book.id, chapter: seen.chapter, segment: seen.segment });\n  }\n}\n\nfunction seekTo(index, { speak = false } = {}) {\n  if (!app.segments.length) return;\n  const target = Math.max(0, Math.min(index, app.segments.length - 1));\n  app.playhead = target;\n  const { chapter, segment } = positionOf(target);\n  if (app.layout) {\n    app.layout.markPosition(target);\n    if (app.layoutKind === 'paged') app.layout.show(target);\n    else app.layout.markActive(target);\n  }\n  updateChapterLabel(chapter);\n  $('nowTitle').textContent = app.chapters[chapter]?.title || '';\n  $('nowDetail').textContent = `第 ${segment + 1} 段 · 共 ${app.chapters[chapter]?.segments.length || 0} 段`;\n  markTocCurrent(chapter);\n  updateReadingProgress(chapter);\n  if (speak && app.session) app.session.jump(target);\n  persistPosition();\n  updateBookmarkButton();\n  app.notes?.updateQuote();\n}\n\n// -------------------------------------------------------------------- speech\nasync function startSpeech() {\n  if (!app.session) return;\n  app.session.unlock();\n  if (!app.session.queue) await app.session.play(app.segments.map(segment => segment.text), app.playhead, { play: false });\n  app.session.resume();\n  app.music.start().catch(() => {});\n}\n\nfunction onSpeechState(event) {\n  const { state, segmentIndex } = event.detail;\n  if (state === 'idle') { setSpeakLabel('▶ 朗读', '开始朗读'); app.music.setDucked(false); app.media?.update({ state: 'paused' }); return; }\n  if (state === 'ended') {\n    setSpeakLabel('▶ 朗读', '重新朗读');\n    app.music.setDucked(false);\n    $('nowDetail').textContent = '本书已读完';\n    persistPosition();\n    app.media?.update({ state: 'paused' });\n    toast('本书已读完');\n    return;\n  }\n  if (Number.isInteger(segmentIndex) && ['playing', 'loading'].includes(state)) {\n    app.playhead = segmentIndex;\n    const { chapter, segment } = positionOf(segmentIndex);\n    updateChapterLabel(chapter);\n    markTocCurrent(chapter);\n    updateReadingProgress(chapter);\n    $('nowTitle').textContent = app.chapters[chapter]?.title || '';\n    $('nowDetail').textContent = `第 ${segment + 1} / ${app.chapters[chapter]?.segments.length || 0} 段`;\n    scheduleProgress();\n    if (state === 'playing') app.layout?.markActive(segmentIndex);\n  }\n  if (state === 'playing') {\n    setSpeakLabel('⏸ 暂停', '暂停朗读');\n    app.music.setDucked(true);\n    $('engineBadge').textContent = app.session?.engine_used === 'device' ? '引擎：系统语音' : '引擎：自然朗读';\n    app.media?.update({ state: 'playing' });\n  } else if (state === 'paused') {\n    setSpeakLabel('▶ 继续', '继续朗读');\n    app.music.setDucked(false);\n    persistPosition();\n    app.media?.update({ state: 'paused' });\n  } else if (state === 'loading') {\n    setSpeakLabel('… 缓冲', '正在准备朗读');\n  }\n}\n\nfunction setSpeakLabel(text, label) {\n  $('speakButton').textContent = text;\n  $('speakButton').setAttribute('aria-label', label);\n}\n\n$('speakButton').onclick = async () => {\n  if (!app.session) return;\n  if (app.session.playing || app.session.state === 'loading') return app.session.pause();\n  if (app.session.state === 'paused' || app.session.state === 'ready') return app.session.resume();\n  return startSpeech();\n};\n\nfunction step(direction) {\n  seekTo(app.playhead + direction, { speak: app.session?.playing });\n}\n$('prevSegment').onclick = () => step(-1);\n$('nextSegment').onclick = () => step(1);\n\n// ----------------------------------------------------------------- bookmarks\nfunction updateBookmarkButton() {\n  const { chapter, segment } = positionOf(app.playhead);\n  const marked = app.bookmarks.some(item => item.chapterIndex === chapter && item.segmentIndex === segment);\n  $('bookmarkAdd').textContent = marked ? '★ 已书签' : '☆ 书签';\n}\n\nasync function loadBookmarks() {\n  app.bookmarks = [];\n  if (server.online && app.book) {\n    try {\n      const bundle = await api.bookBundle(app.book.id);\n      app.bookmarks = bundle.bookmarks || [];\n    } catch { app.bookmarks = []; }\n  }\n  updateBookmarkButton();\n}\n\n$('bookmarkAdd').onclick = async () => {\n  if (!app.book) return;\n  const { chapter, segment } = positionOf(app.playhead);\n  const label = `${app.chapters[chapter]?.title || ''} · 第 ${segment + 1} 段`;\n  if (app.bookmarks.some(item => item.chapterIndex === chapter && item.segmentIndex === segment)) {\n    toast(`这一段已经有书签了`);\n    return;\n  }\n  const local = {\n    id: `local-${crypto.randomUUID()}`, chapterIndex: chapter, segmentIndex: segment,\n    label, createdAt: new Date().toISOString(), pending: true,\n  };\n  app.bookmarks = [...app.bookmarks, local];\n  updateBookmarkButton();\n  toast(`已添加书签：${label}`);\n  if (server.online) {\n    api.addBookmark({ bookId: app.book.id, chapterIndex: chapter, segmentIndex: segment, label })\n      .then(saved => {\n        app.bookmarks = app.bookmarks.map(item => item.id === local.id ? { ...saved, pending: false } : item);\n      })\n      .catch(() => toast('书签已记在本次阅读中，家庭服务器暂未同步', { tone: 'error' }));\n  }\n};\n\n// -------------------------------------------------------------------- panels\nfunction togglePanel(name) {\n  const panel = $(`${name}Panel`);\n  if (!panel) return;\n  if (panel.hidden) openPanel(name); else closePanels();\n}\n\n$('tocButton').onclick = () => togglePanel('toc');\n$('notesButton').onclick = () => { app.notes?.render(); updateNoteCount(); togglePanel('notes'); };\n$('settingsButton').onclick = () => { renderSettings(); togglePanel('settings'); };\n$('layoutButton').onclick = () => switchLayout(app.layoutKind === 'scrolled' ? 'paged' : 'scrolled');\n\ndocument.querySelectorAll('[data-close]').forEach(button => {\n  button.onclick = () => closePanels();\n});\n\nfunction switchLayout(kind) {\n  app.layoutKind = kind;\n  app.settings = writeSettings({ layout: kind });\n  buildLayout(app.playhead);\n  $('layoutButton').textContent = kind === 'scrolled' ? '分页' : '连续';\n  toast(kind === 'scrolled' ? '已切换为连续滚动阅读' : '已切换为分页听读');\n}\n\n// ------------------------------------------------------------------ settings\nfunction renderSettings() {\n  if (!app.settingsPanel) {\n    app.settingsPanel = new SettingsPanel({\n      container: $('settingsBody'),\n      settings: app.settings,\n      music: app.music,\n      voices: () => app.voicesData,\n      onChange: patch => {\n        app.settings = writeSettings(patch);\n        app.settingsPanel.settings = app.settings;\n        applyTheme();\n        if (patch.speed !== undefined) app.session?.setSpeed(patch.speed);\n        if (patch.voice !== undefined) app.session?.setVoice(patch.voice);\n        if (patch.musicLevel !== undefined) app.music.setLevel(patch.musicLevel);\n        if (patch.ducking !== undefined) app.music.setDucking(patch.ducking);\n        if (patch.layout !== undefined && patch.layout !== app.layoutKind) { switchLayout(patch.layout); return; }\n        renderSettings();\n      },\n      onMusic: () => $('musicInput').click(),\n      onMusicClear: async () => { await app.music.clear(); renderSettings(); toast('已移除本机背景音乐'); },\n      onManageVoices: () => { closePanels(); togglePanel('voices'); app.voices?.load(); },\n    });\n  } else {\n    app.settingsPanel.settings = app.settings;\n  }\n  app.settingsPanel.render();\n}\n\n$('musicInput').addEventListener('change', async event => {\n  const file = event.target.files?.[0];\n  event.target.value = '';\n  if (!file) return;\n  try {\n    await app.music.choose(file);\n    await app.music.start();\n    renderSettings();\n    toast(`背景音乐「${file.name}」已保存在本机`);\n  } catch (err) {\n    toast(`背景音乐没能保存：${err.message}`, { tone: 'error' });\n  }\n});\n\n// -------------------------------------------------------------------- voices\n$('openVoices').onclick = () => {\n  togglePanel('voices');\n  app.voices?.load();\n};\n\n// ------------------------------------------------------------------ strategy\nfunction syncMedia(state) {\n  app.media?.update({\n    title: app.segments[app.playhead]?.text || '',\n    artist: app.book?.author || '陪你读书',\n    album: app.book?.title || '',\n    state,\n  });\n}\n\nfunction closeReader() {\n  persistPosition();\n  app.session?.stop();\n  app.session = null;\n  app.music.pause();\n  app.music.setDucked(false);\n  app.layout?.destroy();\n  app.layout = null;\n  app.book = null;\n  app.media?.update({ state: 'none' });\n  $('readerScreen').hidden = true;\n  document.body.style.overflow = '';\n  closePanels();\n  paintShelf();\n}\n$('closeReader').onclick = closeReader;\n\n// ------------------------------------------------------------------ keyboard\ndocument.addEventListener('keydown', event => {\n  if ($('readerScreen').hidden) return;\n  const shortcut = shortcutFor(event, app.layoutKind);\n  if (!shortcut) return;\n  event.preventDefault();\n  if (shortcut.action === 'next') step(1);\n  else if (shortcut.action === 'prev') step(-1);\n  else if (shortcut.action === 'page-next') seekTo(app.playhead + 1);\n  else if (shortcut.action === 'toggle-speech') $('speakButton').click();\n  else if (shortcut.action === 'close-panels') {\n    const open = [...document.querySelectorAll('.panel')].some(panel => !panel.hidden);\n    if (open) closePanels(); else closeReader();\n  } else if (shortcut.action === 'toggle-panel') togglePanel(shortcut.panel);\n  else if (shortcut.action === 'add-bookmark') $('bookmarkAdd').click();\n  else if (shortcut.action === 'start') seekTo(0);\n  else if (shortcut.action === 'speed') {\n    app.settings = writeSettings({ speed: shortcut.value });\n    app.session?.setSpeed(shortcut.value);\n    toast(`语速 ${shortcut.value.toFixed(1)}×`);\n  }\n});\n\n$('shelfSearch').addEventListener('input', paintShelf);\n\n//