ion(index,run){if(run!==token||!active)return;let txt='';if(view){const section=view.book?.sections[index];if(!section){stop();status('已朗读到结尾');return}await view.goTo(index);const doc=await section.createDocument();doc.querySelectorAll('script,style,nav').forEach(x=>x.remove());txt=(doc.body||doc.documentElement)?.textContent||''}else{if(index>=textPages.length){stop();status('已朗读到结尾');return}textIndex=index;renderText();txt=textPages[index]}if(run!==token)return;txt=txt.replace(/\\s+/g,' ').trim();if(!txt){await speakSection(index+1,run);return}let offset=0;const pieces=txt.match(/[\\s\\S]{1,550}/g)||[];function nextPiece(){if(run!==token)return;if(offset>=pieces.length){speakSection(index+1,run).catch(speechFailure);return}const u=new SpeechSynthesisUtterance(pieces[offset++]);utter=u;u.lang='zh-CN';u.rate=Number($('rate').value);const v=voices()[Number($('voice').value)];if(v)u.voice=v;u.onend=nextPiece;u.onerror=e=>{stop();status('朗读失败：'+e.error)};synth.speak(u)}nextPiece()}\n$('speak').onclick=async()=>{if(!supported){status('当前浏览器没有语音朗读能力');return}if(speaking){if(synth.paused){synth.resume();syncMusicVolume();$('speak').textContent='⏸ 暂停'}else{synth.pause();syncMusicVolume();$('speak').textContent='▶ 继续'}return}stop();speaking=true;syncMusicVolume();$('speak').textContent='⏸ 暂停';const run=token;try{const index=view?(view.renderer?.getContents()?.[0]?.index??0):textIndex;await speakSection(index,run)}catch(e){speechFailure(e)}};\nfunction setMusicSource(blob,name){const audio=$('music');if(audio.dataset.url)URL.revokeObjectURL(audio.dataset.url);audio.dataset.url=URL.createObjectURL(blob);audio.src=audio.dataset.url;$('musicName').textContent=name||'本机背景音';$('clearMusic').hidden=false;syncMusicVolume()}\nasync function restoreMusic(){const saved=await request(settingsTx().get('background-audio'));if(saved?.blob instanceof Blob&&saved.blob.size)setMusicSource(saved.blob,saved.name)}\n$('musicFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{aw